# Unity Compass - Environment Configuration
# Copy this file to .env and fill in your values

# 1. Supabase (From Supabase Dashboard -> Project Settings -> API)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 2. Resend Email Notifications (From resend.com -> API Keys)
RESEND_API_KEY=re_your_resend_api_key
ADMIN_EMAIL=syedtawseef0@gmail.com
FROM_EMAIL="Unity Compass <onboarding@resend.dev>"

# 3. Executive Admin Dashboard Passkey
ADMIN_PASSKEY=admin123
