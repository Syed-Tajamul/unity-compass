<MainLayout
  title="Information Technology and Business Consulting - Unity Compass"
  description="Innovative IT and Business Consulting Solutions to empower organizations and drive success with tailored, cutting-edge services."
>
  <div class="text-slate-800 overflow-hidden" id="it-consulting-page-root">

    <!-- ===================================================================== -->
    <!-- SECTION 1: HERO & PRACTICE OVERVIEW                                   -->
    <!-- Top: Centered Shimmer Heading with Accent Line                        -->
    <!-- Middle Row: Image (~68%) | Practice Areas Menu (~32%)                 -->
    <!-- Bottom Row: Headline + Narrative (~56%) | 4 Centered Squares (~44%)   -->
    <!-- Background: PURE WHITE                                                -->
    <!-- ===================================================================== -->
    <section class="relative pt-12 sm:pt-16 lg:pt-20 pb-16 sm:pb-24 bg-white border-b border-slate-200/80 overflow-hidden" aria-labelledby="service-hero-heading">
      
      <!-- Subtle Radial Ambient Glows -->
      <div class="absolute top-1/4 -left-32 w-[600px] h-[600px] bg-[radial-gradient(circle,rgba(40,121,182,0.08)_0%,transparent_70%)] rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute -top-20 -right-32 w-[600px] h-[600px] bg-[radial-gradient(circle,rgba(30,64,175,0.05)_0%,transparent_70%)] rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="max-w-7xl xl:max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-12 sm:space-y-16">
        
        <!-- PART 1: PAGE TOP CENTERED HEADER (Before Image) -->
        <div class="text-center max-w-4xl mx-auto space-y-4">
          <h1
            id="service-hero-heading"
            class="hero-heading-reveal text-3xl sm:text-4xl lg:text-[2.85rem] font-extrabold tracking-tight leading-[1.34] sm:leading-[1.36] lg:leading-[1.38] text-[#0B2553]"
          >
            <span class="service-shimmer-center service-shimmer-line-1 inline-block pb-2 pt-1">Information Technology and Business Consulting</span>
          </h1>
          <div class="w-24 h-1.5 rounded-full bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130] mx-auto hero-subheading-reveal mt-2"></div>
