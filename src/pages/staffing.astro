<!-- Client Script: Automatic Infinite Carousel Engine & On-Load Reveals -->
<script is:inline>
  function initStaffingPage() {
    // 1. On-Load Staggered Reveals
    const revealElements = document.querySelectorAll('.reveal-on-load');
    revealElements.forEach((el) => {
      const delay = el.getAttribute('data-delay') || '0';
      setTimeout(() => {
        el.classList.add('is-revealed');
      }, parseInt(delay, 10));
    });

    // 2. Section 3: "How We Deliver" Infinite Seamless Carousel Engine (Contragenix Inspiration)
    const track = document.getElementById('delivery-carousel-track');
    const viewport = document.getElementById('delivery-carousel-viewport');
    const prevBtn = document.getElementById('delivery-carousel-prev');
    const nextBtn = document.getElementById('delivery-carousel-next');

    if (track && viewport) {
      const stepCount = 5; // 5 unique stages in deliverySteps
      let currentIndex = stepCount; // Start at middle set (index 5 = Stage 1)
      let isAnimating = false;
      let autoplayTimer = null;

      function getStepOffset() {
        const card = track.querySelector('.carousel-stage-card');
        if (!card) return 394;
        const cardWidth = card.getBoundingClientRect().width;
        const gap = 24; // 24px gap-6
        return cardWidth + gap;
      }

      function setPosition(index, withTransition = true) {
        const stepOffset = getStepOffset();
        if (withTransition) {
          track.style.transition = 'transform 0.5s cubic-bezier(0.16, 1, 0.3, 1)';
        } else {
          track.style.transition = 'none';
        }
        track.style.transform = `translateX(-${index * stepOffset}px)`;
        currentIndex = index;
      }

      function nextSlide() {
        if (isAnimating) return;
        isAnimating = true;
        setPosition(currentIndex + 1, true);
      }

      function prevSlide() {
        if (isAnimating) return;
        isAnimating = true;
        setPosition(currentIndex - 1, true);
      }

      track.addEventListener('transitionend', () => {
        isAnimating = false;
        // Seamless wraparound: If moved into 3rd set (>= 10), instantly snap back to 2nd set (- 5)
        if (currentIndex >= stepCount * 2) {
          setPosition(currentIndex - stepCount, false);
        }
        // If moved into 1st set (< 5), instantly snap forward to 2nd set (+ 5)
        else if (currentIndex < stepCount) {
          setPosition(currentIndex + stepCount, false);
        }
      });

      function startAutoplay() {
        stopAutoplay();
        autoplayTimer = setInterval(nextSlide, 3500);
      }

      function stopAutoplay() {
        if (autoplayTimer) {
          clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      }

      if (nextBtn) nextBtn.addEventListener('click', () => {
        nextSlide();
        startAutoplay();
      });

      if (prevBtn) prevBtn.addEventListener('click', () => {
        prevSlide();
        startAutoplay();
      });

      viewport.addEventListener('mouseenter', stopAutoplay);
      viewport.addEventListener('mouseleave', startAutoplay);
      viewport.addEventListener('touchstart', stopAutoplay, { passive: true });
      viewport.addEventListener('touchend', startAutoplay, { passive: true });

      window.addEventListener('resize', () => {
        setPosition(currentIndex, false);
      });

      // Position at Stage 1 of the middle set immediately
      setPosition(stepCount, false);
      startAutoplay();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStaffingPage);
  } else {
    initStaffingPage();
  }
  document.addEventListener('astro:page-load', initStaffingPage);
</script>

