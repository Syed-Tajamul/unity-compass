---
/**
 * staffing.astro
 * 
 * Executive Staffing Solutions Practice Page
 * Bespoke Implementation per User Specification:
 * 1. Page Header (Top Center before Image):
 *    - Title: "Staffing Solutions" with radiant color shimmer and soft initial reveal.
 *    - Subtle gradient accent line.
 * 2. Hero Image & Practice Areas Menu:
 *    - Unclipped showcase frame with object-contain and aspect-[2752/1536].
 *    - 5 Other Practice Areas (current practice excluded).
 *    - Hover state inherits the selected bluish pill style: deep blue gradient with white text.
 * 3. Headline + Narrative & 4 Square Value Cards (Below Section):
 *    - Headline placed directly BEFORE the narrative: "Staffing Solutions Tailored to Your Business Needs"
 *    - Exact user narrative paragraphs highlighting workforce agility & staffing models.
 *    - 4 Center-aligned square cards in 2x2 grid representing the core models & administration.
 * 4. Section 2 ("Staffing Models"):
 *    - Displays the 3 Staffing Models requested by user:
 *      1. Contract / Short-Term Staffing
 *      2. Long-Term Staffing
 *      3. Temp-to-Hire
 *    - Shuttle bottom-to-top color fill cards matching the proposal service page.
 *    - NOTE: "How We Deliver" timeline is REMOVED per user request.
 * 5. Section 3 ("Why UC?"):
 *    - High-end "Prism Spotlight Stage" card animation: dynamic cursor spotlight glow,
 *      3D spring elevation, sibling dimming, and independent floating icon physics.
 * 6. Section 4 ("Ready to Win Your Next Government Contract?"):
 *    - CTA banner with "Book a Strategic Call" button and compass watermark.
 * 7. Alternating backgrounds: White -> Light Blue Blueprint -> White -> Light Blue Blueprint.
 */
import MainLayout from '../layouts/MainLayout.astro';
import WaveDivider from '../components/WaveDivider.astro';

// Remaining 5 Federal Practice Areas (Excluding current practice: Staffing Solutions)
const otherFederalServices = [
  {
    name: 'Proposal Development & Federal Bid Support',
    href: '/proposal-development-services',
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  },
  {
    name: 'OASIS+ & IDIQ Qualification Support',
    href: '/customized-support-services',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    name: 'Security-Cleared Recruitment',
    href: '/recruitment-services',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
  },
  {
    name: 'IT & Program Consulting',
    href: '/information-technology-and-business-consulting',
    icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  },
  {
    name: 'Contract Compliance Support',
    href: '/customized-support-services',
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4',
  },
];

// 4 Animated Square Cards: Client-Focused Staffing Delivery Promises (Complements the 3 Models Below)
const keySquareCards = [
  {
    title: 'Rapid Candidate Turnaround',
    desc: 'Pre-screened talent pools ready to mobilize within days for urgent project deadlines.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
    themeColor: 'text-[#0C487A]',
    iconBg: 'bg-blue-100/90 text-[#0C487A]',
    borderColor: 'border-blue-200/80',
    cardBg: 'from-blue-50/70 via-white to-blue-50/30',
    topBar: 'from-[#0C487A] to-[#1E40AF]',
    hoverShadow: 'hover:shadow-[0_16px_36px_rgba(12,72,122,0.16)]',
    hoverTitle: 'group-hover:text-[#0C487A]',
    floatClass: 'animate-float-subtle-1',
  },
  {
    title: 'Multi-Tier Candidate Vetting',
    desc: 'In-depth technical assessments, background checks, and reference audits before submission.',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
    themeColor: 'text-[#0B2553]',
    iconBg: 'bg-slate-100 text-[#0B2553]',
    borderColor: 'border-slate-200/90',
    cardBg: 'from-slate-50/80 via-white to-slate-100/40',
    topBar: 'from-[#0B2553] to-[#0C487A]',
    hoverShadow: 'hover:shadow-[0_16px_36px_rgba(11,37,83,0.16)]',
    hoverTitle: 'group-hover:text-[#0B2553]',
    floatClass: 'animate-float-subtle-2',
  },
  {
    title: 'Turnkey HR & Payroll',
    desc: 'Direct handling of payroll cycles, tax withholdings, I-9 verification, and benefits management.',
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4',
    themeColor: 'text-[#1E40AF]',
    iconBg: 'bg-indigo-100/90 text-[#1E40AF]',
    borderColor: 'border-blue-200/80',
    cardBg: 'from-indigo-50/70 via-white to-blue-50/30',
    topBar: 'from-[#1E40AF] to-[#2563EB]',
    hoverShadow: 'hover:shadow-[0_16px_36px_rgba(30,64,175,0.16)]',
    hoverTitle: 'group-hover:text-[#1E40AF]',
    floatClass: 'animate-float-subtle-1',
  },
  {
    title: 'Replacement Guarantee',
    desc: 'Zero-risk workforce flexibility—if a placement is not the right fit, we replace them promptly.',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
    themeColor: 'text-[#FF3130]',
    iconBg: 'bg-red-100/90 text-[#FF3130]',
    borderColor: 'border-red-200/80',
    cardBg: 'from-rose-50/70 via-white to-rose-50/30',
    topBar: 'from-[#FF3130] to-[#DC2626]',
    hoverShadow: 'hover:shadow-[0_16px_36px_rgba(255,49,48,0.16)]',
    hoverTitle: 'group-hover:text-[#FF3130]',
    floatClass: 'animate-float-subtle-2',
  },
];

// The 3 Staffing Models provided by user (Featured in Section 2 with Shuttle Bottom-to-Top Animation)
const staffingModels = [
  {
    title: 'Contract / Short-Term Staffing',
    desc: 'Ideal for immediate or specialized requirements, this model supports short-term projects, seasonal needs, and temporary roles requiring quick deployment.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
    badgeText: 'Immediate Deployment',
    theme: 'text-[#0C487A]',
    bgTint: 'bg-blue-50',
    borderColor: 'border-blue-100/80',
  },
  {
    title: 'Long-Term Staffing',
    desc: 'A proactive staffing approach aligned with business growth plans, including new office setups, backfills, retirements, maternity leave coverage, and sabbaticals.',
    icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
    badgeText: 'Strategic Growth',
    theme: 'text-[#1E40AF]',
    bgTint: 'bg-indigo-50',
    borderColor: 'border-indigo-100/80',
  },
  {
    title: 'Temp-to-Hire',
    desc: 'A flexible trial-based model that allows organizations to evaluate performance and cultural fit before transitioning professionals into permanent roles.',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
    badgeText: 'Trial-to-Permanent',
    theme: 'text-[#FF3130]',
    bgTint: 'bg-rose-50',
    borderColor: 'border-red-100/80',
  },
];
---

<MainLayout
  title="Staffing Solutions - Unity Compass"
  description="Flexible staffing solutions to meet short-term, long-term, and project-based workforce needs. Contract, long-term, and temp-to-hire staffing models."
>
  <div class="text-slate-800 overflow-hidden" id="staffing-page-root">

    <!-- ===================================================================== -->
    <!-- SECTION 1: HERO & PRACTICE OVERVIEW                                   -->
    <!-- Top: Centered Shimmer Heading (Page Top Before Image)                 -->
    <!-- Middle Row: Image (~68%) | Practice Areas Menu (~32%)                 -->
    <!-- Bottom Row: Headline + Narrative (~56%) | 4 Centered Squares (~44%)   -->
    <!-- Background: PURE WHITE                                                -->
    <!-- ===================================================================== -->
    <section class="relative pt-12 sm:pt-16 lg:pt-20 pb-16 sm:pb-20 bg-white overflow-hidden" aria-labelledby="service-hero-heading">
      
      <!-- Subtle Radial Ambient Glows -->
      <div class="absolute top-1/4 -left-32 w-[600px] h-[600px] bg-[radial-gradient(circle,rgba(40,121,182,0.08)_0%,transparent_70%)] rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute -top-20 -right-32 w-[600px] h-[600px] bg-[radial-gradient(circle,rgba(255,49,48,0.06)_0%,transparent_70%)] rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="max-w-7xl xl:max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-12 sm:space-y-16">
        
        <!-- ================================================================= -->
        <!-- PART 1: PAGE TOP CENTERED HEADER (Before Image)                   -->
        <!-- Has initial soft reveal blur dissipation matching Homepage Hero  -->
        <!-- ================================================================= -->
        <div class="text-center max-w-4xl mx-auto space-y-4">
          <h1
            id="service-hero-heading"
            class="hero-heading-reveal text-3xl sm:text-4xl lg:text-[2.85rem] font-extrabold tracking-tight leading-tight text-[#0B2553]"
          >
            <span class="service-shimmer-center service-shimmer-line-1 inline-block pb-1">Staffing Solutions</span>
          </h1>
          <div class="w-24 h-1.5 rounded-full bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130] mx-auto hero-subheading-reveal"></div>
        </div>

        <!-- ================================================================= -->
        <!-- PART 2: SHOWCASE FRAME (Image ~68%) + PRACTICE MENU (~32%)        -->
        <!-- ================================================================= -->
        <div class="flex flex-col lg:flex-row items-stretch gap-8 lg:gap-8 xl:gap-10">
          
          <!-- Image Column (~68% Width: Unclipped Graphic Artwork with Corner Badge 100% Visible) -->
          <div class="w-full lg:w-[68%] relative flex justify-center items-center hero-image-reveal">
            <div class="relative w-full group h-full flex flex-col justify-center">
              
              <!-- Soft Dynamic Ambient Glow Aura -->
              <div class="absolute -inset-4 bg-gradient-to-tr from-[#0C487A]/20 via-[#1E40AF]/15 to-[#FF3130]/15 rounded-3xl blur-2xl pointer-events-none opacity-80 group-hover:opacity-100 transition-opacity duration-500" aria-hidden="true"></div>
              
              <!-- Refined Image Window Frame (object-contain with natural aspect ratio to eliminate clipping) -->
              <div class="relative rounded-3xl overflow-hidden border border-slate-200/90 bg-white shadow-[0_20px_50px_-12px_rgba(11,37,83,0.16)] w-full">
                
                <img
                  src="/images/service4.png"
                  alt="Staffing Solutions"
                  class="w-full h-auto aspect-[2752/1536] object-contain object-center group-hover:scale-[1.015] transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] select-none block"
                  width="2752"
                  height="1536"
                  loading="eager"
                />

                <!-- High-End Specular Glass Sheen Overlay -->
                <div class="absolute inset-0 bg-gradient-to-tr from-black/5 via-transparent to-white/10 pointer-events-none"></div>

                <!-- Glowing Top Accent Line on Hover -->
                <div class="absolute inset-x-0 top-0 h-1.5 rounded-t-3xl bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

              </div>

            </div>
          </div>

          <!-- Practice Areas Menu Column (~32% Width: Current Page Excluded, Active Blue Hover) -->
          <div class="w-full lg:w-[32%] flex flex-col justify-center hero-menu-reveal">
            <div class="rounded-3xl border border-slate-200/90 bg-white/95 backdrop-blur-md p-4 sm:p-5 shadow-[0_12px_36px_-10px_rgba(11,37,83,0.08)] flex flex-col justify-center space-y-2.5 h-full">
              
              <div class="space-y-2 flex-1 flex flex-col justify-center py-2">
                {otherFederalServices.map((service, idx) => (
                  <a
                    href={service.href}
                    class="group relative flex items-center justify-between px-4 sm:px-5 py-3.5 sm:py-4 rounded-2xl text-slate-700 font-semibold text-sm transition-all duration-300 border border-slate-200/60 hover:border-[#0C487A]/30 hover:bg-gradient-to-r hover:from-[#0C487A] hover:via-[#103E6B] hover:to-[#1E40AF] hover:text-white hover:shadow-[0_10px_25px_-5px_rgba(12,72,122,0.45)] hover:scale-[1.02] cursor-pointer"
                    style={`--stagger-delay: ${idx * 40}ms;`}
                  >
                    <div class="flex items-center gap-3 min-w-0 pr-2">
                      <span class="w-2.5 h-2.5 rounded-full bg-slate-300 group-hover:bg-[#FF3130] group-hover:shadow-[0_0_8px_#FF3130] transition-all duration-300 shrink-0"></span>
                      <span class="leading-snug transition-colors duration-300">{service.name}</span>
                    </div>
                    <svg class="w-4 h-4 text-slate-400 group-hover:text-white group-hover:translate-x-1 transition-all duration-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                ))}
              </div>

            </div>
          </div>

        </div>

        <!-- ================================================================= -->
        <!-- PART 3: HEADLINE + NARRATIVE (56%) + 4 SQUARES (44%) IN BELOW ROW -->
        <!-- Headline placed directly before narrative!                        -->
        <!-- ================================================================= -->
        <div class="pt-8 sm:pt-10 border-t border-slate-100 flex flex-col lg:flex-row items-center gap-10 lg:gap-12 xl:gap-14">
          
          <!-- Narrative Column (~56% Width: Exact user headline & narrative paragraphs) -->
          <div class="w-full lg:w-[56%] space-y-4 text-left reveal-on-scroll reveal-left">
            
            <h2 class="text-xl sm:text-2xl lg:text-[1.65rem] font-bold text-[#0B2553] leading-snug sm:leading-[1.42]">
              Staffing Solutions Tailored to Your Business Needs
            </h2>
            <div class="w-16 h-1 rounded-full bg-gradient-to-r from-[#0C487A] to-[#FF3130] mb-3"></div>

            <div class="space-y-4 pt-1">
              <p class="text-base sm:text-lg text-slate-600 leading-[2] sm:leading-[2.05] font-normal">
                Unity Compass provides flexible staffing solutions to meet short-term, long-term, and project-based workforce needs. Whether you’re launching a new project, managing seasonal demand, or navigating workforce transitions, our staffing services deliver the right professionals exactly when you need them.
              </p>

              <p class="text-base sm:text-lg text-slate-600 leading-[2] sm:leading-[2.05] font-normal">
                We support organizations with <strong class="font-bold text-[#0C487A]">contract, long-term, and temp-to-hire staffing models</strong>, while handling payroll, compliance, onboarding, and workforce administration. This allows you to stay focused on core business operations while maintaining <strong class="font-bold text-[#FF3130]">workforce agility.</strong>
              </p>
            </div>

          </div>

          <!-- 4 Square Animated Cards Column (~44% Width: 2x2 Grid with Two-Layer Sliding Profile Card Animation) -->
          <div class="w-full lg:w-[44%] reveal-on-scroll reveal-right delay-150">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5 w-full max-w-lg mx-auto lg:mx-0">
              {keySquareCards.map((card, idx) => (
                <div
                  class="square-slide-card group relative cursor-pointer"
                  style={`transition-delay: ${idx * 60}ms;`}
                >
                  <!-- Slide 1: Top Slide (Icon + Title, glides UP on hover) -->
                  <div class="square-slide square-slide-top relative rounded-3xl bg-gradient-to-br from-[#0C487A] via-[#103E6B] to-[#1E40AF] p-4 text-center text-white border border-white/15 shadow-[0_10px_24px_rgba(12,72,122,0.18)] flex flex-col items-center justify-center">
                    <!-- Ambient Glow -->
                    <div class="absolute inset-0 rounded-3xl bg-white/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>

                    <!-- Icon Wrap with Subtle Pulse Ring Affordance -->
                    <div class="square-icon-wrap relative w-11 h-11 rounded-2xl bg-white/15 backdrop-blur-md border border-white/25 flex items-center justify-center text-white mb-2 shadow-inner transition-all duration-500">
                      <div class="absolute -inset-1 rounded-2xl border border-white/30 opacity-70 animate-ping-slow pointer-events-none"></div>
                      <svg class="square-icon-svg w-6 h-6 transition-all duration-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d={card.icon} />
                      </svg>
                    </div>

                    <!-- Title -->
                    <h3 class="square-title text-sm sm:text-[0.92rem] font-bold text-white tracking-tight leading-snug px-1 transition-all duration-500 line-clamp-2">
                      {card.title}
                    </h3>

                    <!-- Subtle Federal Visual Affordance Pill (No 'hover me' text!) -->
                    <div class="square-affordance-pill flex items-center gap-1.5 mt-2 transition-opacity duration-300 group-hover:opacity-0">
                      <span class="w-1.5 h-1.5 rounded-full bg-[#FF3130] animate-pulse"></span>
                      <span class="w-6 h-0.5 rounded-full bg-white/40"></span>
                      <span class="w-1.5 h-1.5 rounded-full bg-blue-300/80"></span>
                    </div>
                  </div>

                  <!-- Slide 2: Bottom Slide (Description, glides DOWN on hover) -->
                  <div class="square-slide square-slide-bottom relative rounded-3xl bg-white border border-slate-200/90 p-4 flex flex-col justify-center items-center shadow-[0_8px_20px_rgba(15,39,74,0.06)] group-hover:shadow-[0_18px_36px_-8px_rgba(12,72,122,0.22)]">
                    <p class="square-desc text-xs text-slate-600 leading-relaxed font-normal text-center">
                      {card.desc}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- SECTION 2: "STAFFING MODELS" (Shuttle Bottom-to-Top Color Fill Hover) -->
    <!-- Displays the 3 Staffing Models requested by user                      -->
    <!-- Background: LIGHT BLUE BLUEPRINT CANVAS                               -->
    <!-- ===================================================================== -->
    <section class="pt-24 sm:pt-28 lg:pt-32 pb-16 sm:pb-24 bg-gradient-to-b from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] border-b border-slate-200/80 relative z-10 scroll-mt-28 overflow-hidden" aria-labelledby="staffing-models-heading">
      <!-- Pure CSS SVG Wave Section Divider (wsd-01) Leading seamlessly from White Hero into Blueprint Section -->
      <WaveDivider variant="wave" position="top" fillColor="#ffffff" />
      
      <!-- 16px Technical Blueprint Checks Pattern Overlay -->
      <div
        class="absolute inset-0 pointer-events-none opacity-25 mix-blend-multiply"
        style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.06) 1px, transparent 1px);"
        aria-hidden="true"
      ></div>

      <!-- Ambient Glow Accents -->
      <div class="absolute -top-32 left-1/4 w-[600px] h-[600px] bg-[radial-gradient(circle,rgba(40,121,182,0.12)_0%,transparent_70%)] rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute -bottom-24 right-10 w-[500px] h-[500px] bg-[radial-gradient(circle,rgba(255,49,48,0.06)_0%,transparent_70%)] rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="max-w-7xl xl:max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <!-- Section Header with Shimmer & Scroll Reveal -->
        <div class="text-center max-w-3xl mx-auto space-y-3 mb-14 sm:mb-16 reveal-on-scroll">
          <h2 id="staffing-models-heading" class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-normal">
            <span class="service-shimmer-center service-shimmer-line-1 block pb-2 pt-0.5">Staffing Models</span>
          </h2>
          <div class="w-24 h-1.5 rounded-full bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130] mx-auto mt-3 mb-4"></div>
          <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
            Three flexible workforce engagement models configured to match your project timeline, volume, and operational requirements.
          </p>
        </div>

        <!-- 3 Staffing Models: Shuttle Bottom-to-Top Color Fill Cards (Same as Proposal Page) -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 max-w-6xl mx-auto">
          {staffingModels.map((item, idx) => (
            <div
              class="shuttle-card group relative rounded-3xl bg-white border border-slate-200/90 shadow-[0_10px_30px_rgba(15,39,74,0.06)] hover:shadow-[0_24px_50px_-10px_rgba(12,72,122,0.28)] transition-all duration-400 flex flex-col justify-between min-h-[320px] p-7 sm:p-8 overflow-hidden cursor-pointer reveal-on-scroll"
              style={`transition-delay: ${idx * 90}ms;`}
              data-card-index={idx}
            >
              <!-- Shuttle Bottom-to-Top Color Fill with Organic Curved Top Crest -->
              <div
                class="shuttle-fill-layer absolute inset-0 bg-gradient-to-t from-[#0C487A] via-[#103E6B] to-[#1E40AF] translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] pointer-events-none rounded-3xl overflow-hidden"
                aria-hidden="true"
              >
                <!-- Organic Curved Soft Light Wave at Leading Edge -->
                <div class="absolute -top-5 left-0 right-0 h-10 bg-white/20 rounded-[100%] blur-sm pointer-events-none"></div>
                <div class="absolute top-0 inset-x-0 h-1 bg-[#FF3130]/80"></div>
              </div>

              <!-- Top Content -->
              <div class="relative z-10">
                
                <!-- Icon Badge with Soft Brand Tint & Glow -->
                <div class="relative w-14 h-14 flex items-center justify-center mb-6">
                  <div class="absolute inset-0 rounded-2xl bg-[#0C487A]/15 blur-lg opacity-40 group-hover:opacity-0 transition-opacity"></div>
                  
