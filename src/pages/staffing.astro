---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContactForm from '../components/ContactForm.astro';
import { servicesData } from '../data/services';
import { companyInfo } from '../data/company';

const service = servicesData.find((s) => s.id === 'staffing')!;
---

<MainLayout
  title={`${service.title} - Unity Compass`}
  description="Find top-tier staffing solutions for federal and commercial contractors. Contract, long-term, and temp-to-hire staffing models engineered for mission success."
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-slate-900 to-brand-dark text-white py-16 sm:py-24 border-b border-slate-800 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-5">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-brand-red/20 text-red-400 border border-brand-red/30">
            Workforce Agility
          </span>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
            Staffing Solutions Tailored to Your Business Needs
          </h1>
          <p class="text-lg text-slate-300 font-medium leading-relaxed">
            {service.heroHeadline}
          </p>
          <p class="text-sm sm:text-base text-slate-400 leading-relaxed">
            {service.leadParagraph}
          </p>
          <div class="pt-3 flex flex-wrap items-center gap-4">
            <Button href="/contact" variant="primary" size="md">
              Request Staffing Support
            </Button>
            <Button href="/career" variant="outline" size="md">
              Browse Open Positions
            </Button>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden border border-slate-700 shadow-2xl bg-slate-800">
            <img
              src={service.image}
              alt={service.title}
              class="w-full h-auto object-cover"
              width="600"
              height="400"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Staffing Models Section -->
  <section class="py-16 sm:py-24 bg-white" aria-labelledby="models-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Engagement Models"
        title="Three Flexible Staffing Models"
        description="Whether you need immediate project reinforcement or strategic multi-year program staffing, we provide flexible structures designed around government contracting requirements."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Contract / Short-Term -->
        <div class="gov-card flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono font-bold text-brand-red bg-red-50 px-2 py-0.5 rounded border border-red-100">
                MODEL 01
              </span>
              <span class="text-xs font-semibold text-slate-400 uppercase">Surge Support</span>
            </div>
            <h3 class="text-xl font-bold text-slate-900 tracking-tight">Contract / Short-Term Staffing</h3>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">
              Fast, specialized talent for short-term projects, unexpected surges, and immediate skill gaps, ensuring quick deployment without long-term commitments.
            </p>
            <ul class="mt-4 pt-4 border-t border-slate-100 space-y-2 text-xs text-slate-500">
              <li class="flex items-center gap-2">
                <span class="text-brand-red font-bold">&bull;</span>
                <span>Immediate deployment for proposal surges</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-brand-red font-bold">&bull;</span>
                <span>Task-order specific technical support</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-brand-red font-bold">&bull;</span>
                <span>Fixed-duration project delivery</span>
              </li>
            </ul>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100">
            <a href="/contact" class="text-xs font-bold text-brand-navy hover:text-brand-red transition-colors inline-flex items-center gap-1">
              <span>Inquire about contract staffing</span> &rarr;
            </a>
          </div>
        </div>

        <!-- Long-Term Staffing -->
        <div class="gov-card flex flex-col justify-between border-brand-navy/30">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono font-bold text-brand-navy bg-blue-50 px-2 py-0.5 rounded border border-blue-100">
                MODEL 02
              </span>
              <span class="text-xs font-semibold text-brand-navy uppercase">Program Continuity</span>
            </div>
            <h3 class="text-xl font-bold text-slate-900 tracking-tight">Long-Term Staffing</h3>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">
              A proactive staffing approach aligned with business growth plans, including new office setups, core personnel backfills, retirements, maternity leave coverage, and sabbaticals.
            </p>
            <ul class="mt-4 pt-4 border-t border-slate-100 space-y-2 text-xs text-slate-500">
              <li class="flex items-center gap-2">
                <span class="text-brand-navy font-bold">&bull;</span>
                <span>Multi-year contract vehicle execution</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-brand-navy font-bold">&bull;</span>
                <span>Dedicated cleared engineering squads</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-brand-navy font-bold">&bull;</span>
                <span>Long-term knowledge retention</span>
              </li>
            </ul>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100">
            <a href="/contact" class="text-xs font-bold text-brand-navy hover:text-brand-red transition-colors inline-flex items-center gap-1">
              <span>Inquire about long-term staffing</span> &rarr;
            </a>
          </div>
        </div>

        <!-- Temp-to-Hire -->
        <div class="gov-card flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100">
                MODEL 03
              </span>
              <span class="text-xs font-semibold text-slate-400 uppercase">Trial-to-Permanent</span>
            </div>
            <h3 class="text-xl font-bold text-slate-900 tracking-tight">Temp-to-Hire</h3>
            <p class="mt-3 text-sm text-slate-600 leading-relaxed">
              A flexible trial-based model that allows organizations to evaluate performance and cultural fit before transitioning professionals into permanent roles.
            </p>
            <ul class="mt-4 pt-4 border-t border-slate-100 space-y-2 text-xs text-slate-500">
              <li class="flex items-center gap-2">
                <span class="text-emerald-600 font-bold">&bull;</span>
                <span>Hands-on evaluation on live client SOWs</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-600 font-bold">&bull;</span>
                <span>Zero bad-hire conversion risk</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-600 font-bold">&bull;</span>
                <span>Smooth permanent transition process</span>
              </li>
            </ul>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100">
            <a href="/contact" class="text-xs font-bold text-brand-navy hover:text-brand-red transition-colors inline-flex items-center gap-1">
              <span>Inquire about temp-to-hire</span> &rarr;
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Key Benefits Grid -->
  <section class="py-16 sm:py-24 bg-slate-50 border-t border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Operational Advantages"
        title="Why Contractors Choose Unity Compass Staffing"
        description="We eliminate staffing bottlenecks so your program managers can deliver on contract milestones with full confidence."
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {service.keyBenefits?.map((item) => (
          <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-subtle">
            <div class="w-10 h-10 rounded-lg bg-brand-navy/10 text-brand-navy flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 tracking-tight">{item.title}</h3>
            <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section class="py-16 sm:py-24 bg-white border-t border-slate-200/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ContactForm />
    </div>
  </section>
</MainLayout>

