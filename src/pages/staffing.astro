<!-- Client Script: Interactive Why UC Spotlight Stage & Mouse Tracking -->
<script is:inline>
  function initWhyUCCardInteractions() {
    const cardsGrid = document.getElementById('why-uc-cards-grid');
    if (!cardsGrid) return;
    const cards = cardsGrid.querySelectorAll('.why-card-spotlight');

    cards.forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });

      card.addEventListener('mouseenter', () => {
        cardsGrid.classList.add('has-active-card');
        card.classList.add('is-active-card');
      });

      card.addEventListener('mouseleave', () => {
        cardsGrid.classList.remove('has-active-card');
        card.classList.remove('is-active-card');
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWhyUCCardInteractions);
  } else {
    initWhyUCCardInteractions();
  }
  document.addEventListener('astro:page-load', initWhyUCCardInteractions);
</script>

