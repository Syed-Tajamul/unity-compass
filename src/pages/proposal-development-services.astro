    icon: 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6',
    themeColor: 'text-[#1E40AF]',
    iconBg: 'bg-indigo-100/90 text-[#1E40AF]',
    borderColor: 'border-blue-200/80',
    cardBg: 'from-indigo-50/70 via-white to-blue-50/30',
    topBar: 'from-[#1E40AF] to-[#2563EB]',
    hoverShadow: 'hover:shadow-[0_16px_36px_rgba(30,64,175,0.16)]',
    hoverTitle: 'group-hover:text-[#1E40AF]',
    floatClass: 'animate-float-subtle-1',
  },
];

// 5-Stage Delivery Process (Animated Top-to-Bottom Vertical Timeline with Interactive Opening Nodes)
const deliverySteps = [
  {
    step: '01',
    num: 1,
    title: 'Opportunity Search',
    desc: "Discover and pursue business opportunities that align with your company's vision and core competencies.",
    icon: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
    color: 'from-[#0C487A] to-[#1E40AF]',
    iconColor: 'text-[#0C487A]',
