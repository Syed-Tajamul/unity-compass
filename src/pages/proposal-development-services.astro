    color: 'from-[#FF3130] to-[#0C487A]',
    iconColor: 'text-[#FF3130]',
    bgTint: 'bg-rose-50',
    badgeText: 'Milestone 05',
  },
];

// What You Get (4 Deliverables with Shuttle Bottom-to-Top Animation)
const deliverables = [
  {
    title: 'Compelling & Tailored Content',
    desc: 'Craft persuasive proposals aligned with RFP requirements, showcasing your value proposition and expertise.',
    icon: 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z',
  },
  {
    title: 'Compliance',
    desc: 'We ensure full compliance with standards and guidelines when drafting proposals.',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    title: 'Collaborative Approach',
    desc: 'Work with SMEs and stakeholders to ensure accuracy and cohesion.',
    icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z',
  },
  {
    title: 'Increased Success Rates',
