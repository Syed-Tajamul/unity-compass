---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContactForm from '../components/ContactForm.astro';
import { servicesData } from '../data/services';
import { companyInfo } from '../data/company';

const service = servicesData.find((s) => s.id === 'proposal-development')!;
---

<MainLayout
  title={`${service.title} - Unity Compass`}
  description="With Unity Compass proposal writing expertise, you can increase your win rates and secure the contracts you deserve. Full lifecycle RFP capture and compliance."
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-slate-900 to-brand-dark text-white py-16 sm:py-24 border-b border-slate-800 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-5">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-brand-red/20 text-red-400 border border-brand-red/30">
            Federal Capture & RFP Excellence
          </span>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
            {service.title}
          </h1>
          <p class="text-lg text-slate-300 font-medium leading-relaxed">
            {service.heroHeadline}
          </p>
          <p class="text-sm sm:text-base text-slate-400 leading-relaxed">
            {service.leadParagraph}
          </p>
          <div class="pt-3 flex flex-wrap items-center gap-4">
            <Button href="/contact" variant="primary" size="md">
              Schedule Proposal Consultation
            </Button>
            <a
              href={companyInfo.capabilityPdf}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-semibold text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 transition-colors"
            >
              <svg class="w-4 h-4 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>Download Capability PDF</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden border border-slate-700 shadow-2xl bg-slate-800">
            <img
              src={service.image}
              alt={service.title}
              class="w-full h-auto object-cover"
              width="600"
              height="400"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Full Overview Section -->
  <section class="py-16 sm:py-24 bg-white" aria-labelledby="overview-heading">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <SectionHeading
        eyebrow="Overview"
        title="Precision in Government Procurement"
        description="Securing government contracts can be daunting, especially for companies new to the process or unfamiliar with federal intricacies."
        align="left"
      />

      <div class="space-y-4 text-base text-slate-700 leading-relaxed border-l-2 border-brand-navy pl-6">
        {service.fullOverview.map((p) => (
          <p>{p}</p>
        ))}
      </div>

      <!-- Not sure where to start notice -->
      <div class="mt-8 p-6 rounded-xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h4 class="text-base font-bold text-slate-900">Not sure where to start?</h4>
          <p class="text-xs sm:text-sm text-slate-600 mt-0.5">
            Contact us, and we’ll help define your opportunity pipeline and recommend the best capture solution for your needs.
          </p>
        </div>
        <Button href="/contact" variant="secondary" size="sm" class="shrink-0">
          Talk to a Specialist &rarr;
        </Button>
      </div>
    </div>
  </section>

  <!-- How We Deliver (5 Steps Process) -->
  <section class="py-16 sm:py-24 bg-slate-50 border-t border-slate-200/80" aria-labelledby="process-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Lifecycle Methodology"
        title="How We Deliver"
        description="Our structured 5-stage proposal delivery methodology guarantees compliance, minimizes rework, and drives winning scores."
      />

      <div class="grid grid-cols-1 md:grid-cols-5 gap-6">
        {service.processSteps?.map((step) => (
          <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-subtle flex flex-col justify-between">
            <div>
              <div class="text-xs font-mono font-bold text-brand-red bg-red-50 inline-block px-2 py-0.5 rounded border border-red-100 mb-3">
                STEP {step.step}
              </div>
              <h3 class="text-base font-bold text-slate-900 tracking-tight">
                {step.title}
              </h3>
              <p class="text-xs text-slate-600 mt-2 leading-relaxed">
                {step.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What You Get Section -->
  <section class="py-16 sm:py-24 bg-white border-t border-slate-200/80" aria-labelledby="benefits-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Key Deliverables"
        title="What You Get with Unity Compass"
        description="High-impact proposal deliverables designed to maximize agency evaluation scores and secure multi-year awards."
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {service.keyBenefits?.map((item) => (
          <div class="gov-card">
            <div class="w-10 h-10 rounded-lg bg-brand-navy/10 text-brand-navy flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 tracking-tight">{item.title}</h3>
            <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>

      <!-- Why UC Feature Box -->
      <div class="mt-12 bg-slate-900 text-white rounded-2xl p-8 sm:p-10 border border-slate-800">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-red">The Unity Compass Advantage</span>
        <h3 class="text-2xl font-bold tracking-tight text-white mt-1">Why UC for Proposal Development?</h3>
        <p class="mt-3 text-sm sm:text-base text-slate-300 leading-relaxed max-w-3xl">
          At Unity Compass, we provide unmatched proposal and capture services through: deep government contracting knowledge, agile solutions, and a commitment to quality without compromise.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Consultation Section -->
  <section class="py-16 sm:py-24 bg-slate-50 border-t border-slate-200/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ContactForm />
    </div>
  </section>
</MainLayout>

