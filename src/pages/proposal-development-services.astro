    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
    color: 'from-[#0C487A] to-[#2563EB]',
    iconColor: 'text-[#0C487A]',
    bgTint: 'bg-sky-50',
    badgeText: 'Milestone 04',
