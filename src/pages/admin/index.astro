    function serializeEditorContent(): any[] {
      const editor = document.getElementById('blog-editor-content');
      if (!editor) return [];
      const cleanHtml = editor.innerHTML.trim();
      return cleanHtml ? [{ tag: 'HTML', html: cleanHtml, text: cleanHtml }] : [];
    }

    function openBlogEditor(blogToEdit?: any) {
      const outletTitle = document.getElementById('outlet-view-title');
      const outletSubtitle = document.getElementById('outlet-view-subtitle');
      const idInput = document.getElementById('blog-input-id') as HTMLInputElement;
      const titleInput = document.getElementById('blog-input-title') as HTMLInputElement;
      const slugInput = document.getElementById('blog-input-slug') as HTMLInputElement;
      const authorInput = document.getElementById('blog-input-author') as HTMLInputElement;
      const readInput = document.getElementById('blog-input-readtime') as HTMLInputElement;
      const excerptInput = document.getElementById('blog-input-excerpt') as HTMLTextAreaElement;
      const imgInput = document.getElementById('blog-input-image') as HTMLInputElement;
      const pubInput = document.getElementById('blog-input-published') as HTMLInputElement;
      const coverSelected = document.getElementById('cover-selected-state');
      const coverEmpty = document.getElementById('cover-empty-state');
      const coverPrev = document.getElementById('blog-cover-preview') as HTMLImageElement;
      const editorEl = document.getElementById('blog-editor-content');
      const tabWrite = document.getElementById('btn-editor-tab-write');

      if (blogToEdit) {
        if (outletTitle) outletTitle.textContent = 'Edit Article';
        if (outletSubtitle) outletSubtitle.textContent = 'Compose and format your article.';
        if (idInput) idInput.value = blogToEdit.id || blogToEdit.slug || '';
        if (titleInput) titleInput.value = blogToEdit.title || '';
        if (slugInput) slugInput.value = blogToEdit.slug || '';
        if (authorInput) authorInput.value = blogToEdit.author || 'Unity Compass Team';
        if (readInput) readInput.value = blogToEdit.read_time || blogToEdit.readTime || '5 min read';
        if (excerptInput) excerptInput.value = blogToEdit.excerpt || '';
        if (pubInput) pubInput.checked = blogToEdit.is_published !== false;

        const coverImg = blogToEdit.image || '';
        if (imgInput) imgInput.value = coverImg;
        if (coverImg && coverPrev && coverSelected && coverEmpty) {
          coverPrev.src = coverImg;
          coverSelected.classList.remove('hidden');
          coverEmpty.classList.add('hidden');
        } else if (coverSelected && coverEmpty) {
          coverSelected.classList.add('hidden');
          coverEmpty.classList.remove('hidden');
        }

        const blocks = blogToEdit.content_blocks || blogToEdit.contentBlocks || [];
        if (editorEl) {
          if (Array.isArray(blocks) && blocks.length > 0) {
            if (blocks[0]?.tag === 'HTML' && (blocks[0].html || blocks[0].text)) {
              editorEl.innerHTML = blocks[0].html || blocks[0].text;
            } else {
              // Convert legacy blocks into semantic HTML
              editorEl.innerHTML = blocks.map((b: any) => {
                const tag = (b.tag || 'p').toUpperCase();
                if (tag === 'H2') return `<h2>${b.text}</h2>`;
                if (tag === 'H3') return `<h3>${b.text}</h3>`;
                if (tag === 'H4') return `<h4>${b.text}</h4>`;
                if (tag === 'QUOTE' || tag === 'BLOCKQUOTE') return `<blockquote>${b.text}</blockquote>`;
                if (tag === 'LI') return `<ul><li>${b.text}</li></ul>`;
                if (tag === 'IMG') return `<img src="${b.image || b.text}" />`;
                if (tag === 'HTML') return b.html || b.text;
                return `<p>${b.text}</p>`;
              }).join('');
            }
          } else {
            editorEl.innerHTML = '<p>Start writing your article here...</p>';
          }
        }
      } else {
        if (outletTitle) outletTitle.textContent = 'Write New Article';
        if (outletSubtitle) outletSubtitle.textContent = 'Compose and format your article.';
        if (idInput) idInput.value = '';
        if (titleInput) titleInput.value = '';
        if (slugInput) slugInput.value = '';
        if (authorInput) authorInput.value = 'Unity Compass Team';
        if (readInput) readInput.value = '5 min read';
        if (excerptInput) excerptInput.value = '';
        if (imgInput) imgInput.value = '';
        if (pubInput) pubInput.checked = true;

        if (coverSelected && coverEmpty) {
          coverSelected.classList.add('hidden');
          coverEmpty.classList.remove('hidden');
        }
        if (editorEl) editorEl.innerHTML = '<p>Start writing your article here...</p>';
      }

      tabWrite?.click();
      switchView('blog-editor');
    }

    function closeBlogEditor() {
      switchView('blogs');
    }

    (window as any).editBlog = (idOrSlug: string) => {
      const blog = allBlogs.find((b: any) => String(b.id) === String(idOrSlug) || String(b.slug) === String(idOrSlug));
      if (blog) {
        openBlogEditor(blog);
      } else {
        console.warn('Could not find blog to edit with id/slug:', idOrSlug);
      }
    };
    (window as any).openBlogEditor = openBlogEditor;

    (window as any).deleteBlog = async (id: string, title: string) => {
      if (!confirm(`Are you sure you want to delete "${title}"? This cannot be undone.`)) return;
      try {
        const res = await fetch(`/api/admin/blogs?id=${encodeURIComponent(id)}`, { method: 'DELETE' });
        const data = await res.json();
        if (res.ok && data.success) {
          await loadBlogs();
        } else {
          alert('Failed to delete blog: ' + (data.error || 'Unknown error'));
        }
      } catch (err: any) {
        alert('Error deleting article: ' + err.message);
      }
    };

    function escapeHtml(str: string) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

