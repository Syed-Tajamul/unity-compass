  <!-- ========================================================================= -->
  <!-- SCRIPTS: AUTH, OUTLET NAVIGATION & LIVE DATA FETCH                        -->
  <!-- ========================================================================= -->
  <script>
    const AUTH_KEY = 'uc_admin_token';
    let allInquiries: any[] = [];

    function initAdminPortal() {
      const loginSection = document.getElementById('login-section');
      const dashboardSection = document.getElementById('dashboard-section');
      const loginForm = document.getElementById('admin-login-form');
      const emailInput = document.getElementById('admin-email') as HTMLInputElement | null;
      const passwordInput = document.getElementById('admin-password') as HTMLInputElement | null;
      const loginBtn = document.getElementById('admin-login-btn') as HTMLButtonElement | null;
      const loginError = document.getElementById('login-error');
      const logoutBtn = document.getElementById('admin-logout-btn');

      function checkAuth() {
        const token = localStorage.getItem(AUTH_KEY);
        if (token === 'uc_admin_session_auth_v1' || token === 'valid_admin_session') {
          loginSection?.classList.add('hidden');
          dashboardSection?.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
          loadDashboardData();
        } else {
          loginSection?.classList.remove('hidden');
          dashboardSection?.classList.add('hidden');
          document.body.style.overflow = '';
        }
      }

      loginForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = emailInput?.value.trim() || '';
        const password = passwordInput?.value.trim() || '';

        if (!email || !password) {
          if (loginError) {
            loginError.textContent = 'Please enter both admin email and password.';
            loginError.classList.remove('hidden');
          }
          return;
        }

        if (loginBtn) {
          loginBtn.disabled = true;
          loginBtn.textContent = 'Verifying...';
        }

        try {
          const res = await fetch('/api/admin/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password }),
          });
          const data = await res.json();

          if (res.ok && data.success) {
            localStorage.setItem(AUTH_KEY, data.token || 'uc_admin_session_auth_v1');
            loginError?.classList.add('hidden');
            checkAuth();
          } else {
            if (loginError) {
              loginError.textContent = data.error || 'Invalid administrator email or password.';
              loginError.classList.remove('hidden');
            }
          }
        } catch (err) {
          if (loginError) {
            loginError.textContent = 'Sign-in verification failed. Please try again.';
            loginError.classList.remove('hidden');
          }
        } finally {
          if (loginBtn) {
            loginBtn.disabled = false;
            loginBtn.textContent = 'Sign In to Admin Panel';
          }
        }
      });

      logoutBtn?.addEventListener('click', () => {
        localStorage.removeItem(AUTH_KEY);
        document.body.style.overflow = '';
        checkAuth();
      });

      // OUTLET SWITCHER LOGIC
      const outletTitle = document.getElementById('outlet-view-title');
      const outletSubtitle = document.getElementById('outlet-view-subtitle');

      const viewMeta: Record<string, { title: string; subtitle: string }> = {
        overview: {
          title: 'Dashboard Overview',
          subtitle: 'Operational status, real-time client inquiries, and candidate applications.',
        },
        inquiries: {
          title: 'Contact Inquiries',
          subtitle: 'Messages and inquiries submitted by users through the contact form.',
        },
        candidates: {
          title: 'Candidates & Resumes',
          subtitle: 'Cleared & GovCon talent submissions.',
        },
        jobs: {
          title: 'Job Board Manager',
          subtitle: 'Live positions displayed on the public career portal.',
        },
        blogs: {
          title: 'Blog Manager',
          subtitle: 'GovCon editorial articles and thought leadership.',
        },
        system: {
          title: 'Database Health & Ping',
          subtitle: 'Automated heartbeat monitor preventing Supabase 7-day inactivity pause.',
        },
      };

      function switchView(viewName: string) {
        document.querySelectorAll('.sidebar-nav-btn').forEach((btn) => {
          if (btn.getAttribute('data-target-view') === viewName) {
            btn.classList.add('bg-[#0B2553]', 'text-white', 'shadow-xs');
            btn.classList.remove('text-[#243A5E]', 'hover:bg-slate-100');
          } else {
            btn.classList.remove('bg-[#0B2553]', 'text-white', 'shadow-xs');
            btn.classList.add('text-[#243A5E]', 'hover:bg-slate-100');
          }
        });

        document.querySelectorAll('.outlet-view').forEach((pane) => pane.classList.add('hidden'));
        document.getElementById(`view-${viewName}`)?.classList.remove('hidden');

        if (viewMeta[viewName] && outletTitle && outletSubtitle) {
          outletTitle.textContent = viewMeta[viewName].title;
          outletSubtitle.textContent = viewMeta[viewName].subtitle;
        }
      }

      document.querySelectorAll('.sidebar-nav-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-target-view');
          if (target) switchView(target);
        });
      });

      document.querySelectorAll('[data-switch-to]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-switch-to');
          if (target) switchView(target);
        });
      });

      // Mobile sidebar toggle
      const mobileToggle = document.getElementById('mobile-sidebar-toggle');
      const sidebarNav = document.getElementById('sidebar-nav-menu');
      mobileToggle?.addEventListener('click', () => {
        sidebarNav?.classList.toggle('hidden');
      });

      // Search & Filters for Contact Queries
      const searchInput = document.getElementById('search-inquiries');
      const sortSelect = document.getElementById('sort-inquiries');
      const statusFilter = document.getElementById('status-filter-inquiries');
      const refreshInquiriesBtn = document.getElementById('refresh-inquiries-btn');
      const refreshApplicationsBtn = document.getElementById('refresh-applications-btn');

      searchInput?.addEventListener('input', () => {
        renderInquiriesTable();
      });

      sortSelect?.addEventListener('change', () => {
        renderInquiriesTable();
      });

      statusFilter?.addEventListener('change', () => {
        renderInquiriesTable();
      });

      refreshInquiriesBtn?.addEventListener('click', async () => {
        const icon = document.getElementById('refresh-inquiries-icon');
        icon?.classList.add('animate-spin');
        try {
          await loadInquiries();
        } finally {
          setTimeout(() => icon?.classList.remove('animate-spin'), 500);
        }
      });

      refreshApplicationsBtn?.addEventListener('click', async () => {
        const icon = refreshApplicationsBtn.querySelector('svg');
        icon?.classList.add('animate-spin');
        try {
          await loadApplications();
        } finally {
          setTimeout(() => icon?.classList.remove('animate-spin'), 500);
        }
      });

      // Heartbeat pulse trigger (In System Tab)
      document.getElementById('manual-ping-btn')?.addEventListener('click', triggerPing);

      async function triggerPing() {
        const resultEl = document.getElementById('ping-result');
        if (resultEl) {
          resultEl.classList.remove('hidden');
          resultEl.textContent = 'Executing database heartbeat pulse...';
        }

        try {
          const res = await fetch('/api/cron/keepalive');
          const data = await res.json();
          if (resultEl) {
            resultEl.textContent = JSON.stringify(data, null, 2);
          }
        } catch (err: any) {
          if (resultEl) {
            resultEl.textContent = `Pulse failed: ${err.message}`;
          }
        }
      }

      checkAuth();
    }

    async function loadDashboardData() {
      loadInquiries();
      loadApplications();
      loadJobs();
      loadBlogs();
    }

    function updateInquiriesMetrics() {
      const unreadCount = allInquiries.filter((i: any) => i.status === 'new').length;
      const countBadge = document.getElementById('sidebar-inquiries-badge');
      const metricEl = document.getElementById('metric-inquiries');
      if (countBadge) countBadge.textContent = String(unreadCount);
      if (metricEl) metricEl.textContent = String(allInquiries.length);
    }

    function renderOverviewInquiries() {
      const recentContainer = document.getElementById('overview-recent-inquiries');
      if (!recentContainer) return;

      if (!allInquiries.length) {
        recentContainer.innerHTML = '<p class="text-xs text-slate-400 text-center py-6">No contact queries yet.</p>';
        return;
      }

      // Sort newest first for overview
      const sorted = [...allInquiries].sort((a, b) => new Date(b.created_at || 0).getTime() - new Date(a.created_at || 0).getTime());
      const top3 = sorted.slice(0, 3);

      recentContainer.innerHTML = top3.map((item: any) => {
        const isNew = item.status === 'new';
        const isViewed = item.status === 'viewed';
        const isReplied = item.status === 'replied';

        const badgeClass = isNew
          ? 'bg-red-50 text-[#FF3130] border border-red-200'
          : isViewed
          ? 'bg-blue-50 text-blue-700 border border-blue-200'
          : isReplied
          ? 'bg-emerald-50 text-emerald-800 border border-emerald-200'
          : 'bg-slate-100 text-slate-700 border border-slate-200';

        const badgeText = isNew ? 'NEW' : isViewed ? 'VIEWED' : isReplied ? 'REPLIED' : (item.status || 'NEW').toUpperCase();

        return `
          <div onclick="viewInquiry('${item.id}')" class="p-3.5 rounded-2xl sm:rounded-3xl bg-slate-50 hover:bg-slate-100/90 border border-slate-200/70 flex items-center justify-between cursor-pointer transition-all">
            <div class="pr-2 min-w-0">
              <p class="text-xs font-bold text-[#0B2553] truncate">${escapeHtml(item.name)}</p>
              <p class="text-[11px] text-slate-500 truncate max-w-xs">${escapeHtml(item.message)}</p>
            </div>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold shrink-0 ${badgeClass}">
              ${badgeText}
            </span>
          </div>
        `;
      }).join('');
    }

    function getFilteredAndSortedInquiries() {
      const searchInput = document.getElementById('search-inquiries') as HTMLInputElement | null;
      const sortSelect = document.getElementById('sort-inquiries') as HTMLSelectElement | null;
      const statusFilter = document.getElementById('status-filter-inquiries') as HTMLSelectElement | null;

      const query = (searchInput?.value || '').toLowerCase().trim();
      const sortOrder = sortSelect?.value || 'recent';
      const status = statusFilter?.value || 'all';

      let filtered = allInquiries.filter((item: any) => {
        // Status filter
        if (status !== 'all' && item.status !== status) {
          return false;
        }
        // Search filter
        if (query) {
          const nameMatch = (item.name || '').toLowerCase().includes(query);
          const emailMatch = (item.email || '').toLowerCase().includes(query);
          const phoneMatch = (item.phone || '').toLowerCase().includes(query);
          const messageMatch = (item.message || '').toLowerCase().includes(query);
          if (!nameMatch && !emailMatch && !phoneMatch && !messageMatch) {
            return false;
          }
        }
        return true;
      });

      // Sort by date (recent vs oldest)
      filtered.sort((a: any, b: any) => {
        const timeA = new Date(a.created_at || 0).getTime();
        const timeB = new Date(b.created_at || 0).getTime();
        return sortOrder === 'oldest' ? timeA - timeB : timeB - timeA;
      });

      return filtered;
    }

    let activeStatusMenuInquiryId: string | null = null;

    (window as any).openStatusMenu = (id: string, e: MouseEvent) => {
      e.stopPropagation();
      const popover = document.getElementById('table-status-popover');
      if (!popover) return;

      if (activeStatusMenuInquiryId === id && !popover.classList.contains('hidden')) {
        popover.classList.add('hidden');
        activeStatusMenuInquiryId = null;
        return;
      }

      activeStatusMenuInquiryId = id;
      const trigger = e.currentTarget as HTMLElement;
      const rect = trigger.getBoundingClientRect();

      const popoverWidth = 144;
      let left = rect.left;
      if (left + popoverWidth > window.innerWidth - 12) {
        left = Math.max(12, rect.right - popoverWidth);
      }

      popover.style.top = `${rect.bottom + 4}px`;
      popover.style.left = `${left}px`;
      popover.classList.remove('hidden');
    };

    function closeStatusMenu() {
      const popover = document.getElementById('table-status-popover');
      if (popover && !popover.classList.contains('hidden')) {
        popover.classList.add('hidden');
        activeStatusMenuInquiryId = null;
      }
    }

    document.addEventListener('click', (e) => {
      const popover = document.getElementById('table-status-popover');
      if (popover && !popover.contains(e.target as Node)) {
        closeStatusMenu();
      }
    });

    window.addEventListener('scroll', closeStatusMenu, true);

    document.querySelectorAll('#table-status-popover button[data-status-choice]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const status = (btn as HTMLElement).getAttribute('data-status-choice');
        if (activeStatusMenuInquiryId && status) {
          (window as any).updateInquiryStatus(activeStatusMenuInquiryId, status);
        }
        closeStatusMenu();
      });
    });

    function renderInquiriesTable() {
      const tbody = document.getElementById('inquiries-table-body');
      if (!tbody) return;

      const list = getFilteredAndSortedInquiries();

      if (!list.length) {
        const searchInput = document.getElementById('search-inquiries') as HTMLInputElement | null;
        const query = searchInput?.value.trim();
        tbody.innerHTML = `<tr><td colspan="6" class="px-5 py-8 text-center text-slate-400">${
          query ? `No queries found matching "${escapeHtml(query)}".` : 'No contact queries received yet.'
        }</td></tr>`;
        return;
      }

      tbody.innerHTML = list.map((item: any) => {
        const isNew = item.status === 'new';
        const isViewed = item.status === 'viewed';
        const isReplied = item.status === 'replied';

        const badgeClass = isNew
          ? 'bg-red-50 text-[#FF3130] border-red-200 hover:bg-red-100/70'
          : isViewed
          ? 'bg-blue-50 text-blue-700 border-blue-200 hover:bg-blue-100/70'
          : isReplied
          ? 'bg-emerald-50 text-emerald-800 border-emerald-200 hover:bg-emerald-100/70'
          : 'bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100';

        const dotColor = isNew
          ? 'bg-[#FF3130]'
          : isViewed
          ? 'bg-blue-600'
          : isReplied
          ? 'bg-emerald-600'
          : 'bg-slate-400';

        const badgeText = isNew ? 'New' : isViewed ? 'Viewed' : isReplied ? 'Replied' : (item.status || 'New');

        return `
          <tr class="hover:bg-slate-50/80 transition-colors">
            <td class="px-5 py-3.5 font-bold text-[#0B2553] whitespace-nowrap">${escapeHtml(item.name)}</td>
            <td class="px-5 py-3.5 whitespace-nowrap">
              <a href="mailto:${escapeHtml(item.email)}" class="text-[#0C487A] font-semibold hover:underline block">${escapeHtml(item.email)}</a>
              <span class="text-slate-400 text-[11px]">${escapeHtml(item.phone || 'No phone')}</span>
            </td>
            <td class="px-5 py-3.5 max-w-xs truncate text-[#243A5E]" title="${escapeHtml(item.message)}">${escapeHtml(item.message)}</td>
            <td class="px-5 py-3.5 text-slate-400 text-[11px] whitespace-nowrap">${item.created_at ? new Date(item.created_at).toLocaleDateString() : 'N/A'}</td>
            <td class="px-5 py-3.5 whitespace-nowrap">
              <button
                type="button"
                id="status-trigger-${item.id}"
                onclick="openStatusMenu('${item.id}', event)"
                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold border transition-all cursor-pointer shadow-2xs hover:shadow-xs active:scale-95 ${badgeClass}"
                title="Change status"
              >
                <span class="w-1.5 h-1.5 rounded-full ${dotColor}"></span>
                <span>${badgeText}</span>
                <svg class="w-3 h-3 opacity-60 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
            </td>
            <td class="px-5 py-3.5 text-right whitespace-nowrap">
              <button
                onclick="viewInquiry('${item.id}')"
                class="px-3 py-1.5 text-xs font-bold rounded-lg bg-slate-100 hover:bg-[#0B2553] hover:text-white text-[#0B2553] transition-all cursor-pointer"
                title="View full query details"
              >
                View
              </button>
            </td>
          </tr>
        `;
      }).join('');
    }

    async function loadInquiries() {
      try {
        const res = await fetch('/api/admin/inquiries');
        const data = await res.json();
        allInquiries = data.inquiries || [];

        updateInquiriesMetrics();
        renderOverviewInquiries();
        renderInquiriesTable();
      } catch (e) {
        const tbody = document.getElementById('inquiries-table-body');
        if (tbody) tbody.innerHTML = `<tr><td colspan="6" class="px-5 py-8 text-center text-red-500">Failed to load contact queries.</td></tr>`;
      }
    }

    async function loadApplications() {
      const tbody = document.getElementById('applications-table-body');
      const recentContainer = document.getElementById('overview-recent-applications');

      try {
        const res = await fetch('/api/admin/applications');
        const data = await res.json();
        const list = data.applications || [];

        const metricEl = document.getElementById('metric-applications');
        const badgeEl = document.getElementById('sidebar-candidates-badge');
        if (metricEl) metricEl.textContent = String(list.length);
        if (badgeEl) badgeEl.textContent = String(list.length);

        // Populate Overview Preview
        if (recentContainer) {
          if (!list.length) {
            recentContainer.innerHTML = '<p class="text-xs text-slate-400 text-center py-6">No candidates yet.</p>';
          } else {
            recentContainer.innerHTML = list.slice(0, 3).map((item: any) => `
              <div class="p-3.5 rounded-2xl sm:rounded-3xl bg-slate-50 border border-slate-200/70 flex items-center justify-between">
                <div>
                  <p class="text-xs font-bold text-[#0B2553]">${escapeHtml(item.candidate_name)}</p>
                  <p class="text-[11px] text-slate-500">${escapeHtml(item.job_title)}</p>
                </div>
                ${item.resume_url && item.resume_url !== '#' ? `
                  <a href="${item.resume_url}" target="_blank" class="px-3 py-1 rounded-md sm:rounded-lg bg-[#FF3130] text-white text-[10px] font-bold">Resume</a>
                ` : `<span class="text-[10px] text-slate-400">No file</span>`}
              </div>
            `).join('');
          }
        }

        if (!tbody) return;
        if (!list.length) {
          tbody.innerHTML = `<tr><td colspan="6" class="px-5 py-8 text-center text-slate-400">No candidate applications received yet.</td></tr>`;
          return;
        }

        tbody.innerHTML = list.map((item: any) => `
          <tr class="hover:bg-slate-50/80 transition-colors">
            <td class="px-5 py-3.5 font-bold text-[#0B2553]">${escapeHtml(item.candidate_name)}</td>
            <td class="px-5 py-3.5 text-[#0B2553] font-semibold">${escapeHtml(item.job_title)}</td>
            <td class="px-5 py-3.5">
              <a href="mailto:${escapeHtml(item.candidate_email)}" class="text-[#0C487A] font-semibold hover:underline block">${escapeHtml(item.candidate_email)}</a>
              <span class="text-slate-400 text-[11px]">${escapeHtml(item.candidate_phone)}</span>
            </td>
            <td class="px-5 py-3.5 text-slate-400 text-[11px]">${item.created_at ? new Date(item.created_at).toLocaleDateString() : 'N/A'}</td>
            <td class="px-5 py-3.5">
              ${item.resume_url && item.resume_url !== '#' ? `
                <a href="${item.resume_url}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#FF3130] hover:bg-[#E02625] text-white text-[11px] font-bold shadow-xs active:scale-[0.98] transition-all">
                  <span>Download Resume</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                </a>
              ` : `<span class="text-slate-400 text-[11px]">No file</span>`}
            </td>
            <td class="px-5 py-3.5 text-right">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-slate-100 text-slate-700 border border-slate-200">
                ${item.status}
              </span>
            </td>
          </tr>
        `).join('');
      } catch (e) {
        if (tbody) tbody.innerHTML = `<tr><td colspan="6" class="px-5 py-8 text-center text-red-500">Failed to load applications.</td></tr>`;
      }
    }

    async function loadJobs() {
      const tbody = document.getElementById('jobs-table-body');
      try {
        const res = await fetch('/api/admin/jobs');
        const data = await res.json();
        const list = data.jobs || [];

        const metricEl = document.getElementById('metric-jobs');
        const badgeEl = document.getElementById('sidebar-jobs-badge');
        if (metricEl) metricEl.textContent = String(list.filter((j: any) => j.is_active !== false).length);
        if (badgeEl) badgeEl.textContent = String(list.length);

        if (!tbody) return;
        tbody.innerHTML = list.map((item: any) => `
          <tr class="hover:bg-slate-50/80 transition-colors">
            <td class="px-5 py-3.5 font-bold text-[#0B2553]">${escapeHtml(item.title)} <span class="text-slate-400 text-[10px] block font-mono">${item.id}</span></td>
            <td class="px-5 py-3.5 text-[#243A5E] font-medium">${escapeHtml(item.department)}</td>
            <td class="px-5 py-3.5 text-slate-500">${escapeHtml(item.location)} (${item.workplaceType || item.workplace_type || 'Hybrid'})</td>
            <td class="px-5 py-3.5 font-bold text-[#0B2553]">${escapeHtml(item.clearanceLevel || item.clearance_level || 'None')}</td>
            <td class="px-5 py-3.5 text-right">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-bold ${item.is_active !== false ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-slate-100 text-slate-500'}">
                ${item.is_active !== false ? 'Active' : 'Inactive'}
              </span>
            </td>
          </tr>
        `).join('');
      } catch (e) {}
    }

    async function loadBlogs() {
      const tbody = document.getElementById('blogs-table-body');
      try {
        const res = await fetch('/api/admin/blogs');
        const data = await res.json();
        const list = data.blogs || [];

        const metricEl = document.getElementById('metric-blogs');
        const badgeEl = document.getElementById('sidebar-blogs-badge');
        if (metricEl) metricEl.textContent = String(list.length);
        if (badgeEl) badgeEl.textContent = String(list.length);

        if (!tbody) return;
        tbody.innerHTML = list.map((item: any) => `
          <tr class="hover:bg-slate-50/80 transition-colors">
            <td class="px-5 py-3.5 font-bold text-[#0B2553]">${escapeHtml(item.title)} <span class="text-slate-400 text-[10px] block font-mono">/blog/${item.slug}</span></td>
            <td class="px-5 py-3.5 text-[#FF3130] font-bold">${escapeHtml(item.category)}</td>
            <td class="px-5 py-3.5 text-slate-400 text-[11px]">${escapeHtml(item.date)} by ${escapeHtml(item.author)}</td>
            <td class="px-5 py-3.5 text-right">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                Published
              </span>
            </td>
          </tr>
        `).join('');
      } catch (e) {}
    }

    function escapeHtml(str: string) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    (window as any).viewInquiry = (id: string) => {
      const modal = document.getElementById('inquiry-modal');
      const body = document.getElementById('inquiry-modal-body');
      if (!modal || !body) return;

      const item = allInquiries.find((i: any) => String(i.id) === String(id));
      if (!item) return;

      const isNew = item.status === 'new';
      const isViewed = item.status === 'viewed';
      const isReplied = item.status === 'replied';

      body.innerHTML = `
        <div class="space-y-2.5 p-4 rounded-2xl bg-slate-50 border border-slate-200/80">
          <div class="flex items-center justify-between">
            <span class="text-xs text-slate-500 font-medium">Name:</span>
            <span class="font-bold text-[#0B2553] text-sm">${escapeHtml(item.name)}</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-xs text-slate-500 font-medium">Email:</span>
            <a href="mailto:${escapeHtml(item.email)}" class="text-[#0C487A] font-bold hover:underline">${escapeHtml(item.email)}</a>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-xs text-slate-500 font-medium">Phone:</span>
            <a href="tel:${escapeHtml(item.phone || '')}" class="text-[#0C487A] font-bold hover:underline">${escapeHtml(item.phone || 'N/A')}</a>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-xs text-slate-500 font-medium">Submitted:</span>
            <span class="text-slate-600 font-semibold">${item.created_at ? new Date(item.created_at).toLocaleString() : 'N/A'}</span>
          </div>
          <div class="flex items-center justify-between pt-2.5 border-t border-slate-200/60">
            <span class="text-xs text-slate-500 font-medium">Status:</span>
            <div class="inline-flex rounded-lg p-0.5 bg-slate-200/70">
              <button
                type="button"
                onclick="updateInquiryStatus('${item.id}', 'new')"
                class="px-3 py-1 rounded-md text-xs font-bold transition-all cursor-pointer ${
                  isNew ? 'bg-white text-[#FF3130] shadow-xs' : 'text-slate-600 hover:text-[#0B2553]'
                }"
              >
                ● New
              </button>
              <button
                type="button"
                onclick="updateInquiryStatus('${item.id}', 'viewed')"
                class="px-3 py-1 rounded-md text-xs font-bold transition-all cursor-pointer ${
                  isViewed ? 'bg-white text-blue-700 shadow-xs' : 'text-slate-600 hover:text-[#0B2553]'
                }"
              >
                ● Viewed
              </button>
              <button
                type="button"
                onclick="updateInquiryStatus('${item.id}', 'replied')"
                class="px-3 py-1 rounded-md text-xs font-bold transition-all cursor-pointer ${
                  isReplied ? 'bg-white text-emerald-700 shadow-xs' : 'text-slate-600 hover:text-[#0B2553]'
                }"
              >
                ● Replied
              </button>
            </div>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-1.5">User Message</label>
          <div class="p-4 rounded-2xl bg-white border border-slate-200 text-[#243A5E] whitespace-pre-wrap leading-relaxed max-h-60 overflow-y-auto">
            ${escapeHtml(item.message)}
          </div>
        </div>

        <div class="pt-2 border-t border-slate-100 flex justify-end">
          <button
            type="button"
            onclick="document.getElementById('inquiry-modal').classList.add('hidden')"
            class="px-4 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-[#0B2553] font-bold text-xs transition-all cursor-pointer"
          >
            Close
          </button>
        </div>
      `;

      modal.classList.remove('hidden');
    };

    (window as any).updateInquiryStatus = async (id: string, status: string) => {
      closeStatusMenu();
      // Optimistic update
      const item = allInquiries.find((i: any) => String(i.id) === String(id));
      if (item) {
        item.status = status;
      }

      updateInquiriesMetrics();
      renderOverviewInquiries();
      renderInquiriesTable();

      // If modal is currently open with this inquiry, re-render it
      const modal = document.getElementById('inquiry-modal');
      if (modal && !modal.classList.contains('hidden')) {
        (window as any).viewInquiry(id);
      }

      try {
        await fetch('/api/admin/inquiries', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, status }),
        });
      } catch (e) {
        console.error('Failed to update inquiry status in backend:', e);
      }
    };

    document.getElementById('close-inquiry-modal')?.addEventListener('click', () => {
      document.getElementById('inquiry-modal')?.classList.add('hidden');
    });

    // Close modal on backdrop click
    document.getElementById('inquiry-modal')?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) {
        document.getElementById('inquiry-modal')?.classList.add('hidden');
      }
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAdminPortal);
    } else {
      initAdminPortal();
    }
    document.addEventListener('astro:page-load', initAdminPortal);
    document.addEventListener('astro:before-swap', () => {
      document.body.style.overflow = '';
    });
  </script>

  <style is:global>
    /* Isolate scrolling strictly to #admin-outlet when the admin dashboard is active */
    body:has(#dashboard-section:not(.hidden)) {
      overflow: hidden !important;
      height: 100vh !important;
    }

    #admin-outlet {
      -webkit-overflow-scrolling: touch;
      scroll-behavior: smooth;
    }
  </style>
</MainLayout>
