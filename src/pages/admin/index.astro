        <button
          type="button"
          id="btn-modal-upload-device"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold text-white bg-[#0B2553] hover:bg-[#0C487A] transition-all cursor-pointer shadow-xs active:scale-95"
        >
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
          </svg>
          <span id="btn-modal-upload-text">Upload from Computer</span>
        </button>
        <span id="modal-upload-status" class="text-xs text-slate-500 font-medium"></span>
      </div>

      <!-- Media Library Grid -->
      <div class="p-5 sm:p-6 overflow-y-auto flex-1 bg-white">
        <div id="media-library-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 sm:gap-4">
          <p class="col-span-full text-center text-xs text-slate-400 py-8">Loading media library...</p>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="p-4 sm:p-5 border-t border-slate-100 bg-slate-50/60 flex items-center justify-between shrink-0">
        <span class="text-xs text-slate-400">Click any image to select it</span>
        <button
          type="button"
          id="btn-modal-cancel-image"
          class="px-4 py-2 rounded-xl text-xs font-bold text-slate-500 hover:bg-slate-200 transition-colors cursor-pointer"
        >
          Cancel
        </button>
      </div>

    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- SCRIPTS: AUTH, OUTLET NAVIGATION & LIVE DATA FETCH                        -->
  <!-- ========================================================================= -->
  <script>
    const AUTH_KEY = 'uc_admin_token';
    let allInquiries: any[] = [];
    let allBlogs: any[] = [];
    let availableImages: any[] = [];

    const viewMeta: Record<string, { title: string; subtitle: string }> = {
      overview: {
        title: 'Dashboard Overview',
        subtitle: 'Operational status, real-time client inquiries, and candidate applications.',
      },
      inquiries: {
        title: 'Contact Inquiries',
        subtitle: 'Messages and inquiries submitted by users through the contact form.',
      },
      candidates: {
        title: 'Candidates & Resumes',
        subtitle: 'Cleared & GovCon talent submissions.',
      },
      blogs: {
        title: 'Articles & Blog',
        subtitle: 'Manage and publish GovCon articles.',
      },
      'blog-editor': {
        title: 'Article Editor',
        subtitle: 'Compose, format, and publish your article.',
      },
      system: {
        title: 'Database Health & Ping',
        subtitle: 'Automated heartbeat monitor preventing Supabase 7-day inactivity pause.',
      },
    };

    function switchView(viewName: string) {
      const activeNavTarget = viewName === 'blog-editor' ? 'blogs' : viewName;
      document.querySelectorAll('.sidebar-nav-btn').forEach((btn) => {
        const svg = btn.querySelector('svg');
        if (btn.getAttribute('data-target-view') === activeNavTarget) {
          btn.classList.add('bg-[#0B2553]', 'text-white', 'shadow-xs', 'is-active');
          btn.classList.remove('text-[#243A5E]', 'hover:bg-slate-100');
          if (svg) {
            svg.classList.add('text-white');
            svg.classList.remove('text-slate-400');
          }
        } else {
          btn.classList.remove('bg-[#0B2553]', 'text-white', 'shadow-xs', 'is-active');
          btn.classList.add('text-[#243A5E]', 'hover:bg-slate-100');
          if (svg) {
            svg.classList.remove('text-white');
            svg.classList.add('text-slate-400');
          }
        }
      });

      document.querySelectorAll('.outlet-view').forEach((pane) => pane.classList.add('hidden'));
      const targetPane = document.getElementById(`view-${viewName}`);
      if (targetPane) {
        targetPane.classList.remove('hidden');
      }

      // Switch top header between standard app bar and focused editor bar
      const headerDefault = document.getElementById('header-default-bar');
      const headerEditor = document.getElementById('header-editor-bar');
      if (viewName === 'blog-editor') {
        if (headerDefault) headerDefault.classList.add('hidden');
        if (headerEditor) headerEditor.classList.remove('hidden');
      } else {
        if (headerDefault) headerDefault.classList.remove('hidden');
        if (headerEditor) headerEditor.classList.add('hidden');
      }

      const outletTitle = document.getElementById('outlet-view-title');
      const outletSubtitle = document.getElementById('outlet-view-subtitle');
      if (viewMeta[viewName] && outletTitle && outletSubtitle) {
        outletTitle.textContent = viewMeta[viewName].title;
        outletSubtitle.textContent = viewMeta[viewName].subtitle;
      }

      const adminOutlet = document.getElementById('admin-outlet');
      if (adminOutlet) {
        adminOutlet.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }
    (window as any).switchView = switchView;

    function initAdminPortal() {
      const loginSection = document.getElementById('login-section');
      const dashboardSection = document.getElementById('dashboard-section');
      const loginForm = document.getElementById('admin-login-form');
      const emailInput = document.getElementById('admin-email') as HTMLInputElement | null;
      const passwordInput = document.getElementById('admin-password') as HTMLInputElement | null;
      const loginBtn = document.getElementById('admin-login-btn') as HTMLButtonElement | null;
      const loginError = document.getElementById('login-error');
      const logoutBtn = document.getElementById('admin-logout-btn');

      function checkAuth() {
        const token = localStorage.getItem(AUTH_KEY);
        if (token === 'uc_admin_session_auth_v1' || token === 'valid_admin_session') {
          loginSection?.classList.add('hidden');
          dashboardSection?.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
          loadDashboardData();
        } else {
          loginSection?.classList.remove('hidden');
          dashboardSection?.classList.add('hidden');
          document.body.style.overflow = '';
        }
      }

      loginForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = emailInput?.value.trim() || '';
        const password = passwordInput?.value.trim() || '';

        if (!email || !password) {
          if (loginError) {
            loginError.textContent = 'Please enter both admin email and password.';
            loginError.classList.remove('hidden');
          }
          return;
        }

        if (loginBtn) {
          loginBtn.disabled = true;
          loginBtn.textContent = 'Verifying...';
        }

        try {
          const res = await fetch('/api/admin/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password }),
          });
          const data = await res.json();

          if (res.ok && data.success) {
            localStorage.setItem(AUTH_KEY, data.token || 'uc_admin_session_auth_v1');
            loginError?.classList.add('hidden');
            checkAuth();
          } else {
            if (loginError) {
              loginError.textContent = data.error || 'Invalid administrator email or password.';
              loginError.classList.remove('hidden');
            }
          }
        } catch (err) {
          if (loginError) {
            loginError.textContent = 'Sign-in verification failed. Please try again.';
            loginError.classList.remove('hidden');
          }
        } finally {
          if (loginBtn) {
            loginBtn.disabled = false;
            loginBtn.textContent = 'Sign In to Admin Panel';
          }
        }
      });

      logoutBtn?.addEventListener('click', () => {
        localStorage.removeItem(AUTH_KEY);
        document.body.style.overflow = '';
        checkAuth();
      });

      // OUTLET SWITCHER EVENT LISTENERS
      document.querySelectorAll('.sidebar-nav-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-target-view');
          if (target) switchView(target);
        });
      });

      document.querySelectorAll('[data-switch-to]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-switch-to');
          if (target) switchView(target);
        });
      });

      // Mobile sidebar toggle
      const mobileToggle = document.getElementById('mobile-sidebar-toggle');
      const sidebarNav = document.getElementById('sidebar-nav-menu');
      mobileToggle?.addEventListener('click', () => {
        sidebarNav?.classList.toggle('hidden');
      });

      // Search & Filters for Contact Queries
      const searchInput = document.getElementById('search-inquiries');
      const sortSelect = document.getElementById('sort-inquiries');
      const statusFilter = document.getElementById('status-filter-inquiries');
      const refreshInquiriesBtn = document.getElementById('refresh-inquiries-btn');
      const refreshApplicationsBtn = document.getElementById('refresh-applications-btn');

      searchInput?.addEventListener('input', () => {
        renderInquiriesTable();
      });

      sortSelect?.addEventListener('change', () => {
        renderInquiriesTable();
      });

      statusFilter?.addEventListener('change', () => {
        renderInquiriesTable();
      });

      refreshInquiriesBtn?.addEventListener('click', async () => {
        const icon = document.getElementById('refresh-inquiries-icon');
        icon?.classList.add('animate-spin');
        try {
          await loadInquiries();
        } finally {
          setTimeout(() => icon?.classList.remove('animate-spin'), 500);
        }
      });

      refreshApplicationsBtn?.addEventListener('click', async () => {
        const icon = refreshApplicationsBtn.querySelector('svg');
        icon?.classList.add('animate-spin');
        try {
          await loadApplications();
        } finally {
          setTimeout(() => icon?.classList.remove('animate-spin'), 500);
        }
      });

      // Heartbeat pulse trigger (In System Tab)
      document.getElementById('manual-ping-btn')?.addEventListener('click', triggerPing);

      async function triggerPing() {
        const resultEl = document.getElementById('ping-result');
        if (resultEl) {
          resultEl.classList.remove('hidden');
          resultEl.textContent = 'Executing database heartbeat pulse...';
        }

        try {
          const res = await fetch('/api/cron/keepalive');
          const data = await res.json();
          if (resultEl) {
            resultEl.textContent = JSON.stringify(data, null, 2);
          }
        } catch (err: any) {
          if (resultEl) {
            resultEl.textContent = `Pulse failed: ${err.message}`;
          }
        }
      }

      // Blog Workspace Navigation Handlers
      const btnCreateBlog = document.getElementById('btn-create-blog');
      const btnBackToBlogs = document.getElementById('btn-back-to-blogs');
      const btnCancelBlogScreen = document.getElementById('btn-cancel-blog-screen');
      const blogTitleInput = document.getElementById('blog-input-title') as HTMLInputElement | null;
      const blogSlugInput = document.getElementById('blog-input-slug') as HTMLInputElement | null;
      const blogIdInput = document.getElementById('blog-input-id') as HTMLInputElement | null;

      btnCreateBlog?.addEventListener('click', () => {
        openBlogEditor();
      });

      btnBackToBlogs?.addEventListener('click', () => {
        switchView('blogs');
      });
      btnCancelBlogScreen?.addEventListener('click', () => {
        switchView('blogs');
      });

      // Auto slug generation when typing title on new articles
      blogTitleInput?.addEventListener('input', () => {
        if (!blogIdInput?.value && blogSlugInput) {
          blogSlugInput.value = (blogTitleInput.value || '')
            .toLowerCase()
            .trim()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/(^-|-$)/g, '');
        }
      });

      // Clean Cover Image & Media Library Selector
      const coverEmptyState = document.getElementById('cover-empty-state');
      const coverSelectedState = document.getElementById('cover-selected-state');
      const btnChangeCover = document.getElementById('btn-change-cover');
      const btnRemoveCover = document.getElementById('btn-remove-cover');
      const blogInputImage = document.getElementById('blog-input-image') as HTMLInputElement | null;
      const blogCoverPreview = document.getElementById('blog-cover-preview') as HTMLImageElement | null;
      const imageModal = document.getElementById('modal-choose-image');
      const btnCloseImageModal = document.getElementById('btn-close-image-modal');
      const btnModalCancelImage = document.getElementById('btn-modal-cancel-image');
      const btnModalUploadDevice = document.getElementById('btn-modal-upload-device');
      const modalUploadInput = document.getElementById('modal-upload-input') as HTMLInputElement | null;
      const modalUploadStatus = document.getElementById('modal-upload-status');

      function openImagePickerModal() {
        imageModal?.classList.remove('hidden');
        loadMediaLibrary();
      }

      function closeImagePickerModal() {
        imageModal?.classList.add('hidden');
        if (modalUploadStatus) modalUploadStatus.textContent = '';
      }

      coverEmptyState?.addEventListener('click', openImagePickerModal);
      btnChangeCover?.addEventListener('click', openImagePickerModal);
      btnCloseImageModal?.addEventListener('click', closeImagePickerModal);
      btnModalCancelImage?.addEventListener('click', closeImagePickerModal);
      imageModal?.addEventListener('click', (e) => {
        if (e.target === e.currentTarget) closeImagePickerModal();
      });

      (window as any).selectMediaImage = (url: string) => {
        if (blogInputImage) blogInputImage.value = url;
        if (blogCoverPreview) blogCoverPreview.src = url;
        coverSelectedState?.classList.remove('hidden');
        coverEmptyState?.classList.add('hidden');
        closeImagePickerModal();
      };

      btnRemoveCover?.addEventListener('click', () => {
        if (blogInputImage) blogInputImage.value = '';
        if (blogCoverPreview) blogCoverPreview.src = '';
        coverSelectedState?.classList.add('hidden');
        coverEmptyState?.classList.remove('hidden');
      });

      btnModalUploadDevice?.addEventListener('click', () => {
        modalUploadInput?.click();
      });

      modalUploadInput?.addEventListener('change', async () => {
        const file = modalUploadInput.files?.[0];
        if (!file) return;

        if (modalUploadStatus) modalUploadStatus.textContent = 'Uploading image...';
        try {
          const formData = new FormData();
          formData.append('file', file);
          const res = await fetch('/api/admin/upload-image', {
            method: 'POST',
            body: formData,
          });
          const data = await res.json();
          if (res.ok && data.url) {
            if (modalUploadStatus) modalUploadStatus.textContent = 'Uploaded ✓';
            (window as any).selectMediaImage(data.url);
          } else {
            if (modalUploadStatus) modalUploadStatus.textContent = 'Upload failed: ' + (data.error || 'Server error');
          }
        } catch (err: any) {
          if (modalUploadStatus) modalUploadStatus.textContent = 'Upload error: ' + err.message;
        } finally {
          if (modalUploadInput) modalUploadInput.value = '';
        }
      });

      async function loadMediaLibrary() {
        const grid = document.getElementById('media-library-grid');
        if (!grid) return;
        grid.innerHTML = '<p class="col-span-full text-center text-xs text-slate-400 py-8">Loading media library...</p>';

        try {
          const res = await fetch('/api/admin/upload-image');
          const data = await res.json();
          availableImages = data.images || [];

          if (availableImages.length === 0) {
            grid.innerHTML = '<p class="col-span-full text-center text-xs text-slate-400 py-8">No images found. Click "Upload from Computer" above to add one.</p>';
            return;
          }

          grid.innerHTML = availableImages.map((img: any) => `
            <div
              onclick="window.selectMediaImage('${img.url}')"
              class="group relative rounded-2xl overflow-hidden border border-slate-200 hover:border-[#0B2553] bg-slate-50 aspect-[16/10] cursor-pointer shadow-2xs hover:shadow-md transition-all hover:scale-[1.02]"
              title="${escapeHtml(img.name || '')}"
            >
              <img src="${img.url}" class="w-full h-full object-cover" loading="lazy" />
              <div class="absolute inset-0 bg-[#0B2553]/0 group-hover:bg-[#0B2553]/20 transition-colors flex items-center justify-center">
                <span class="opacity-0 group-hover:opacity-100 px-2.5 py-1 rounded-lg bg-white text-[#0B2553] text-[10px] font-bold shadow-sm transition-opacity">Select</span>
              </div>
            </div>
          `).join('');
        } catch (err) {
          grid.innerHTML = '<p class="col-span-full text-center text-xs text-red-500 py-8">Failed to load media library.</p>';
        }
      }

      // Editor Toolbar Handlers
      const editorContent = document.getElementById('blog-editor-content');
      document.querySelectorAll('#editor-toolbar button[data-cmd]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const cmd = (btn as HTMLElement).dataset.cmd;
          if (cmd) {
            document.execCommand(cmd, false, undefined);
            editorContent?.focus();
          }
        });
      });

      document.querySelectorAll('#editor-toolbar button[data-block]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const tag = (btn as HTMLElement).dataset.block;
          if (tag) {
            document.execCommand('formatBlock', false, tag);
            editorContent?.focus();
          }
        });
      });

      document.getElementById('btn-insert-link')?.addEventListener('click', (e) => {
        e.preventDefault();
        const url = prompt('Enter link URL (e.g. https://...):');
        if (url) {
          document.execCommand('createLink', false, url);
          editorContent?.focus();
        }
      });

      document.getElementById('btn-insert-inline-img')?.addEventListener('click', (e) => {
        e.preventDefault();
        const url = prompt('Enter image URL to insert inline (or upload to bucket via cover/gallery uploader):');
        if (url) {
          document.execCommand('insertImage', false, url);
          editorContent?.focus();
        }
      });

      // Write vs Live Preview Tabs
      const tabWrite = document.getElementById('btn-editor-tab-write');
      const tabPreview = document.getElementById('btn-editor-tab-preview');
      const editorPreview = document.getElementById('blog-editor-preview');

      tabWrite?.addEventListener('click', () => {
        tabWrite.classList.add('bg-white', 'text-[#0B2553]', 'shadow-xs');
        tabWrite.classList.remove('text-slate-500');
        tabPreview?.classList.remove('bg-white', 'text-[#0B2553]', 'shadow-xs');
        tabPreview?.classList.add('text-slate-500');

        editorContent?.classList.remove('hidden');
        editorPreview?.classList.add('hidden');
      });

      tabPreview?.addEventListener('click', () => {
        tabPreview?.classList.add('bg-white', 'text-[#0B2553]', 'shadow-xs');
        tabPreview.classList.remove('text-slate-500');
        tabWrite?.classList.remove('bg-white', 'text-[#0B2553]', 'shadow-xs');
        tabWrite?.classList.add('text-slate-500');

        if (editorPreview && editorContent) {
          editorPreview.innerHTML = editorContent.innerHTML || '<p class="text-slate-400 italic">No content written yet.</p>';
        }
        editorContent?.classList.add('hidden');
        editorPreview?.classList.remove('hidden');
      });

      // Save Blog Article (Create or Update)
      const btnSaveBlog = document.getElementById('btn-save-blog-screen');
      const btnSaveBlogText = document.getElementById('btn-save-blog-text');

      btnSaveBlog?.addEventListener('click', async () => {
        const id = (document.getElementById('blog-input-id') as HTMLInputElement)?.value.trim();
        const title = (document.getElementById('blog-input-title') as HTMLInputElement)?.value.trim();
        const slug = (document.getElementById('blog-input-slug') as HTMLInputElement)?.value.trim();
        const author = (document.getElementById('blog-input-author') as HTMLInputElement)?.value.trim() || 'Unity Compass Team';
        const readTime = (document.getElementById('blog-input-readtime') as HTMLInputElement)?.value.trim() || '5 min read';
        const excerpt = (document.getElementById('blog-input-excerpt') as HTMLTextAreaElement)?.value.trim() || '';
        const image = (document.getElementById('blog-input-image') as HTMLInputElement)?.value.trim() || 'https://papgpunctttqnlttycdd.supabase.co/storage/v1/object/public/blog-images/blog-1-growth.jpg';
        const isPublished = (document.getElementById('blog-input-published') as HTMLInputElement)?.checked ?? true;

        if (!title) {
          alert('Please enter an article title.');
          return;
        }
        if (!slug) {
          alert('Please enter a valid URL slug.');
          return;
        }
        if (!excerpt) {
          alert('Please enter a brief executive excerpt.');
          return;
        }

        const contentBlocks = serializeEditorContent();

        if (btnSaveBlogText) btnSaveBlogText.textContent = 'Saving...';
        if (btnSaveBlog) (btnSaveBlog as HTMLButtonElement).disabled = true;

        try {
          const isEdit = Boolean(id);
          const method = isEdit ? 'PUT' : 'POST';
          const payload: any = {
            title,
            slug,
            category: 'GovCon Advisory',
            author,
            readTime,
            excerpt,
            image,
            contentBlocks,
            isPublished,
          };
          if (isEdit) {
            payload.id = id;
          }

          const res = await fetch('/api/admin/blogs', {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const result = await res.json();

          if (res.ok && result.success) {
            switchView('blogs');
            await loadBlogs();
          } else {
            alert('Failed to save article: ' + (result.error || 'Server error'));
          }
        } catch (err: any) {
          alert('Error saving article: ' + err.message);
        } finally {
          if (btnSaveBlogText) btnSaveBlogText.textContent = 'Save & Publish';
          if (btnSaveBlog) (btnSaveBlog as HTMLButtonElement).disabled = false;
        }
      });

      checkAuth();
    }

    async function loadDashboardData() {
      loadInquiries();
      loadApplications();
      loadBlogs();
    }

    function updateInquiriesMetrics() {
      const unreadCount = allInquiries.filter((i: any) => i.status === 'new').length;
      const countBadge = document.getElementById('sidebar-inquiries-badge');
      const metricEl = document.getElementById('metric-inquiries');
      if (countBadge) countBadge.textContent = String(unreadCount);
      if (metricEl) metricEl.textContent = String(allInquiries.length);
    }

    function renderOverviewInquiries() {
      const recentContainer = document.getElementById('overview-recent-inquiries');
      if (!recentContainer) return;

      if (!allInquiries.length) {
        recentContainer.innerHTML = '<p class="text-xs text-slate-400 text-center py-6">No contact queries yet.</p>';
        return;
      }

      // Sort newest first for overview
      const sorted = [...allInquiries].sort((a, b) => new Date(b.created_at || 0).getTime() - new Date(a.created_at || 0).getTime());
      const top3 = sorted.slice(0, 3);

      recentContainer.innerHTML = top3.map((item: any) => {
        const isNew = item.status === 'new';
        const isViewed = item.status === 'viewed';
        const isReplied = item.status === 'replied';

        const badgeClass = isNew
          ? 'bg-red-50 text-[#FF3130] border border-red-200'
          : isViewed
          ? 'bg-blue-50 text-blue-700 border border-blue-200'
          : isReplied
          ? 'bg-emerald-50 text-emerald-800 border border-emerald-200'
          : 'bg-slate-100 text-slate-700 border border-slate-200';

        const badgeText = isNew ? 'NEW' : isViewed ? 'VIEWED' : isReplied ? 'REPLIED' : (item.status || 'NEW').toUpperCase();

        return `
          <div onclick="viewInquiry('${item.id}')" class="p-3.5 rounded-2xl sm:rounded-3xl bg-slate-50 hover:bg-slate-100/90 border border-slate-200/70 flex items-center justify-between cursor-pointer transition-all">
            <div class="pr-2 min-w-0">
              <p class="text-xs font-bold text-[#0B2553] truncate">${escapeHtml(item.name)}</p>
              <p class="text-[11px] text-slate-500 truncate max-w-xs">${escapeHtml(item.message)}</p>
            </div>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold shrink-0 ${badgeClass}">
              ${badgeText}
            </span>
          </div>
        `;
      }).join('');
    }

    function getFilteredAndSortedInquiries() {
      const searchInput = document.getElementById('search-inquiries') as HTMLInputElement | null;
      const sortSelect = document.getElementById('sort-inquiries') as HTMLSelectElement | null;
      const statusFilter = document.getElementById('status-filter-inquiries') as HTMLSelectElement | null;

      const query = (searchInput?.value || '').toLowerCase().trim();
      const sortOrder = sortSelect?.value || 'recent';
      const status = statusFilter?.value || 'all';

      let filtered = allInquiries.filter((item: any) => {
        // Status filter
        if (status !== 'all' && item.status !== status) {
          return false;
        }
        // Search filter
        if (query) {
          const nameMatch = (item.name || '').toLowerCase().includes(query);
          const emailMatch = (item.email || '').toLowerCase().includes(query);
          const phoneMatch = (item.phone || '').toLowerCase().includes(query);
          const messageMatch = (item.message || '').toLowerCase().includes(query);
          if (!nameMatch && !emailMatch && !phoneMatch && !messageMatch) {
            return false;
          }
        }
        return true;
      });

      // Sort by date (recent vs oldest)
      filtered.sort((a: any, b: any) => {
        const timeA = new Date(a.created_at || 0).getTime();
        const timeB = new Date(b.created_at || 0).getTime();
        return sortOrder === 'oldest' ? timeA - timeB : timeB - timeA;
      });

      return filtered;
    }

    let activeStatusMenuInquiryId: string | null = null;

    (window as any).openStatusMenu = (id: string, e: MouseEvent) => {
      e.stopPropagation();
      const popover = document.getElementById('table-status-popover');
      if (!popover) return;

      if (activeStatusMenuInquiryId === id && !popover.classList.contains('hidden')) {
        popover.classList.add('hidden');
        activeStatusMenuInquiryId = null;
        return;
      }

      activeStatusMenuInquiryId = id;
      const trigger = e.currentTarget as HTMLElement;
      const rect = trigger.getBoundingClientRect();

      const popoverWidth = 144;
      let left = rect.left;
      if (left + popoverWidth > window.innerWidth - 12) {
        left = Math.max(12, rect.right - popoverWidth);
      }

      popover.style.top = `${rect.bottom + 4}px`;
      popover.style.left = `${left}px`;
      popover.classList.remove('hidden');
    };

    function closeStatusMenu() {
      const popover = document.getElementById('table-status-popover');
      if (popover && !popover.classList.contains('hidden')) {
        popover.classList.add('hidden');
        activeStatusMenuInquiryId = null;
      }
    }

    document.addEventListener('click', (e) => {
      const popover = document.getElementById('table-status-popover');
      if (popover && !popover.contains(e.target as Node)) {
        closeStatusMenu();
      }
    });

    window.addEventListener('scroll', closeStatusMenu, true);

    document.querySelectorAll('#table-status-popover button[data-status-choice]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const status = (btn as HTMLElement).getAttribute('data-status-choice');
        if (activeStatusMenuInquiryId && status) {
          (window as any).updateInquiryStatus(activeStatusMenuInquiryId, status);
        }
        closeStatusMenu();
      });
    });

    function renderInquiriesTable() {
      const tbody = document.getElementById('inquiries-table-body');
