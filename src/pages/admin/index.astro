---
/**
 * index.astro - Unity Compass Executive Admin Management Console
 * 
 * Fully harmonized with Unity Compass Design System:
 * - Executive light blueprint canvas (#F4F8FC via #EBF3FA to #DFEDF8) with 16px checks
 * - Professional Sidebar Navigation with live badges, user profile, and quick actions
 * - Smooth Outlet Component (#admin-outlet) with dynamic view switching:
 *   1. Overview (Executive KPIs, recent inquiries, recent candidate resumes)
 *   2. Contact Inquiries (Search, status filters, reply actions, full details modal)
 *   3. Candidates & Resumes (Live submissions, one-click PDF resume download from Supabase Storage)
 *   4. Job Board Manager (Track and manage career requisitions)
 *   5. Blog Publications (Editorial overview and live article links)
 *   6. System & Keep-Alive (On-demand Supabase ping, cron health, Resend status)
 */
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout
  title="Executive Admin Management Console - Unity Compass"
  description="Executive portal for managing federal inquiries, cleared candidate resumes, career postings, and editorial insights."
>
  <!-- ========================================================================= -->
  <!-- GATE: LOGIN SCREEN (Displayed when unauthorized)                         -->
  <!-- ========================================================================= -->
  <div id="login-section" class="relative min-h-[85vh] flex items-center justify-center p-4 overflow-hidden bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8]">
    <!-- Technical Blueprint Check Pattern -->
    <div
      class="absolute inset-0 opacity-[0.24] mix-blend-multiply pointer-events-none"
      style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.08) 1px, transparent 1px);"
      aria-hidden="true"
    ></div>

    <!-- Soft Ambient Radial Blue Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[radial-gradient(circle,rgba(12,72,122,0.11)_0%,rgba(30,64,175,0.05)_45%,transparent_70%)] rounded-full blur-3xl pointer-events-none -z-10" aria-hidden="true"></div>

    <div class="relative z-10 w-full max-w-md bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 p-8 sm:p-10 shadow-[0_20px_50px_-10px_rgba(12,72,122,0.14)] overflow-hidden">
      <!-- Top Red Accent Stripe -->
      <div class="absolute top-0 inset-x-0 h-1.5 bg-[#FF3130]"></div>

      <div class="text-center mb-8">
        <!-- Dashed Outer Ring Icon -->
        <div class="relative w-16 h-16 mx-auto flex items-center justify-center mb-4">
          <div class="absolute inset-0 rounded-full border-2 border-dashed border-[#FF3130]/35 animate-[spin_20s_linear_infinite]"></div>
          <div class="w-12 h-12 rounded-full bg-red-50 text-[#FF3130] flex items-center justify-center font-black text-lg">
            UC
          </div>
        </div>

        <h1 class="text-2xl font-extrabold text-[#0B2553] tracking-tight">Executive Console</h1>
        <p class="text-xs text-[#243A5E] mt-1 font-medium">Unity Compass Management &amp; GovCon Operations</p>
      </div>

      <form id="admin-login-form" class="space-y-4" novalidate>
        <div>
          <label class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-1.5">
            Admin Access Passkey
          </label>
          <input
            type="password"
            id="admin-passkey"
            required
            placeholder="Enter admin password..."
            class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-[#0B2553] text-sm focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white transition-all placeholder:text-slate-400"
          />
          <p class="text-[11px] text-slate-400 mt-1.5">Default initial passkey: <code class="text-[#FF3130] font-mono font-bold">admin123</code></p>
        </div>

        <div id="login-error" class="hidden p-3 rounded-xl bg-red-50 border border-red-200 text-red-800 text-xs font-semibold">
          Invalid access passkey. Please verify and try again.
        </div>

        <button
          type="submit"
          class="w-full py-3.5 px-6 rounded-md sm:rounded-lg font-bold text-xs uppercase tracking-wider text-white bg-[#FF3130] hover:bg-[#E02625] shadow-lg shadow-[#FF3130]/25 active:scale-[0.98] transition-all cursor-pointer"
        >
          Sign In to Console
        </button>
      </form>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- DASHBOARD: SIDEBAR + OUTLET COMPONENT (Displayed when authorized)          -->
  <!-- ========================================================================= -->
  <div id="dashboard-section" class="hidden min-h-screen bg-slate-50/60 flex flex-col lg:flex-row">
    
    <!-- ======================================================================= -->
    <!-- 1. EXECUTIVE SIDEBAR COMPONENT                                          -->
    <!-- ======================================================================= -->
    <aside class="w-full lg:w-72 bg-white border-r border-slate-200/90 flex flex-col justify-between shrink-0 shadow-sm relative z-20">
      
      <div>
        <!-- Sidebar Brand Header -->
        <div class="p-6 border-b border-slate-100 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-[#0B2553] text-white flex items-center justify-center font-extrabold text-sm shadow-sm">
              UC
            </div>
            <div>
              <h2 class="text-sm font-extrabold text-[#0B2553] tracking-tight">Unity Compass</h2>
              <span class="inline-flex items-center gap-1 text-[10px] font-bold text-[#FF3130] uppercase tracking-wider">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                Admin Console
              </span>
            </div>
          </div>

          <!-- Mobile Hamburger Toggle -->
          <button
            type="button"
            id="mobile-sidebar-toggle"
            class="lg:hidden p-2 text-slate-500 hover:text-[#0B2553] rounded-md sm:rounded-lg"
            aria-label="Toggle Menu"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>

        <!-- Sidebar Navigation Items -->
        <nav id="sidebar-nav-menu" class="p-4 space-y-1.5">
          
          <!-- 1. Overview -->
          <button
            type="button"
            data-target-view="overview"
            class="sidebar-nav-btn active w-full flex items-center justify-between px-4 py-3 rounded-md sm:rounded-lg text-xs font-bold transition-all cursor-pointer bg-[#0B2553] text-white shadow-xs"
          >
            <div class="flex items-center gap-3">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
              <span>Dashboard Overview</span>
            </div>
          </button>

          <!-- 2. Inquiries -->
          <button
            type="button"
            data-target-view="inquiries"
            class="sidebar-nav-btn w-full flex items-center justify-between px-4 py-3 rounded-md sm:rounded-lg text-xs font-bold text-[#243A5E] hover:bg-slate-100 hover:text-[#0B2553] transition-all cursor-pointer"
          >
            <div class="flex items-center gap-3">
              <svg class="w-4 h-4 text-slate-400 group-hover:text-[#FF3130]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>Contact Inquiries</span>
            </div>
            <span id="sidebar-inquiries-badge" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-red-100 text-[#FF3130]">0</span>
          </button>

          <!-- 3. Candidates & Resumes -->
          <button
            type="button"
            data-target-view="candidates"
            class="sidebar-nav-btn w-full flex items-center justify-between px-4 py-3 rounded-md sm:rounded-lg text-xs font-bold text-[#243A5E] hover:bg-slate-100 hover:text-[#0B2553] transition-all cursor-pointer"
          >
            <div class="flex items-center gap-3">
              <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
              <span>Candidates &amp; Resumes</span>
            </div>
            <span id="sidebar-candidates-badge" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">0</span>
          </button>

          <!-- 4. Job Board -->
          <button
            type="button"
            data-target-view="jobs"
            class="sidebar-nav-btn w-full flex items-center justify-between px-4 py-3 rounded-md sm:rounded-lg text-xs font-bold text-[#243A5E] hover:bg-slate-100 hover:text-[#0B2553] transition-all cursor-pointer"
          >
            <div class="flex items-center gap-3">
              <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>Job Board Manager</span>
            </div>
            <span id="sidebar-jobs-badge" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600">0</span>
          </button>

          <!-- 5. Blogs -->
          <button
            type="button"
            data-target-view="blogs"
            class="sidebar-nav-btn w-full flex items-center justify-between px-4 py-3 rounded-md sm:rounded-lg text-xs font-bold text-[#243A5E] hover:bg-slate-100 hover:text-[#0B2553] transition-all cursor-pointer"
          >
            <div class="flex items-center gap-3">
              <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
              </svg>
              <span>Blog Manager</span>
            </div>
            <span id="sidebar-blogs-badge" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600">0</span>
          </button>

          <!-- 6. System & Keep-Alive -->
          <button
            type="button"
            data-target-view="system"
            class="sidebar-nav-btn w-full flex items-center justify-between px-4 py-3 rounded-md sm:rounded-lg text-xs font-bold text-[#243A5E] hover:bg-slate-100 hover:text-[#0B2553] transition-all cursor-pointer"
          >
            <div class="flex items-center gap-3">
              <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              <span>Database Health &amp; Ping</span>
            </div>
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          </button>

        </nav>
      </div>

      <!-- Sidebar Footer (User Card & Logout) -->
      <div class="p-4 border-t border-slate-100 space-y-3">
        <div class="p-3 rounded-2xl sm:rounded-3xl bg-slate-50 border border-slate-200/80 flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-full bg-[#0B2553] text-white flex items-center justify-center font-bold text-xs">
              ST
            </div>
            <div class="truncate max-w-[130px]">
              <p class="text-xs font-extrabold text-[#0B2553] truncate">Syed Tawseef</p>
              <p class="text-[10px] text-slate-500 font-medium">Administrator</p>
            </div>
          </div>
          <button
            type="button"
            id="admin-logout-btn"
            class="p-1.5 text-slate-400 hover:text-[#FF3130] rounded-md sm:rounded-lg transition-colors cursor-pointer"
            title="Sign Out"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
          </button>
        </div>

        <a
          href="/"
          target="_blank"
          class="block text-center text-xs font-bold text-[#0C487A] hover:text-[#FF3130] transition-colors py-1"
        >
          View Live Website &rarr;
        </a>
      </div>

    </aside>

    <!-- ======================================================================= -->
    <!-- 2. MAIN HEADER & OUTLET COMPONENT                                       -->
    <!-- ======================================================================= -->
    <main class="flex-1 flex flex-col min-w-0">
      
      <!-- Top Action Bar -->
      <header class="bg-white border-b border-slate-200/90 px-6 sm:px-8 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 sticky top-0 z-10">
        <div>
          <div class="flex items-center gap-2.5">
            <h1 id="outlet-view-title" class="text-xl sm:text-2xl font-extrabold text-[#0B2553] tracking-tight">
              Dashboard Overview
            </h1>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              Supabase Live
            </span>
          </div>
          <p id="outlet-view-subtitle" class="text-xs text-slate-500 mt-0.5">
            Operational status, real-time client inquiries, and candidate applications.
          </p>
        </div>

        <!-- Quick Top Action Buttons -->
        <div class="flex items-center gap-3 shrink-0">
          <button
            type="button"
            id="header-ping-btn"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-md sm:rounded-lg text-xs font-bold text-[#0B2553] bg-slate-100 hover:bg-slate-200/80 transition-colors cursor-pointer"
            title="Send keep-alive heartbeat to Supabase"
          >
            <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>Ping Heartbeat</span>
          </button>

          <a
            href="/career"
            target="_blank"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-md sm:rounded-lg text-xs font-bold text-white bg-[#FF3130] hover:bg-[#E02625] shadow-xs active:scale-[0.98] transition-all cursor-pointer"
          >
            <span>Live Careers</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </header>

      <!-- ===================================================================== -->
      <!-- THE OUTLET: DYNAMIC VIEW CONTAINER                                    -->
      <!-- ===================================================================== -->
      <div id="admin-outlet" class="flex-1 p-6 sm:p-8 space-y-8">
        
        <!-- ------------------------------------------------------------------- -->
        <!-- VIEW 1: OVERVIEW (Default)                                          -->
        <!-- ------------------------------------------------------------------- -->
        <div id="view-overview" class="outlet-view space-y-8">
          
          <!-- 4 Executive KPI Cards -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
            
            <!-- Metric 1: Inquiries -->
            <div class="relative bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 p-6 shadow-[0_10px_30px_-6px_rgba(12,72,122,0.06)] overflow-hidden">
              <div class="absolute top-0 inset-x-0 h-1 bg-[#FF3130]"></div>
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Total Leads</span>
              <p id="metric-inquiries" class="text-3xl font-black text-[#FF3130] mt-2">--</p>
              <span class="text-[11px] text-slate-500 font-medium mt-1 block">Contact submissions</span>
            </div>

            <!-- Metric 2: Candidates -->
            <div class="relative bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 p-6 shadow-[0_10px_30px_-6px_rgba(12,72,122,0.06)] overflow-hidden">
              <div class="absolute top-0 inset-x-0 h-1 bg-emerald-500"></div>
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Candidate Resumes</span>
              <p id="metric-applications" class="text-3xl font-black text-emerald-600 mt-2">--</p>
              <span class="text-[11px] text-slate-500 font-medium mt-1 block">In Supabase Storage</span>
            </div>

            <!-- Metric 3: Active Jobs -->
            <div class="relative bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 p-6 shadow-[0_10px_30px_-6px_rgba(12,72,122,0.06)] overflow-hidden">
              <div class="absolute top-0 inset-x-0 h-1 bg-[#0B2553]"></div>
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Active Jobs</span>
              <p id="metric-jobs" class="text-3xl font-black text-[#0B2553] mt-2">--</p>
              <span class="text-[11px] text-slate-500 font-medium mt-1 block">Open requisitions</span>
            </div>

            <!-- Metric 4: Blogs -->
            <div class="relative bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 p-6 shadow-[0_10px_30px_-6px_rgba(12,72,122,0.06)] overflow-hidden">
              <div class="absolute top-0 inset-x-0 h-1 bg-[#EE8522]"></div>
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Published Insights</span>
              <p id="metric-blogs" class="text-3xl font-black text-[#EE8522] mt-2">--</p>
              <span class="text-[11px] text-slate-500 font-medium mt-1 block">Live articles</span>
            </div>

          </div>

          <!-- Quick Preview Split Cards -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            
            <!-- Recent Inquiries Card -->
            <div class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 p-6 shadow-[0_10px_30px_-6px_rgba(12,72,122,0.06)] space-y-4">
              <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-[#FF3130]"></span>
                  <h3 class="text-base font-bold text-[#0B2553]">Recent Contact Leads</h3>
                </div>
                <button
                  type="button"
                  data-switch-to="inquiries"
                  class="rounded-md sm:rounded-lg text-xs font-bold text-[#FF3130] hover:underline cursor-pointer"
                >
                  View All &rarr;
                </button>
              </div>

              <div id="overview-recent-inquiries" class="space-y-3">
                <p class="text-xs text-slate-400 text-center py-6">Loading leads...</p>
              </div>
            </div>

            <!-- Recent Applications Card -->
            <div class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 p-6 shadow-[0_10px_30px_-6px_rgba(12,72,122,0.06)] space-y-4">
              <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                  <h3 class="text-base font-bold text-[#0B2553]">Recent Candidate Submissions</h3>
                </div>
                <button
                  type="button"
                  data-switch-to="candidates"
                  class="rounded-md sm:rounded-lg text-xs font-bold text-[#0B2553] hover:underline cursor-pointer"
                >
                  View All &rarr;
                </button>
              </div>

              <div id="overview-recent-applications" class="space-y-3">
                <p class="text-xs text-slate-400 text-center py-6">Loading candidates...</p>
              </div>
            </div>

          </div>

        </div>

        <!-- ------------------------------------------------------------------- -->
        <!-- VIEW 2: CONTACT INQUIRIES                                           -->
        <!-- ------------------------------------------------------------------- -->
        <div id="view-inquiries" class="outlet-view hidden space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h2 class="text-lg font-bold text-[#0B2553]">Lead Submissions from Contact Form</h2>
              <p class="text-xs text-slate-500">Prospective clients requesting GovCon proposals, staffing, and advisory scoping.</p>
            </div>
            
            <div class="flex items-center gap-3">
              <input
                type="text"
                id="search-inquiries"
                placeholder="Search leads by name, email, or message..."
                class="px-4 py-2 text-xs rounded-xl border border-slate-200 bg-white text-[#0B2553] w-64 focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130]"
              />
              <button
                type="button"
                id="refresh-inquiries-btn"
                class="p-2.5 rounded-md sm:rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-600 transition-colors cursor-pointer"
                title="Refresh leads"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
              </button>
            </div>
          </div>

          <div class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 overflow-hidden shadow-[0_10px_30px_-6px_rgba(12,72,122,0.06)]">
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs text-[#243A5E]">
                <thead class="bg-slate-50 text-[#0B2553] uppercase tracking-wider text-[11px] font-bold border-b border-slate-200">
                  <tr>
                    <th class="px-6 py-4">Lead Name</th>
                    <th class="px-6 py-4">Contact Info</th>
                    <th class="px-6 py-4">Message Snippet</th>
                    <th class="px-6 py-4">Submitted</th>
                    <th class="px-6 py-4">Status</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                  </tr>
                </thead>
                <tbody id="inquiries-table-body" class="divide-y divide-slate-100">
                  <tr>
                    <td colspan="6" class="px-6 py-8 text-center text-slate-400">Loading inquiries...</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- ------------------------------------------------------------------- -->
        <!-- VIEW 3: CANDIDATES & RESUMES                                        -->
        <!-- ------------------------------------------------------------------- -->
        <div id="view-candidates" class="outlet-view hidden space-y-6">
