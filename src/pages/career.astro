---
import MainLayout from '../layouts/MainLayout.astro';
import JobBoard from '../components/JobBoard.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<MainLayout
  title="Careers Latest Job Listing - Unity Compass"
  description="Explore cleared and non-cleared career opportunities in federal contracting, IT, defense engineering, and proposal development with Unity Compass."
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-slate-900 to-brand-dark text-white py-16 sm:py-24 border-b border-slate-800 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center max-w-3xl">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-brand-red/20 text-red-400 border border-brand-red/30 mb-4">
        Talent Acquisition & GovCon Careers
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight">
        Careers & Current Opportunities
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
        Join mission-driven teams across defense, intelligence, and federal civilian agencies. We source top-tier professionals for permanent, contract, and cleared positions.
      </p>
    </div>
  </section>

  <!-- Interactive Job Board Section -->
  <section class="py-16 sm:py-24 bg-slate-50" aria-label="Open Positions">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <JobBoard />
    </div>
  </section>
</MainLayout>

