---
/**
 * career.astro - Unity Compass Careers Page (Complete Redesign)
 * 
 * Strict Structure:
 * - Section 01: Careers Hero (Split-screen, "Build Your Career. Make an Impact.", dual CTAs)
 * - Section 02: Why Work With Unity Compass? ("More Than a Job. A Career With Purpose.", 4 cards)
 * - Section 03: Explore Open Positions ("Find Your Next Opportunity", JobBoard component)
 * - Section 04: Our Hiring Process ("A Clear Path to Your Next Opportunity", 4 connected steps)
 * - Section 05: Join Our Talent Network ("Your Next Opportunity May Be Just Around the Corner.", Zoho-ready resume form)
 * - Section 06: Frequently Asked Questions (6 accessible GovCon accordions)
 * - Section 07: Final CTA ("Ready to Take the Next Step?", Explore Open Positions button)
 */
import MainLayout from '../layouts/MainLayout.astro';
import JobBoard from '../components/JobBoard.astro';
import HiringProcess from '../components/HiringProcess.astro';
import WaveDivider from '../components/WaveDivider.astro';

// Section 02 - 4 Pillars Data
const whyWorkPillars = [
  {
    number: '01',
    title: 'Meaningful Work',
    description: 'Contribute to projects supporting important government missions across defense, intelligence, and civilian agencies.',
    accentColor: 'bg-[#FF3130]',
    iconColor: 'text-[#FF3130]',
    bgColor: 'bg-red-50',
    borderColor: 'border-red-200/70',
  },
  {
    number: '02',
    title: 'Professional Growth',
    description: 'Expand your expertise through challenging assignments, high-visibility solicitations, and career advancement opportunities.',
    accentColor: 'bg-[#0B2553]',
    iconColor: 'text-[#0B2553]',
    bgColor: 'bg-blue-50',
    borderColor: 'border-blue-200/70',
  },
  {
    number: '03',
    title: 'Diverse Opportunities',
    description: 'Explore roles across technology, proposal development, security-cleared staffing, systems architecture, and business consulting.',
    accentColor: 'bg-[#EE8522]',
    iconColor: 'text-[#EE8522]',
    bgColor: 'bg-amber-50',
    borderColor: 'border-amber-200/70',
  },
  {
    number: '04',
    title: 'People & Collaboration',
    description: 'Work alongside dedicated GovCon professionals who value domain expertise, teamwork, integrity, and mission success.',
    accentColor: 'bg-emerald-600',
    iconColor: 'text-emerald-700',
    bgColor: 'bg-emerald-50',
    borderColor: 'border-emerald-200/70',
  },
];

// Section 06 - 6 Exact FAQs
const faqs = [
  {
    question: 'How do I apply for an open position?',
    answer: 'Select "View Position" on any listed opening to examine the comprehensive scope, responsibilities, and required qualifications. From there, select "Apply Now" to submit your resume, contact details, and clearance credentials directly through our secure portal.',
  },
  {
    question: 'Can I submit my resume if there are no suitable openings?',
    answer: 'Yes! We encourage you to submit your credentials to our Talent Network section below. Our recruitment directors continuously evaluate candidates against pipeline solicitations, upcoming contract awards, and unadvertised cleared requisitions.',
  },
  {
    question: 'What types of employment opportunities are available?',
    answer: 'Unity Compass supports direct permanent placements, long-term prime subcontracting positions, 1099 specialized advisory engagements, and temp-to-hire assignments across DoD, Intelligence Community, and civilian federal programs.',
  },
  {
    question: 'Are security clearances required for all positions?',
    answer: 'No. While many of our national security and defense programs require active Secret, Top Secret, or TS/SCI with Polygraph credentials, we also offer non-cleared and DHS Public Trust opportunities in proposal development, corporate consulting, and enterprise software engineering.',
  },
  {
    question: 'How will I know if my application has been received?',
    answer: 'Upon submitting your application or resume document, you will receive an immediate confirmation on-screen. Our specialized recruitment team reviews submissions against active labor categories within 48 to 72 business hours.',
  },
  {
    question: 'Can I apply for multiple positions?',
    answer: 'Yes. You are welcome to submit applications for all positions that align with your background and certifications. Our talent partners will evaluate your profile across all applicable requisitions.',
  },
];
---

<MainLayout
  title="Careers - Unity Compass | Build Your Career. Make an Impact."
  description="Explore career opportunities with Unity Compass across federal contracting, defense, intelligence, and civilian agencies. Find mission-focused roles in cleared staffing, IT, and consulting."
>
  <!-- ========================================================================= -->
  <!-- SECTION 01 – CAREERS HERO (Sophisticated Split-Screen Layout)              -->
  <!-- ========================================================================= -->
  <section
    class="relative min-h-[580px] sm:min-h-[620px] lg:min-h-[660px] flex items-center overflow-hidden bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] pt-16 sm:pt-20 lg:pt-24 pb-20 sm:pb-28"
    aria-labelledby="career-hero-heading"
  >
    <!-- Technical Blueprint Check Grid Pattern (Matching Homepage ~40% reduced) -->
    <div
      class="absolute inset-0 opacity-[0.24] mix-blend-multiply pointer-events-none"
      style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.08) 1px, transparent 1px);"
      aria-hidden="true"
    ></div>

    <!-- Soft Ambient Radial Blue Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[radial-gradient(circle,rgba(12,72,122,0.11)_0%,rgba(30,64,175,0.05)_45%,transparent_70%)] rounded-full blur-3xl pointer-events-none -z-10" aria-hidden="true"></div>

    <div class="max-w-7xl xl:max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 xl:gap-16 items-center">
        
        <!-- LEFT COLUMN: Headline, Description & Dual CTAs (7 cols) -->
        <div class="lg:col-span-7 max-w-2xl">
          
          <!-- Heading -->
          <h1
            id="career-hero-heading"
            class="scroll-reveal text-3xl sm:text-4xl lg:text-[2.85rem] xl:text-[3.25rem] font-extrabold tracking-tight leading-[1.16] text-[#0B2553]"
          >
            Build Your Career. <br />
            <span class="text-[#FF3130]">Make an Impact.</span>
          </h1>

          <!-- Description -->
          <p class="scroll-reveal delay-100 mt-5 sm:mt-6 text-base sm:text-lg text-[#243A5E] leading-[1.78] font-normal">
            Explore career opportunities with Unity Compass across federal contracting, defense, intelligence, and civilian agencies. Whether you're an experienced professional, technical specialist, or emerging leader, discover opportunities where your expertise contributes to meaningful missions.
          </p>

          <!-- Dual Hero CTAs -->
          <div class="scroll-reveal delay-150 mt-8 sm:mt-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-4 sm:gap-5">
            <!-- Button 1: Explore Open Positions -->
            <a
              href="#open-positions"
              class="inline-flex items-center justify-center gap-3 px-8 sm:px-9 py-4 rounded-xl bg-gradient-to-r from-[#FF3130] to-[#E02625] hover:from-[#E02625] hover:to-[#C61E1D] text-white text-base font-bold shadow-[0_8px_24px_-4px_rgba(255,49,48,0.25)] hover:shadow-[0_12px_28px_-2px_rgba(255,49,48,0.35)] cursor-pointer whitespace-nowrap transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
            >
              <span>Explore Open Positions</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </a>

            <!-- Button 2: Submit Your Resume -->
            <a
              href="#talent-network"
              class="inline-flex items-center justify-center gap-2.5 px-8 sm:px-9 py-4 rounded-xl border border-[#0B2553]/20 hover:border-[#0B2553] bg-white/90 hover:bg-white text-[#0B2553] text-base font-bold shadow-xs cursor-pointer whitespace-nowrap transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
            >
              <span>Submit Your Resume</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>

          <!-- Trust Badges Row -->
          <div class="scroll-reveal delay-200 mt-10 pt-6 border-t border-slate-200/80 flex flex-wrap items-center gap-6 text-xs font-semibold text-slate-600">
            <span class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              Cleared &amp; Sensitive Roles
            </span>
            <span class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#0B2553]"></span>
              Direct Prime Placements
            </span>
            <span class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#FF3130]"></span>
              DoD &amp; Civilian Contracts
            </span>
          </div>

        </div>

        <!-- RIGHT COLUMN: Professional Visual Anchor Card (5 cols) -->
        <div class="lg:col-span-5 relative scroll-reveal delay-250">
          <div class="relative mx-auto max-w-md lg:max-w-none">
            
            <!-- Card Frame with Ambient Shadow -->
            <div class="relative rounded-3xl bg-white border border-slate-200/90 p-4 sm:p-5 shadow-[0_20px_50px_-10px_rgba(12,72,122,0.16)] overflow-hidden">
              <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-slate-100 relative">
                <img
                  src="/images/career.png"
                  alt="Unity Compass Careers and Talent Solutions"
                  class="w-full h-full object-cover object-center transform hover:scale-105 transition-transform duration-700"
                  loading="eager"
                  width="800"
                  height="600"
                  onerror="this.src='/images/hero-image-scaled.png'"
                />
                
                <!-- Subtle Gradient Vignette -->
                <div class="absolute inset-0 bg-gradient-to-t from-[#0B2553]/70 via-transparent to-transparent"></div>
                
                <!-- Bottom Inset Text on Image -->
                <div class="absolute bottom-4 left-4 right-4 text-white">
                  <span class="text-[10px] font-bold uppercase tracking-wider bg-[#FF3130] text-white px-2.5 py-0.5 rounded-full inline-block mb-1 shadow-xs">
                    Mission Impact
                  </span>
                  <p class="text-xs sm:text-sm font-bold text-white leading-snug">
                    Connecting cleared professionals with federal prime opportunities.
                  </p>
                </div>
              </div>

              <!-- Micro-Stats Bar Under Image -->
              <div class="mt-4 pt-3 border-t border-slate-100 grid grid-cols-2 gap-3 text-center">
                <div class="p-2 rounded-xl bg-slate-50 border border-slate-100">
                  <p class="text-xs font-extrabold text-[#0B2553]">Confidential</p>
                  <p class="text-[10px] text-slate-500 font-medium">Candidate Privacy</p>
                </div>
                <div class="p-2 rounded-xl bg-slate-50 border border-slate-100">
                  <p class="text-xs font-extrabold text-[#FF3130]">48-Hour</p>
                  <p class="text-[10px] text-slate-500 font-medium">Recruiter Review</p>
                </div>
              </div>
            </div>

            <!-- Decorative Floating Pill -->
            <div class="hidden sm:flex absolute -bottom-4 -left-4 items-center gap-2 px-4 py-2.5 rounded-2xl bg-white/95 backdrop-blur-sm border border-slate-200/90 shadow-lg text-xs font-bold text-[#0B2553]">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Active Federal Solicitations</span>
            </div>

          </div>
        </div>

      </div>
    </div>

    <!-- Pure CSS WaveDivider Transition into Section 02 -->
    <WaveDivider variant="wave" position="bottom" fillColor="#ffffff" />
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 02 – WHY WORK WITH UNITY COMPASS? (4 Refined Cards)               -->
  <!-- ========================================================================= -->
  <section class="relative bg-white py-20 sm:py-28" aria-labelledby="why-work-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Heading -->
      <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
        <h2
          id="why-work-heading"
          class="scroll-reveal text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0B2553] tracking-tight leading-[1.18]"
        >
          More Than a Job. <br class="hidden sm:inline" />
          <span class="text-[#FF3130]">A Career With Purpose.</span>
        </h2>
        <p class="scroll-reveal delay-100 mt-4 text-base sm:text-lg text-[#243A5E] leading-relaxed font-normal max-w-2xl mx-auto">
          Be part of a team that connects expertise, opportunity, and mission-focused work.
        </p>
      </div>

      <!-- 4 Visually Appealing Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
        {whyWorkPillars.map((pillar, idx) => (
          <div
            class="scroll-reveal group relative rounded-3xl bg-white border border-slate-200/90 p-7 sm:p-8 shadow-[0_10px_30px_-6px_rgba(12,72,122,0.06)] hover:shadow-[0_20px_45px_-8px_rgba(12,72,122,0.14)] hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between overflow-hidden"
            style={`animation-delay: ${idx * 100}ms`}
          >
            <!-- Top Color Stripe -->
            <div class={`absolute top-0 inset-x-0 h-1.5 ${pillar.accentColor}`}></div>

            <div>
              <!-- Dashed Outer Ring Icon Box -->
              <div class="relative w-14 h-14 mb-6 flex items-center justify-center">
                <div class="absolute inset-0 rounded-2xl border-2 border-dashed border-slate-300 group-hover:border-[#FF3130]/40 transition-colors"></div>
                <div class={`w-11 h-11 rounded-xl ${pillar.bgColor} ${pillar.iconColor} flex items-center justify-center font-black text-sm shadow-xs group-hover:scale-105 transition-transform`}>
                  {pillar.number}
                </div>
              </div>

              <!-- Card Title -->
              <h3 class="text-lg font-bold text-[#0B2553] tracking-tight leading-snug group-hover:text-[#0C487A] transition-colors">
                {pillar.title}
              </h3>

              <!-- Card Description -->
              <p class="text-xs sm:text-sm text-[#243A5E] mt-3 leading-relaxed font-normal">
                {pillar.description}
              </p>
            </div>

            <!-- Bottom Pill -->
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center gap-1.5 text-xs font-semibold text-slate-400">
              <span class={`w-1.5 h-1.5 rounded-full ${pillar.accentColor}`}></span>
              <span>Pillar {pillar.number}</span>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 03 – EXPLORE OPEN POSITIONS (Primary Functional Section)          -->
  <!-- ========================================================================= -->
  <section id="open-positions" class="relative bg-slate-50/70 py-20 sm:py-28 border-t border-slate-200/80" aria-labelledby="open-positions-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Heading -->
      <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-16">
        <h2
          id="open-positions-heading"
          class="scroll-reveal text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0B2553] tracking-tight"
        >
          Find Your <span class="text-[#FF3130]">Next Opportunity</span>
        </h2>
        <p class="scroll-reveal delay-100 mt-4 text-base sm:text-lg text-[#243A5E] leading-relaxed font-normal">
          Explore current openings and discover a role that aligns with your experience, skills, and career goals.
        </p>
      </div>

      <!-- Functional Search, Multi-Filter, and Job Cards -->
      <JobBoard />

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 04 – OUR HIRING PROCESS (4-Step Connected Workflow)               -->
  <!-- ========================================================================= -->
  <HiringProcess />

  <!-- ========================================================================= -->
  <!-- SECTION 05 – JOIN OUR TALENT NETWORK (Direct Resume Submission Form)      -->
  <!-- ========================================================================= -->
  <section id="talent-network" class="relative bg-white py-20 sm:py-28 border-t border-slate-200/80" aria-labelledby="talent-network-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Left Column: Context & Narrative (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-[#FF3130]/10 text-[#FF3130] border border-[#FF3130]/20">
            Talent Community
          </span>

          <h2
            id="talent-network-heading"
            class="text-3xl sm:text-4xl font-extrabold text-[#0B2553] tracking-tight leading-[1.18]"
          >
            Your Next Opportunity May Be Just <span class="text-[#FF3130]">Around the Corner.</span>
          </h2>

          <p class="text-base text-[#243A5E] leading-relaxed font-normal">
            Don't see a position that matches your experience? Share your resume with Unity Compass. Our recruitment team can consider your profile for relevant opportunities as they arise across DoD, Civilian, and intelligence programs.
          </p>

          <!-- Key Highlights Checklist -->
          <ul class="space-y-3 pt-2 text-sm text-[#243A5E]">
            <li class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-red-50 text-[#FF3130] flex items-center justify-center shrink-0">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span>Direct consideration for unadvertised cleared positions</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-blue-50 text-[#0B2553] flex items-center justify-center shrink-0">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span>Complete candidate privacy and clearance discretion</span>
            </li>
            <li class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span>Proactive alignment with upcoming prime contract awards</span>
            </li>
          </ul>
        </div>

        <!-- Right Column: Interactive Resume Submission Form (7 cols) -->
        <div class="lg:col-span-7">
          <div class="relative rounded-3xl bg-white border border-slate-200/90 p-8 sm:p-10 shadow-[0_12px_40px_-10px_rgba(12,72,122,0.12)] overflow-hidden">
            <div class="absolute top-0 inset-x-0 h-1.5 bg-[#FF3130]"></div>

            <h3 class="text-xl font-extrabold text-[#0B2553] tracking-tight mb-2">
              Submit Your Resume
            </h3>
            <p class="text-xs text-slate-500 mb-6">
              Complete the fields below to connect with our talent acquisition team.
            </p>

            <form id="talent-network-form" class="space-y-4" novalidate>
              <div id="talent-form-feedback" class="hidden p-3.5 rounded-xl text-xs font-semibold"></div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Full Name -->
                <div>
                  <label class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-1">
                    Full Name *
                  </label>
                  <input
                    type="text"
                    id="tn-name"
                    required
                    placeholder="Jane Doe"
                    class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 text-[#0B2553] text-sm focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white"
                  />
                </div>

                <!-- Email Address -->
                <div>
                  <label class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-1">
                    Email Address *
                  </label>
                  <input
                    type="email"
                    id="tn-email"
                    required
                    placeholder="jane.doe@example.com"
                    class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 text-[#0B2553] text-sm focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <!-- Phone -->
                <div>
                  <label class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-1">
                    Phone Number *
                  </label>
                  <input
                    type="tel"
                    id="tn-phone"
                    required
                    placeholder="+1 (555) 000-0000"
                    class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 text-[#0B2553] text-sm focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white"
                  />
                </div>

                <!-- Area of Expertise -->
                <div>
                  <label class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-1">
                    Area of Expertise
                  </label>
                  <select
                    id="tn-expertise"
                    class="w-full px-3 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 text-[#0B2553] text-xs focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white cursor-pointer font-medium"
                  >
                    <option value="Proposal Development">Proposal Development</option>
                    <option value="Federal IT & Cloud">Federal IT &amp; Cloud</option>
                    <option value="Cybersecurity & Compliance">Cybersecurity &amp; Compliance</option>
                    <option value="Engineering & Defense">Engineering &amp; Defense</option>
                    <option value="Staffing & Recruitment">Staffing &amp; Recruitment</option>
                    <option value="Program Management">Program Management</option>
                    <option value="Other">Other Specialty</option>
                  </select>
                </div>

                <!-- Preferred Employment Type -->
                <div>
                  <label class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-1">
                    Preferred Type
                  </label>
                  <select
                    id="tn-type"
                    class="w-full px-3 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 text-[#0B2553] text-xs focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white cursor-pointer font-medium"
                  >
                    <option value="Full-Time">Full-Time</option>
                    <option value="Contract / 1099">Contract / 1099</option>
                    <option value="Temp-to-Hire">Temp-to-Hire</option>
                    <option value="Any">Open to Any</option>
                  </select>
                </div>
              </div>

              <!-- Security Clearance Status -->
              <div>
                <label class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-1">
                  Security Clearance Status
                </label>
                <select
                  id="tn-clearance"
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50/50 text-[#0B2553] text-xs focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white cursor-pointer font-medium"
                >
                  <option value="None">None / Non-Cleared</option>
                  <option value="Public Trust">DHS / Federal Public Trust</option>
                  <option value="Secret">Secret Clearance</option>
                  <option value="Top Secret / SCI">Top Secret / SCI</option>
                  <option value="TS/SCI with Polygraph">TS/SCI with CI or Full-Scope Polygraph</option>
                </select>
              </div>

              <!-- Resume Upload Zone -->
              <div>
                <label class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-1">
                  Attach Resume Document (PDF, DOCX max 5MB) *
                </label>
                <div class="border-2 border-dashed border-slate-300 hover:border-[#FF3130] rounded-2xl p-5 text-center bg-slate-50/60 hover:bg-red-50/20 transition-all cursor-pointer relative">
                  <input
                    type="file"
                    id="tn-resume"
                    required
                    accept=".pdf,.doc,.docx"
                    class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
                  />
                  <div class="space-y-1 pointer-events-none">
                    <svg class="w-7 h-7 text-[#FF3130] mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                    </svg>
                    <p class="text-xs font-bold text-[#0B2553]">
                      Click to upload or drag and drop your resume
                    </p>
                    <p class="text-[11px] text-slate-500">
                      PDF, DOC, DOCX up to 5MB
                    </p>
                  </div>
                  <div id="tn-file-name" class="hidden text-xs font-bold text-emerald-700 bg-emerald-50 py-1 px-3 rounded-lg border border-emerald-200 inline-block mt-2"></div>
                </div>
              </div>

              <!-- Consent & Privacy Information -->
              <div class="pt-2">
                <p class="text-[11px] text-slate-500 leading-relaxed font-normal">
                  By submitting your resume, you consent to Unity Compass securely processing your candidate credentials in accordance with our <a href="/privacy-policy" class="text-[#0C487A] font-bold hover:underline">Privacy Policy</a> for current and future federal contracting opportunities.
                </p>
              </div>

              <!-- Submit Button -->
              <button
                type="submit"
                id="tn-submit-btn"
                class="w-full py-4 px-6 rounded-2xl text-xs font-bold uppercase tracking-wider text-white bg-[#FF3130] hover:bg-[#E02625] shadow-lg shadow-[#FF3130]/25 active:scale-[0.98] transition-all cursor-pointer"
              >
                Submit Your Resume to Talent Network
              </button>
            </form>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 06 – FREQUENTLY ASKED QUESTIONS (Accordion-Based)                 -->
  <!-- ========================================================================= -->
  <section class="relative bg-slate-50/70 py-20 sm:py-28 border-t border-slate-200/80" aria-labelledby="faq-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Heading -->
      <div class="text-center max-w-2xl mx-auto mb-14 sm:mb-16">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-[#FF3130]/10 text-[#FF3130] border border-[#FF3130]/20 mb-3.5">
          Candidate FAQ
        </span>
        <h2
          id="faq-heading"
          class="text-3xl sm:text-4xl font-extrabold text-[#0B2553] tracking-tight"
        >
          Frequently Asked <span class="text-[#FF3130]">Questions</span>
        </h2>
        <p class="mt-3 text-sm sm:text-base text-[#243A5E] font-normal">
          Common questions about applying, security clearances, and working with Unity Compass.
        </p>
      </div>

      <!-- Accessible Accordions List -->
      <div class="space-y-4" role="region" aria-label="FAQ Accordion">
        {faqs.map((faq, index) => (
          <div class="faq-item rounded-2xl bg-white border border-slate-200/90 shadow-xs overflow-hidden transition-all duration-200">
            <button
              type="button"
              class="faq-toggle w-full px-6 py-5 text-left flex items-center justify-between gap-4 font-bold text-sm sm:text-base text-[#0B2553] hover:text-[#0C487A] transition-colors cursor-pointer"
              aria-expanded="false"
              aria-controls={`faq-answer-${index}`}
              id={`faq-btn-${index}`}
            >
              <span>{faq.question}</span>
              <span class="faq-icon w-6 h-6 rounded-full bg-slate-100 text-[#0B2553] flex items-center justify-center shrink-0 transition-transform duration-300">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </button>
            <div
              id={`faq-answer-${index}`}
              role="region"
              aria-labelledby={`faq-btn-${index}`}
              class="faq-content hidden px-6 pb-6 pt-1 text-xs sm:text-sm text-[#243A5E] leading-relaxed font-normal border-t border-slate-100"
            >
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 07 – FINAL CTA (Ready to Take the Next Step?)                      -->
  <!-- ========================================================================= -->
  <section class="relative bg-white py-20 sm:py-28 overflow-hidden border-t border-slate-200/80" aria-labelledby="final-cta-heading">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="relative rounded-3xl bg-gradient-to-br from-[#0B2553] via-[#0C3860] to-[#081832] p-10 sm:p-14 lg:p-16 text-center text-white shadow-2xl border border-blue-900/40 overflow-hidden">
        <!-- Blueprint Grid Checks Overlay -->
        <div
          class="absolute inset-0 pointer-events-none opacity-20"
          style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(255, 255, 255, 0.1) 1px, transparent 1px), linear-gradient(to bottom, rgba(255, 255, 255, 0.1) 1px, transparent 1px);"
          aria-hidden="true"
        ></div>

        <!-- Ambient Glow -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[300px] bg-[radial-gradient(ellipse,rgba(255,49,48,0.25)_0%,transparent_70%)] pointer-events-none blur-3xl"></div>

        <div class="relative z-10 max-w-2xl mx-auto space-y-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-[#FF3130]/20 text-red-300 border border-[#FF3130]/30">
            Next Steps
          </span>

          <h2
            id="final-cta-heading"
            class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-[1.16]"
          >
            Ready to Take the <span class="text-[#FF3130]">Next Step?</span>
          </h2>

          <p class="text-sm sm:text-base text-slate-300 leading-relaxed font-normal">
            Explore opportunities with Unity Compass and bring your expertise to work that matters.
          </p>

          <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href="#open-positions"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 sm:px-10 py-4 rounded-xl font-bold text-xs uppercase tracking-wider text-white bg-[#FF3130] hover:bg-[#E02625] shadow-lg shadow-[#FF3130]/30 active:scale-[0.98] transition-all cursor-pointer"
            >
              <span>Explore Open Positions</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </a>
            
            <a
              href="/contact"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 sm:px-10 py-4 rounded-xl border border-white/20 hover:border-white bg-white/10 hover:bg-white/20 text-white font-bold text-xs uppercase tracking-wider transition-all cursor-pointer"
            >
              <span>Contact Recruitment</span>
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

</MainLayout>

<!-- ========================================================================= -->
<!-- CLIENT SCRIPTS: TALENT NETWORK SUBMISSION & ACCORDION BEHAVIORS          -->
<!-- ========================================================================= -->
<script>
  // 1. Accordion Handling (Accessible FAQ)
  document.querySelectorAll('.faq-toggle').forEach((button) => {
    button.addEventListener('click', () => {
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      const answerId = button.getAttribute('aria-controls');
      const content = document.getElementById(answerId || '');
      const icon = button.querySelector('.faq-icon');

      if (isExpanded) {
        button.setAttribute('aria-expanded', 'false');
        content?.classList.add('hidden');
        icon?.classList.remove('rotate-180', 'bg-red-50', 'text-[#FF3130]');
      } else {
        button.setAttribute('aria-expanded', 'true');
        content?.classList.remove('hidden');
        icon?.classList.add('rotate-180', 'bg-red-50', 'text-[#FF3130]');
      }
    });
  });

  // 2. Talent Network Form Handling
  const tnForm = document.getElementById('talent-network-form') as HTMLFormElement;
  const tnFeedback = document.getElementById('talent-form-feedback');
  const tnSubmitBtn = document.getElementById('tn-submit-btn') as HTMLButtonElement;
  const tnResumeInput = document.getElementById('tn-resume') as HTMLInputElement;
  const tnFileName = document.getElementById('tn-file-name');

  tnResumeInput?.addEventListener('change', () => {
    if (tnResumeInput.files && tnResumeInput.files[0]) {
      const file = tnResumeInput.files[0];
      if (tnFileName) {
        tnFileName.textContent = `✓ Selected: ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)`;
        tnFileName.classList.remove('hidden');
      }
    }
  });

  tnForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!tnFeedback || !tnSubmitBtn) return;

    tnFeedback.classList.add('hidden');
    tnFeedback.className = 'p-3.5 rounded-xl text-xs font-semibold mb-3';

    const name = (document.getElementById('tn-name') as HTMLInputElement)?.value.trim();
    const email = (document.getElementById('tn-email') as HTMLInputElement)?.value.trim();
    const phone = (document.getElementById('tn-phone') as HTMLInputElement)?.value.trim();
    const expertise = (document.getElementById('tn-expertise') as HTMLSelectElement)?.value || 'General';
    const preferredType = (document.getElementById('tn-type') as HTMLSelectElement)?.value || 'Any';
    const clearance = (document.getElementById('tn-clearance') as HTMLSelectElement)?.value || 'None';
    const file = tnResumeInput?.files?.[0];

    if (!name || !email || !phone) {
      tnFeedback.textContent = 'Please fill out all required candidate fields.';
      tnFeedback.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
      tnFeedback.classList.remove('hidden');
      return;
    }

    if (!file) {
      tnFeedback.textContent = 'Please attach your resume document (PDF or Word format).';
      tnFeedback.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
      tnFeedback.classList.remove('hidden');
      return;
    }

    if (file.size > 5 * 1024 * 1024) {
      tnFeedback.textContent = 'Resume file exceeds 5MB limit. Please upload a smaller document.';
      tnFeedback.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
      tnFeedback.classList.remove('hidden');
      return;
    }

    tnSubmitBtn.disabled = true;
    tnSubmitBtn.textContent = 'Submitting Your Resume...';

    const formData = new FormData();
    formData.append('name', name);
    formData.append('email', email);
    formData.append('phone', phone);
    formData.append('jobTitle', `Talent Network: ${expertise} (${clearance}) [${preferredType}]`);
    formData.append('resume', file);

    try {
      const res = await fetch('/api/careers/apply', {
        method: 'POST',
        body: formData,
      });
      const data = await res.json().catch(() => ({}));

      if (res.ok && data.success) {
        tnFeedback.textContent = 'Thank you! Your resume has been submitted to the Unity Compass Talent Network. Our recruitment team will review your qualifications.';
        tnFeedback.classList.add('bg-emerald-50', 'text-emerald-800', 'border', 'border-emerald-200');
        tnFeedback.classList.remove('hidden');
        tnForm.reset();
        if (tnFileName) tnFileName.classList.add('hidden');
      } else {
        tnFeedback.textContent = data.error || 'Failed to submit resume. Please try again.';
        tnFeedback.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
        tnFeedback.classList.remove('hidden');
      }
    } catch (err) {
      tnFeedback.textContent = 'Network error while submitting resume. Please try again or email us directly.';
      tnFeedback.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
      tnFeedback.classList.remove('hidden');
    } finally {
      tnSubmitBtn.disabled = false;
      tnSubmitBtn.textContent = 'Submit Your Resume to Talent Network';
    }
  });
</script>
