---
/**
 * career.astro - Executive GovCon & Cleared Career Portal
 * 
 * Harmonized with Unity Compass Design System:
 * - Clean, focused Hero with technical blueprint grid and ambient radial glow
 * - Explore Open Opportunities section with uncluttered, spacious job listings
 * - Full visibility for Key Responsibilities & Required Qualifications
 * - Dedicated Hiring Process Section (5 Milestones matching client spec)
 * - Pure CSS WaveDivider transitions
 */
import MainLayout from '../layouts/MainLayout.astro';
import JobBoard from '../components/JobBoard.astro';
import HiringProcess from '../components/HiringProcess.astro';
import WaveDivider from '../components/WaveDivider.astro';
---

<MainLayout
  title="Careers & Cleared Talent Placement - Unity Compass"
  description="Explore active cleared and non-cleared career opportunities in federal contracting, IT systems architecture, defense engineering, and proposal development with Unity Compass."
>
  <!-- ========================================================================= -->
  <!-- SECTION 1: CLEAN, FOCUSED EXECUTIVE HERO                                  -->
  <!-- ========================================================================= -->
  <section class="relative overflow-hidden bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] pt-16 sm:pt-20 lg:pt-24 pb-24 sm:pb-32 lg:pb-36" aria-labelledby="career-hero-heading">
    <!-- Technical Blueprint Check Pattern -->
    <div
      class="absolute inset-0 opacity-[0.24] mix-blend-multiply pointer-events-none"
      style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.08) 1px, transparent 1px);"
      aria-hidden="true"
    ></div>

    <!-- Soft Ambient Radial Blue Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[radial-gradient(circle,rgba(12,72,122,0.11)_0%,rgba(30,64,175,0.05)_45%,transparent_70%)] rounded-full blur-3xl pointer-events-none -z-10" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
      <div class="text-center max-w-3xl mx-auto">
        <!-- Headline -->
        <h1
          id="career-hero-heading"
          class="scroll-reveal text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-[#0B2553] leading-[1.16]"
        >
          Empowering Mission-Critical <span class="text-[#FF3130]">Careers</span>
        </h1>

        <!-- Subtitle -->
        <p class="scroll-reveal delay-100 mt-4 text-base sm:text-lg text-[#243A5E] leading-[1.75] max-w-2xl mx-auto font-normal">
          Direct permanent, contract, and cleared placements across federal defense, intelligence, and civilian agencies. Find your next leadership, technical, or proposal mission.
        </p>
      </div>
    </div>

    <!-- Pure CSS SVG Wave Section Divider Leading into Opportunities -->
    <WaveDivider variant="wave" position="bottom" fillColor="#ffffff" />
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 2: EXPLORE OPEN OPPORTUNITIES (Uncluttered, Highly Readable)      -->
  <!-- ========================================================================= -->
  <section class="relative bg-white py-16 sm:py-24" aria-label="Open Positions">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Heading (Clean & Simple) -->
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <h2 class="scroll-reveal text-3xl sm:text-4xl font-extrabold text-[#0B2553] tracking-tight">
          Explore Open <span class="text-[#FF3130]">Opportunities</span>
        </h2>
        <p class="scroll-reveal delay-100 text-sm sm:text-base text-[#243A5E] mt-3 font-normal">
          Filter positions by department, workplace model, and security clearance requirement.
        </p>
      </div>

      <!-- Live Job Board Component (Spacious, Complete Responsibilities & Requirements) -->
      <div class="scroll-reveal delay-150">
        <JobBoard />
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 3: HIRING PROCESS WORKFLOW                                        -->
  <!-- ========================================================================= -->
  <HiringProcess />

</MainLayout>
