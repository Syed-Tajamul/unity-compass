---
/**
 * career.astro - Unity Compass Careers Page
 * 
 * Strict Redesign & Visual Harmony:
 * - 100% synchronized with homepage and about-us design language, colors, and typography
 * - Section 01: Careers Hero (Clean floating visual anchor, NO white card frame, NO chips/badges,
 *   single primary CTA "Explore Open Positions", exact homepage line-heights)
 * - Section 02: Why Work With Unity Compass? ("More Than a Job. A Career With Purpose.", animated text gradient, 4 cards)
 * - Section 03: Explore Open Positions ("Find Your Next Opportunity", streamlined JobBoard)
 * - Section 04: Our Hiring Process (4 Interactive Two-Layer Sliding Cards from Screenshot 4)
 * - Section 05: Join Our Talent Network (No badges, clean 4-field resume form, relaxed line-height)
 * - Section 06: Frequently Asked Questions (No badges, silky-smooth CSS grid accordion animations)
 * - Section 07: Final CTA (No badges, executive navy card with subtle glow)
 * - Page-wide IntersectionObserver scroll-reveal animations across every viewport section
 */
import MainLayout from '../layouts/MainLayout.astro';
import JobBoard from '../components/JobBoard.astro';
import HiringProcess from '../components/HiringProcess.astro';
import WaveDivider from '../components/WaveDivider.astro';

// Section 02 - 4 Pillars Data
const whyWorkPillars = [
  {
    number: '01',
    title: 'Meaningful Work',
    description: 'Contribute to projects supporting important government missions across defense, intelligence, and civilian agencies.',
    accentColor: 'bg-[#FF3130]',
    iconColor: 'text-[#FF3130]',
    bgColor: 'bg-red-50',
  },
  {
    number: '02',
    title: 'Professional Growth',
    description: 'Expand your expertise through challenging assignments, high-visibility solicitations, and career advancement opportunities.',
    accentColor: 'bg-[#0B2553]',
    iconColor: 'text-[#0B2553]',
    bgColor: 'bg-blue-50',
  },
  {
    number: '03',
    title: 'Diverse Opportunities',
    description: 'Explore roles across technology, proposal development, security-cleared staffing, systems architecture, and business consulting.',
    accentColor: 'bg-[#EE8522]',
    iconColor: 'text-[#EE8522]',
    bgColor: 'bg-amber-50',
  },
  {
    number: '04',
    title: 'People & Collaboration',
    description: 'Work alongside dedicated GovCon professionals who value domain expertise, teamwork, integrity, and mission success.',
    accentColor: 'bg-emerald-600',
    iconColor: 'text-emerald-700',
    bgColor: 'bg-emerald-50',
  },
];

// Section 06 - 6 Exact FAQs
const faqs = [
  {
    question: 'How do I apply for an open position?',
    answer: 'Select "View Position" on any listed opening to examine the comprehensive scope, responsibilities, and required qualifications. From there, select "Apply Now" to submit your resume, contact details, and clearance credentials directly through our secure portal.',
  },
  {
    question: 'Can I submit my resume if there are no suitable openings?',
    answer: 'Yes! We encourage you to submit your credentials to our Talent Network section below. Our recruitment directors continuously evaluate candidates against pipeline solicitations, upcoming contract awards, and unadvertised cleared requisitions.',
  },
  {
    question: 'What types of employment opportunities are available?',
    answer: 'Unity Compass supports direct permanent placements, long-term prime subcontracting positions, 1099 specialized advisory engagements, and temp-to-hire assignments across DoD, Intelligence Community, and civilian federal programs.',
  },
  {
    question: 'Are security clearances required for all positions?',
    answer: 'No. While many of our national security and defense programs require active Secret, Top Secret, or TS/SCI with Polygraph credentials, we also offer non-cleared and DHS Public Trust opportunities in proposal development, corporate consulting, and enterprise software engineering.',
  },
  {
    question: 'How will I know if my application has been received?',
    answer: 'Upon submitting your application or resume document, you will receive an immediate confirmation on-screen. Our specialized recruitment team reviews submissions against active labor categories within 48 to 72 business hours.',
  },
  {
    question: 'Can I apply for multiple positions?',
    answer: 'Yes. You are welcome to submit applications for all positions that align with your background and certifications. Our talent partners will evaluate your profile across all applicable requisitions.',
  },
];
---

<MainLayout
  title="Careers - Unity Compass | Build Your Career. Make an Impact."
  description="Explore career opportunities with Unity Compass across federal contracting, defense, intelligence, and civilian agencies. Find mission-focused roles in cleared staffing, IT, and consulting."
>
  <!-- ========================================================================= -->
  <!-- SECTION 01 – CAREERS HERO (Sophisticated Split-Screen Layout)              -->
  <!-- ========================================================================= -->
  <section
    class="relative min-h-[580px] sm:min-h-[620px] lg:min-h-[660px] flex items-center overflow-hidden bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] pt-16 sm:pt-20 lg:pt-24 pb-20 sm:pb-28"
    aria-labelledby="career-hero-heading"
  >
    <!-- Technical Blueprint Check Grid Pattern (Matching Homepage ~40% reduced) -->
    <div
      class="absolute inset-0 opacity-[0.24] mix-blend-multiply pointer-events-none"
      style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.08) 1px, transparent 1px);"
      aria-hidden="true"
    ></div>

    <!-- Soft Ambient Radial Blue Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[radial-gradient(circle,rgba(12,72,122,0.11)_0%,rgba(30,64,175,0.05)_45%,transparent_70%)] rounded-full blur-3xl pointer-events-none -z-10" aria-hidden="true"></div>

    <div class="max-w-7xl xl:max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-[0.94fr_1.06fr] gap-8 items-center">
        
        <!-- LEFT COLUMN: Headline, Description & Single Clean CTA -->
        <div class="max-w-2xl">
          
          <!-- Heading with Homepage Hero Line-Height -->
          <h1
            id="career-hero-heading"
            class="career-reveal text-3xl sm:text-4xl lg:text-[2.75rem] xl:text-[3.15rem] font-extrabold tracking-tight leading-[1.18] sm:leading-[1.20] text-[#0B2553]"
          >
            <span class="block text-[#0B2553]">
              Build Your Career.
            </span>
            <span class="block text-[#FF3130]">
              Make an Impact.
            </span>
          </h1>

          <!-- Description with Relaxed Homepage Hero Line-Height -->
          <p class="career-reveal career-delay-1 mt-5 sm:mt-6 text-base sm:text-lg text-[#243A5E] leading-[1.78] sm:leading-[1.82] font-normal max-w-xl">
            Explore career opportunities with Unity Compass across federal contracting, defense, intelligence, and civilian agencies. Whether you're an experienced professional, technical specialist, or emerging leader, discover opportunities where your expertise contributes to meaningful missions.
          </p>

          <!-- Primary CTA Button (Explore Open Positions only) -->
          <div class="career-reveal career-delay-2 mt-8 sm:mt-10 flex items-center">
            <a
              href="#open-positions"
              class="inline-flex items-center justify-center gap-3 px-8 sm:px-9 py-4 rounded-md sm:rounded-lg bg-gradient-to-r from-[#FF3130] to-[#E02625] hover:from-[#E02625] hover:to-[#C61E1D] text-white text-base font-bold shadow-[0_8px_24px_-4px_rgba(255,49,48,0.25)] hover:shadow-[0_12px_28px_-2px_rgba(255,49,48,0.35)] cursor-pointer whitespace-nowrap transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
            >
              <span>Explore Open Positions</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </a>
          </div>

        </div>

        <!-- RIGHT COLUMN: 3D Isometric Art Sized Exactly as in about-us.astro -->
        <div class="career-reveal career-delay-2 relative mx-auto w-full max-w-2xl flex items-center justify-center" aria-hidden="true">
          <!-- Ambient Blue Shadow Diffusion & Ground Glow Matching about-us.astro -->
          <div class="absolute inset-x-[12%] bottom-[5%] h-[24%] rounded-full bg-[#0C487A]/15 blur-3xl pointer-events-none"></div>
          
          <!-- Clean 3D Transparent Illustration (Full max-w-2xl size identical to about-us.astro) -->
          <img
            src="/images/career-960.webp"
            srcset="/images/career-960.webp 960w, /images/career.webp 2521w"
            sizes="(min-width: 1280px) 672px, (min-width: 1024px) 52vw, 100vw"
            alt="Unity Compass Careers and Opportunities"
            class="career-float relative h-auto w-full object-contain drop-shadow-[0_24px_22px_rgba(15,39,74,0.14)]"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="1600"
            height="817"
            onerror="this.src='/images/career.png'"
          />
        </div>

      </div>
    </div>

    <!-- Pure CSS WaveDivider Transition into Section 02 -->
    <WaveDivider variant="wave" position="bottom" fillColor="#ffffff" />
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 02 – WHY WORK WITH UNITY COMPASS? (4 Refined Cards)               -->
  <!-- ========================================================================= -->
  <section class="relative bg-white py-20 sm:py-28" aria-labelledby="why-work-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Heading with Homepage Hero Line-Height & Animated Gradient -->
      <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
        <h2
          id="why-work-heading"
          class="career-reveal text-2xl sm:text-3xl md:text-4xl lg:text-[2.65rem] font-extrabold tracking-tight leading-[1.38] sm:leading-[1.46] text-center"
        >
          <span class="block text-[#0B2553] pb-2 sm:pb-3.5">More Than a Job.</span>
          <span class="service-shimmer-center service-shimmer-line-1 block pb-2.5 pt-1">A Career With Purpose.</span>
        </h2>

        <!-- Brand Accent Bar -->
        <div class="w-24 h-1.5 rounded-full bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130] mx-auto mt-5 mb-5"></div>

        <p class="career-reveal career-delay-1 mt-2 text-base sm:text-lg text-[#243A5E] leading-[1.78] sm:leading-[1.82] font-normal max-w-2xl mx-auto">
          Be part of a team that connects expertise, opportunity, and mission-focused work.
        </p>
      </div>

      <!-- 4 Visually Appealing Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {whyWorkPillars.map((pillar, idx) => (
          <div
            class={`career-reveal career-delay-${idx + 1} group relative rounded-3xl bg-white border border-slate-200/90 p-7 sm:p-8 shadow-[0_10px_30px_-6px_rgba(12,72,122,0.06)] hover:shadow-[0_20px_45px_-8px_rgba(12,72,122,0.14)] hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between overflow-hidden`}
          >
            <!-- Top Color Stripe -->
            <div class={`absolute top-0 inset-x-0 h-1.5 ${pillar.accentColor}`}></div>

            <div>
              <!-- Dashed Outer Ring Icon Box -->
              <div class="relative w-14 h-14 mb-6 flex items-center justify-center">
                <div class="absolute inset-0 rounded-full border-2 border-dashed border-slate-300 group-hover:border-[#FF3130]/40 transition-colors"></div>
                <div class={`w-11 h-11 rounded-full ${pillar.bgColor} ${pillar.iconColor} flex items-center justify-center font-black text-sm shadow-xs group-hover:scale-105 transition-transform`}>
                  {pillar.number}
                </div>
              </div>

              <!-- Card Title -->
              <h3 class="text-lg font-bold text-[#0B2553] tracking-tight leading-snug group-hover:text-[#0C487A] transition-colors">
                {pillar.title}
              </h3>

              <!-- Card Description -->
              <p class="text-xs sm:text-sm text-[#243A5E] mt-3 leading-relaxed font-normal">
                {pillar.description}
              </p>
            </div>

            <!-- Bottom Indicator -->
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center gap-1.5 text-xs font-semibold text-slate-400">
              <span class={`w-1.5 h-1.5 rounded-full ${pillar.accentColor}`}></span>
              <span>Pillar {pillar.number}</span>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 03 – EXPLORE OPEN POSITIONS (Primary Functional Section)          -->
  <!-- ========================================================================= -->
  <section id="open-positions" class="relative bg-slate-50/70 py-20 sm:py-28 border-t border-slate-200/80" aria-labelledby="open-positions-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Heading -->
      <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-16">
        <h2
          id="open-positions-heading"
          class="career-reveal text-2xl sm:text-3xl md:text-4xl lg:text-[2.65rem] font-extrabold tracking-tight leading-[1.18] sm:leading-[1.22] text-center"
        >
          <span class="text-[#0B2553]">Find Your </span>
          <span class="service-shimmer-center service-shimmer-line-1 inline-block pb-1.5 pt-0.5">Next Opportunity</span>
        </h2>

        <!-- Brand Accent Bar -->
        <div class="w-24 h-1.5 rounded-full bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130] mx-auto mt-4 mb-5"></div>

        <p class="career-reveal career-delay-1 mt-2 text-base sm:text-lg text-[#243A5E] leading-[1.78] sm:leading-[1.82] font-normal max-w-2xl mx-auto">
          Explore current openings and discover a role that aligns with your experience, skills, and career goals.
        </p>
      </div>

      <!-- Functional Search, Multi-Filter, and Job Cards -->
      <JobBoard />

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 04 – OUR HIRING PROCESS (4-Step Sliding Cards Workflow)           -->
  <!-- ========================================================================= -->
  <HiringProcess />

  <!-- ========================================================================= -->
  <!-- SECTION 05 – JOIN OUR TALENT NETWORK (Direct Resume Submission Form)      -->
  <!-- ========================================================================= -->
  <section id="talent-network" class="relative bg-white py-20 sm:py-28 border-t border-slate-200/80" aria-labelledby="talent-network-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Left Column: Context & Narrative (5 cols on lg) -->
        <div class="lg:col-span-5 space-y-6">
          <h2
            id="talent-network-heading"
            class="career-reveal text-3xl sm:text-4xl lg:text-[2.65rem] font-extrabold text-[#0B2553] tracking-tight leading-[1.28] sm:leading-[1.34]"
          >
            Your Next Opportunity May Be Just <span class="service-shimmer-center service-shimmer-line-1 inline-block pb-1">Around the Corner.</span>
          </h2>

          <p class="career-reveal career-delay-1 text-base text-[#243A5E] leading-[1.78] sm:leading-[1.82] font-normal">
            Don't see a position that matches your experience? Share your resume with Unity Compass. Our recruitment team can consider your profile for relevant opportunities as they arise across DoD, Civilian, and intelligence programs.
          </p>

          <!-- Key Highlights Checklist -->
          <ul class="space-y-3.5 pt-2 text-sm text-[#243A5E]">
            <li class="career-reveal career-delay-2 flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-red-50 text-[#FF3130] flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span class="font-medium">Direct consideration for unadvertised cleared positions</span>
            </li>
            <li class="career-reveal career-delay-3 flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-blue-50 text-[#0B2553] flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span class="font-medium">Complete candidate privacy and clearance discretion</span>
            </li>
            <li class="career-reveal career-delay-4 flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span class="font-medium">Proactive alignment with upcoming prime contract awards</span>
            </li>
          </ul>
        </div>

        <!-- Right Column: Interactive Resume Submission Form (7 cols on lg) -->
        <div class="lg:col-span-7 career-reveal career-delay-1">
          <div class="relative rounded-3xl bg-white border border-slate-200/90 p-8 sm:p-10 shadow-[0_12px_40px_-10px_rgba(12,72,122,0.12)] overflow-hidden">
            <div class="absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130]"></div>

            <div class="career-reveal career-delay-1">
              <h3 class="text-xl sm:text-2xl font-extrabold text-[#0B2553] tracking-tight mb-2">
                Submit Your Resume
              </h3>
              <p class="text-xs sm:text-sm text-slate-500 mb-6 font-normal">
                Share your credentials directly with our executive recruitment directors.
              </p>
            </div>

            <form id="talent-network-form" class="space-y-4" novalidate>
              <div id="talent-form-feedback" class="hidden p-3.5 rounded-xl text-xs font-semibold"></div>

              <!-- Full Name -->
              <div class="career-reveal career-delay-2">
                <label for="tn-name" class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-1.5">
                  Full Name *
                </label>
                <input
                  type="text"
                  id="tn-name"
                  required
                  placeholder="Jane Doe"
                  class="w-full px-4 py-3 rounded border border-slate-200 bg-slate-50/50 text-[#0B2553] text-sm focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white transition-all"
                />
              </div>

              <!-- Email & Phone in 2-Column Grid -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 career-reveal career-delay-3">
                <!-- Email Address -->
                <div>
                  <label for="tn-email" class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-1.5">
                    Email Address *
                  </label>
                  <input
                    type="email"
                    id="tn-email"
                    required
                    placeholder="jane.doe@example.com"
                    class="w-full px-4 py-3 rounded border border-slate-200 bg-slate-50/50 text-[#0B2553] text-sm focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white transition-all"
                  />
                </div>

                <!-- Phone -->
                <div>
                  <label for="tn-phone" class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-1.5">
                    Phone Number *
                  </label>
                  <input
                    type="tel"
                    id="tn-phone"
                    required
                    placeholder="+1 (555) 000-0000"
                    class="w-full px-4 py-3 rounded border border-slate-200 bg-slate-50/50 text-[#0B2553] text-sm focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white transition-all"
                  />
                </div>
              </div>

              <!-- Resume Upload Zone -->
              <div class="career-reveal career-delay-4">
                <label class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-1.5">
                  Attach Resume Document (PDF, DOCX max 5MB) *
                </label>
                <div class="border-2 border-dashed border-slate-300 hover:border-[#FF3130] rounded p-6 text-center bg-slate-50/60 hover:bg-red-50/20 transition-all cursor-pointer relative">
                  <input
                    type="file"
                    id="tn-resume"
                    required
                    accept=".pdf,.doc,.docx"
                    class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
                  />
                  <div class="space-y-1.5 pointer-events-none">
                    <svg class="w-8 h-8 text-[#FF3130] mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                    </svg>
                    <p class="text-sm font-bold text-[#0B2553]">
                      Click to upload or drag and drop your resume
                    </p>
                    <p class="text-xs text-slate-500">
                      PDF, DOC, DOCX up to 5MB
                    </p>
                  </div>
                  <div id="tn-file-name" class="hidden text-xs font-bold text-emerald-700 bg-emerald-50 py-1.5 px-3 rounded-lg border border-emerald-200 inline-block mt-2"></div>
                </div>
              </div>

              <!-- Consent & Privacy Information -->
              <div class="pt-2 career-reveal career-delay-5">
                <p class="text-xs text-slate-500 leading-relaxed font-normal">
                  By submitting your resume, you consent to Unity Compass securely processing your candidate credentials in accordance with our <a href="/privacy-policy" class="text-[#0C487A] font-bold hover:underline">Privacy Policy</a> for current and future federal contracting opportunities.
                </p>
              </div>

              <!-- Submit Button -->
              <div class="career-reveal career-delay-5">
                <button
                  type="submit"
                  id="tn-submit-btn"
                  class="w-full py-4 px-6 rounded-md sm:rounded-lg text-xs sm:text-sm font-bold uppercase tracking-wider text-white bg-[#FF3130] hover:bg-[#E02625] shadow-lg shadow-[#FF3130]/25 active:scale-[0.98] transition-all cursor-pointer"
                >
                  Submit Your Resume to Talent Network
                </button>
              </div>
            </form>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 06 – FREQUENTLY ASKED QUESTIONS (Smooth CSS Grid Accordion)       -->
  <!-- ========================================================================= -->
  <section class="relative bg-slate-50/70 py-20 sm:py-28 border-t border-slate-200/80" aria-labelledby="faq-heading">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Heading with Animated Gradient -->
      <div class="text-center max-w-2xl mx-auto mb-14 sm:mb-16">
        <h2
          id="faq-heading"
          class="career-reveal text-2xl sm:text-3xl md:text-4xl lg:text-[2.65rem] font-extrabold tracking-tight leading-[1.18] sm:leading-[1.22] text-center"
        >
          <span class="text-[#0B2553]">Frequently Asked </span>
          <span class="service-shimmer-center service-shimmer-line-1 inline-block pb-1.5 pt-0.5">Questions</span>
        </h2>
        
        <!-- Brand Accent Bar -->
        <div class="w-24 h-1.5 rounded-full bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130] mx-auto mt-4 mb-5"></div>

        <p class="career-reveal career-delay-1 mt-2 text-base sm:text-lg text-[#243A5E] leading-[1.78] font-normal text-center max-w-2xl mx-auto">
          Common questions about applying, security clearances, and working with Unity Compass.
        </p>
      </div>

      <!-- Accessible Accordions List with Smooth Animated Expansion -->
      <div class="space-y-4" role="region" aria-label="FAQ Accordion">
        {faqs.map((faq, index) => (
          <div
            class="faq-item career-reveal rounded-md bg-white border border-slate-200/90 shadow-xs overflow-hidden transition-all duration-300 focus-within:outline focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-[#0C487A]"
            style={`transition-delay: ${index * 110}ms;`}
          >
            <button
              type="button"
              class="faq-toggle w-full px-6 py-5 rounded-md text-left flex items-center justify-between gap-4 font-bold text-base sm:text-lg text-[#0B2553] hover:text-[#0C487A] transition-colors cursor-pointer focus-visible:outline-none"
              aria-expanded="false"
              aria-controls={`faq-answer-${index}`}
              id={`faq-btn-${index}`}
            >
              <span>{faq.question}</span>
              <span class="faq-icon w-8 h-8 rounded-full bg-slate-100 text-[#0B2553] flex items-center justify-center shrink-0 transition-transform duration-300">
                <svg class="w-4 h-4 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </button>
            <div
              id={`faq-answer-${index}`}
              role="region"
              aria-labelledby={`faq-btn-${index}`}
              class="faq-panel grid grid-rows-[0fr] gap-8 transition-[grid-template-rows] duration-300 ease-out"
            >
              <div class="overflow-hidden">
                <div class="px-6 pb-6 pt-2 text-sm sm:text-base text-[#243A5E] leading-relaxed font-normal border-t border-slate-100">
                  <p>{faq.answer}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 07 – FINAL CTA (Ready to Take the Next Step?)                      -->
  <!-- ========================================================================= -->
  <section class="relative bg-white py-20 sm:py-28 overflow-hidden border-t border-slate-200/80" aria-labelledby="final-cta-heading">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="relative rounded-3xl bg-gradient-to-br from-[#0B2553] via-[#0C3860] to-[#081832] p-10 sm:p-14 lg:p-16 text-center text-white shadow-2xl border border-blue-900/40 overflow-hidden career-reveal">
        <!-- Blueprint Grid Checks Overlay -->
        <div
          class="absolute inset-0 pointer-events-none opacity-20"
          style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(255, 255, 255, 0.1) 1px, transparent 1px), linear-gradient(to bottom, rgba(255, 255, 255, 0.1) 1px, transparent 1px);"
          aria-hidden="true"
        ></div>

        <!-- Ambient Glow -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[300px] bg-[radial-gradient(ellipse,rgba(255,49,48,0.25)_0%,transparent_70%)] pointer-events-none blur-3xl"></div>

        <div class="relative z-10 max-w-2xl mx-auto space-y-6">
          <h2
            id="final-cta-heading"
            class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-[1.18] sm:leading-[1.20]"
          >
            Ready to Take the <span class="text-[#FF3130]">Next Step?</span>
          </h2>

          <p class="text-sm sm:text-base text-slate-300 leading-[1.78] sm:leading-[1.82] font-normal">
            Explore opportunities with Unity Compass and bring your expertise to work that matters.
          </p>

          <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href="#open-positions"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 sm:px-10 py-4 rounded-md sm:rounded-lg font-bold text-xs uppercase tracking-wider text-white bg-[#FF3130] hover:bg-[#E02625] shadow-lg shadow-[#FF3130]/30 active:scale-[0.98] transition-all cursor-pointer"
            >
              <span>Explore Open Positions</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </a>
            
            <a
              href="/contact"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 sm:px-10 py-4 rounded-md sm:rounded-lg border border-white/20 hover:border-white bg-white/10 hover:bg-white/20 text-white font-bold text-xs uppercase tracking-wider transition-all cursor-pointer"
            >
              <span>Contact Recruitment</span>
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

</MainLayout>

<!-- ========================================================================= -->
<!-- STYLES & ANIMATIONS: Viewport Reveal, Floating Levitation, Shimmer        -->
<!-- ========================================================================= -->
<style is:global>
  /* Viewport Scroll Reveal (Harmonized with about-us.astro) */
  .career-reveal {
    opacity: 0;
    transform: translateY(28px);
    filter: blur(6px);
    will-change: opacity, transform, filter;
    transition:
      opacity 750ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 750ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 750ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .career-reveal.is-visible {
    opacity: 1 !important;
    transform: translateY(0) !important;
    filter: blur(0) !important;
  }

  .career-delay-1 { transition-delay: 90ms; }
  .career-delay-2 { transition-delay: 180ms; }
  .career-delay-3 { transition-delay: 270ms; }
  .career-delay-4 { transition-delay: 360ms; }
  .career-delay-5 { transition-delay: 450ms; }

  /* Floating Levitation on Hero Visual */
  @keyframes careerFloatLevitation {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .career-float {
    animation: careerFloatLevitation 6.5s ease-in-out infinite;
  }

  /* Center-Aligned Continuous Radiant Color Shimmer Sweep */
  .service-shimmer-center {
    background: linear-gradient(
      90deg,
      #0F274A 0%,
      #1E40AF 22%,
      #2563EB 42%,
      #DC2626 58%,
      #EF4444 72%,
      #0F274A 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    will-change: background-position;
    width: fit-content;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
    padding-bottom: 0.16em;
    padding-top: 0.05em;
    overflow: visible;
  }

  .service-shimmer-line-1 {
    animation: servicePageShimmer1 9.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @keyframes servicePageShimmer1 {
    0% { background-position: 0% 50%; }
    48% { background-position: 100% 50%; }
    52% { background-position: 100% 50%; }
    100% { background-position: 200% 50%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .career-reveal {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
      transition: none !important;
    }
    .career-float {
      animation: none !important;
    }
    .service-shimmer-center {
      animation: none !important;
      background: none !important;
      -webkit-text-fill-color: #0F274A !important;
      color: #0F274A !important;
    }
  }
</style>

<!-- ========================================================================= -->
<!-- CLIENT SCRIPTS: ACCORDION ANIMATION, FORM SUBMISSION & SCROLL OBSERVER    -->
<!-- ========================================================================= -->
<script>
  function initCareerPage() {
    // 1. Smooth Accordion Handling with CSS Grid Rows
    document.querySelectorAll('.faq-toggle').forEach((button) => {
      button.addEventListener('click', () => {
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        const answerId = button.getAttribute('aria-controls');
        const panel = document.getElementById(answerId || '');
        const icon = button.querySelector('.faq-icon');

        if (isExpanded) {
          button.setAttribute('aria-expanded', 'false');
          panel?.classList.remove('grid-rows-[1fr]');
          panel?.classList.add('grid-rows-[0fr]');
          icon?.classList.remove('rotate-180', 'bg-red-50', 'text-[#FF3130]');
        } else {
          button.setAttribute('aria-expanded', 'true');
          panel?.classList.remove('grid-rows-[0fr]');
          panel?.classList.add('grid-rows-[1fr]');
          icon?.classList.add('rotate-180', 'bg-red-50', 'text-[#FF3130]');
        }
      });
    });

    // 2. Viewport Scroll-Reveal Observer (Matching about-us.astro)
    const revealElements = document.querySelectorAll<HTMLElement>('.career-reveal');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reducedMotion || !('IntersectionObserver' in window)) {
      revealElements.forEach((el) => el.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver(
        (entries, currentObserver) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            currentObserver.unobserve(entry.target);
          });
        },
        { rootMargin: '0px 0px -6% 0px', threshold: 0.1 }
      );

      revealElements.forEach((el) => observer.observe(el));
    }

    // 3. Talent Network Form Handling
    const tnForm = document.getElementById('talent-network-form') as HTMLFormElement;
    const tnFeedback = document.getElementById('talent-form-feedback');
    const tnSubmitBtn = document.getElementById('tn-submit-btn') as HTMLButtonElement;
    const tnResumeInput = document.getElementById('tn-resume') as HTMLInputElement;
    const tnFileName = document.getElementById('tn-file-name');

    tnResumeInput?.addEventListener('change', () => {
      if (tnResumeInput.files && tnResumeInput.files[0]) {
        const file = tnResumeInput.files[0];
        if (tnFileName) {
          tnFileName.textContent = `✓ Selected: ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)`;
          tnFileName.classList.remove('hidden');
        }
      }
    });

    tnForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!tnFeedback || !tnSubmitBtn) return;

      tnFeedback.classList.add('hidden');
      tnFeedback.className = 'p-3.5 rounded-xl text-xs font-semibold mb-3';

      const name = (document.getElementById('tn-name') as HTMLInputElement)?.value.trim();
      const email = (document.getElementById('tn-email') as HTMLInputElement)?.value.trim();
      const phone = (document.getElementById('tn-phone') as HTMLInputElement)?.value.trim();
      const file = tnResumeInput?.files?.[0];

      if (!name || !email || !phone) {
        tnFeedback.textContent = 'Please fill out all required candidate fields.';
        tnFeedback.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
        tnFeedback.classList.remove('hidden');
        return;
      }

      if (!file) {
        tnFeedback.textContent = 'Please attach your resume document (PDF or Word format).';
        tnFeedback.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
        tnFeedback.classList.remove('hidden');
        return;
      }

      if (file.size > 5 * 1024 * 1024) {
        tnFeedback.textContent = 'Resume file exceeds 5MB limit. Please upload a smaller document.';
        tnFeedback.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
        tnFeedback.classList.remove('hidden');
        return;
      }

      tnSubmitBtn.disabled = true;
      tnSubmitBtn.textContent = 'Submitting Your Resume...';

      const formData = new FormData();
      formData.append('name', name);
      formData.append('email', email);
      formData.append('phone', phone);
      formData.append('jobTitle', 'Talent Network: General Submission');
      formData.append('resume', file);

      try {
        const res = await fetch('/api/careers/apply', {
          method: 'POST',
          body: formData,
        });
        const data = await res.json().catch(() => ({}));

        if (res.ok && data.success) {
          tnFeedback.textContent = 'Thank you! Your resume has been submitted to the Unity Compass Talent Network. Our recruitment team will review your qualifications.';
          tnFeedback.classList.add('bg-emerald-50', 'text-emerald-800', 'border', 'border-emerald-200');
          tnFeedback.classList.remove('hidden');
          tnForm.reset();
          if (tnFileName) tnFileName.classList.add('hidden');
        } else {
          tnFeedback.textContent = data.error || 'Failed to submit resume. Please try again.';
          tnFeedback.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
          tnFeedback.classList.remove('hidden');
        }
      } catch (err) {
        tnFeedback.textContent = 'Network error while submitting resume. Please try again or email us directly.';
        tnFeedback.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
        tnFeedback.classList.remove('hidden');
      } finally {
        tnSubmitBtn.disabled = false;
        tnSubmitBtn.textContent = 'Submit Your Resume to Talent Network';
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCareerPage, { once: true });
  } else {
    initCareerPage();
  }
</script>
