<!-- STYLES & ANIMATIONS: Viewport Reveal, Floating Levitation, Shimmer        -->
<!-- ========================================================================= -->
<style is:global>
  /* Viewport Scroll Reveal (Fast, zero-blur) */
  .career-reveal {
    opacity: 0;
    transform: translateY(20px);
    will-change: opacity, transform;
    transition:
      opacity 600ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .career-reveal.is-visible {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }

  .career-delay-1 { transition-delay: 90ms; }
  .career-delay-2 { transition-delay: 180ms; }
  .career-delay-3 { transition-delay: 270ms; }
  .career-delay-4 { transition-delay: 360ms; }
  .career-delay-5 { transition-delay: 450ms; }

  /* Floating Levitation on Hero Visual */
  @keyframes careerFloatLevitation {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .career-float {
    animation: careerFloatLevitation 6.5s ease-in-out infinite;
  }

  /* Center-Aligned Continuous Radiant Color Shimmer Sweep */
  .service-shimmer-center {
    background: linear-gradient(
      90deg,
      #0F274A 0%,
      #1E40AF 22%,
      #2563EB 42%,
      #DC2626 58%,
      #EF4444 72%,
      #0F274A 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    will-change: background-position;
    width: fit-content;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
    padding-bottom: 0.16em;
    padding-top: 0.05em;
    overflow: visible;
  }

  /* Inline Left-Aligned Continuous Radiant Color Shimmer Sweep */
  .service-shimmer-inline {
    background: linear-gradient(
      90deg,
      #0F274A 0%,
      #1E40AF 22%,
      #2563EB 42%,
      #DC2626 58%,
      #EF4444 72%,
      #0F274A 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    will-change: background-position;
    display: inline;
    padding-bottom: 0.16em;
    padding-top: 0.05em;
  }

  .service-shimmer-line-1 {
    animation: servicePageShimmer1 9.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @keyframes servicePageShimmer1 {
    0% { background-position: 0% 50%; }
    48% { background-position: 100% 50%; }
    52% { background-position: 100% 50%; }
    100% { background-position: 200% 50%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .career-reveal {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
      transition: none !important;
    }
    .career-float {
      animation: none !important;
    }
    .service-shimmer-center {
      animation: none !important;
      background: none !important;
      -webkit-text-fill-color: #0F274A !important;
      color: #0F274A !important;
    }
  }
</style>

<!-- ========================================================================= -->
<!-- CLIENT SCRIPTS: ACCORDION ANIMATION, FORM SUBMISSION & SCROLL OBSERVER    -->
<!-- ========================================================================= -->
<script>
  function initCareerPage() {
    // 1. Smooth Accordion Handling with CSS Grid Rows
    document.querySelectorAll('.faq-toggle').forEach((button) => {
      button.addEventListener('click', () => {
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        const answerId = button.getAttribute('aria-controls');
        const panel = document.getElementById(answerId || '');
        const icon = button.querySelector('.faq-icon');

        if (isExpanded) {
          button.setAttribute('aria-expanded', 'false');
          panel?.classList.remove('grid-rows-[1fr]');
          panel?.classList.add('grid-rows-[0fr]');
          icon?.classList.remove('rotate-180', 'bg-red-50', 'text-[#FF3130]');
        } else {
          button.setAttribute('aria-expanded', 'true');
          panel?.classList.remove('grid-rows-[0fr]');
          panel?.classList.add('grid-rows-[1fr]');
          icon?.classList.add('rotate-180', 'bg-red-50', 'text-[#FF3130]');
        }
      });
    });

    // 2. Viewport Scroll-Reveal Observer (Matching about-us.astro)
    const revealElements = document.querySelectorAll<HTMLElement>('.career-reveal');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reducedMotion || !('IntersectionObserver' in window)) {
      revealElements.forEach((el) => el.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver(
        (entries, currentObserver) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            currentObserver.unobserve(entry.target);
          });
        },
        { rootMargin: '0px 0px -6% 0px', threshold: 0.1 }
      );

      revealElements.forEach((el) => observer.observe(el));
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCareerPage, { once: true });
  } else {
    initCareerPage();
  }
  document.addEventListener('astro:page-load', initCareerPage);
</script>
