      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
      transition: none !important;
    }

    .service-radar-card::before,
    .service-radar-card::after,
    .service-radar-icon::before,
    .service-radar-scan {
      display: none !important;
    }

    .capabilities-track {
      transition: none !important;
    }

    .process-timeline::before {
      transform: scaleY(1) !important;
    }
  }
</style>

<script>
  function initServiceRadarCards() {
    const supportsHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!supportsHover || reducedMotion) return;

    document.querySelectorAll<HTMLElement>('[data-service-radar]').forEach((card) => {
      if (card.dataset.radarInitialized === 'true') return;
      card.dataset.radarInitialized = 'true';

      card.addEventListener('pointermove', (event) => {
        const bounds = card.getBoundingClientRect();
        card.style.setProperty('--spot-x', `${event.clientX - bounds.left}px`);
        card.style.setProperty('--spot-y', `${event.clientY - bounds.top}px`);
      });

      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--spot-x', '50%');
        card.style.setProperty('--spot-y', '50%');
      });
    });
  }

  function initCapabilitiesCarousel() {
    const carousel = document.querySelector<HTMLElement>('[data-capabilities-carousel]');
    if (!carousel || carousel.dataset.initialized === 'true') return;

    const track = carousel.querySelector<HTMLElement>('[data-capabilities-track]');
    const viewport = carousel.querySelector<HTMLElement>('[data-capabilities-viewport]');
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-capability-slide]'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-capability-dot]'));
    const previousButton = carousel.querySelector<HTMLButtonElement>('[data-capability-prev]');
    const nextButton = carousel.querySelector<HTMLButtonElement>('[data-capability-next]');
    const status = carousel.querySelector<HTMLElement>('[data-capability-status]');

    if (!track || !viewport || slides.length === 0) return;

    carousel.dataset.initialized = 'true';
    let currentIndex = 0;
    let touchStartX: number | undefined;
    let suppressClick = false;

    function showSlide(nextIndex: number) {
      currentIndex = (nextIndex + slides.length) % slides.length;
      track.style.transform = `translate3d(-${currentIndex * 100}%, 0, 0)`;

      slides.forEach((slide, index) => {
        const isCurrent = index === currentIndex;
        slide.setAttribute('aria-hidden', String(!isCurrent));
        slide.toggleAttribute('inert', !isCurrent);
      });

      dots.forEach((dot, index) => {
        const isCurrent = index === currentIndex;
        dot.classList.toggle('is-active', isCurrent);
        if (isCurrent) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });

      if (status) status.textContent = `${currentIndex + 1} / ${slides.length}`;
    }

    previousButton?.addEventListener('click', () => showSlide(currentIndex - 1));
    nextButton?.addEventListener('click', () => showSlide(currentIndex + 1));

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = Number.parseInt(dot.dataset.capabilityDot ?? '0', 10);
        showSlide(index);
      });
    });

    carousel.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      showSlide(currentIndex + (event.key === 'ArrowRight' ? 1 : -1));
    });

    viewport.addEventListener('touchstart', (event) => {
      touchStartX = event.touches[0]?.clientX;
    }, { passive: true });

    viewport.addEventListener('touchend', (event) => {
      if (touchStartX === undefined) return;
      const touchEndX = event.changedTouches[0]?.clientX ?? touchStartX;
      const distance = touchEndX - touchStartX;
      touchStartX = undefined;

      if (Math.abs(distance) < 50) return;
      suppressClick = true;
      showSlide(currentIndex + (distance < 0 ? 1 : -1));
      window.setTimeout(() => { suppressClick = false; }, 250);
    }, { passive: true });

    viewport.addEventListener('click', (event) => {
      if (!suppressClick) return;
      event.preventDefault();
      event.stopPropagation();
    }, true);

    showSlide(0);
  }

  function initTimelineFocusStates() {
    const processTimelines = document.querySelectorAll<HTMLElement>('.process-timeline');
    processTimelines.forEach((timeline) => {
      const cards = timeline.querySelectorAll<HTMLElement>('.timeline-card');
      cards.forEach((card) => {
        card.addEventListener('mouseenter', () => {
          timeline.classList.add('has-card-hover');
          card.classList.add('is-card-focused');
          card.closest('.timeline-step')?.classList.add('is-active-step');
        });
        card.addEventListener('mouseleave', () => {
          timeline.classList.remove('has-card-hover');
          card.classList.remove('is-card-focused');
          timeline.querySelectorAll('.timeline-step').forEach((s) => s.classList.remove('is-active-step'));
        });
      });
    });
  }

  function initAboutPage() {
    initServiceRadarCards();
    initCapabilitiesCarousel();
    initTimelineFocusStates();

    const elements = document.querySelectorAll<HTMLElement>(
      '.about-reveal, .about-scroll-region :is(h2, h3, h4, p, dt, dd)'
    );
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function animateMetric(element: HTMLElement) {
      const value = element.dataset.metricValue;
      const match = value?.match(/\d+/);
      if (!value || !match || element.dataset.counted === 'true') return;

      element.dataset.counted = 'true';

      if (reducedMotion) {
        element.textContent = value;
        return;
      }

      const target = Number.parseInt(match[0], 10);
      const prefix = value.slice(0, match.index);
      const suffix = value.slice((match.index ?? 0) + match[0].length);
      const duration = 1400;
      let startTime: number | undefined;

      element.textContent = `${prefix}0${suffix}`;

      function step(timestamp: number) {
        startTime ??= timestamp;
        const progress = Math.min((timestamp - startTime) / duration, 1);
        const easedProgress = 1 - Math.pow(1 - progress, 3);
        element.textContent = `${prefix}${Math.floor(target * easedProgress)}${suffix}`;

        if (progress < 1) {
          requestAnimationFrame(step);
        } else {
          element.textContent = value;
        }
      }

      requestAnimationFrame(step);
    }

    if (reducedMotion || !('IntersectionObserver' in window)) {
      elements.forEach((element) => {
        element.classList.add('is-visible');
        if (element.classList.contains('about-count')) animateMetric(element);
      });
      return;
    }

    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        if (entry.target.classList.contains('about-count')) {
          animateMetric(entry.target as HTMLElement);
        }
        currentObserver.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });

    elements.forEach((element) => observer.observe(element));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAboutPage, { once: true });
  } else {
    initAboutPage();
  }
</script>
