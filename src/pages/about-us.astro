---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MetricsGrid from '../components/MetricsGrid.astro';
import AgencyLogos from '../components/AgencyLogos.astro';
import { companyInfo } from '../data/company';

const values = [
  {
    title: 'Client First',
    desc: 'Our client engagement model emphasizes listening, assessment, and strategic alignment before execution, positioning clients for measurable progress.',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
  },
  {
    title: 'Integrity & Transparency',
    desc: 'We maintain clear communication, defensible documentation, and rigorous accountability throughout every proposal and contract engagement.',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    title: 'Innovation',
    desc: 'Combining modern digital tools and systematic capture methodologies with deep federal procurement knowledge.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
  {
    title: 'Quality Excellence',
    desc: 'Every proposal volume, compliance matrix, and candidate screening is built to withstand rigorous federal evaluation and audit scrutiny.',
    icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z',
  },
  {
    title: 'Long-Term Partnerships',
    desc: 'Dedicated to delivering lasting value, ensuring enduring client relationships, and driving sustained revenue growth across contract lifecycles.',
    icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z',
  },
];
---

<MainLayout
  title="About Unity Compass | Government Contracting Experts"
  description="Learn about Unity Compass, a trusted partner delivering consulting, staffing, and proposal development to empower federal contractors and commercial firms."
>
  <!-- Page Header / Hero -->
  <section class="bg-gradient-to-b from-slate-900 to-brand-dark text-white py-16 sm:py-20 border-b border-slate-800 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-brand-red/20 text-red-400 border border-brand-red/30 mb-4">
          Corporate Identity & Expertise
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight">
          About Unity Compass
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
          A government contracting consulting and staffing firm dedicated to helping commercial businesses and federal contractors compete, qualify, and perform in complex federal environments.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <Button href="/contact" variant="primary" size="md">
            Schedule a Consultation
          </Button>
          <a
            href={companyInfo.capabilityPdf}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-semibold text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 transition-colors"
          >
            <svg class="w-4 h-4 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Capability Statement (PDF)</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Who We Are Editorial Section -->
  <section class="py-16 sm:py-24 bg-white" aria-labelledby="whoweare-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        
        <!-- Left: Who We Are Content -->
        <div class="lg:col-span-7 space-y-6">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-brand-red">Executive Overview</span>
            <h2 id="whoweare-heading" class="text-3xl font-extrabold text-slate-900 tracking-tight mt-1">
              Who We Are
            </h2>
          </div>

          <div class="space-y-4 text-slate-600 leading-relaxed">
            <p>
              Unity Compass is a government contracting consulting and staffing firm dedicated to helping commercial businesses and federal contractors compete, qualify, and perform in complex federal environments.
            </p>
            <p>
              We specialize in proposal development, OASIS+ readiness support, cleared and non-cleared recruitment, staffing solutions, and IT & program consulting. Our approach is structured, compliance-driven, and built around defensible documentation, because in federal contracting, precision determines outcomes.
            </p>
            <p>
              We work with primes, subcontractors, and growth-stage firms seeking to strengthen their federal footprint, improve proposal quality, and accelerate contract execution through reliable talent acquisition and advisory support.
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100">
            <h3 class="text-xl font-bold text-slate-900 tracking-tight mb-2">
              Strategic Support for Federal and Commercial Growth
            </h3>
            <p class="text-slate-600 leading-relaxed">
              Unity Compass is a consulting and workforce solutions firm supporting commercial organizations and federal contractors in navigating complex, competitive environments. We provide focused expertise across Information Technology consulting, proposal development, staffing, and recruitment, helping organizations strengthen their capabilities, expand their footprint, and execute with confidence.
            </p>
            <p class="text-slate-600 leading-relaxed mt-3">
              Our approach is practical and results-driven. Rather than offering generic solutions, we work closely with each client to understand their operational structure, workforce requirements, and strategic objectives. This enables us to deliver solutions that are structured, aligned, and sustainable.
            </p>
          </div>
        </div>

        <!-- Right: Mission & Vision Card -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-slate-50 rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-subtle space-y-6">
            <!-- Mission -->
            <div class="space-y-2">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-red-100 text-brand-red flex items-center justify-center font-bold">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                </div>
                <h3 class="text-lg font-bold text-slate-900 uppercase tracking-tight">Our Mission</h3>
              </div>
              <p class="text-sm text-slate-600 leading-relaxed pl-10">
                To empower businesses with innovative solutions, exceptional talent, and strategic support to achieve their goals in the government marketplace.
              </p>
            </div>

            <div class="border-t border-slate-200"></div>

            <!-- Vision -->
            <div class="space-y-2">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-brand-navy/10 text-brand-navy flex items-center justify-center font-bold">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                </div>
                <h3 class="text-lg font-bold text-slate-900 uppercase tracking-tight">Our Vision</h3>
              </div>
              <p class="text-sm text-slate-600 leading-relaxed pl-10">
                To be a trusted partner for organizations seeking to make a meaningful impact across federal, state, and local markets.
              </p>
            </div>

            <div class="border-t border-slate-200"></div>

            <!-- Headquarters info -->
            <div class="text-xs text-slate-500 pl-10">
              <p class="font-semibold text-slate-800">Corporate Office</p>
              <p>{companyInfo.address.full}</p>
              <p class="mt-1">Inquiries: <a href={`mailto:${companyInfo.email}`} class="text-brand-navy font-semibold">{companyInfo.email}</a></p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Our Team & Multidisciplinary Expertise -->
  <section class="py-16 sm:py-24 bg-slate-50 border-t border-slate-200/80" aria-labelledby="team-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Multidisciplinary Model"
        title="Our Team and Expertise"
        description="Unity Compass is built on a foundation of experienced professionals with backgrounds in engineering, technical consulting, federal contracting support, and talent acquisition."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="gov-card">
          <div class="w-12 h-12 rounded-xl bg-brand-navy/10 text-brand-navy flex items-center justify-center mb-5">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 tracking-tight">
            Engineering Expertise
          </h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">
            Technical specialists delivering structured analysis, system evaluations, cybersecurity architecture, and mission-focused implementation support.
          </p>
        </div>

        <div class="gov-card">
          <div class="w-12 h-12 rounded-xl bg-brand-red/10 text-brand-red flex items-center justify-center mb-5">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 tracking-tight">
            Consulting & Strategic Advisory
          </h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">
            Experienced GovCon consultants helping organizations strengthen proposals, optimize operational workflows, and compete effectively for multi-million dollar vehicles.
          </p>
        </div>

        <div class="gov-card">
          <div class="w-12 h-12 rounded-xl bg-brand-navy/10 text-brand-navy flex items-center justify-center mb-5">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 tracking-tight">
            Recruitment & Workforce Solutions
          </h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">
            Talent specialists sourcing cleared and non-cleared professionals across all clearance levels (Secret, TS/SCI, Polygraph) to support critical program execution.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Values Grid -->
  <section class="py-16 sm:py-24 bg-white" aria-labelledby="values-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Corporate Values"
        title="Our Principles and Standards"
        description="The enduring values that guide our interactions, contract delivery, and partnerships with government agencies and defense primes."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {values.map((val) => (
          <div class="p-6 rounded-xl border border-slate-200 bg-white hover:border-slate-300 transition-colors shadow-subtle">
            <div class="w-10 h-10 rounded-lg bg-red-50 text-brand-red flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={val.icon} />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 tracking-tight">{val.title}</h3>
            <p class="mt-2 text-xs sm:text-sm text-slate-600 leading-relaxed">{val.desc}</p>
          </div>
        ))}

        <!-- Professional Standards Feature Box -->
        <div class="p-6 rounded-xl border border-brand-navy/20 bg-brand-navy text-white flex flex-col justify-between">
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-red-300">Code of Conduct</span>
            <h3 class="text-lg font-bold text-white mt-1">Commitment to Professional Standards</h3>
            <p class="mt-2 text-xs sm:text-sm text-slate-200 leading-relaxed">
              Unity Compass operates with integrity, discipline, and a strong commitment to quality. We uphold high standards in every engagement to remain your most trusted GovCon ally.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-white/10 text-xs text-slate-300">
            Federal FAR & DFARS Alignment
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Verified Metrics -->
  <MetricsGrid />

  <!-- Agency Support Seals -->
  <AgencyLogos />
</MainLayout>

