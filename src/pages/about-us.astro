---
import MainLayout from '../layouts/MainLayout.astro';
import { companyInfo, verifiedMetrics } from '../data/company';

const canonicalUrl = 'https://unitycompass.com/about-us';
const meetingUrl = 'https://meetings.hubspot.com/unity-compass/gov-con-expert';

const differentiators = [
  {
    number: '01',
    title: 'GovCon Experience',
    description: 'More than a decade of Government Business Development Capture experience informs every pursuit and delivery decision.',
    icon: 'M12 3l7 3v5c0 4.8-2.9 8-7 10-4.1-2-7-5.2-7-10V6l7-3zm-3 9 2 2 4-4',
  },
  {
    number: '02',
    title: 'Solutions Built Around You',
    description: 'We align strategy, talent, and technical support to each client’s goals instead of forcing a generic delivery model.',
    icon: 'M12 2a10 10 0 100 20 10 10 0 000-20zm0 6v4l3 2',
  },
  {
    number: '03',
    title: 'Reliable, Measurable Delivery',
    description: 'Clear ownership, rigorous compliance, and disciplined review keep deliverables credible, timely, and ready for scrutiny.',
    icon: 'M4 12l5 5L20 6',
  },
] as const;

const proposalOutcomes = [
  {
    title: 'Tailored content',
    description: 'Persuasive responses aligned to the RFP, your value proposition, and evaluator priorities.',
  },
  {
    title: 'Compliance',
    description: 'Documentation and formatting checked against agency instructions and evaluation standards.',
  },
  {
    title: 'Collaboration',
    description: 'Structured coordination with subject-matter experts and stakeholders for accuracy and cohesion.',
  },
  {
    title: 'Higher win potential',
    description: 'Meticulous planning and review designed to reduce rework and strengthen proposal quality.',
  },
] as const;

const deliverySteps = [
  {
    number: '01',
    title: 'Opportunity Search',
    description: 'Discover and pursue opportunities that align with your capabilities, goals, and growth strategy.',
  },
  {
    number: '02',
    title: 'Go/No-Go Analysis',
    description: 'Evaluate fit, competitiveness, resources, and risk so your team can make an informed pursuit decision.',
  },
  {
    number: '03',
    title: 'Proposal Development',
    description: 'Build the executive summary, technical approach, management plan, and pricing narrative around one clear strategy.',
  },
  {
    number: '04',
    title: 'Response and Review',
    description: 'Validate compliance, strengthen the story, and review every volume against the highest evaluation standards.',
  },
  {
    number: '05',
    title: 'Submission',
    description: 'Package and deliver a complete, credible response on time and in the required format.',
  },
] as const;

const companyValues = [
  'Client First',
  'Integrity & Transparency',
  'Innovation',
  'Quality Excellence',
  'Long-Term Partnerships',
] as const;

const performanceMetrics = verifiedMetrics.slice(0, 5);

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${canonicalUrl}#about-page`,
  url: canonicalUrl,
  name: 'About Unity Compass',
  description: 'Learn how Unity Compass aligns technical consulting, federal advisory, and workforce solutions to help government contractors compete, hire, and deliver.',
  isPartOf: {
    '@id': 'https://unitycompass.com/#website',
  },
  about: {
    '@id': 'https://unitycompass.com/#organization',
  },
};
---

<MainLayout
  title="About Unity Compass | Federal Consulting & Workforce Partner"
  description="Unity Compass helps government contractors compete, hire, and deliver through technical consulting, federal advisory, proposal support, and cleared staffing."
  canonicalUrl={canonicalUrl}
  ogImage="/images/about-hero-1600.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(aboutPageSchema)} />
  <noscript><style>.about-reveal { opacity: 1 !important; transform: none !important; }</style></noscript>

  <header class="about-hero relative isolate overflow-hidden bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8]">
    <div class="absolute inset-0 about-grid opacity-50" aria-hidden="true"></div>
    <div class="absolute -left-32 top-16 h-80 w-80 rounded-full bg-blue-300/20 blur-3xl" aria-hidden="true"></div>
    <div class="absolute -right-24 bottom-0 h-72 w-72 rounded-full bg-red-300/10 blur-3xl" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto grid max-w-7xl items-center gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[0.92fr_1.08fr] lg:gap-14 lg:px-8 lg:py-20">
      <div class="about-hero-copy max-w-3xl">
        <h1 class="max-w-2xl text-4xl font-extrabold leading-[1.08] tracking-[-0.04em] text-[#0F274A] sm:text-5xl lg:text-[3.8rem]">
          A practical partner for <span class="about-gradient-text">federal work.</span>
        </h1>
        <p class="mt-6 max-w-xl text-base leading-8 text-slate-600 sm:text-lg">
          We help contractors compete, hire, and deliver in regulated environments.
        </p>

        <dl class="mt-10 grid max-w-xl grid-cols-2 gap-x-6 gap-y-4 border-t border-[#0C487A]/15 pt-6 sm:grid-cols-3">
          <div>
            <dt class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Focus</dt>
            <dd class="mt-1 text-sm font-semibold text-[#0F274A]">Federal delivery</dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Model</dt>
            <dd class="mt-1 text-sm font-semibold text-[#0F274A]">Integrated support</dd>
          </div>
          <div class="col-span-2 sm:col-span-1">
            <dt class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Based in</dt>
            <dd class="mt-1 text-sm font-semibold text-[#0F274A]">Frederick, Maryland</dd>
          </div>
        </dl>
      </div>

      <div class="about-hero-art relative mx-auto w-full max-w-2xl" aria-hidden="true">
        <div class="absolute inset-x-[12%] bottom-[5%] h-[24%] rounded-full bg-[#0C487A]/15 blur-3xl"></div>
        <img
          src="/images/about-hero-960.webp"
          srcset="/images/about-hero-480.webp 480w, /images/about-hero-960.webp 960w, /images/about-hero-1600.webp 1600w"
          sizes="(min-width: 1280px) 672px, (min-width: 1024px) 52vw, 100vw"
          alt=""
          width="1600"
          height="900"
          fetchpriority="high"
          decoding="async"
          class="about-float relative h-auto w-full object-contain drop-shadow-[0_24px_22px_rgba(15,39,74,0.14)]"
        />
      </div>
    </div>
  </header>

  <section class="bg-white py-20 sm:py-24 lg:py-28" aria-labelledby="company-heading">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[1.08fr_0.92fr] lg:gap-16 lg:px-8">
      <div class="about-reveal">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#FF3130]">Who we are</p>
        <h2 id="company-heading" class="mt-3 max-w-2xl text-3xl font-extrabold leading-tight tracking-[-0.035em] text-[#0F274A] sm:text-4xl">
          Strategy, talent, and delivery under one roof
        </h2>
        <div class="mt-5 h-1.5 w-20 rounded-full bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130]" aria-hidden="true"></div>

        <div class="mt-8 max-w-3xl space-y-5 text-base leading-8 text-slate-600 sm:text-lg">
          <p>
            Unity Compass specializes in IT and business consulting, staffing, recruitment, proposal development, and digital solutions for commercial and federal clients. We combine deep government contracting expertise with a client-first approach to deliver measurable results and lasting partnerships.
          </p>
          <p>
            We work with primes, subcontractors, and growth-stage firms that need to strengthen their federal footprint, secure critical talent, and perform with confidence in regulated environments.
          </p>
          <p>
            Proposal development is one of our core strengths. With more than 10 years of Government Business Development Capture experience, our team can manage the RFP lifecycle from opportunity and pricing strategy through compliant submission.
          </p>
        </div>
      </div>

      <aside class="about-reveal about-delay-1 rounded-3xl border border-slate-200 bg-[#F4F8FC] p-6 shadow-[0_20px_50px_-28px_rgba(15,39,74,0.35)] sm:p-8" aria-labelledby="proposal-outcomes-heading">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#0C487A]">Proposal advantage</p>
        <h3 id="proposal-outcomes-heading" class="mt-3 text-2xl font-extrabold tracking-tight text-[#0F274A]">
          Credible responses, built to withstand scrutiny
        </h3>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-1" role="list">
          {proposalOutcomes.map((outcome) => (
            <li class="rounded-xl border border-white bg-white/90 p-4 shadow-sm">
              <div class="flex gap-3">
                <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#FF3130] text-white" aria-hidden="true">
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 12l4 4L19 6" /></svg>
                </span>
                <div>
                  <h4 class="font-bold text-[#0F274A]">{outcome.title}</h4>
                  <p class="mt-1 text-sm leading-6 text-slate-600">{outcome.description}</p>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <section class="relative overflow-hidden border-y border-slate-200/80 bg-[#F4F8FC] py-20 sm:py-24 lg:py-28" aria-labelledby="why-heading">
    <div class="absolute inset-0 about-grid opacity-35" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="about-reveal mx-auto mb-12 max-w-3xl text-center sm:mb-16">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#FF3130]">Why Unity Compass</p>
        <h2 id="why-heading" class="mt-3 text-3xl font-extrabold tracking-[-0.035em] text-[#0F274A] sm:text-4xl">
          Built for complex, competitive environments
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg">
          The depth to understand the requirement, the flexibility to fit your organization, and the discipline to deliver.
        </p>
      </div>

      <ul class="grid gap-5 md:grid-cols-3" role="list">
        {differentiators.map((item, index) => (
          <li class={`about-reveal about-delay-${index + 1} group relative overflow-hidden rounded-2xl border border-slate-200/90 bg-white p-7 shadow-[0_16px_45px_-24px_rgba(15,39,74,0.3)] transition duration-300 hover:-translate-y-1.5 hover:border-[#0C487A]/30 hover:shadow-[0_24px_50px_-22px_rgba(15,39,74,0.35)] sm:p-8`}>
            <span class="absolute right-6 top-5 text-sm font-extrabold tracking-[0.12em] text-slate-200 transition-colors duration-300 group-hover:text-[#FF3130]/25" aria-hidden="true">{item.number}</span>
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-[#0C487A] text-white shadow-[0_8px_22px_-8px_rgba(12,72,122,0.7)] transition duration-300 group-hover:scale-105 group-hover:bg-[#FF3130]">
              <svg class="h-6 w-6" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={item.icon} /></svg>
            </div>
            <h3 class="mt-7 text-xl font-extrabold tracking-tight text-[#0F274A] sm:text-2xl">{item.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-600 sm:text-base">{item.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="relative overflow-hidden border-b border-slate-200/80 bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] py-14 sm:py-16" aria-label="Unity Compass performance highlights">
    <div class="absolute inset-0 about-grid opacity-35" aria-hidden="true"></div>
    <div class="absolute left-1/2 top-1/2 h-48 w-4/5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(ellipse,rgba(40,121,182,0.12)_0%,transparent_70%)] blur-3xl" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="about-reveal rounded-3xl border border-slate-200/90 bg-white/90 px-5 py-7 shadow-[0_18px_45px_-20px_rgba(15,39,74,0.22),0_0_0_1px_rgba(255,255,255,0.9)_inset] backdrop-blur-xl sm:px-8 sm:py-9 lg:px-10">
        <dl class="grid grid-cols-2 gap-x-4 gap-y-7 md:grid-cols-5 md:gap-0">
          {performanceMetrics.map((metric, index) => (
            <div class={`about-reveal about-delay-${Math.min(index + 1, 5)} relative px-2 py-2 text-center sm:px-4 ${index > 0 ? 'md:border-l md:border-slate-200' : ''} ${index === performanceMetrics.length - 1 ? 'col-span-2 md:col-span-1' : ''}`}>
              <dd class="text-3xl font-extrabold tracking-tight text-[#0F274A] sm:text-4xl">
                {metric.value}
              </dd>
              <span class="mx-auto mt-3 block h-1 w-8 rounded-full bg-[#FF3130]" aria-hidden="true"></span>
              <dt class="mt-3 text-xs font-bold uppercase leading-5 tracking-[0.1em] text-slate-600">{metric.label}</dt>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-white py-20 sm:py-24 lg:py-28" aria-labelledby="process-heading">
    <div class="absolute inset-0 about-grid opacity-25" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="about-reveal mx-auto max-w-3xl text-center">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#FF3130]">How we deliver</p>
        <h2 id="process-heading" class="mt-3 text-3xl font-extrabold tracking-[-0.035em] text-[#0F274A] sm:text-4xl lg:text-5xl">
          From the right opportunity to a ready submission
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg">
          A disciplined proposal process keeps decisions clear, contributors aligned, and every response focused on what evaluators need to see.
        </p>
      </div>

      <ol class="process-timeline about-reveal mt-16" role="list">
        {deliverySteps.map((step, index) => (
          <li class={`timeline-step about-reveal about-delay-${Math.min(index + 1, 5)}`}>
            <span class="timeline-node" aria-hidden="true">{step.number}</span>
            <article class="timeline-card">
              <p class="text-xs font-bold uppercase tracking-[0.15em] text-[#FF3130]">Step {step.number}</p>
              <h3 class="mt-2 text-xl font-extrabold text-[#0F274A] sm:text-2xl">{step.title}</h3>
              <p class="mt-3 text-sm leading-7 text-slate-600 sm:text-base">{step.description}</p>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="relative overflow-hidden border-y border-slate-200/80 bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] py-20 sm:py-24 lg:py-28" aria-labelledby="purpose-heading">
    <div class="absolute inset-0 about-grid opacity-35" aria-hidden="true"></div>
    <div class="absolute -right-40 -top-40 h-96 w-96 rounded-full bg-blue-400/15 blur-3xl" aria-hidden="true"></div>
    <div class="absolute -bottom-40 -left-40 h-96 w-96 rounded-full bg-red-300/10 blur-3xl" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="about-reveal max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#FF3130]">Mission, vision, and values</p>
        <h2 id="purpose-heading" class="mt-3 text-3xl font-extrabold tracking-[-0.035em] text-[#0F274A] sm:text-4xl">What guides the work</h2>
        <div class="mt-5 h-1.5 w-20 rounded-full bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130]" aria-hidden="true"></div>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        <article class="about-reveal group relative overflow-hidden rounded-2xl border border-slate-200/90 bg-white/95 p-7 shadow-[0_18px_45px_-24px_rgba(15,39,74,0.28)] backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-[#0C487A]/25 hover:shadow-[0_24px_50px_-22px_rgba(15,39,74,0.34)] sm:p-8">
          <span class="absolute inset-y-0 left-0 w-1.5 bg-gradient-to-b from-[#0C487A] to-[#1E40AF]" aria-hidden="true"></span>
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#FF3130]">Our mission</p>
          <h3 class="mt-3 text-xl font-bold text-[#0F274A] sm:text-2xl">Empower organizations to compete and perform</h3>
          <p class="mt-4 leading-7 text-slate-600">To empower businesses with innovative solutions, exceptional talent, and strategic support to achieve their goals in the government marketplace.</p>
        </article>
        <article class="about-reveal about-delay-1 group relative overflow-hidden rounded-2xl border border-slate-200/90 bg-white/95 p-7 shadow-[0_18px_45px_-24px_rgba(15,39,74,0.28)] backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:border-[#0C487A]/25 hover:shadow-[0_24px_50px_-22px_rgba(15,39,74,0.34)] sm:p-8">
          <span class="absolute inset-y-0 left-0 w-1.5 bg-gradient-to-b from-[#FF3130] to-[#DC2626]" aria-hidden="true"></span>
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#FF3130]">Our vision</p>
          <h3 class="mt-3 text-xl font-bold text-[#0F274A] sm:text-2xl">Be the partner trusted for meaningful impact</h3>
          <p class="mt-4 leading-7 text-slate-600">To be a trusted partner for organizations seeking to make a meaningful impact across federal, state, and local markets.</p>
        </article>
      </div>

      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-5" aria-label="Unity Compass values" role="list">
        {companyValues.map((value, index) => (
          <li class={`about-reveal about-delay-${Math.min(index + 1, 5)} flex min-h-20 items-center rounded-xl border border-slate-200/90 bg-white/90 px-4 py-4 text-sm font-bold leading-6 text-[#0F274A] shadow-[0_10px_28px_-22px_rgba(15,39,74,0.3)] backdrop-blur-md transition duration-300 hover:-translate-y-1 hover:border-[#0C487A]/25 hover:bg-white`}>
            <span class="mr-3 h-2 w-2 shrink-0 rounded-full bg-[#FF3130]" aria-hidden="true"></span>{value}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="relative overflow-hidden bg-white py-20 sm:py-24" aria-labelledby="conversation-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="about-reveal relative overflow-hidden rounded-3xl border border-slate-200 bg-gradient-to-br from-[#F4F8FC] via-white to-[#EBF3FA] px-6 py-12 shadow-[0_24px_60px_-30px_rgba(15,39,74,0.35)] sm:px-10 sm:py-14 lg:flex lg:items-center lg:justify-between lg:gap-12 lg:px-14">
        <div class="absolute -right-20 -top-28 h-72 w-72 rounded-full border-[48px] border-[#0C487A]/5" aria-hidden="true"></div>
        <div class="relative max-w-2xl">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#FF3130]">Your next move</p>
          <h2 id="conversation-heading" class="mt-3 text-3xl font-extrabold leading-tight tracking-[-0.035em] text-[#0F274A] sm:text-4xl">
            Bring the challenge. We’ll help define the path forward.
          </h2>
          <p class="mt-4 text-base leading-7 text-slate-600">
            Talk with our team about your next pursuit, critical hire, or delivery priority.
          </p>
        </div>
        <div class="relative mt-8 flex shrink-0 flex-col gap-3 sm:flex-row lg:mt-0 lg:flex-col xl:flex-row">
          <a
            href={meetingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex min-h-12 items-center justify-center gap-2.5 rounded-xl bg-[#0C487A] px-6 py-3 text-sm font-bold text-white shadow-[0_10px_26px_-10px_rgba(12,72,122,0.7)] transition duration-300 hover:-translate-y-0.5 hover:bg-[#0A2540] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FF3130]"
          >
            Talk with our team
            <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.25" d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </a>
          <a
            href={`mailto:${companyInfo.email}`}
            class="inline-flex min-h-12 items-center justify-center rounded-xl border border-[#0C487A]/20 bg-white px-6 py-3 text-sm font-bold text-[#0C487A] shadow-sm transition duration-300 hover:-translate-y-0.5 hover:border-[#0C487A]/40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0C487A]"
          >
            {companyInfo.email}
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .about-grid {
    background-size: 16px 16px;
    background-image:
      linear-gradient(to right, rgba(12, 72, 122, 0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(12, 72, 122, 0.08) 1px, transparent 1px);
  }

  .about-gradient-text {
    background: linear-gradient(100deg, #0C487A 5%, #1E40AF 40%, #FF3130 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .about-hero-copy {
    animation: aboutHeroIn 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .about-hero-art {
    animation: aboutHeroIn 1000ms cubic-bezier(0.16, 1, 0.3, 1) 120ms both;
  }

  .about-float {
    animation: aboutFloat 7s ease-in-out infinite;
  }

  .about-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 750ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 750ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .about-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .about-delay-1 { transition-delay: 80ms; }
  .about-delay-2 { transition-delay: 160ms; }
  .about-delay-3 { transition-delay: 240ms; }
  .about-delay-4 { transition-delay: 320ms; }
  .about-delay-5 { transition-delay: 400ms; }

  .process-timeline {
    position: relative;
    list-style: none;
    padding: 0;
  }

  .process-timeline::before {
    content: '';
    position: absolute;
    top: 1.5rem;
    bottom: 1.5rem;
    left: 1.5rem;
    width: 2px;
    background: linear-gradient(to bottom, #0C487A, #1E40AF 55%, #FF3130);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1) 180ms;
  }

  .process-timeline.is-visible::before {
    transform: scaleY(1);
  }

  .timeline-step {
    position: relative;
    min-height: 8rem;
    padding-left: 4.75rem;
  }

  .timeline-step:not(:last-child) {
    margin-bottom: 1.5rem;
  }

  .timeline-node {
    position: absolute;
    top: 1.25rem;
    left: 0;
    z-index: 2;
    display: flex;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    border: 5px solid white;
    border-radius: 9999px;
    background: #0C487A;
    box-shadow: 0 8px 24px -8px rgba(12, 72, 122, 0.55);
    color: white;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    transition: background-color 250ms ease, transform 250ms ease;
  }

  .timeline-card {
    border: 1px solid rgba(226, 232, 240, 0.95);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.96);
    padding: 1.5rem;
    box-shadow: 0 18px 45px -28px rgba(15, 39, 74, 0.38);
    transition: border-color 250ms ease, box-shadow 250ms ease, transform 250ms ease;
  }

  .timeline-step:hover .timeline-node {
    background: #FF3130;
    transform: scale(1.06);
  }

  .timeline-step:hover .timeline-card {
    border-color: rgba(12, 72, 122, 0.28);
    box-shadow: 0 24px 50px -25px rgba(15, 39, 74, 0.42);
    transform: translateY(-3px);
  }

  @media (min-width: 1024px) {
    .process-timeline::before {
      left: 50%;
      transform: translateX(-50%) scaleY(0);
    }

    .process-timeline.is-visible::before {
      transform: translateX(-50%) scaleY(1);
    }

    .timeline-step {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 6rem;
      min-height: 10rem;
      padding-left: 0;
    }

    .timeline-step:not(:last-child) {
      margin-bottom: 0.75rem;
    }

    .timeline-step:nth-child(odd) .timeline-card {
      grid-column: 1;
      text-align: right;
    }

    .timeline-step:nth-child(even) .timeline-card {
      grid-column: 2;
    }

    .timeline-node {
      left: 50%;
      transform: translateX(-50%);
    }

    .timeline-step:hover .timeline-node {
      transform: translateX(-50%) scale(1.06);
    }
  }

  @keyframes aboutHeroIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes aboutFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-hero-copy,
    .about-hero-art,
    .about-float,
    .about-reveal,
    .process-timeline::before,
    .timeline-node,
    .timeline-card {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    .process-timeline::before {
      transform: scaleY(1) !important;
    }
  }
</style>

<script>
  function initAboutPage() {
    const elements = document.querySelectorAll<HTMLElement>('.about-reveal');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reducedMotion || !('IntersectionObserver' in window)) {
      elements.forEach((element) => element.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        currentObserver.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });

    elements.forEach((element) => observer.observe(element));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAboutPage, { once: true });
  } else {
    initAboutPage();
  }
</script>
