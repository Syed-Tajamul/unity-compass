---
import {
  ArrowRight,
  Award,
  BadgeCheck,
  BriefcaseBusiness,
  ChevronLeft,
  ChevronRight,
  CircleDollarSign,
  FilePenLine,
  HandCoins,
  Handshake,
  HeartHandshake,
  Landmark,
  Layers3,
  Lightbulb,
  MapPin,
  MessageCircle,
  MonitorCog,
  PanelsTopLeft,
  Rocket,
  Route,
  Scale,
  ShieldCheck,
  ShoppingCart,
  SlidersHorizontal,
  Target,
  Telescope,
  TrendingUp,
  Trophy,
  UserRoundSearch,
  UsersRound,
} from 'lucide-astro';
import MainLayout from '../layouts/MainLayout.astro';
import { companyInfo, verifiedMetrics } from '../data/company';

const canonicalUrl = 'https://unitycompass.com/about-us';
const meetingUrl = 'https://meetings.hubspot.com/unity-compass/gov-con-expert';

const differentiators = [
  {
    number: '01',
    title: 'GovCon Experience',
    description: 'More than a decade of Government Business Development Capture experience informs every pursuit and delivery decision.',
    icon: ShieldCheck,
  },
  {
    number: '02',
    title: 'Solutions Built Around You',
    description: 'We align strategy, talent, and technical support to each client’s goals instead of forcing a generic delivery model.',
    icon: SlidersHorizontal,
  },
  {
    number: '03',
    title: 'Reliable, Measurable Delivery',
    description: 'Clear ownership, rigorous compliance, and disciplined review keep deliverables credible, timely, and ready for scrutiny.',
    icon: BadgeCheck,
  },
] as const;

const coreServices = [
  {
    number: '01',
    title: 'Proposal Development Services',
    description: 'End-to-end support from opportunity identification and capture strategy through compliant writing, review, and submission.',
    href: '/proposal-development-services',
    icon: FilePenLine,
  },
  {
    number: '02',
    title: 'Cleared Recruitment Services',
    description: 'Access to qualified cleared and non-cleared talent for federal, defense, and mission-critical programs.',
    href: '/recruitment-services',
    icon: UserRoundSearch,
  },
  {
    number: '03',
    title: 'Staffing Solutions',
    description: 'Contract, contract-to-hire, and direct-hire staffing models for commercial and government clients.',
    href: '/staffing',
    icon: BriefcaseBusiness,
  },
  {
    number: '04',
    title: 'IT & Business Consulting',
    description: 'Strategic technology and business solutions that improve efficiency, modernize operations, and support sustainable growth.',
    href: '/information-technology-and-business-consulting',
    icon: MonitorCog,
  },
  {
    number: '05',
    title: 'Website Designing Services',
    description: 'Modern, secure, and high-performing websites designed to strengthen your brand presence and digital experience.',
    href: `mailto:${companyInfo.email}?subject=Website%20Designing%20Services`,
    icon: PanelsTopLeft,
  },
  {
    number: '06',
    title: 'Grant Writing',
    description: 'Compelling, well-researched grant proposals developed to help organizations pursue and secure non-dilutive funding.',
    href: `mailto:${companyInfo.email}?subject=Grant%20Writing%20Services`,
    icon: HandCoins,
  },
] as const;

const capabilityGroups = [
  {
    label: 'Pursuit & Funding',
    title: 'Build credible paths to opportunity',
    services: [coreServices[0], coreServices[5]],
  },
  {
    label: 'Talent',
    title: 'Put the right people behind the mission',
    services: [coreServices[1], coreServices[2]],
  },
  {
    label: 'Technology & Growth',
    title: 'Modernize operations and digital presence',
    services: [coreServices[3], coreServices[4]],
  },
] as const;

const deliverySteps = [
  {
    number: '01',
    title: 'Connect and Discover',
    description: 'Meet with our experts to define your goals, constraints, priorities, and the outcomes that matter most.',
    icon: MessageCircle,
  },
  {
    number: '02',
    title: 'Strategize and Plan',
    description: 'Assess the requirement, align the right expertise, and build a practical roadmap with clear ownership and milestones.',
    icon: Route,
  },
  {
    number: '03',
    title: 'Execute and Deliver',
    description: 'Carry out the work with disciplined coordination, transparent communication, and rigorous quality control.',
    icon: Rocket,
  },
  {
    number: '04',
    title: 'Measure and Grow',
    description: 'Review results, refine the approach, and position your organization for stronger performance and sustained growth.',
    icon: TrendingUp,
  },
] as const;

const companyValues = [
  { title: 'Client First', icon: HeartHandshake },
  { title: 'Integrity & Transparency', icon: Scale },
  { title: 'Innovation', icon: Lightbulb },
  { title: 'Quality Excellence', icon: Award },
  { title: 'Long-Term Partnerships', icon: Handshake },
] as const;

const metricIcons = [Trophy, CircleDollarSign, Landmark, ShoppingCart, UsersRound];
const performanceMetrics = verifiedMetrics.slice(0, 5).map((metric, index) => ({
  ...metric,
  icon: metricIcons[index],
}));

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${canonicalUrl}#about-page`,
  url: canonicalUrl,
  name: 'About Unity Compass',
  description: 'Learn how Unity Compass aligns technical consulting, federal advisory, and workforce solutions to help government contractors compete, hire, and deliver.',
  isPartOf: {
    '@id': 'https://unitycompass.com/#website',
  },
  about: {
    '@id': 'https://unitycompass.com/#organization',
  },
};
---

<MainLayout
  title="About Unity Compass | Federal Consulting & Workforce Partner"
  description="Unity Compass helps government contractors compete, hire, and deliver through technical consulting, federal advisory, proposal support, and cleared staffing."
  canonicalUrl={canonicalUrl}
  ogImage="/images/about-hero-1600.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(aboutPageSchema)} />
  <noscript><style>.about-reveal, .about-scroll-region :is(h2, h3, h4, p, dt, dd) { opacity: 1 !important; transform: none !important; filter: none !important; }</style></noscript>

  <header class="about-hero relative isolate overflow-hidden bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8]">
    <div class="absolute inset-0 about-grid opacity-50" aria-hidden="true"></div>
    <div class="absolute -left-32 top-16 h-80 w-80 rounded-full bg-blue-300/20 blur-3xl" aria-hidden="true"></div>
    <div class="absolute -right-24 bottom-0 h-72 w-72 rounded-full bg-red-300/10 blur-3xl" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto grid max-w-7xl items-center gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[0.92fr_1.08fr] lg:gap-14 lg:px-8 lg:py-20">
      <div class="max-w-3xl">
        <h1 class="hero-heading-reveal max-w-2xl text-3xl font-extrabold leading-[1.16] tracking-tight text-[#0F274A] sm:text-4xl sm:leading-[1.18] lg:text-[2.75rem] xl:text-[3.15rem]">
          A practical partner for <span class="about-gradient-text">federal work.</span>
        </h1>
        <p class="hero-subheading-reveal mt-6 max-w-xl text-base leading-8 text-slate-600 sm:text-lg">
          We help contractors compete, hire, and deliver in regulated environments.
        </p>

        <dl class="hero-cta-reveal mt-10 grid max-w-xl grid-cols-2 gap-x-6 gap-y-4 border-t border-[#0C487A]/15 pt-6 sm:grid-cols-3">
          <div>
            <dt class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-[0.12em] text-slate-500">
              <Target class="h-3.5 w-3.5 text-[#0C487A]" aria-hidden="true" stroke-width={2.25} />
              Focus
            </dt>
            <dd class="mt-1 text-sm font-semibold text-[#0F274A]">Federal delivery</dd>
          </div>
          <div>
            <dt class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-[0.12em] text-slate-500">
              <Layers3 class="h-3.5 w-3.5 text-[#0C487A]" aria-hidden="true" stroke-width={2.25} />
              Model
            </dt>
            <dd class="mt-1 text-sm font-semibold text-[#0F274A]">Integrated support</dd>
          </div>
          <div class="col-span-2 sm:col-span-1">
            <dt class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-[0.12em] text-slate-500">
              <MapPin class="h-3.5 w-3.5 text-[#0C487A]" aria-hidden="true" stroke-width={2.25} />
              Based in
            </dt>
            <dd class="mt-1 text-sm font-semibold text-[#0F274A]">Frederick, Maryland</dd>
          </div>
        </dl>
      </div>

      <div class="about-hero-art relative mx-auto w-full max-w-2xl" aria-hidden="true">
        <div class="absolute inset-x-[12%] bottom-[5%] h-[24%] rounded-full bg-[#0C487A]/15 blur-3xl"></div>
        <img
          src="/images/about-hero-960.webp"
          srcset="/images/about-hero-480.webp 480w, /images/about-hero-960.webp 960w, /images/about-hero-1600.webp 1600w"
          sizes="(min-width: 1280px) 672px, (min-width: 1024px) 52vw, 100vw"
          alt=""
          width="1600"
          height="900"
          fetchpriority="high"
          decoding="async"
          class="about-float relative h-auto w-full object-contain drop-shadow-[0_24px_22px_rgba(15,39,74,0.14)]"
        />
      </div>
    </div>
  </header>

  <section class="about-scroll-region bg-white py-20 sm:py-24 lg:py-28" aria-labelledby="company-heading">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[1.02fr_0.98fr] lg:gap-16 lg:px-8">
      <div class="about-reveal max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#FF3130]">Who we are</p>
        <h2 id="company-heading" class="about-section-heading mt-3 max-w-2xl text-2xl font-extrabold leading-[1.18] tracking-tight sm:text-3xl sm:leading-[1.22] md:text-4xl lg:text-[2.65rem] lg:leading-[1.24]">
          One partner across strategy, talent, technology, and growth
        </h2>
        <div class="mt-5 h-1.5 w-20 rounded-full bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130]" aria-hidden="true"></div>

        <div class="mt-8 max-w-3xl space-y-5 text-base leading-8 text-slate-600 sm:text-lg">
          <p>
            Unity Compass provides proposal development, cleared recruitment, staffing solutions, IT and business consulting, website design, and grant writing for commercial organizations and government contractors.
          </p>
          <p>
            We work with primes, subcontractors, and growth-stage firms that need to strengthen their federal footprint, secure critical talent, and perform with confidence in regulated environments.
          </p>
          <p>
            Our integrated model connects strategy, people, technology, and communications so clients can move from opportunity to execution with one accountable partner.
          </p>
        </div>

        <dl class="mt-8 grid grid-cols-2 gap-4 border-t border-slate-200 pt-6 sm:grid-cols-3">
          <div>
            <dt class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Experience</dt>
            <dd class="mt-1 text-sm font-extrabold text-[#0B2553]">10+ years</dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Markets</dt>
            <dd class="mt-1 text-sm font-extrabold text-[#0B2553]">Federal & commercial</dd>
          </div>
          <div class="col-span-2 sm:col-span-1">
            <dt class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Approach</dt>
            <dd class="mt-1 text-sm font-extrabold text-[#0B2553]">Client first</dd>
          </div>
        </dl>
      </div>

      <aside
        class="capabilities-carousel about-reveal about-delay-1 overflow-hidden rounded-3xl border border-slate-200 bg-[#F4F8FC] shadow-[0_24px_60px_-30px_rgba(15,39,74,0.38)]"
        aria-label="Unity Compass service capabilities"
        aria-roledescription="carousel"
        role="region"
        data-capabilities-carousel
      >
        <div class="flex items-center justify-between border-b border-slate-200/90 px-5 py-5 sm:px-7">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#FF3130]">What we do</p>
            <p class="mt-1 text-sm font-semibold text-slate-600">Six connected capabilities</p>
          </div>
          <div class="flex items-center gap-2">
            <button type="button" class="capability-control" aria-label="Previous capability group" data-capability-prev>
              <ChevronLeft class="h-4 w-4" aria-hidden="true" stroke-width={2.25} />
            </button>
            <button type="button" class="capability-control" aria-label="Next capability group" data-capability-next>
              <ChevronRight class="h-4 w-4" aria-hidden="true" stroke-width={2.25} />
            </button>
          </div>
        </div>

        <div class="capabilities-viewport" data-capabilities-viewport>
          <div class="capabilities-track" data-capabilities-track>
            {capabilityGroups.map((group, groupIndex) => (
              <section
                class="capability-slide p-5 sm:p-7"
                aria-label={`${groupIndex + 1} of ${capabilityGroups.length}: ${group.label}`}
                aria-roledescription="slide"
                aria-hidden={groupIndex === 0 ? 'false' : 'true'}
                inert={groupIndex !== 0}
                data-capability-slide
              >
                <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#0C487A]">{group.label}</p>
                <h3 class="mt-2 text-xl font-extrabold leading-snug tracking-tight text-[#0B2553] sm:text-2xl">{group.title}</h3>

                <div class="mt-5 grid gap-3">
                  {group.services.map((service) => {
                    const Icon = service.icon;
                    return (
                    <a href={service.href} class="group/service rounded-2xl border border-white bg-white/95 p-4 shadow-sm transition duration-300 hover:-translate-y-0.5 hover:border-[#0C487A]/20 hover:shadow-md sm:p-5">
                      <div class="flex items-start gap-4">
                        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#0C487A] text-white transition-colors duration-300 group-hover/service:bg-[#FF3130]" aria-hidden="true">
                          <Icon class="h-5 w-5" stroke-width={1.8} />
                        </span>
                        <span class="min-w-0">
                          <span class="block font-extrabold leading-6 text-[#0B2553]">{service.title}</span>
                          <span class="mt-1 block text-sm leading-6 text-slate-600">{service.description}</span>
                        </span>
                      </div>
                    </a>
                    );
                  })}
                </div>
              </section>
            ))}
          </div>
        </div>

        <div class="flex items-center justify-between border-t border-slate-200/90 px-5 py-4 sm:px-7">
          <div class="flex items-center gap-2" aria-label="Choose a capability group">
            {capabilityGroups.map((group, index) => (
              <button
                type="button"
                class={`capability-dot ${index === 0 ? 'is-active' : ''}`}
                aria-label={`Show ${group.label}`}
                aria-current={index === 0 ? 'true' : undefined}
                data-capability-dot={index}
              ></button>
            ))}
          </div>
          <p class="text-xs font-bold uppercase tracking-[0.1em] text-slate-500" aria-live="polite" data-capability-status>
            1 / {capabilityGroups.length}
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="about-scroll-region relative overflow-hidden border-y border-slate-200/80 bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] py-14 sm:py-16" aria-label="Unity Compass performance highlights">
    <div class="absolute inset-0 about-grid opacity-35" aria-hidden="true"></div>
    <div class="absolute left-1/2 top-1/2 h-48 w-4/5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(ellipse,rgba(40,121,182,0.12)_0%,transparent_70%)] blur-3xl" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="about-reveal rounded-3xl border border-slate-200/90 bg-white/90 px-5 py-7 shadow-[0_18px_45px_-20px_rgba(15,39,74,0.22),0_0_0_1px_rgba(255,255,255,0.9)_inset] backdrop-blur-xl sm:px-8 sm:py-9 lg:px-10">
        <dl class="grid grid-cols-2 gap-x-4 gap-y-7 md:grid-cols-5 md:gap-0">
          {performanceMetrics.map((metric, index) => {
            const Icon = metric.icon;
            return (
            <div class={`about-reveal about-delay-${Math.min(index + 1, 5)} relative px-2 py-2 text-center sm:px-4 ${index > 0 ? 'md:border-l md:border-slate-200' : ''} ${index === performanceMetrics.length - 1 ? 'col-span-2 md:col-span-1' : ''}`}>
              <span class="mx-auto mb-3 flex h-9 w-9 items-center justify-center rounded-xl bg-[#0C487A]/[0.08] text-[#0C487A]" aria-hidden="true">
                <Icon class="h-4 w-4" stroke-width={2} />
              </span>
              <dd class="about-count text-3xl font-extrabold tracking-tight text-[#0F274A] sm:text-4xl" data-metric-value={metric.value}>
                {metric.value}
              </dd>
              <span class="mx-auto mt-3 block h-1 w-8 rounded-full bg-[#FF3130]" aria-hidden="true"></span>
              <dt class="mt-3 text-xs font-bold uppercase leading-5 tracking-[0.1em] text-slate-600">{metric.label}</dt>
            </div>
            );
          })}
        </dl>
      </div>
    </div>
  </section>

  <section class="about-scroll-region relative overflow-hidden border-y border-slate-200/80 bg-[#F4F8FC] py-20 sm:py-24 lg:py-28" aria-labelledby="why-heading">
    <div class="absolute inset-0 about-grid opacity-35" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="about-reveal mx-auto mb-12 max-w-3xl text-center sm:mb-16">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#FF3130]">Why Unity Compass</p>
        <h2 id="why-heading" class="about-section-heading mt-3 text-2xl font-extrabold leading-[1.18] tracking-tight sm:text-3xl sm:leading-[1.22] md:text-4xl lg:text-[2.65rem] lg:leading-[1.24]">
          Built for complex, competitive environments
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg">
          The depth to understand the requirement, the flexibility to fit your organization, and the discipline to deliver.
        </p>
      </div>

      <ul class="grid gap-5 md:grid-cols-3" role="list">
        {differentiators.map((item, index) => {
          const Icon = item.icon;
          return (
          <li class={`service-radar-card about-reveal about-delay-${index + 1} group relative overflow-hidden rounded-2xl border border-slate-200/90 bg-white p-7 shadow-[0_16px_45px_-24px_rgba(15,39,74,0.3)] transition duration-500 hover:-translate-y-1.5 hover:border-[#0C487A]/30 hover:shadow-[0_26px_55px_-20px_rgba(15,39,74,0.42)] sm:p-8`} data-service-radar>
            <span class="service-radar-scan" aria-hidden="true"></span>
            <span class="service-radar-number absolute right-6 top-5 text-sm font-extrabold tracking-[0.12em] text-slate-200" aria-hidden="true">{item.number}</span>
            <div class="service-radar-icon flex h-12 w-12 items-center justify-center rounded-xl bg-[#0C487A] text-white shadow-[0_8px_22px_-8px_rgba(12,72,122,0.7)]">
              <Icon class="h-6 w-6" aria-hidden="true" stroke-width={1.8} />
            </div>
            <h3 class="service-radar-title mt-7 text-xl font-extrabold tracking-tight text-[#0F274A] sm:text-2xl">{item.title}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-600 sm:text-base">{item.description}</p>
          </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="about-scroll-region relative overflow-hidden bg-white py-20 sm:py-24 lg:py-28" aria-labelledby="services-heading">
    <div class="absolute inset-0 about-grid opacity-25" aria-hidden="true"></div>
    <div class="absolute left-1/2 top-1/2 h-[28rem] w-4/5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgba(40,121,182,0.1)_0%,transparent_70%)] blur-3xl" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="about-reveal mx-auto mb-12 max-w-4xl text-center sm:mb-16">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#FF3130]">Our core services</p>
        <h2 id="services-heading" class="about-section-heading mx-auto mt-3 max-w-4xl text-2xl font-extrabold leading-[1.18] tracking-tight sm:text-3xl sm:leading-[1.22] md:text-4xl lg:text-[2.65rem] lg:leading-[1.24]">
          Integrated expertise to help you compete, hire, modernize, and grow
        </h2>
        <div class="mx-auto mt-4 h-1.5 w-24 rounded-full bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130]" aria-hidden="true"></div>
        <p class="mx-auto mt-5 max-w-2xl text-sm font-normal leading-relaxed text-slate-600 sm:text-base lg:text-[1.05rem]">
          Six connected service areas give organizations the strategy, talent, technical capacity, and communications support required to move important work forward.
        </p>
      </div>

      <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-3" role="list">
        {coreServices.map((service, index) => {
          const Icon = service.icon;
          return (
          <li class={`about-reveal about-delay-${Math.min(index + 1, 5)}`}>
            <a
              href={service.href}
              class="service-radar-card group relative flex h-full min-h-72 flex-col overflow-hidden rounded-2xl border border-slate-200/90 bg-white p-7 shadow-[0_16px_45px_-24px_rgba(15,39,74,0.3)] transition duration-500 hover:-translate-y-1.5 hover:border-[#0C487A]/30 hover:shadow-[0_26px_55px_-20px_rgba(15,39,74,0.42)] focus-visible:-translate-y-1.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF3130] focus-visible:ring-offset-4 sm:p-8"
              data-service-radar
            >
              <span class="service-radar-scan" aria-hidden="true"></span>
              <span class="service-radar-number absolute right-6 top-5 text-sm font-extrabold tracking-[0.12em] text-slate-200" aria-hidden="true">{service.number}</span>
              <span class="service-radar-icon flex h-12 w-12 items-center justify-center rounded-xl bg-[#0C487A] text-white shadow-[0_8px_22px_-8px_rgba(12,72,122,0.7)]" aria-hidden="true">
                <Icon class="h-6 w-6" stroke-width={1.8} />
              </span>
              <h3 class="service-radar-title mt-7 text-xl font-extrabold leading-snug tracking-tight text-[#0B2553] sm:text-2xl">{service.title}</h3>
              <p class="mt-3 text-sm leading-7 text-slate-600 sm:text-base">{service.description}</p>
              <span class="service-radar-link mt-auto inline-flex items-center gap-2 pt-6 text-sm font-bold text-[#0C487A]">
                Explore this service
                <ArrowRight class="h-4 w-4" aria-hidden="true" stroke-width={2.25} />
              </span>
            </a>
          </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="about-scroll-region relative overflow-hidden bg-white py-20 sm:py-24 lg:py-28" aria-labelledby="process-heading">
    <div class="absolute inset-0 about-grid opacity-25" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="about-reveal mx-auto max-w-3xl text-center">
