---
import MainLayout from '../layouts/MainLayout.astro';
import { companyInfo } from '../data/company';

const canonicalUrl = 'https://unitycompass.com/about-us';
const meetingUrl = 'https://meetings.hubspot.com/unity-compass/gov-con-expert';

const expertise = [
  {
    number: '01',
    title: 'Technical',
    description: 'System analysis, implementation support, and program delivery.',
    detail: 'Practical expertise for IT programs and mission-critical delivery environments.',
    icon: 'M14.7 6.3a1 1 0 00-1.4-1.4l-1.6 1.6-2.2-2.2 1.6-1.6a1 1 0 00-1.4-1.4 6 6 0 00-7.4 7.4l8.3 8.3a2 2 0 002.8 0l3.6-3.6a2 2 0 000-2.8L8.7 2.3a6 6 0 007.4 7.4zM5.5 8.5l-3 3',
  },
  {
    number: '02',
    title: 'Advisory',
    description: 'Proposal strategy, operating models, and federal growth support.',
    detail: 'Structured guidance that turns complex requirements into clear next steps.',
    icon: 'M9 6V4a3 3 0 016 0v2m4 0H5a2 2 0 00-2 2v10a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2zM3 11h18M9 11v2h6v-2',
  },
  {
    number: '03',
    title: 'Workforce',
    description: 'Cleared recruitment and flexible staffing for critical roles.',
    detail: 'Talent solutions aligned to program demands, team culture, and delivery timelines.',
    icon: 'M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2m7-10a4 4 0 100-8 4 4 0 000 8zm13 10v-2a4 4 0 00-3-3.87m-4-12a4 4 0 010 7.75',
  },
] as const;

const operatingModel = [
  {
    number: '01',
    title: 'Listen first',
    description: 'We start with your operating environment, immediate priorities, and definition of success.',
  },
  {
    number: '02',
    title: 'Define the work',
    description: 'We align scope, ownership, and measurable outcomes before execution begins.',
  },
  {
    number: '03',
    title: 'Deliver it well',
    description: 'We keep communication direct, ownership clear, and delivery focused on results.',
  },
] as const;

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${canonicalUrl}#about-page`,
  url: canonicalUrl,
  name: 'About Unity Compass',
  description: 'Learn how Unity Compass aligns technical consulting, federal advisory, and workforce solutions to help government contractors compete, hire, and deliver.',
  isPartOf: {
    '@id': 'https://unitycompass.com/#website',
  },
  about: {
    '@id': 'https://unitycompass.com/#organization',
  },
};
---

<MainLayout
  title="About Unity Compass | Federal Consulting & Workforce Partner"
  description="Unity Compass helps government contractors compete, hire, and deliver through technical consulting, federal advisory, proposal support, and cleared staffing."
  canonicalUrl={canonicalUrl}
  ogImage="/images/about-hero-1600.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(aboutPageSchema)} />
  <noscript><style>.about-reveal { opacity: 1 !important; transform: none !important; }</style></noscript>

  <header class="about-hero relative isolate overflow-hidden bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8]">
    <div class="absolute inset-0 about-grid opacity-50" aria-hidden="true"></div>
    <div class="absolute -left-32 top-16 h-80 w-80 rounded-full bg-blue-300/20 blur-3xl" aria-hidden="true"></div>
    <div class="absolute -right-24 bottom-0 h-72 w-72 rounded-full bg-red-300/10 blur-3xl" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto grid max-w-7xl items-center gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[0.92fr_1.08fr] lg:gap-14 lg:px-8 lg:py-20">
      <div class="about-hero-copy max-w-3xl">
        <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-[#0C487A]/15 bg-white/75 px-3.5 py-1.5 text-xs font-bold uppercase tracking-[0.15em] text-[#0C487A] shadow-sm backdrop-blur-sm">
          <span class="h-1.5 w-1.5 rounded-full bg-[#FF3130]" aria-hidden="true"></span>
          About Unity Compass
        </p>
        <h1 class="max-w-2xl text-4xl font-extrabold leading-[1.08] tracking-[-0.04em] text-[#0F274A] sm:text-5xl lg:text-[3.8rem]">
          A practical partner for <span class="about-gradient-text">federal work.</span>
        </h1>
        <p class="mt-6 max-w-xl text-base leading-8 text-slate-600 sm:text-lg">
          We help contractors compete, hire, and deliver in regulated environments.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a
            href={meetingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex min-h-12 items-center justify-center gap-2.5 rounded-xl bg-[#FF3130] px-6 py-3 text-sm font-bold text-white shadow-[0_10px_28px_-10px_rgba(255,49,48,0.7)] transition duration-300 hover:-translate-y-0.5 hover:bg-[#E02827] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0C487A]"
          >
            Start a conversation
            <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.25" d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </a>
          <a
            href={companyInfo.capabilityPdf}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex min-h-12 items-center justify-center gap-2.5 rounded-xl border border-[#0C487A]/20 bg-white/75 px-6 py-3 text-sm font-bold text-[#0C487A] shadow-sm backdrop-blur-sm transition duration-300 hover:-translate-y-0.5 hover:border-[#0C487A]/40 hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0C487A]"
          >
            Capability statement
            <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-y-0.5" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" />
            </svg>
          </a>
        </div>

        <dl class="mt-10 grid max-w-xl grid-cols-2 gap-x-6 gap-y-4 border-t border-[#0C487A]/15 pt-6 sm:grid-cols-3">
          <div>
            <dt class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Focus</dt>
            <dd class="mt-1 text-sm font-semibold text-[#0F274A]">Federal delivery</dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Model</dt>
            <dd class="mt-1 text-sm font-semibold text-[#0F274A]">Integrated support</dd>
          </div>
          <div class="col-span-2 sm:col-span-1">
            <dt class="text-xs font-bold uppercase tracking-[0.12em] text-slate-500">Based in</dt>
            <dd class="mt-1 text-sm font-semibold text-[#0F274A]">Frederick, Maryland</dd>
          </div>
        </dl>
      </div>

      <div class="about-hero-art relative mx-auto w-full max-w-2xl" aria-hidden="true">
        <div class="absolute inset-x-[12%] bottom-[5%] h-[24%] rounded-full bg-[#0C487A]/15 blur-3xl"></div>
        <img
          src="/images/about-hero-960.webp"
          srcset="/images/about-hero-480.webp 480w, /images/about-hero-960.webp 960w, /images/about-hero-1600.webp 1600w"
          sizes="(min-width: 1280px) 672px, (min-width: 1024px) 52vw, 100vw"
          alt=""
          width="1600"
          height="900"
          fetchpriority="high"
          decoding="async"
          class="about-float relative h-auto w-full object-contain drop-shadow-[0_24px_22px_rgba(15,39,74,0.14)]"
        />
      </div>
    </div>
  </header>

  <section class="bg-white py-20 sm:py-24 lg:py-28" aria-labelledby="useful-heading">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20 lg:px-8">
      <div class="about-reveal">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#FF3130]">Who we are</p>
        <h2 id="useful-heading" class="mt-3 max-w-md text-3xl font-extrabold leading-tight tracking-[-0.035em] text-[#0F274A] sm:text-4xl">
          What makes us useful
        </h2>
        <div class="mt-5 h-1.5 w-20 rounded-full bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130]" aria-hidden="true"></div>
      </div>

      <div class="about-reveal about-delay-1 max-w-3xl space-y-6 text-lg leading-8 text-slate-600 sm:text-xl sm:leading-9">
        <p>
          Unity Compass works with primes, subcontractors, and growth-stage firms across proposal development, OASIS+ readiness, staffing, recruitment, and IT programs.
        </p>
        <p>
          Our specialists work as one team, so strategy, delivery, and hiring decisions stay aligned.
        </p>
        <aside class="mt-8 border-l-2 border-[#FF3130] pl-5 text-base leading-7 text-slate-500 sm:pl-6">
          One partner connecting the decisions that shape a pursuit with the people and systems that deliver it.
        </aside>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden border-y border-slate-200/80 bg-[#F4F8FC] py-20 sm:py-24 lg:py-28" aria-labelledby="expertise-heading">
    <div class="absolute inset-0 about-grid opacity-35" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="about-reveal mx-auto mb-12 max-w-3xl text-center sm:mb-16">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#FF3130]">Connected capabilities</p>
        <h2 id="expertise-heading" class="mt-3 text-3xl font-extrabold tracking-[-0.035em] text-[#0F274A] sm:text-4xl">
          Expertise that moves together
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg">
          Technical, advisory, and workforce specialists collaborate around the same mission and measurable outcome.
        </p>
      </div>

      <ul class="grid gap-5 md:grid-cols-3" role="list">
        {expertise.map((item, index) => (
          <li class={`about-reveal about-delay-${index + 1} group relative overflow-hidden rounded-2xl border border-slate-200/90 bg-white p-7 shadow-[0_16px_45px_-24px_rgba(15,39,74,0.3)] transition duration-300 hover:-translate-y-1.5 hover:border-[#0C487A]/30 hover:shadow-[0_24px_50px_-22px_rgba(15,39,74,0.35)] sm:p-8`}>
            <span class="absolute right-6 top-5 text-sm font-extrabold tracking-[0.12em] text-slate-200 transition-colors duration-300 group-hover:text-[#FF3130]/25" aria-hidden="true">
              {item.number}
            </span>
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-[#0C487A] text-white shadow-[0_8px_22px_-8px_rgba(12,72,122,0.7)] transition duration-300 group-hover:scale-105 group-hover:bg-[#FF3130]">
              <svg class="h-6 w-6" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={item.icon} />
              </svg>
            </div>
            <h3 class="mt-7 text-2xl font-extrabold tracking-tight text-[#0F274A]">{item.title}</h3>
            <p class="mt-3 text-base font-semibold leading-7 text-slate-700">{item.description}</p>
            <p class="mt-3 text-sm leading-6 text-slate-500">{item.detail}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="relative overflow-hidden bg-[#07192C] py-20 text-white sm:py-24 lg:py-28" aria-labelledby="model-heading">
    <div class="absolute inset-0 bg-fed-dots opacity-40" aria-hidden="true"></div>
    <div class="absolute -right-40 -top-40 h-96 w-96 rounded-full bg-blue-500/15 blur-3xl" aria-hidden="true"></div>
    <div class="absolute -bottom-40 -left-40 h-96 w-96 rounded-full bg-red-500/10 blur-3xl" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="about-reveal grid gap-8 border-b border-white/10 pb-12 lg:grid-cols-[1fr_0.8fr] lg:items-end">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-red-300">Our operating model</p>
          <h2 id="model-heading" class="mt-3 max-w-3xl text-3xl font-extrabold leading-tight tracking-[-0.035em] text-white sm:text-4xl lg:text-5xl">
            Listen first. Define the work. Deliver it well.
          </h2>
        </div>
        <p class="max-w-xl text-base leading-7 text-slate-300 lg:justify-self-end">
          That is the operating model. It keeps communication direct, ownership clear, and deliverables measurable.
        </p>
      </div>

      <ol class="mt-12 grid gap-8 md:grid-cols-3 md:gap-0" role="list">
        {operatingModel.map((step, index) => (
          <li class={`about-reveal about-delay-${index + 1} relative md:px-8 ${index === 0 ? 'md:pl-0' : ''} ${index === operatingModel.length - 1 ? 'md:pr-0' : ''}`}>
            {index > 0 && <span class="absolute -left-px top-0 hidden h-full w-px bg-white/10 md:block" aria-hidden="true"></span>}
            <span class="font-mono text-xs font-bold tracking-[0.18em] text-red-300">{step.number}</span>
            <h3 class="mt-5 text-xl font-bold text-white sm:text-2xl">{step.title}</h3>
            <p class="mt-3 max-w-sm text-sm leading-7 text-slate-300 sm:text-base">{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="relative overflow-hidden bg-white py-20 sm:py-24" aria-labelledby="conversation-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="about-reveal relative overflow-hidden rounded-3xl border border-slate-200 bg-gradient-to-br from-[#F4F8FC] via-white to-[#EBF3FA] px-6 py-12 shadow-[0_24px_60px_-30px_rgba(15,39,74,0.35)] sm:px-10 sm:py-14 lg:flex lg:items-center lg:justify-between lg:gap-12 lg:px-14">
        <div class="absolute -right-20 -top-28 h-72 w-72 rounded-full border-[48px] border-[#0C487A]/5" aria-hidden="true"></div>
        <div class="relative max-w-2xl">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#FF3130]">Your next move</p>
          <h2 id="conversation-heading" class="mt-3 text-3xl font-extrabold leading-tight tracking-[-0.035em] text-[#0F274A] sm:text-4xl">
            Bring the challenge. We’ll help define the path forward.
          </h2>
          <p class="mt-4 text-base leading-7 text-slate-600">
            Talk with our team about your next pursuit, critical hire, or delivery priority.
          </p>
        </div>
        <div class="relative mt-8 flex shrink-0 flex-col gap-3 sm:flex-row lg:mt-0 lg:flex-col xl:flex-row">
          <a
            href={meetingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex min-h-12 items-center justify-center gap-2.5 rounded-xl bg-[#0C487A] px-6 py-3 text-sm font-bold text-white shadow-[0_10px_26px_-10px_rgba(12,72,122,0.7)] transition duration-300 hover:-translate-y-0.5 hover:bg-[#0A2540] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FF3130]"
          >
            Talk with our team
            <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.25" d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </a>
          <a
            href={`mailto:${companyInfo.email}`}
            class="inline-flex min-h-12 items-center justify-center rounded-xl border border-[#0C487A]/20 bg-white px-6 py-3 text-sm font-bold text-[#0C487A] shadow-sm transition duration-300 hover:-translate-y-0.5 hover:border-[#0C487A]/40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0C487A]"
          >
            {companyInfo.email}
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .about-grid {
    background-size: 16px 16px;
    background-image:
      linear-gradient(to right, rgba(12, 72, 122, 0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(12, 72, 122, 0.08) 1px, transparent 1px);
  }

  .about-gradient-text {
    background: linear-gradient(100deg, #0C487A 5%, #1E40AF 40%, #FF3130 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .about-hero-copy {
    animation: aboutHeroIn 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .about-hero-art {
    animation: aboutHeroIn 1000ms cubic-bezier(0.16, 1, 0.3, 1) 120ms both;
  }

  .about-float {
    animation: aboutFloat 7s ease-in-out infinite;
  }

  .about-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 750ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 750ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .about-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .about-delay-1 { transition-delay: 80ms; }
  .about-delay-2 { transition-delay: 160ms; }
  .about-delay-3 { transition-delay: 240ms; }

  @keyframes aboutHeroIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes aboutFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-hero-copy,
    .about-hero-art,
    .about-float,
    .about-reveal {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  function initAboutPage() {
    const elements = document.querySelectorAll<HTMLElement>('.about-reveal');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reducedMotion || !('IntersectionObserver' in window)) {
      elements.forEach((element) => element.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        currentObserver.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });

    elements.forEach((element) => observer.observe(element));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAboutPage, { once: true });
  } else {
    initAboutPage();
  }
</script>
