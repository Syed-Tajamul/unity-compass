---
import MainLayout from '../../layouts/MainLayout.astro';
import WaveDivider from '../../components/WaveDivider.astro';
import type { CeipalJob } from '../../data/ceipalJobs';
import sanitizeHtml from 'sanitize-html';
import { getCeipalJobs } from '../api/jobs';

export const prerender = false;

const { id } = Astro.params;
const { jobs } = await getCeipalJobs();
let job: CeipalJob | undefined = jobs.find((candidate) => candidate.id === id);

if (job && id) {
  try {
    const response = await fetch(`https://candidateportal.ceipal.com/api/jobs/description/${encodeURIComponent(id)}`);
    if (response.ok) {
      const payload = await response.json();
      const jobInfo = payload?.data?.jobInfo;
      const details = jobInfo?.jobDetails;
      if (details) {
        job = {
          ...job,
          jobCode: details.jobCode || job.jobCode,
          title: details.positionTitle || job.title,
          location: details.location || job.location,
          employmentType: details.jobType || job.employmentType,
          experience: details.experience || job.experience,
          payRate: details.payRate && details.payRate !== 'N/A' ? details.payRate : job.payRate,
          skills: Array.isArray(jobInfo.skillsData?.skills) ? jobInfo.skillsData.skills : job.skills,
          fullDescription: jobInfo.descriptionData?.jobDescription || job.fullDescription,
          postedDate: details.postedDate || job.postedDate,
        };
      }
    }
  } catch (error) {
    console.warn(`Unable to refresh CEIPAL job ${id}:`, error);
  }
}

if (!job) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const title = job.title
  .replace(/^JPC\s*-\s*\d+\s*[-–—:]\s*/i, '')
  .replace(/\s*\|+\s*$/, '')
  .trim();
const canonicalUrl = `https://unitycompass.com/career/${job.id}`;

function stripHtml(value: string): string {
  return value
    .replace(/<[^>]*>/g, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}

function sanitizeJobHtml(value: string): string {
  return sanitizeHtml(value, {
    allowedTags: ['p', 'br', 'div', 'h2', 'h3', 'h4', 'ul', 'ol', 'li', 'strong', 'b', 'em', 'i', 'a', 'hr'],
    allowedAttributes: {
      a: ['href', 'target', 'rel'],
    },
    allowedSchemes: ['http', 'https', 'mailto'],
    transformTags: {
      h1: 'h2',
      a: (_tagName, attribs) => ({
        tagName: 'a',
        attribs: { ...attribs, rel: 'noopener noreferrer' },
      }),
    },
  });
}

const plainDescription = stripHtml(job.fullDescription || job.summary);
const renderedDescription = sanitizeJobHtml(job.fullDescription || `<p>${job.summary}</p>`);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://unitycompass.com/' },
      { '@type': 'ListItem', position: 2, name: 'Careers', item: 'https://unitycompass.com/career' },
      { '@type': 'ListItem', position: 3, name: title, item: canonicalUrl },
    ],
  },
];
---

<MainLayout
  title={`${title} | Careers at Unity Compass`}
  description={job.summary || plainDescription.slice(0, 155)}
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
>
  <section class="relative overflow-hidden bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] pb-24 pt-16 sm:pb-28 sm:pt-20" aria-labelledby="job-title">
    <div class="absolute inset-0 opacity-[0.24]" style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12,72,122,.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(12,72,122,.08) 1px, transparent 1px);" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav class="mb-7 flex flex-wrap items-center gap-2 text-xs font-semibold text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#0B2553]">Home</a><span aria-hidden="true">/</span>
        <a href="/career" class="hover:text-[#0B2553]">Careers</a><span aria-hidden="true">/</span>
        <span class="text-[#0B2553]" aria-current="page">{title}</span>
      </nav>
      <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
        <div class="max-w-4xl">
          <div class="mb-4 flex flex-wrap gap-2">
            <span class="rounded bg-white px-3 py-1 font-mono text-xs font-bold text-[#0B2553] shadow-sm">{job.jobCode}</span>
            <span class="rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-bold text-[#0B2553]">{job.employmentType}</span>
          </div>
          <h1 id="job-title" class="text-3xl font-extrabold leading-tight tracking-tight text-[#0B2553] sm:text-4xl lg:text-5xl">{title}</h1>
          <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium text-slate-600">
            <span>{job.location}</span>
            {job.experience && <span>{job.experience} experience</span>}
            <span>{job.postedDate}</span>
          </div>
        </div>
        <a href={job.applyUrl} target="_blank" rel="noopener noreferrer" class="inline-flex shrink-0 items-center justify-center rounded-lg bg-[#FF3130] px-8 py-4 text-sm font-bold uppercase tracking-wider text-white shadow-lg shadow-red-500/20 hover:bg-[#E02625]">
          Apply through CEIPAL <span class="ml-2" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
    <WaveDivider variant="wave" position="bottom" fillColor="#ffffff" />
  </section>

  <div class="bg-white py-16 sm:py-24">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[minmax(0,1fr)_320px] lg:px-8">
      <article class="job-description max-w-none text-slate-700" set:html={renderedDescription} />

      <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start" aria-label="Position details">
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_10px_30px_-6px_rgba(12,72,122,.08)]">
          <div class="h-1.5 bg-gradient-to-r from-[#0C487A] to-[#FF3130]"></div>
          <dl class="space-y-4 p-6 text-sm">
            <div><dt class="font-bold text-slate-500">Location</dt><dd class="mt-1 text-[#0B2553]">{job.location}</dd></div>
            <div><dt class="font-bold text-slate-500">Employment type</dt><dd class="mt-1 text-[#0B2553]">{job.employmentType}</dd></div>
            <div><dt class="font-bold text-slate-500">Experience</dt><dd class="mt-1 text-[#0B2553]">{job.experience || 'See position description'}</dd></div>
            <div><dt class="font-bold text-slate-500">Requisition</dt><dd class="mt-1 font-mono text-[#0B2553]">{job.jobCode}</dd></div>
          </dl>
        </div>
        {job.skills.length > 0 && (
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <h2 class="text-sm font-extrabold uppercase tracking-wider text-[#0B2553]">Primary skills</h2>
            <ul class="mt-4 flex flex-wrap gap-2">
              {job.skills.map((skill) => <li class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700">{skill}</li>)}
            </ul>
          </div>
        )}
        <a href="/career" class="inline-flex text-sm font-bold text-[#0C487A] hover:underline">&larr; View all open positions</a>
      </aside>
    </div>
  </div>
</MainLayout>

<style>
  .job-description :global(h2),
  .job-description :global(h3) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: #0B2553;
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.35;
  }
  .job-description :global(p) { margin: 1rem 0; line-height: 1.8; }
  .job-description :global(ul), .job-description :global(ol) { margin: 1.25rem 0; padding-left: 1.5rem; }
  .job-description :global(ul) { list-style: disc; }
  .job-description :global(ol) { list-style: decimal; }
  .job-description :global(li) { margin: .65rem 0; line-height: 1.7; }
  .job-description :global(strong) { color: #0B2553; font-weight: 700; }
</style>
