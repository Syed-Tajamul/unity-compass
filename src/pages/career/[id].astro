---
/**
 * [id].astro - Dedicated Job Details & Application Page
 * 
 * Strict Specification:
 * - Statically generated for each job position.
 * - Job overview.
 * - Responsibilities.
 * - Qualifications & Required experience.
 * - Clearance requirements.
 * - Employment details.
 * - Apply Now CTA with live resume upload to Supabase Storage.
 * - Visual consistency with Unity Compass design system.
 */
import MainLayout from '../../layouts/MainLayout.astro';
import WaveDivider from '../../components/WaveDivider.astro';
import { jobPositions as fallbackPositions, type JobPosition } from '../../data/jobs';
import { supabase, isSupabaseConfigured } from '../../lib/supabase';

export async function getStaticPaths() {
  let positions: JobPosition[] = fallbackPositions;

  if (isSupabaseConfigured && supabase) {
    try {
      const { data, error } = await supabase
        .from('jobs')
        .select('*');

      if (!error && data && data.length > 0) {
        positions = data.map((d: any) => ({
          id: d.id,
          title: d.title,
          department: d.department,
          location: d.location,
          workplaceType: d.workplace_type || 'Hybrid',
          employmentType: d.employment_type || 'Full-Time',
          clearanceLevel: d.clearance_level || 'None',
          description: d.description,
          requirements: Array.isArray(d.requirements) ? d.requirements : JSON.parse(d.requirements || '[]'),
          responsibilities: Array.isArray(d.responsibilities) ? d.responsibilities : JSON.parse(d.responsibilities || '[]'),
          postedDate: d.posted_date || 'Active',
        }));
      }
    } catch (err) {
      console.error('Failed to load jobs for getStaticPaths, using fallback:', err);
    }
  }

  return positions.map((job) => ({
    params: { id: job.id },
    props: { job },
  }));
}

interface Props {
  job: JobPosition;
}

const { job } = Astro.props;
---

<MainLayout
  title={`${job.title} - Careers | Unity Compass`}
  description={job.description}
>
  <!-- ========================================================================= -->
  <!-- HERO: JOB HEADER & METADATA BAR                                           -->
  <!-- ========================================================================= -->
  <section class="relative overflow-hidden bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] pt-16 sm:pt-20 lg:pt-24 pb-20 sm:pb-28" aria-labelledby="job-title-heading">
    <!-- Technical Blueprint Check Pattern -->
    <div
      class="absolute inset-0 opacity-[0.24] mix-blend-multiply pointer-events-none"
      style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.08) 1px, transparent 1px);"
      aria-hidden="true"
    ></div>

    <!-- Soft Ambient Radial Blue Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] h-[650px] bg-[radial-gradient(circle,rgba(12,72,122,0.11)_0%,rgba(30,64,175,0.05)_45%,transparent_70%)] rounded-full blur-3xl pointer-events-none -z-10" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
      <!-- Breadcrumb Bar -->
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#0B2553] transition-colors">Home</a>
        <span>/</span>
        <a href="/career" class="hover:text-[#0B2553] transition-colors">Careers</a>
        <span>/</span>
        <span class="text-[#0B2553] truncate max-w-xs">{job.title}</span>
      </nav>

      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8">
        <div class="space-y-4 max-w-3xl">
          
          <!-- Clearance & Type Badges -->
          <div class="flex flex-wrap items-center gap-2">
            <span class={`text-xs font-bold uppercase tracking-wider px-3.5 py-1 rounded-full border ${
              job.clearanceLevel.includes('Poly')
                ? 'bg-red-50 text-[#FF3130] border-red-200/80'
                : job.clearanceLevel.includes('Top Secret')
                ? 'bg-blue-50 text-[#0B2553] border-blue-200/80'
                : job.clearanceLevel.includes('Secret')
                ? 'bg-amber-50 text-amber-900 border-amber-200/80'
                : job.clearanceLevel.includes('Trust')
                ? 'bg-emerald-50 text-emerald-900 border-emerald-200/80'
                : 'bg-slate-100 text-slate-700 border-slate-200'
            }`}>
              {job.clearanceLevel}
            </span>

            <span class="text-xs font-semibold px-3 py-1 rounded-full bg-white text-[#0B2553] border border-slate-200/80 shadow-xs">
              {job.department}
            </span>

            <span class="text-xs font-medium px-3 py-1 rounded-full bg-white text-slate-700 border border-slate-200/80 shadow-xs">
              {job.workplaceType}
            </span>

            <span class="text-xs font-medium px-3 py-1 rounded-full bg-white text-slate-700 border border-slate-200/80 shadow-xs">
              {job.employmentType}
            </span>
          </div>

          <!-- Job Title -->
          <h1 id="job-title-heading" class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0B2553] tracking-tight leading-[1.16]">
            {job.title}
          </h1>

          <!-- Meta Location & Date -->
          <div class="flex flex-wrap items-center gap-4 text-xs sm:text-sm text-slate-600 font-medium pt-2">
            <span class="flex items-center gap-1.5 text-slate-700 font-semibold">
              <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              {job.location}
            </span>
            <span>•</span>
            <span>Requisition ID: <code class="text-[#0B2553] font-mono font-bold uppercase">{job.id}</code></span>
            <span>•</span>
            <span>Posted: {job.postedDate}</span>
          </div>
        </div>

        <!-- Hero Apply CTA Button -->
        <div class="shrink-0 flex items-center gap-3">
          <a
            href="#apply-section"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-md sm:rounded-lg text-xs font-bold uppercase tracking-wider text-white bg-[#FF3130] hover:bg-[#E02625] shadow-lg shadow-[#FF3130]/25 active:scale-[0.98] transition-all cursor-pointer"
          >
            <span>Apply for this Position</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Pure CSS WaveDivider Transition -->
    <WaveDivider variant="wave" position="bottom" fillColor="#ffffff" />
  </section>

  <!-- ========================================================================= -->
  <!-- MAIN CONTENT: JOB SPECIFICATION & APPLICATION SIDEBAR                     -->
  <!-- ========================================================================= -->
  <section class="py-16 sm:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- LEFT COLUMN: JOB SPECIFICATION (8 cols) -->
        <div class="lg:col-span-8 space-y-12">
          
          <!-- 1. Position Overview -->
          <div class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-extrabold text-[#0B2553] tracking-tight pb-3 border-b border-slate-100 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#FF3130]"></span>
              Position Overview
            </h2>
            <p class="text-base sm:text-lg text-[#243A5E] leading-relaxed font-normal">
              {job.description}
            </p>
          </div>

          <!-- 2. Key Responsibilities -->
          <div class="space-y-5">
            <h2 class="text-xl sm:text-2xl font-extrabold text-[#0B2553] tracking-tight pb-3 border-b border-slate-100 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#0B2553]"></span>
              Key Responsibilities
            </h2>
            <p class="text-sm text-slate-500">
              In this role, you will lead mission-critical deliverables and support client operations across the following core scope:
            </p>
            <ul class="space-y-3.5 text-sm sm:text-base text-[#243A5E]">
              {job.responsibilities && job.responsibilities.length > 0 ? (
                job.responsibilities.map((resp) => (
                  <li class="flex items-start gap-3.5">
                    <span class="w-5 h-5 rounded-full bg-red-50 text-[#FF3130] flex items-center justify-center shrink-0 mt-0.5 border border-red-200/60">
                      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                      </svg>
                    </span>
                    <span class="leading-relaxed font-normal">{resp}</span>
                  </li>
                ))
              ) : (
                <li class="text-slate-500 italic">Responsibilities align with standard GovCon labor category scope.</li>
              )}
            </ul>
          </div>

          <!-- 3. Qualifications & Required Experience -->
          <div class="space-y-5">
            <h2 class="text-xl sm:text-2xl font-extrabold text-[#0B2553] tracking-tight pb-3 border-b border-slate-100 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-blue-600"></span>
              Qualifications &amp; Required Experience
            </h2>
            <p class="text-sm text-slate-500">
              Candidates should possess documented competencies and verifiable credentials in the following areas:
            </p>
            <ul class="space-y-3.5 text-sm sm:text-base text-[#243A5E]">
              {job.requirements.map((req) => (
                <li class="flex items-start gap-3.5">
                  <span class="w-5 h-5 rounded-full bg-blue-50 text-[#0B2553] flex items-center justify-center shrink-0 mt-0.5 border border-blue-200/60">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                  </span>
                  <span class="leading-relaxed font-normal">{req}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- 4. Security Clearance & Eligibility -->
          <div class="rounded-2xl sm:rounded-3xl bg-slate-50 border border-slate-200/90 p-7 sm:p-8 space-y-3">
            <h3 class="text-base font-bold text-[#0B2553] flex items-center gap-2">
              <svg class="w-5 h-5 text-[#FF3130]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>Security Clearance &amp; US Citizenship Mandate</span>
            </h3>
            <p class="text-xs sm:text-sm text-[#243A5E] leading-relaxed font-normal">
              This position requires an active <strong class="text-[#0B2553]">{job.clearanceLevel}</strong>. Due to federal contract sensitivity, candidates must hold verifiable United States citizenship and meet all agency DISS / JPAS sponsorship criteria.
            </p>
          </div>

          <!-- Back Link -->
          <div class="pt-6 border-t border-slate-100">
            <a href="/career" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#0B2553] hover:text-[#FF3130] transition-colors">
              <span aria-hidden="true">&larr;</span>
              <span>Back to All Open Positions</span>
            </a>
          </div>

        </div>

        <!-- RIGHT COLUMN: SIDEBAR & APPLICATION FORM (4 cols) -->
        <div class="lg:col-span-4 space-y-8 sticky top-24">
          
          <!-- Employment Details Summary Card -->
          <div class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 p-6 sm:p-7 shadow-[0_10px_30px_-6px_rgba(12,72,122,0.06)] relative overflow-hidden">
            <div class="absolute top-0 inset-x-0 h-1.5 bg-[#0B2553]"></div>

            <h3 class="text-base font-extrabold text-[#0B2553] tracking-tight mb-4">
              Employment Details
            </h3>

            <dl class="space-y-3.5 text-xs">
              <div class="flex items-center justify-between pb-2.5 border-b border-slate-100">
                <dt class="text-slate-500 font-medium">Department:</dt>
                <dd class="text-[#0B2553] font-bold text-right">{job.department}</dd>
              </div>
              <div class="flex items-center justify-between pb-2.5 border-b border-slate-100">
                <dt class="text-slate-500 font-medium">Workplace Model:</dt>
                <dd class="text-[#0B2553] font-bold text-right">{job.workplaceType}</dd>
              </div>
              <div class="flex items-center justify-between pb-2.5 border-b border-slate-100">
                <dt class="text-slate-500 font-medium">Employment Type:</dt>
                <dd class="text-[#0B2553] font-bold text-right">{job.employmentType}</dd>
              </div>
              <div class="flex items-center justify-between pb-2.5 border-b border-slate-100">
                <dt class="text-slate-500 font-medium">Clearance Required:</dt>
                <dd class="text-[#FF3130] font-bold text-right">{job.clearanceLevel}</dd>
              </div>
              <div class="flex items-center justify-between pb-2.5 border-b border-slate-100">
                <dt class="text-slate-500 font-medium">Location:</dt>
                <dd class="text-[#0B2553] font-bold text-right">{job.location}</dd>
              </div>
              <div class="flex items-center justify-between">
                <dt class="text-slate-500 font-medium">Requisition:</dt>
                <dd class="text-slate-700 font-mono font-bold uppercase">{job.id}</dd>
              </div>
            </dl>
          </div>

          <!-- Embedded Direct Application Card -->
          <div id="apply-section" class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 p-6 sm:p-7 shadow-[0_12px_35px_-8px_rgba(12,72,122,0.08)] relative overflow-hidden">
            <div class="absolute top-0 inset-x-0 h-1.5 bg-[#FF3130]"></div>

            <div class="mb-5">
              <span class="text-[11px] font-bold uppercase tracking-wider text-[#FF3130] bg-red-50 px-2.5 py-0.5 rounded-full border border-red-200/60">
                Quick Apply
              </span>
              <h3 class="text-xl font-extrabold text-[#0B2553] tracking-tight mt-2">
                Apply for this Role
              </h3>
              <p class="text-xs text-slate-500 mt-1">
                Attach your resume to submit your application directly to our recruitment team.
              </p>
            </div>

            <form id="job-detail-apply-form" class="space-y-3.5" novalidate>
              <div id="detail-form-feedback" class="hidden p-3 rounded-xl text-xs font-semibold"></div>

              <div>
                <label class="block text-[11px] font-bold text-[#0B2553] uppercase tracking-wider mb-1">
                  Full Name *
                </label>
                <input
                  type="text"
                  id="detail-name"
                  required
                  placeholder="Your full name"
                  class="w-full px-3.5 py-2 text-xs rounded-xl border border-slate-200 bg-slate-50/50 text-[#0B2553] focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white"
                />
              </div>

              <div>
                <label class="block text-[11px] font-bold text-[#0B2553] uppercase tracking-wider mb-1">
                  Email Address *
                </label>
                <input
                  type="email"
                  id="detail-email"
                  required
                  placeholder="name@example.com"
                  class="w-full px-3.5 py-2 text-xs rounded-xl border border-slate-200 bg-slate-50/50 text-[#0B2553] focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white"
                />
              </div>

              <div>
                <label class="block text-[11px] font-bold text-[#0B2553] uppercase tracking-wider mb-1">
                  Phone Number *
                </label>
                <input
                  type="tel"
                  id="detail-phone"
                  required
                  placeholder="+1 (555) 000-0000"
                  class="w-full px-3.5 py-2 text-xs rounded-xl border border-slate-200 bg-slate-50/50 text-[#0B2553] focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white"
                />
              </div>

              <div>
                <label class="block text-[11px] font-bold text-[#0B2553] uppercase tracking-wider mb-1">
                  Attach Resume (PDF, DOCX max 5MB) *
                </label>
                <input
                  type="file"
                  id="detail-resume"
                  required
                  accept=".pdf,.doc,.docx"
                  class="w-full text-xs text-slate-600 file:mr-2 file:py-2 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-red-50 file:text-[#FF3130] hover:file:bg-red-100 cursor-pointer"
                />
              </div>

              <div class="pt-2">
                <button
                  type="submit"
                  id="detail-submit-btn"
                  class="w-full py-3 px-4 rounded-md sm:rounded-lg text-xs font-bold uppercase tracking-wider text-white bg-[#FF3130] hover:bg-[#E02625] shadow-md shadow-[#FF3130]/25 active:scale-[0.98] transition-all cursor-pointer"
                >
                  Submit Application
                </button>
              </div>

              <p class="text-[10px] text-slate-400 text-center leading-relaxed pt-1">
                Your credentials are kept strictly confidential in accordance with our Privacy Policy.
              </p>
            </form>
          </div>

        </div>

      </div>

    </div>
  </section>
</MainLayout>

<script define:vars={{ jobTitle: job.title, jobId: job.id }}>
  const form = document.getElementById('job-detail-apply-form');
  const feedback = document.getElementById('detail-form-feedback');
  const submitBtn = document.getElementById('detail-submit-btn');
  const fileInput = document.getElementById('detail-resume');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!feedback || !submitBtn) return;

    feedback.classList.add('hidden');
    feedback.className = 'p-3 rounded-xl text-xs font-semibold mb-2';

    const name = document.getElementById('detail-name')?.value.trim();
    const email = document.getElementById('detail-email')?.value.trim();
    const phone = document.getElementById('detail-phone')?.value.trim();
    const file = fileInput?.files?.[0];

    if (!name || !email || !phone) {
      feedback.textContent = 'Please fill out all required fields.';
      feedback.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
      feedback.classList.remove('hidden');
      return;
    }

    if (!file) {
      feedback.textContent = 'Please select your resume document to upload.';
      feedback.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
      feedback.classList.remove('hidden');
      return;
    }

    if (file.size > 5 * 1024 * 1024) {
      feedback.textContent = 'Resume file exceeds 5MB limit. Please upload a smaller document.';
      feedback.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
      feedback.classList.remove('hidden');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting Application...';

    const formData = new FormData();
    formData.append('name', name);
    formData.append('email', email);
    formData.append('phone', phone);
    formData.append('jobTitle', jobTitle);
    formData.append('jobId', jobId);
    formData.append('resume', file);

    try {
      const res = await fetch('/api/careers/apply', {
        method: 'POST',
        body: formData,
      });
      const data = await res.json().catch(() => ({}));

      if (res.ok && data.success) {
        feedback.classList.add('hidden');
        if (window.showToast) {
          window.showToast({
            title: 'Application Submitted Successfully',
            message: 'Application submitted successfully! Our recruitment team will review your qualifications.',
            type: 'success',
          });
        }
        form.reset();
      } else {
        feedback.textContent = data.error || 'Failed to submit application. Please try again.';
        feedback.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
        feedback.classList.remove('hidden');
      }
    } catch (err) {
      feedback.textContent = 'Network error while submitting application. Please try again or email us directly.';
      feedback.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
      feedback.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Submit Application';
    }
  });
</script>

