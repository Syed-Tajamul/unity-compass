---
/**
 * contact.astro - Executive GovCon Contact & Advisory Hub
 * 
 * Harmonized Theme & Visual Architecture:
 * - Executive sky gradient hero (#F4F8FC via #EBF3FA to #DFEDF8) with technical blueprint grid
 * - Deep navy (#0B2553) headlines with brand red (#FF3130) accents
 * - Pure CSS WaveDivider connecting hero into content canvas with zero layout shift
 * - Dual Fast-Track Action Banners: HubSpot Calendar Booking & Direct Toll-Free Dialing
 * - Split-Screen Layout: Verified Headquarters & Communication Channels alongside Enhanced Contact Form
 * - Clear 3-Step Engagement Roadmap
 * - Interactive Frequently Asked Questions (FAQ)
 * - 100% responsive, accessible, and compliant with GovCon design standards
 */
import MainLayout from '../layouts/MainLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import WaveDivider from '../components/WaveDivider.astro';
import { companyInfo } from '../data/company';

const hubspotMeetingUrl = 'https://meetings.hubspot.com/aroosa1?uuid=6b1bf327-e7f0-4fa8-b2ef-37ecde56e4c2';

const engagementSteps = [
  {
    step: '01',
    title: 'Initial Intake & NDA',
    desc: 'We execute a mutual Non-Disclosure Agreement and review your solicitation scope, RFP deadlines, or workforce requirements within 24 hours.',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    step: '02',
    title: 'Strategy & Resourcing Plan',
    desc: 'Our practice leads design a tailored capture roadmap, compliance matrix, or candidate vetting pipeline aligned strictly with agency evaluation criteria.',
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01',
  },
  {
    step: '03',
    title: 'Execution & Mission Delivery',
    desc: 'Dedicated proposal writers, volume managers, or security-cleared professionals deploy seamlessly into your team with ongoing executive oversight.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
];

const faqs = [
  {
    question: 'How quickly can Unity Compass deploy a proposal or capture team for an active RFP?',
    answer: 'For fast-turnaround solicitations or active task orders, our capture strategists, compliance managers, and proposal writers can mobilize within 24 to 48 hours of intake review and NDA execution.',
  },
  {
    question: 'What security clearance levels does your recruitment practice support?',
    answer: 'We support all major levels across DoD and Intelligence Community programs: Public Trust, Secret, Top Secret (TS), TS/SCI, as well as Counter-Intelligence (CI) and Full-Scope Polygraph clearances.',
  },
  {
    question: 'Can Unity Compass participate as a Subcontractor or Teaming Partner?',
    answer: 'Yes. We routinely team with Prime contractors and mid-tier firms as a specialized subcontractor providing proposal development, cleared workforce augmentation, and specialized IT consulting under formal Teaming Agreements.',
  },
  {
    question: 'Where is your corporate headquarters located?',
    answer: 'Our corporate headquarters is based in Frederick, Maryland (2153 Wainwright Ct, Unit 1B), strategically positioned within the National Capital Region (NCR) corridor with rapid access to Washington D.C., Fort Meade, and APG.',
  },
];
---

<MainLayout
  title="Contact Unity Compass | Direct GovCon & Staffing Advisory"
  description="Connect with Unity Compass in Frederick, MD for proposal development, security-cleared recruitment, staffing solutions, and IT consulting. Direct advisory response within 1 business day."
>
  <!-- ========================================================================= -->
  <!-- SECTION 1: EXECUTIVE HERO SECTION                                         -->
  <!-- Executive Sky Gradient (#F4F8FC to #DFEDF8) with Technical Blueprint Grid -->
  <!-- ========================================================================= */ -->
  <section class="relative min-h-[460px] sm:min-h-[500px] flex items-center overflow-hidden bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] pt-14 sm:pt-18 lg:pt-22 pb-24 sm:pb-28 lg:pb-32" aria-labelledby="contact-hero-heading">
    <!-- Technical Blueprint Check Pattern (matching homepage hero) -->
    <div
      class="absolute inset-0 opacity-[0.24] mix-blend-multiply pointer-events-none"
      style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.08) 1px, transparent 1px);"
      aria-hidden="true"
    ></div>

    <!-- Soft Ambient Radial Blue Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] h-[650px] bg-[radial-gradient(circle,rgba(12,72,122,0.11)_0%,rgba(30,64,175,0.05)_45%,transparent_70%)] rounded-full blur-3xl pointer-events-none -z-10" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full text-center">
      <div class="max-w-3xl mx-auto">
        <!-- Live Advisory Desk Pill -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full text-xs font-bold tracking-wider uppercase bg-white/90 text-[#0C487A] border border-[#0C487A]/20 shadow-xs mb-5">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-[0_0_8px_#10B981] animate-pulse"></span>
          <span>Federal Advisory Desk Active &bull; Mon&ndash;Fri 9am&ndash;6pm EST</span>
        </div>

        <!-- Headline: Deep Navy with Selective Red Accent -->
        <h1
          id="contact-hero-heading"
          class="hero-heading-reveal text-3xl sm:text-4xl lg:text-[2.85rem] font-extrabold tracking-tight text-[#0B2553] leading-[1.18]"
        >
          Let's Discuss Your <span class="text-[#FF3130]">Federal Objectives</span>
        </h1>

        <!-- High-Contrast Subtitle -->
        <p class="hero-subheading-reveal mt-5 text-base sm:text-lg text-[#243A5E] leading-[1.78] sm:leading-[1.82] max-w-2xl mx-auto font-normal">
          Connect directly with our government contracting capture, compliance, and talent advisory team in Frederick, Maryland. Whether you are pursuing an upcoming prime solicitation or need security-cleared personnel, we respond with audit-defensible precision within 1 business day.
        </p>

        <!-- 3 Quick Pillars of Confidence -->
        <div class="hero-cta-reveal mt-8 flex flex-wrap items-center justify-center gap-3 sm:gap-4 text-xs sm:text-sm font-semibold text-[#0B2553]">
          <div class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white/80 border border-slate-200/80 shadow-2xs">
            <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            <span>&lt; 24h Advisory Response</span>
          </div>
          <div class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white/80 border border-slate-200/80 shadow-2xs">
            <svg class="w-4 h-4 text-[#0C487A]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Frederick, MD (NCR Corridor)</span>
          </div>
          <div class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white/80 border border-slate-200/80 shadow-2xs">
            <svg class="w-4 h-4 text-[#FF3130]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>Strict NDA Protection</span>
          </div>
        </div>

      </div>
    </div>

    <!-- Organic Pure CSS Wave Divider Transitioning from Hero into White Canvas -->
    <WaveDivider variant="wave" position="bottom" fillColor="#ffffff" />
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 2: DUAL FAST-TRACK ACTION TILES                                   -->
  <!-- Direct Calendar Consultation & Toll-Free Phone Options                    -->
  <!-- ========================================================================= -->
  <section class="py-8 sm:py-12 bg-white relative z-20 -mt-8 sm:-mt-12" aria-label="Direct Consultation Channels">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        
        <!-- Action Card 1: 30-Min Strategy Call -->
        <div class="group relative rounded-3xl bg-gradient-to-br from-[#F4F8FC] to-[#EBF3FA] border border-[#0C487A]/20 p-7 sm:p-8 shadow-[0_10px_30px_-5px_rgba(12,72,122,0.08)] hover:shadow-[0_16px_36px_-4px_rgba(12,72,122,0.16)] transition-all duration-300 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-12 h-12 rounded-2xl bg-[#0C487A] text-white flex items-center justify-center shadow-md shadow-[#0C487A]/25 group-hover:scale-105 transition-transform">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[#0B2553]">
              Schedule a Strategy Call
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Book a dedicated 30-minute consultation directly with our GovCon capture leads to review active solicitations, compliance criteria, or staffing scopes.
            </p>
          </div>
          <div class="pt-6">
            <a
              href={hubspotMeetingUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-xl bg-gradient-to-r from-[#FF3130] to-[#E02625] hover:from-[#E02625] hover:to-[#C61E1D] text-white text-sm font-bold shadow-[0_6px_20px_-3px_rgba(255,49,48,0.28)] hover:shadow-[0_10px_24px_-2px_rgba(255,49,48,0.38)] hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 cursor-pointer"
            >
              <span>Select Date &amp; Time</span>
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Action Card 2: Direct Toll-Free Telephone -->
        <div class="group relative rounded-3xl bg-gradient-to-br from-[#F4F8FC] to-[#EBF3FA] border border-[#0C487A]/20 p-7 sm:p-8 shadow-[0_10px_30px_-5px_rgba(12,72,122,0.08)] hover:shadow-[0_16px_36px_-4px_rgba(12,72,122,0.16)] transition-all duration-300 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-12 h-12 rounded-2xl bg-[#FF3130] text-white flex items-center justify-center shadow-md shadow-[#FF3130]/25 group-hover:scale-105 transition-transform">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-[#0B2553]">
              Direct Advisory Line
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              Connect immediately with our advisory team for urgent proposal deadlines, RFP teaming requests, or fast-turnaround cleared hiring questions.
            </p>
          </div>
          <div class="pt-6">
            <a
              href={`tel:${companyInfo.phoneRaw}`}
              class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-xl border border-[#0C487A]/30 bg-white hover:bg-slate-50 text-[#0B2553] hover:text-[#0C487A] text-sm font-bold shadow-[0_4px_14px_rgba(11,37,83,0.06)] hover:shadow-[0_8px_20px_rgba(11,37,83,0.12)] hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 cursor-pointer"
            >
              <span>Call {companyInfo.phone}</span>
              <svg class="w-4 h-4 text-[#FF3130]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 3: SPLIT-SCREEN CONTACT HUB & INQUIRY FORM                        -->
  <!-- Left: Corporate Headquarters & Channels | Right: Enhanced Contact Form     -->
  <!-- ========================================================================= -->
  <section class="py-14 sm:py-20 bg-white relative z-10" aria-label="Headquarters Details and Project Inquiry Form">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 xl:gap-14 items-start">
        
        <!-- Left Column (5 cols): Corporate Credentials & Verified Channels -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Corporate Contact Card -->
          <div class="bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] rounded-3xl p-7 sm:p-8 border border-slate-200/90 shadow-[0_10px_30px_-5px_rgba(12,72,122,0.08)] space-y-7 relative overflow-hidden">
            <!-- Minute Technical Blueprint Check Pattern -->
            <div
              class="absolute inset-0 opacity-25 mix-blend-multiply pointer-events-none"
              style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.08) 1px, transparent 1px);"
              aria-hidden="true"
            ></div>

            <div class="relative z-10">
              <span class="text-xs font-bold uppercase tracking-wider text-[#FF3130]">Corporate Headquarters</span>
              <h2 class="text-2xl font-extrabold text-[#0B2553] tracking-tight mt-1">Get In Touch</h2>
              <p class="text-sm text-slate-600 mt-2 leading-relaxed">
                Reach our executive practice in Frederick, Maryland, or connect directly with our specialized capture managers.
              </p>
            </div>

            <div class="space-y-5 text-sm relative z-10">
              <!-- Physical Office -->
              <div class="flex items-start gap-4">
                <div class="w-11 h-11 rounded-2xl bg-white text-[#FF3130] border border-slate-200/80 flex items-center justify-center shrink-0 shadow-xs">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider">Executive Office</h4>
                  <p class="font-bold text-[#0B2553] mt-0.5 leading-snug">{companyInfo.address.street}</p>
                  <p class="text-slate-600 leading-snug">{companyInfo.address.city}, {companyInfo.address.state} {companyInfo.address.zip}</p>
                  <span class="text-[11px] font-semibold text-[#0C487A] block mt-1">NCR Corridor &bull; Near DC, Fort Meade &amp; APG</span>
                </div>
              </div>

              <!-- Toll Free Phone -->
              <div class="flex items-start gap-4">
                <div class="w-11 h-11 rounded-2xl bg-white text-[#FF3130] border border-slate-200/80 flex items-center justify-center shrink-0 shadow-xs">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider">Toll-Free Phone</h4>
                  <a href={`tel:${companyInfo.phoneRaw}`} class="font-bold text-[#0B2553] hover:text-[#FF3130] transition-colors block mt-0.5 text-base">
                    {companyInfo.phone}
                  </a>
                  <p class="text-xs text-slate-500">Mon&ndash;Fri, 9:00 AM &ndash; 6:00 PM EST</p>
                </div>
              </div>

              <!-- Email Channels -->
              <div class="flex items-start gap-4">
                <div class="w-11 h-11 rounded-2xl bg-white text-[#FF3130] border border-slate-200/80 flex items-center justify-center shrink-0 shadow-xs">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider">Email Channels</h4>
                  <a href={`mailto:${companyInfo.email}`} class="font-bold text-[#0B2553] hover:text-[#FF3130] transition-colors block mt-0.5">
                    {companyInfo.email}
                  </a>
                  <a href={`mailto:${companyInfo.infoEmail}`} class="text-xs text-slate-600 hover:text-[#0C487A] transition-colors block mt-0.5">
                    {companyInfo.infoEmail}
                  </a>
                </div>
              </div>
            </div>

            <!-- Social Media Buttons -->
            <div class="pt-5 border-t border-slate-200/80 relative z-10">
              <h4 class="text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-3">Connect Online</h4>
              <div class="flex items-center gap-2.5">
                <a
                  href={companyInfo.social.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2.5 rounded-xl bg-white hover:bg-[#FF3130] text-slate-600 hover:text-white transition-all duration-200 border border-slate-200/90 shadow-xs hover:scale-105 active:scale-95 cursor-pointer"
                  aria-label="LinkedIn"
                  title="LinkedIn"
                >
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                  </svg>
                </a>

                <a
                  href={companyInfo.social.twitter}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2.5 rounded-xl bg-white hover:bg-[#FF3130] text-slate-600 hover:text-white transition-all duration-200 border border-slate-200/90 shadow-xs hover:scale-105 active:scale-95 cursor-pointer"
                  aria-label="X (Twitter)"
                  title="X (Twitter)"
                >
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                </a>

                <a
                  href={companyInfo.social.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2.5 rounded-xl bg-white hover:bg-[#FF3130] text-slate-600 hover:text-white transition-all duration-200 border border-slate-200/90 shadow-xs hover:scale-105 active:scale-95 cursor-pointer"
                  aria-label="Instagram"
                  title="Instagram"
                >
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                </a>
              </div>
            </div>

            <!-- Corporate Capability PDF Download -->
            <div class="pt-2 relative z-10">
              <a
                href={companyInfo.capabilityPdf}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between p-4.5 rounded-2xl bg-white border border-[#0C487A]/25 hover:border-[#0C487A] text-[#0B2553] hover:text-[#0C487A] transition-all shadow-xs group cursor-pointer"
              >
                <div>
                  <span class="text-[10px] font-bold uppercase tracking-wider text-[#FF3130] block">Official GovCon Asset</span>
                  <p class="text-sm font-bold text-[#0B2553] mt-0.5">Corporate Capability Statement (PDF)</p>
                  <p class="text-xs text-slate-500">Core NAICS codes, past performance &amp; vehicles</p>
                </div>
                <div class="w-9 h-9 rounded-xl bg-slate-100 group-hover:bg-[#FF3130] text-[#0C487A] group-hover:text-white flex items-center justify-center transition-colors shrink-0 ml-3">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                  </svg>
                </div>
              </a>
            </div>
          </div>

          <!-- Stylized Geographic Location Card -->
          <div class="bg-white rounded-3xl p-6 border border-slate-200/90 shadow-[0_10px_25px_-5px_rgba(12,72,122,0.06)] flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-blue-50 border border-blue-100 text-[#0C487A] flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-[#0C487A]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
            </div>
            <div>
              <h4 class="text-sm font-bold text-[#0B2553]">National Capital Region Corridor</h4>
              <p class="text-xs text-slate-500 mt-0.5 leading-relaxed">
                Direct access to federal program offices across Maryland, Northern Virginia, and Washington D.C.
              </p>
            </div>
          </div>

        </div>

        <!-- Right Column (7 cols): The Enhanced Project Inquiry Form -->
        <div class="lg:col-span-7">
          <ContactForm />
        </div>

      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 4: 3-STEP ENGAGEMENT ROADMAP                                      -->
  <!-- Transparent, Disciplined Onboarding Protocol                              -->
  <!-- ========================================================================= -->
  <section class="py-16 sm:py-20 bg-slate-50 border-t border-slate-200/80" aria-labelledby="roadmap-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-[#FF3130]">Client Onboarding Protocol</span>
        <h2 id="roadmap-heading" class="text-2xl sm:text-3xl font-extrabold text-[#0B2553] tracking-tight mt-1">
          How We Engage With New Partners
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-2 leading-relaxed">
          From first contact to live project delivery, our engagement process is fast, disciplined, and transparent.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {engagementSteps.map((item) => (
          <div class="bg-white rounded-3xl p-8 border border-slate-200/90 shadow-[0_10px_25px_-5px_rgba(12,72,122,0.06)] relative flex flex-col justify-between hover:shadow-[0_16px_36px_-4px_rgba(12,72,122,0.12)] hover:-translate-y-1 transition-all duration-300">
            <div>
              <div class="flex items-center justify-between mb-6">
                <span class="text-3xl font-black text-slate-200 font-mono tracking-tighter">{item.step}</span>
                <div class="w-10 h-10 rounded-xl bg-blue-50 text-[#0C487A] border border-blue-100 flex items-center justify-center">
                  <svg class="w-5 h-5 text-[#0C487A]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
                  </svg>
                </div>
              </div>
              <h3 class="text-lg font-bold text-[#0B2553] mb-2.5">{item.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed font-normal">{item.desc}</p>
            </div>
            <div class="pt-6 mt-6 border-t border-slate-100 flex items-center text-xs font-bold text-[#0C487A]">
              <span>Verified Capture Phase</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 5: FREQUENTLY ASKED ADVISORY QUESTIONS (FAQ)                     -->
  <!-- Crisp, Authoritative Clarifications for Prime Contractors & Clients      -->
  <!-- ========================================================================= -->
  <section class="py-16 sm:py-24 bg-white" aria-labelledby="faq-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-[#FF3130]">Procurement &amp; Engagement FAQ</span>
        <h2 id="faq-heading" class="text-2xl sm:text-3xl font-extrabold text-[#0B2553] tracking-tight mt-1">
          Frequently Asked Questions
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-2 leading-relaxed">
          Common questions regarding contract mechanisms, security clearances, and proposal mobilization.
        </p>
      </div>

      <div class="max-w-4xl mx-auto space-y-4">
        {faqs.map((faq, idx) => (
          <details class="group bg-slate-50/70 border border-slate-200/80 rounded-2xl p-5 sm:p-6 transition-all duration-200 open:bg-white open:shadow-[0_10px_25px_-5px_rgba(12,72,122,0.08)] open:border-[#0C487A]/30 cursor-pointer">
            <summary class="flex items-center justify-between font-bold text-base sm:text-lg text-[#0B2553] list-none select-none">
              <span class="pr-4">{faq.question}</span>
              <div class="w-8 h-8 rounded-full bg-white border border-slate-200/80 text-slate-500 group-open:bg-[#0C487A] group-open:text-white flex items-center justify-center shrink-0 transition-colors">
                <svg class="w-4 h-4 transform group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </summary>
            <p class="mt-4 text-sm sm:text-base text-slate-600 leading-relaxed font-normal pt-2 border-t border-slate-100">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

</MainLayout>
