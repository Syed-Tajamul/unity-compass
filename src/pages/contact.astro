---
/**
 * contact.astro - Executive GovCon Contact & Advisory Hub
 * 
 * Inspired by Reference Designs (Contragenix & HireGenix):
 * - Hero with "REACH OUT TO US" eyebrow and "Connect With Our Team" headline
 * - Top 3 prominent contact cards (Email, Call Us Anytime, Strategy Call / Executive Office)
 *   with top colored accent bars, circular icon badges with dashed rings, and direct action pills
 * - Smooth WaveDivider transition from sky gradient hero into crisp white content section
 * - Main Split Section (Image 6 layout):
 *   - Left: "GET IN TOUCH" pill, "Send Us a Message" headline, explanatory copy,
 *     3 soft-green checkmark pills, Capability Statement download, and verified office details
 *   - Right: Clean ContactForm card with top gradient bar, inner field icons, and brand red submit pill
 * - 3-Step Client Onboarding Protocol
 * - Procurement & Engagement FAQ accordion
 */
import MainLayout from '../layouts/MainLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import WaveDivider from '../components/WaveDivider.astro';
import { companyInfo } from '../data/company';

const hubspotMeetingUrl = 'https://meetings.hubspot.com/aroosa1?uuid=6b1bf327-e7f0-4fa8-b2ef-37ecde56e4c2';

const engagementSteps = [
  {
    step: '01',
    title: 'Initial Intake & NDA',
    desc: 'We execute a mutual Non-Disclosure Agreement and review your solicitation scope, RFP deadlines, or workforce requirements within 24 hours.',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    step: '02',
    title: 'Strategy & Resourcing Plan',
    desc: 'Our practice leads design a tailored capture roadmap, compliance matrix, or candidate vetting pipeline aligned strictly with agency evaluation criteria.',
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01',
  },
  {
    step: '03',
    title: 'Execution & Mission Delivery',
    desc: 'Dedicated proposal writers, volume managers, or security-cleared professionals deploy seamlessly into your team with ongoing executive oversight.',
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
];

const faqs = [
  {
    question: 'How quickly can Unity Compass deploy a proposal or capture team for an active RFP?',
    answer: 'For fast-turnaround solicitations or active task orders, our capture strategists, compliance managers, and proposal writers can mobilize within 24 to 48 hours of intake review and NDA execution.',
  },
  {
    question: 'What security clearance levels does your recruitment practice support?',
    answer: 'We support all major levels across DoD and Intelligence Community programs: Public Trust, Secret, Top Secret (TS), TS/SCI, as well as Counter-Intelligence (CI) and Full-Scope Polygraph clearances.',
  },
  {
    question: 'Can Unity Compass participate as a Subcontractor or Teaming Partner?',
    answer: 'Yes. We routinely team with Prime contractors and mid-tier firms as a specialized subcontractor providing proposal development, cleared workforce augmentation, and specialized IT consulting under formal Teaming Agreements.',
  },
  {
    question: 'Where is your corporate headquarters located?',
    answer: 'Our corporate headquarters is based in Frederick, Maryland (2153 Wainwright Ct, Unit 1B), strategically positioned within the National Capital Region (NCR) corridor with rapid access to Washington D.C., Fort Meade, and APG.',
  },
];
---

<MainLayout
  title="Contact Unity Compass | Direct GovCon & Staffing Advisory"
  description="Connect with Unity Compass in Frederick, MD for proposal development, security-cleared recruitment, staffing solutions, and IT consulting. Direct advisory response within 1 business day."
>
  <!-- ========================================================================= -->
  <!-- SECTION 1: HERO & 3 TOP CONTACT CARDS                                     -->
  <!-- Inspired by HireGenix & Contragenix (Reference Images 2 & 5)              -->
  <!-- ========================================================================= -->
  <section class="relative overflow-hidden bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] pt-14 sm:pt-20 lg:pt-24 pb-28 sm:pb-36 lg:pb-40" aria-labelledby="contact-hero-heading">
    <!-- Technical Blueprint Check Pattern (matching homepage hero) -->
    <div
      class="absolute inset-0 opacity-[0.24] mix-blend-multiply pointer-events-none"
      style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.08) 1px, transparent 1px);"
      aria-hidden="true"
    ></div>

    <!-- Soft Ambient Radial Blue Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[radial-gradient(circle,rgba(12,72,122,0.11)_0%,rgba(30,64,175,0.05)_45%,transparent_70%)] rounded-full blur-3xl pointer-events-none -z-10" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
      <!-- Header Area -->
      <div class="text-center max-w-3xl mx-auto">
        <!-- Eyebrow Pill: REACH OUT TO US (matching HireGenix Image 5) -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold tracking-widest uppercase bg-white/90 text-[#FF3130] border border-[#FF3130]/20 shadow-xs mb-4">
          <span class="w-2 h-2 rounded-full bg-[#FF3130] animate-pulse"></span>
          <span>REACH OUT TO US</span>
        </div>

        <!-- Headline: Connect With Our Team -->
        <h1
          id="contact-hero-heading"
          class="hero-heading-reveal text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-[#0B2553] leading-[1.16]"
        >
          Connect With Our <span class="text-[#FF3130]">Team</span>
        </h1>

        <!-- High-Contrast Subtitle -->
        <p class="hero-subheading-reveal mt-4 text-base sm:text-lg text-[#243A5E] leading-[1.75] max-w-2xl mx-auto font-normal">
          We're here to answer your questions, evaluate active solicitations, and provide the strategic GovCon and staffing support you need.
        </p>
      </div>

      <!-- 3 Prominent Contact Cards (matching Reference Images 2 & 5) -->
      <div class="mt-12 sm:mt-16 grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 max-w-6xl mx-auto">
        
        <!-- CARD 1: EMAIL -->
        <div class="group relative rounded-3xl bg-white border border-slate-200/90 p-8 sm:p-9 shadow-[0_12px_35px_-8px_rgba(12,72,122,0.08)] hover:shadow-[0_20px_45px_-8px_rgba(12,72,122,0.16)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between overflow-hidden">
          <!-- Top Accent Border Bar (Brand Red) -->
          <div class="absolute top-0 inset-x-0 h-1.5 bg-[#FF3130]"></div>

          <div class="text-center">
            <!-- Icon Badge with Dashed Outer Ring -->
            <div class="relative w-16 h-16 mx-auto flex items-center justify-center mb-5">
              <div class="absolute inset-0 rounded-full border-2 border-dashed border-[#FF3130]/35 animate-[spin_20s_linear_infinite]"></div>
              <div class="w-12 h-12 rounded-full bg-red-50 text-[#FF3130] flex items-center justify-center group-hover:scale-105 transition-transform">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
            </div>

            <h3 class="text-xl font-bold text-[#0B2553]">Email</h3>
            <p class="text-xs text-slate-500 mt-1 uppercase tracking-wider font-semibold">Direct Federal Inbox</p>
            
            <a
              href={`mailto:${companyInfo.email}`}
              class="mt-3 block text-sm sm:text-base font-semibold text-[#0B2553] hover:text-[#FF3130] transition-colors break-all"
            >
              {companyInfo.email}
            </a>
            <p class="text-xs text-slate-400 mt-0.5">Response within 24 business hours</p>
          </div>

          <div class="pt-6 text-center">
            <a
              href={`mailto:${companyInfo.email}`}
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full text-sm font-bold text-white bg-gradient-to-r from-[#FF3130] to-[#E02625] hover:from-[#E02625] hover:to-[#C61E1D] shadow-[0_6px_20px_-3px_rgba(255,49,48,0.28)] hover:shadow-[0_10px_24px_-2px_rgba(255,49,48,0.38)] hover:-translate-y-0.5 active:translate-y-0 transition-all cursor-pointer"
            >
              <span>Send Email</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- CARD 2: CALL US ANYTIME -->
        <div class="group relative rounded-3xl bg-white border border-slate-200/90 p-8 sm:p-9 shadow-[0_12px_35px_-8px_rgba(12,72,122,0.08)] hover:shadow-[0_20px_45px_-8px_rgba(12,72,122,0.16)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between overflow-hidden">
          <!-- Top Accent Border Bar (Navy Blue) -->
          <div class="absolute top-0 inset-x-0 h-1.5 bg-[#0C487A]"></div>

          <div class="text-center">
            <!-- Icon Badge with Dashed Outer Ring -->
            <div class="relative w-16 h-16 mx-auto flex items-center justify-center mb-5">
              <div class="absolute inset-0 rounded-full border-2 border-dashed border-[#0C487A]/35 animate-[spin_20s_linear_infinite]"></div>
              <div class="w-12 h-12 rounded-full bg-blue-50 text-[#0C487A] flex items-center justify-center group-hover:scale-105 transition-transform">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
            </div>

            <h3 class="text-xl font-bold text-[#0B2553]">Call Us Anytime</h3>
            <p class="text-xs text-slate-500 mt-1 uppercase tracking-wider font-semibold">Toll-Free Direct Line</p>
            
            <a
              href={`tel:${companyInfo.phoneRaw}`}
              class="mt-3 block text-sm sm:text-base font-bold text-[#0B2553] hover:text-[#0C487A] transition-colors"
            >
              {companyInfo.phone}
            </a>
            <p class="text-xs text-slate-400 mt-0.5">Mon&ndash;Fri, 9:00 AM &ndash; 6:00 PM EST</p>
          </div>

          <div class="pt-6 text-center">
            <a
              href={`tel:${companyInfo.phoneRaw}`}
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full text-sm font-bold text-white bg-gradient-to-r from-[#0C487A] to-[#0B2553] hover:from-[#0B2553] hover:to-[#081B3A] shadow-[0_6px_20px_-3px_rgba(12,72,122,0.28)] hover:shadow-[0_10px_24px_-2px_rgba(12,72,122,0.38)] hover:-translate-y-0.5 active:translate-y-0 transition-all cursor-pointer"
            >
              <span>Call Now</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- CARD 3: VISIT OUR OFFICE / BOOK A MEETING -->
        <div class="group relative rounded-3xl bg-white border border-slate-200/90 p-8 sm:p-9 shadow-[0_12px_35px_-8px_rgba(12,72,122,0.08)] hover:shadow-[0_20px_45px_-8px_rgba(12,72,122,0.16)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between overflow-hidden">
          <!-- Top Accent Border Bar (Brand Red) -->
          <div class="absolute top-0 inset-x-0 h-1.5 bg-[#FF3130]"></div>

          <div class="text-center">
            <!-- Icon Badge with Dashed Outer Ring -->
            <div class="relative w-16 h-16 mx-auto flex items-center justify-center mb-5">
              <div class="absolute inset-0 rounded-full border-2 border-dashed border-[#FF3130]/35 animate-[spin_20s_linear_infinite]"></div>
              <div class="w-12 h-12 rounded-full bg-red-50 text-[#FF3130] flex items-center justify-center group-hover:scale-105 transition-transform">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
            </div>

            <h3 class="text-xl font-bold text-[#0B2553]">Visit Our Office</h3>
            <p class="text-xs text-slate-500 mt-1 uppercase tracking-wider font-semibold">Corporate Headquarters</p>
            
            <p class="mt-3 text-sm sm:text-base font-semibold text-[#0B2553]">
              Frederick, MD 21702
            </p>
            <p class="text-xs text-slate-400 mt-0.5">NCR Corridor &bull; Near DC &amp; Fort Meade</p>
          </div>

          <div class="pt-6 text-center">
            <a
              href={hubspotMeetingUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full text-sm font-bold text-white bg-gradient-to-r from-[#FF3130] to-[#E02625] hover:from-[#E02625] hover:to-[#C61E1D] shadow-[0_6px_20px_-3px_rgba(255,49,48,0.28)] hover:shadow-[0_10px_24px_-2px_rgba(255,49,48,0.38)] hover:-translate-y-0.5 active:translate-y-0 transition-all cursor-pointer"
            >
              <span>Book a Meeting</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- Organic Pure CSS Wave Divider Transitioning from Hero into White Canvas -->
    <WaveDivider variant="wave" position="bottom" fillColor="#ffffff" />
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 2: "SEND US A MESSAGE" (Image 6 Split Layout)                     -->
  <!-- Left: "GET IN TOUCH", Headline, Trust checkmark pills, Capability PDF     -->
  <!-- Right: Enhanced Project Brief & Proposal Contact Form                     -->
  <!-- ========================================================================= -->
  <section class="py-16 sm:py-24 bg-white relative z-10" aria-label="Send Us a Message and Project Inquiry Form">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 xl:gap-16 items-start">
        
        <!-- Left Column (5 cols): Narrative, Confidence Pills & Headquarters -->
        <div class="lg:col-span-5 space-y-7">
          
          <div>
            <!-- Eyebrow Badge (matching Image 6) -->
            <span class="inline-block px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-50 text-[#FF3130] border border-red-100 mb-3">
              GET IN TOUCH
            </span>

            <!-- Main Section Title (matching Image 6) -->
            <h2 class="text-3xl sm:text-4xl font-extrabold text-[#0B2553] tracking-tight leading-tight">
              Send Us a Message
            </h2>

            <!-- Narrative Paragraphs -->
            <p class="mt-4 text-base text-slate-600 leading-relaxed font-normal">
              Fill out the form and our advisory team will get back to you as soon as possible. We are here to answer any questions regarding federal capture, RFP compliance, and security-cleared workforce solutions.
            </p>
            <p class="mt-3 text-sm text-slate-500 leading-relaxed font-normal">
              If you have an active solicitation deadline or teaming requirement, our senior capture leads will review your scope under a mutual non-disclosure agreement.
            </p>
          </div>

          <!-- 3 Soft-Green Confidence Pills (matching Image 6 layout) -->
          <div class="space-y-3 pt-1">
            <!-- Pill 1 -->
            <div class="flex items-center gap-3.5 px-4.5 py-3.5 rounded-2xl bg-emerald-50/80 border border-emerald-100/90 text-emerald-950 text-sm font-semibold shadow-2xs">
              <div class="w-6 h-6 rounded-full bg-emerald-500 text-white flex items-center justify-center shrink-0 shadow-xs">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span>Quick response within 24 hours on business days</span>
            </div>

            <!-- Pill 2 -->
            <div class="flex items-center gap-3.5 px-4.5 py-3.5 rounded-2xl bg-emerald-50/80 border border-emerald-100/90 text-emerald-950 text-sm font-semibold shadow-2xs">
              <div class="w-6 h-6 rounded-full bg-emerald-500 text-white flex items-center justify-center shrink-0 shadow-xs">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span>Confidential proposal reviews under standard NDA</span>
            </div>

            <!-- Pill 3 -->
            <div class="flex items-center gap-3.5 px-4.5 py-3.5 rounded-2xl bg-emerald-50/80 border border-emerald-100/90 text-emerald-950 text-sm font-semibold shadow-2xs">
              <div class="w-6 h-6 rounded-full bg-emerald-500 text-white flex items-center justify-center shrink-0 shadow-xs">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span>Direct guidance from senior GovCon capture leads</span>
            </div>
          </div>

          <!-- Official Capability PDF Card -->
          <div class="pt-2">
            <a
              href={companyInfo.capabilityPdf}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-5 rounded-2xl bg-slate-50/80 border border-slate-200/90 hover:border-[#0C487A] text-[#0B2553] hover:text-[#0C487A] transition-all shadow-xs group cursor-pointer"
            >
              <div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-[#FF3130] block">Official GovCon Asset</span>
                <p class="text-sm font-bold text-[#0B2553] mt-0.5">Corporate Capability Statement (PDF)</p>
                <p class="text-xs text-slate-500">Core NAICS codes, past performance &amp; vehicles</p>
              </div>
              <div class="w-10 h-10 rounded-xl bg-white group-hover:bg-[#FF3130] text-[#0C487A] group-hover:text-white flex items-center justify-center transition-colors shrink-0 ml-3 shadow-xs border border-slate-200/70">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
              </div>
            </a>
          </div>

          <!-- Corporate Headquarters Summary -->
          <div class="p-5 rounded-2xl bg-slate-50/80 border border-slate-200/90 space-y-3 text-xs text-slate-600">
            <div class="flex items-center justify-between">
              <span class="font-bold text-[#0B2553] uppercase tracking-wider text-[11px]">Executive Office Details</span>
              <span class="text-[#0C487A] font-semibold text-[11px]">NCR Corridor</span>
            </div>
            <p class="leading-relaxed">
              <strong class="text-[#0B2553] block">{companyInfo.name}</strong>
              {companyInfo.address.street}<br />
              {companyInfo.address.city}, {companyInfo.address.state} {companyInfo.address.zip}, USA
            </p>
            <div class="pt-2 border-t border-slate-200/70 flex items-center justify-between">
              <span>Mon&ndash;Fri: 9:00 AM &ndash; 6:00 PM EST</span>
              <div class="flex items-center gap-2">
                <a
                  href={companyInfo.social.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-slate-500 hover:text-[#0C487A] transition-colors"
                  aria-label="LinkedIn"
                >
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                  </svg>
                </a>
                <a
                  href={companyInfo.social.twitter}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-slate-500 hover:text-[#0C487A] transition-colors"
                  aria-label="X (Twitter)"
                >
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                </a>
                <a
                  href={companyInfo.social.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-slate-500 hover:text-[#0C487A] transition-colors"
                  aria-label="Instagram"
                >
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
