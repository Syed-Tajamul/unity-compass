---
/**
 * contact.astro - Executive GovCon Contact & Advisory Hub
 * 
 * Clean, focused, high-converting layout:
 * - Sky gradient hero with technical blueprint grid
 * - Bold headline: "Connect With Our Team" + supporting copy
 * - 3 elevated contact cards (Email, Call Us Anytime, Visit Our Office) with top color stripes and action buttons
 * - Pure CSS WaveDivider transition
 * - "Send Us a Message" section (Image 6 layout):
 *   - Left: Title, explanatory narrative, and 3 soft-green checkmark pills
 *   - Right: Streamlined ContactForm (Name, Email, Phone, Message)
 * - Silk-smooth scroll-reveal animations for all cards, text, pills, and form
 */
import MainLayout from '../layouts/MainLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import WaveDivider from '../components/WaveDivider.astro';
import { companyInfo } from '../data/company';

const hubspotMeetingUrl = 'https://meetings.hubspot.com/aroosa1?uuid=6b1bf327-e7f0-4fa8-b2ef-37ecde56e4c2';
---

<MainLayout
  title="Contact Unity Compass | Direct GovCon & Staffing Advisory"
  description="Connect with Unity Compass in Frederick, MD for proposal development, security-cleared recruitment, staffing solutions, and IT consulting. Direct advisory response within 1 business day."
>
  <!-- ========================================================================= -->
  <!-- SECTION 1: HERO & 3 TOP CONTACT CARDS (Split-Screen Layout)               -->
  <!-- ========================================================================= -->
  <section class="relative overflow-hidden bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] pt-16 sm:pt-20 lg:pt-24 pb-28 sm:pb-36 lg:pb-40" aria-labelledby="contact-hero-heading">
    <!-- Technical Blueprint Check Pattern (Matching Homepage & Careers) -->
    <div
      class="absolute inset-0 opacity-[0.24] mix-blend-multiply pointer-events-none"
      style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.08) 1px, transparent 1px);"
      aria-hidden="true"
    ></div>

    <!-- Soft Ambient Radial Blue Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[radial-gradient(circle,rgba(12,72,122,0.11)_0%,rgba(30,64,175,0.05)_45%,transparent_70%)] rounded-full blur-3xl pointer-events-none -z-10" aria-hidden="true"></div>

    <div class="max-w-7xl xl:max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
      
      <!-- Split-Screen Grid: Content & 3D Isometric Illustration -->
      <div class="grid grid-cols-1 lg:grid-cols-[0.94fr_1.06fr] gap-8 items-center">
        
        <!-- LEFT COLUMN: Headline, Description & CTAs -->
        <div class="max-w-2xl">
          <!-- Headline with Homepage Hero Typography & Continuous Radiant Shimmer Gradient -->
          <h1
            id="contact-hero-heading"
            class="hero-heading-reveal text-3xl sm:text-4xl lg:text-[2.75rem] xl:text-[3.15rem] font-extrabold tracking-tight leading-[1.18] sm:leading-[1.20]"
          >
            <span class="hero-shimmer-title-line hero-shimmer-title-line-1 block">
              Connect With
            </span>
            <span class="hero-shimmer-title-line hero-shimmer-title-line-2 block">
              Our Team.
            </span>
          </h1>

          <!-- Subtitle with Relaxed Leading -->
          <p class="hero-subheading-reveal mt-5 sm:mt-6 text-base sm:text-lg text-[#243A5E] leading-[1.78] sm:leading-[1.82] font-normal max-w-xl">
            We're here to answer your questions, evaluate active solicitations, and provide the strategic GovCon advisory and staffing solutions you need across federal environments.
          </p>

          <!-- Primary CTAs (Sequential Buttons: Step 3) -->
          <div class="mt-8 sm:mt-10 flex flex-wrap items-center gap-4">
            <a
              href="#send-message"
              class="inline-flex items-center justify-center gap-3 px-8 sm:px-9 py-4 rounded-md sm:rounded-lg bg-gradient-to-r from-[#FF3130] to-[#E02625] hover:from-[#E02625] hover:to-[#C61E1D] text-white text-base font-bold shadow-[0_8px_24px_-4px_rgba(255,49,48,0.25)] hover:shadow-[0_12px_28px_-2px_rgba(255,49,48,0.35)] cursor-pointer whitespace-nowrap transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
            >
              <span>Send Us a Message</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </a>

            <a
              href={hubspotMeetingUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-md sm:rounded-lg border border-slate-300/80 hover:border-[#0C487A] bg-white/80 hover:bg-white text-[#0B2553] font-bold text-base shadow-xs hover:shadow-md transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 cursor-pointer"
            >
              <span>Book a Strategy Call</span>
              <svg class="w-4 h-4 text-[#FF3130]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- RIGHT COLUMN: 3D Isometric Art (Sequential Step 4) -->
        <div class="hero-artwork-reveal relative mx-auto w-full max-w-2xl flex items-center justify-center" aria-hidden="true">
          <!-- Ambient Blue Shadow Diffusion & Ground Glow -->
          <div class="absolute inset-x-[12%] bottom-[5%] h-[24%] rounded-full bg-[#0C487A]/15 blur-3xl pointer-events-none"></div>
          
          <!-- Clean 3D Transparent Illustration without any background artifacts -->
          <img
            src="/images/contactus-960.webp"
            srcset="/images/contactus-960.webp 960w, /images/contactus.webp 2512w"
            sizes="(min-width: 1280px) 672px, (min-width: 1024px) 52vw, 100vw"
            alt="Unity Compass Contact & Advisory Team"
            class="contact-float relative h-auto w-full object-contain drop-shadow-[0_24px_22px_rgba(15,39,74,0.14)]"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="2512"
            height="1400"
            onerror="this.src='/images/contactus.png'"
          />
        </div>

      </div>

      <!-- 3 Prominent Contact Cards with Sequential Staggered Entrance -->
      <div class="mt-16 sm:mt-24 grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        
        <!-- CARD 1: EMAIL -->
        <div class="contact-reveal contact-delay-1 group relative rounded-2xl sm:rounded-3xl bg-white border border-slate-200/90 p-8 sm:p-9 shadow-[0_12px_35px_-8px_rgba(12,72,122,0.08)] hover:shadow-[0_20px_45px_-8px_rgba(12,72,122,0.16)] hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between overflow-hidden">
          <!-- Top Accent Border Bar (Brand Red) -->
          <div class="absolute top-0 inset-x-0 h-1.5 bg-[#FF3130]"></div>

          <div class="text-center">
            <!-- Icon Badge with Dashed Outer Ring -->
            <div class="relative w-16 h-16 mx-auto flex items-center justify-center mb-5">
              <div class="absolute inset-0 rounded-full border-2 border-dashed border-[#FF3130]/35 animate-[spin_20s_linear_infinite]"></div>
              <div class="w-12 h-12 rounded-full bg-red-50 text-[#FF3130] flex items-center justify-center group-hover:scale-105 transition-transform">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
            </div>

            <h3 class="text-xl font-bold text-[#0B2553]">Email</h3>
            <p class="text-xs text-slate-500 mt-1 uppercase tracking-wider font-semibold">Direct Federal Inbox</p>
            
            <a
              href={`mailto:${companyInfo.email}`}
              class="mt-3 block text-sm sm:text-base font-semibold text-[#0B2553] hover:text-[#FF3130] transition-colors break-all"
            >
              {companyInfo.email}
            </a>
            <p class="text-xs text-slate-400 mt-0.5">Response within 24 business hours</p>
          </div>

          <div class="pt-6 text-center">
            <a
              href={`mailto:${companyInfo.email}`}
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full text-sm font-bold text-white bg-gradient-to-r from-[#FF3130] to-[#E02625] hover:from-[#E02625] hover:to-[#C61E1D] shadow-[0_6px_20px_-3px_rgba(255,49,48,0.28)] hover:shadow-[0_10px_24px_-2px_rgba(255,49,48,0.38)] hover:-translate-y-0.5 active:translate-y-0 transition-all cursor-pointer"
            >
              <span>Send Email</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- CARD 2: CALL US ANYTIME -->
        <div class="contact-reveal contact-delay-2 group relative rounded-2xl sm:rounded-3xl bg-white border border-slate-200/90 p-8 sm:p-9 shadow-[0_12px_35px_-8px_rgba(12,72,122,0.08)] hover:shadow-[0_20px_45px_-8px_rgba(12,72,122,0.16)] hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between overflow-hidden">
          <!-- Top Accent Border Bar (Navy Blue) -->
          <div class="absolute top-0 inset-x-0 h-1.5 bg-[#0C487A]"></div>

          <div class="text-center">
            <!-- Icon Badge with Dashed Outer Ring -->
            <div class="relative w-16 h-16 mx-auto flex items-center justify-center mb-5">
              <div class="absolute inset-0 rounded-full border-2 border-dashed border-[#0C487A]/35 animate-[spin_20s_linear_infinite]"></div>
              <div class="w-12 h-12 rounded-full bg-blue-50 text-[#0C487A] flex items-center justify-center group-hover:scale-105 transition-transform">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
            </div>

            <h3 class="text-xl font-bold text-[#0B2553]">Call Us Anytime</h3>
            <p class="text-xs text-slate-500 mt-1 uppercase tracking-wider font-semibold">Toll-Free Direct Line</p>
            
            <a
              href={`tel:${companyInfo.phoneRaw}`}
              class="mt-3 block text-sm sm:text-base font-bold text-[#0B2553] hover:text-[#0C487A] transition-colors"
            >
              {companyInfo.phone}
            </a>
            <p class="text-xs text-slate-400 mt-0.5">Mon&ndash;Fri, 9:00 AM &ndash; 6:00 PM EST</p>
          </div>

          <div class="pt-6 text-center">
            <a
              href={`tel:${companyInfo.phoneRaw}`}
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full text-sm font-bold text-white bg-gradient-to-r from-[#0C487A] to-[#0B2553] hover:from-[#0B2553] hover:to-[#081B3A] shadow-[0_6px_20px_-3px_rgba(12,72,122,0.28)] hover:shadow-[0_10px_24px_-2px_rgba(12,72,122,0.38)] hover:-translate-y-0.5 active:translate-y-0 transition-all cursor-pointer"
            >
              <span>Call Now</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- CARD 3: VISIT OUR OFFICE / BOOK A MEETING -->
        <div class="contact-reveal contact-delay-3 group relative rounded-2xl sm:rounded-3xl bg-white border border-slate-200/90 p-8 sm:p-9 shadow-[0_12px_35px_-8px_rgba(12,72,122,0.08)] hover:shadow-[0_20px_45px_-8px_rgba(12,72,122,0.16)] hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between overflow-hidden">
          <!-- Top Accent Border Bar (Brand Red) -->
          <div class="absolute top-0 inset-x-0 h-1.5 bg-[#FF3130]"></div>

          <div class="text-center">
            <!-- Icon Badge with Dashed Outer Ring -->
            <div class="relative w-16 h-16 mx-auto flex items-center justify-center mb-5">
              <div class="absolute inset-0 rounded-full border-2 border-dashed border-[#FF3130]/35 animate-[spin_20s_linear_infinite]"></div>
              <div class="w-12 h-12 rounded-full bg-red-50 text-[#FF3130] flex items-center justify-center group-hover:scale-105 transition-transform">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
            </div>

            <h3 class="text-xl font-bold text-[#0B2553]">Visit Our Office</h3>
            <p class="text-xs text-slate-500 mt-1 uppercase tracking-wider font-semibold">Corporate Headquarters</p>
            
            <p class="mt-3 text-sm sm:text-base font-semibold text-[#0B2553]">
              Frederick, MD 21702
            </p>
            <p class="text-xs text-slate-400 mt-0.5">NCR Corridor &bull; Near DC &amp; Fort Meade</p>
          </div>

          <div class="pt-6 text-center">
            <a
              href={hubspotMeetingUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full text-sm font-bold text-white bg-gradient-to-r from-[#FF3130] to-[#E02625] hover:from-[#E02625] hover:to-[#C61E1D] shadow-[0_6px_20px_-3px_rgba(255,49,48,0.28)] hover:shadow-[0_10px_24px_-2px_rgba(255,49,48,0.38)] hover:-translate-y-0.5 active:translate-y-0 transition-all cursor-pointer"
            >
              <span>Book a Meeting</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- Organic Pure CSS Wave Divider Transitioning from Hero into White Canvas -->
    <WaveDivider variant="wave" position="bottom" fillColor="#ffffff" />
  </section>

    <!-- Organic Pure CSS Wave Divider Transitioning from Hero into White Canvas -->
    <WaveDivider variant="wave" position="bottom" fillColor="#ffffff" />
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 2: "SEND US A MESSAGE" (Image 6 Split Layout)                     -->
  <!-- Left: Headline, Narrative & 3 Confidence Pills                            -->
  <!-- Right: Streamlined Project Brief & Inquiry Form                           -->
  <!-- ========================================================================= -->
  <section id="send-message" class="py-16 sm:py-24 lg:py-28 bg-white relative z-10" aria-label="Send Us a Message and Project Inquiry Form">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left Column (5 cols): Headline, Narrative & Confidence Pills -->
        <div class="lg:col-span-5 space-y-6 sm:space-y-8">
          
          <div class="contact-reveal">
            <!-- Main Section Title -->
            <h2 class="text-3xl sm:text-4xl font-extrabold text-[#0B2553] tracking-tight leading-tight">
              Send Us a Message
            </h2>

            <!-- Narrative Paragraphs -->
            <p class="mt-4 text-base text-slate-600 leading-relaxed font-normal">
              Fill out the form and our advisory team will get back to you as soon as possible. We are here to answer any questions regarding federal capture, RFP compliance, and security-cleared workforce solutions.
            </p>
            <p class="mt-3 text-sm text-slate-500 leading-relaxed font-normal">
              If you have an active solicitation deadline or teaming requirement, our senior capture leads will review your scope under a mutual non-disclosure agreement.
            </p>
          </div>

          <!-- 3 Confidence Pills in Executive Blue with Brand Red Checkmark Badge -->
          <div class="space-y-3.5 pt-1">
            <!-- Pill 1 -->
            <div class="contact-reveal contact-delay-2 group flex items-center gap-3.5 px-5 py-4 rounded-lg bg-[#F4F8FC] border border-[#0C487A]/15 text-[#0B2553] text-sm font-semibold shadow-2xs hover:bg-[#EBF3FA] hover:border-[#0C487A]/25 transition-all duration-200">
              <div class="w-6 h-6 rounded-full bg-red-50 text-[#FF3130] border border-[#FF3130]/25 flex items-center justify-center shrink-0 shadow-2xs group-hover:bg-[#FF3130] group-hover:text-white transition-all duration-200">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.8" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span>Quick response within 24 hours on business days</span>
            </div>

            <!-- Pill 2 -->
            <div class="contact-reveal contact-delay-3 group flex items-center gap-3.5 px-5 py-4 rounded-lg bg-[#F4F8FC] border border-[#0C487A]/15 text-[#0B2553] text-sm font-semibold shadow-2xs hover:bg-[#EBF3FA] hover:border-[#0C487A]/25 transition-all duration-200">
              <div class="w-6 h-6 rounded-full bg-red-50 text-[#FF3130] border border-[#FF3130]/25 flex items-center justify-center shrink-0 shadow-2xs group-hover:bg-[#FF3130] group-hover:text-white transition-all duration-200">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.8" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span>Confidential proposal reviews under standard NDA</span>
            </div>

            <!-- Pill 3 -->
            <div class="contact-reveal contact-delay-4 group flex items-center gap-3.5 px-5 py-4 rounded-lg bg-[#F4F8FC] border border-[#0C487A]/15 text-[#0B2553] text-sm font-semibold shadow-2xs hover:bg-[#EBF3FA] hover:border-[#0C487A]/25 transition-all duration-200">
              <div class="w-6 h-6 rounded-full bg-red-50 text-[#FF3130] border border-[#FF3130]/25 flex items-center justify-center shrink-0 shadow-2xs group-hover:bg-[#FF3130] group-hover:text-white transition-all duration-200">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.8" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span>Direct guidance from senior GovCon capture leads</span>
            </div>
          </div>

        </div>

        <!-- Right Column (7 cols): Clean Contact Form -->
        <div class="lg:col-span-7 contact-reveal contact-delay-2">
          <ContactForm />
        </div>

      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SCROLL REVEAL ANIMATION STYLES & INTERSECTION OBSERVER SCRIPT            -->
  <!-- ========================================================================= -->
  <style is:global>
    /* Viewport Scroll Reveal (Harmonized with about-us.astro & career.astro) */
    .contact-reveal {
      opacity: 0;
      transform: translateY(28px);
      filter: blur(6px);
      will-change: opacity, transform, filter;
      transition:
        opacity 750ms cubic-bezier(0.16, 1, 0.3, 1),
        transform 750ms cubic-bezier(0.16, 1, 0.3, 1),
        filter 750ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .contact-reveal.is-visible {
      opacity: 1 !important;
      transform: translateY(0) !important;
      filter: blur(0) !important;
    }

    .contact-delay-1 { transition-delay: 90ms; }
    .contact-delay-2 { transition-delay: 180ms; }
    .contact-delay-3 { transition-delay: 270ms; }
    .contact-delay-4 { transition-delay: 360ms; }
    .contact-delay-5 { transition-delay: 450ms; }

    /* Floating Levitation on Hero Visual (Exact 6.5s matching career.astro & about-us.astro) */
    @keyframes contactFloatLevitation {
      0%, 100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-10px);
      }
    }

    .contact-float {
      animation: contactFloatLevitation 6.5s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      .contact-reveal {
        opacity: 1 !important;
        transform: none !important;
        filter: none !important;
        transition: none !important;
      }
      .contact-float {
        animation: none !important;
      }
    }
  </style>

  <script>
    function setupContactScrollReveal() {
      const elements = document.querySelectorAll<HTMLElement>('.contact-reveal');
      if (!elements.length) return;

      if (!('IntersectionObserver' in window)) {
        elements.forEach((el) => el.classList.add('is-visible'));
        return;
      }

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              obs.unobserve(entry.target);
            }
          });
        },
        {
          root: null,
          rootMargin: '0px 0px -6% 0px',
          threshold: 0.1,
        }
      );

      elements.forEach((el) => observer.observe(el));
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupContactScrollReveal);
    } else {
      setupContactScrollReveal();
    }
    document.addEventListener('astro:page-load', setupContactScrollReveal);
  </script>

</MainLayout>
