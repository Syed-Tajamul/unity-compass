---
import MainLayout from '../layouts/MainLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { companyInfo } from '../data/company';
---

<MainLayout
  title="Contact Unity Compass | Get in Touch Today"
  description="Contact Unity Compass for staffing, consulting, and proposal dev support. Reach our Frederick, MD team for inquiries and federal consultation."
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-slate-900 to-brand-dark text-white py-16 sm:py-24 border-b border-slate-800 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center max-w-3xl">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-brand-red/20 text-red-400 border border-brand-red/30 mb-4">
        Direct Federal Advisory
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight">
        Contact Unity Compass
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
        Let’s discuss your federal contracting goals, upcoming RFPs, or security-cleared staffing needs. Our team responds within one business day.
      </p>
    </div>
  </section>

  <!-- Main Contact Section -->
  <section class="py-16 sm:py-24 bg-slate-50" aria-label="Contact Details and Inquiry Form">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Left: Corporate Contact Card -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-white rounded-2xl p-8 border border-slate-200/80 shadow-subtle space-y-8">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-brand-red">Contact Information</span>
              <h2 class="text-2xl font-bold text-slate-900 tracking-tight mt-1">Get In Touch</h2>
              <p class="text-sm text-slate-500 mt-2">
                Reach our corporate headquarters in Frederick, Maryland, or connect directly with our GovCon capture leads.
              </p>
            </div>

            <div class="space-y-6 text-sm">
              <!-- Address -->
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-slate-100 text-brand-slate flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Corporate Address</h4>
                  <p class="font-semibold text-slate-900 mt-0.5 leading-snug">{companyInfo.address.full}</p>
                </div>
              </div>

              <!-- Phone -->
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-slate-100 text-brand-slate flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Toll-Free Phone</h4>
                  <a href={`tel:${companyInfo.phoneRaw}`} class="font-semibold text-brand-navy hover:text-brand-red transition-colors block mt-0.5">
                    {companyInfo.phone}
                  </a>
                  <p class="text-xs text-slate-400">Monday &ndash; Friday, 9:00 AM &ndash; 6:00 PM EST</p>
                </div>
              </div>

              <!-- Email -->
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-xl bg-slate-100 text-brand-slate flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Email Inquiry</h4>
                  <a href={`mailto:${companyInfo.email}`} class="font-semibold text-brand-navy hover:text-brand-red transition-colors block mt-0.5">
                    {companyInfo.email}
                  </a>
                  <a href={`mailto:${companyInfo.infoEmail}`} class="text-xs text-slate-500 hover:text-brand-navy transition-colors block">
                    {companyInfo.infoEmail}
                  </a>
                </div>
              </div>
            </div>

            <!-- Social Links -->
            <div class="pt-6 border-t border-slate-100">
              <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Connect Online</h4>
              <div class="flex items-center gap-3">
                <a
                  href={companyInfo.social.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2 rounded-lg bg-slate-100 text-slate-700 hover:text-white hover:bg-brand-navy transition-colors text-xs font-semibold flex items-center gap-2"
                >
                  <span>LinkedIn</span>
                </a>
                <a
                  href={companyInfo.social.twitter}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2 rounded-lg bg-slate-100 text-slate-700 hover:text-white hover:bg-slate-900 transition-colors text-xs font-semibold flex items-center gap-2"
                >
                  <span>X (Twitter)</span>
                </a>
                <a
                  href={companyInfo.social.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-2 rounded-lg bg-slate-100 text-slate-700 hover:text-white hover:bg-brand-red transition-colors text-xs font-semibold flex items-center gap-2"
                >
                  <span>Instagram</span>
                </a>
              </div>
            </div>

            <!-- Capability PDF Direct Download -->
            <div class="pt-2">
              <a
                href={companyInfo.capabilityPdf}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between p-4 rounded-xl bg-slate-900 text-white hover:bg-slate-800 transition-colors group"
              >
                <div>
                  <span class="text-[10px] font-bold uppercase tracking-wider text-brand-red">Official Document</span>
                  <p class="text-sm font-bold text-white mt-0.5">Corporate Capability Statement</p>
                  <p class="text-xs text-slate-400">2-page executive GovCon portfolio (PDF)</p>
                </div>
                <svg class="w-5 h-5 text-slate-400 group-hover:text-white group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Right: Interactive Contact Form -->
        <div class="lg:col-span-7">
          <ContactForm />
        </div>

      </div>
    </div>
  </section>
</MainLayout>

