        </div>

        <!-- Right Column (7 cols): The Enhanced Project Brief Form (matching Image 6) -->
        <div class="lg:col-span-7">
          <ContactForm />
        </div>

      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 3: 3-STEP ENGAGEMENT ROADMAP                                      -->
  <!-- Transparent, Disciplined Onboarding Protocol                              -->
  <!-- ========================================================================= -->
  <section class="py-16 sm:py-20 bg-slate-50 border-t border-slate-200/80" aria-labelledby="roadmap-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-[#FF3130]">Client Onboarding Protocol</span>
        <h2 id="roadmap-heading" class="text-2xl sm:text-3xl font-extrabold text-[#0B2553] tracking-tight mt-1">
          How We Engage With New Partners
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-2 leading-relaxed">
          From first contact to live project delivery, our engagement process is fast, disciplined, and transparent.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {engagementSteps.map((item) => (
          <div class="bg-white rounded-3xl p-8 border border-slate-200/90 shadow-[0_10px_25px_-5px_rgba(12,72,122,0.06)] relative flex flex-col justify-between hover:shadow-[0_16px_36px_-4px_rgba(12,72,122,0.12)] hover:-translate-y-1 transition-all duration-300">
            <div>
              <div class="flex items-center justify-between mb-6">
                <span class="text-3xl font-black text-slate-200 font-mono tracking-tighter">{item.step}</span>
                <div class="w-10 h-10 rounded-xl bg-blue-50 text-[#0C487A] border border-blue-100 flex items-center justify-center">
                  <svg class="w-5 h-5 text-[#0C487A]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
                  </svg>
                </div>
              </div>
              <h3 class="text-lg font-bold text-[#0B2553] mb-2.5">{item.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed font-normal">{item.desc}</p>
            </div>
            <div class="pt-6 mt-6 border-t border-slate-100 flex items-center text-xs font-bold text-[#0C487A]">
              <span>Verified Capture Phase</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 4: FREQUENTLY ASKED ADVISORY QUESTIONS (FAQ)                     -->
  <!-- Crisp, Authoritative Clarifications for Prime Contractors & Clients      -->
  <!-- ========================================================================= -->
  <section class="py-16 sm:py-24 bg-white" aria-labelledby="faq-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-[#FF3130]">Procurement &amp; Engagement FAQ</span>
        <h2 id="faq-heading" class="text-2xl sm:text-3xl font-extrabold text-[#0B2553] tracking-tight mt-1">
          Frequently Asked Questions
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-2 leading-relaxed">
          Common questions regarding contract mechanisms, security clearances, and proposal mobilization.
        </p>
      </div>

      <div class="max-w-4xl mx-auto space-y-4">
        {faqs.map((faq) => (
          <details class="group bg-slate-50/70 border border-slate-200/80 rounded-2xl p-5 sm:p-6 transition-all duration-200 open:bg-white open:shadow-[0_10px_25px_-5px_rgba(12,72,122,0.08)] open:border-[#0C487A]/30 cursor-pointer">
            <summary class="flex items-center justify-between font-bold text-base sm:text-lg text-[#0B2553] list-none select-none">
              <span class="pr-4">{faq.question}</span>
              <div class="w-8 h-8 rounded-full bg-white border border-slate-200/80 text-slate-500 group-open:bg-[#0C487A] group-open:text-white flex items-center justify-center shrink-0 transition-colors">
                <svg class="w-4 h-4 transform group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </summary>
            <p class="mt-4 text-sm sm:text-base text-slate-600 leading-relaxed font-normal pt-2 border-t border-slate-100">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

</MainLayout>
