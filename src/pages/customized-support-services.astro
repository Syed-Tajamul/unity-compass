---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContactForm from '../components/ContactForm.astro';
import { servicesData } from '../data/services';
import { companyInfo } from '../data/company';

const service = servicesData.find((s) => s.id === 'customized-support-services')!;
---

<MainLayout
  title={`${service.title} - Unity Compass`}
  description="Customized service support tailored to your needs. At Unity Compass, we deliver bespoke business, IT, staffing, and proposal solutions."
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-slate-900 to-brand-dark text-white py-16 sm:py-24 border-b border-slate-800 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-5">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-brand-red/20 text-red-400 border border-brand-red/30">
            Tailored GovCon Solutions
          </span>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
            Customized Service Support Tailored to Your Needs
          </h1>
          <p class="text-lg text-slate-300 font-medium leading-relaxed">
            {service.heroHeadline}
          </p>
          <p class="text-sm sm:text-base text-slate-400 leading-relaxed">
            {service.leadParagraph}
          </p>
          <div class="pt-3 flex flex-wrap items-center gap-4">
            <Button href="/contact" variant="primary" size="md">
              Discuss Custom Engagement
            </Button>
            <a
              href={companyInfo.capabilityPdf}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-semibold text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 transition-colors"
            >
              <svg class="w-4 h-4 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>Download Capability PDF</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden border border-slate-700 shadow-2xl bg-slate-800">
            <img
              src={service.image}
              alt={service.title}
              class="w-full h-auto object-cover"
              width="600"
              height="400"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Four Pillars of Customized Support -->
  <section class="py-16 sm:py-24 bg-white" aria-labelledby="custom-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Custom Offerings"
        title="Our Customized Service Pillars"
        description="We understand that off-the-shelf solutions don’t always address the complexities of your business. We engineer bespoke interventions that fit."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- 1. Tailored Business Solutions -->
        <div class="gov-card">
          <div class="w-12 h-12 rounded-xl bg-brand-navy/10 text-brand-navy flex items-center justify-center mb-5">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 tracking-tight">Tailored Business Solutions</h3>
          <p class="mt-3 text-sm text-slate-600 leading-relaxed">
            We understand that off-the-shelf solutions don’t always address the complexities of your business. At UC, we work closely with you to develop strategies and processes that are uniquely tailored to your needs, helping you overcome obstacles and seize opportunities effectively.
          </p>
        </div>

        <!-- 2. IT Support Services -->
        <div class="gov-card">
          <div class="w-12 h-12 rounded-xl bg-brand-red/10 text-brand-red flex items-center justify-center mb-5">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 tracking-tight">IT Support Services</h3>
          <p class="mt-3 text-sm text-slate-600 leading-relaxed">
            From optimizing your IT infrastructure to implementing cutting-edge technologies, we provide IT solutions that are as unique as your business. Whether it’s system maintenance, cybersecurity, or software customization, our team ensures your IT environment supports your long-term growth.
          </p>
        </div>

        <!-- 3. Staffing & Recruitment -->
        <div class="gov-card">
          <div class="w-12 h-12 rounded-xl bg-brand-navy/10 text-brand-navy flex items-center justify-center mb-5">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 tracking-tight">Staffing & Recruitment</h3>
          <p class="mt-3 text-sm text-slate-600 leading-relaxed">
            Finding the right talent is critical for any business. Our customized staffing solutions are designed to match you with professionals who not only meet your technical requirements but also align with your company culture and mission goals.
          </p>
        </div>

        <!-- 4. Proposal Development & Business Assistance -->
        <div class="gov-card">
          <div class="w-12 h-12 rounded-xl bg-brand-red/10 text-brand-red flex items-center justify-center mb-5">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 tracking-tight">Proposal Development & Business Assistance</h3>
          <p class="mt-3 text-sm text-slate-600 leading-relaxed">
            For federal contractors and commercial entities, we provide comprehensive support in proposal development, documentation, and compliance. Our experts help you craft compelling proposals that enhance your chances of success.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section class="py-16 sm:py-24 bg-slate-50 border-t border-slate-200/80">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <ContactForm />
    </div>
  </section>
</MainLayout>

