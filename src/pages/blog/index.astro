---
/**
 * index.astro - Insights & GovCon Intelligence Hub
 * 
 * Fully harmonized with Unity Compass Design System:
 * - Sky blueprint canvas (#F4F8FC via #EBF3FA to #DFEDF8) with technical 16px checks
 * - Category filter pills with active state
 * - Live search filtering
 * - Featured article spotlight card
 * - Signature GovCon article cards with smooth zoom hover
 * - Pure CSS WaveDivider transition
 */
import MainLayout from '../../layouts/MainLayout.astro';
import WaveDivider from '../../components/WaveDivider.astro';
import { blogPosts as fallbackPosts, type BlogPost } from '../../data/blogPosts';
import { supabase, isSupabaseConfigured } from '../../lib/supabase';

let blogPosts: BlogPost[] = fallbackPosts;

if (isSupabaseConfigured && supabase) {
  try {
    const { data, error } = await supabase
      .from('blogs')
      .select('*')
      .eq('is_published', true)
      .order('created_at', { ascending: false });

    if (!error && data && data.length > 0) {
      blogPosts = data.map((d: any) => ({
        slug: d.slug,
        title: d.title,
        date: d.date,
        author: d.author || 'Unity Compass Team',
        readTime: d.read_time || '5 min read',
        category: d.category,
        excerpt: d.excerpt,
        image: d.image,
        contentBlocks: Array.isArray(d.content_blocks) ? d.content_blocks : JSON.parse(d.content_blocks || '[]'),
      }));
    }
  } catch (err) {
    console.error('Failed to load blogs from Supabase, using local fallback:', err);
  }
}

const featuredPost = blogPosts[0];
const remainingPosts = blogPosts.slice(1);
const categories = ['All', ...Array.from(new Set(blogPosts.map((p) => p.category)))];
---

<MainLayout
  title="Insights & Intelligence - Unity Compass | GovCon Strategies"
  description="Actionable intelligence, federal proposal best practices, cleared staffing trends, and defense compliance insights from Unity Compass."
>
  <!-- ========================================================================= -->
  <!-- SECTION 1: HERO & CATEGORY BAR                                            -->
  <!-- ========================================================================= -->
  <section class="relative overflow-hidden bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] pt-16 sm:pt-20 lg:pt-24 pb-24 sm:pb-32 lg:pb-36" aria-labelledby="blog-hero-heading">
    <!-- Technical Blueprint Check Pattern -->
    <div
      class="absolute inset-0 opacity-[0.24] mix-blend-multiply pointer-events-none"
      style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.08) 1px, transparent 1px);"
      aria-hidden="true"
    ></div>

    <!-- Soft Ambient Radial Blue Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[radial-gradient(circle,rgba(12,72,122,0.11)_0%,rgba(30,64,175,0.05)_45%,transparent_70%)] rounded-full blur-3xl pointer-events-none -z-10" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
      <!-- Header Area -->
      <div class="text-center max-w-3xl mx-auto">
        <!-- Eyebrow Pill -->
        <span class="scroll-reveal inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-[#FF3130]/10 text-[#FF3130] border border-[#FF3130]/20 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#FF3130] animate-pulse"></span>
          GovCon Intelligence &amp; Analysis
        </span>

        <!-- Headline -->
        <h1
          id="blog-hero-heading"
          class="scroll-reveal delay-100 text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-[#0B2553] leading-[1.16]"
        >
          Insights, Trends &amp; <span class="text-[#FF3130]">Capture Strategies</span>
        </h1>

        <!-- Subtitle -->
        <p class="scroll-reveal delay-150 mt-4 text-base sm:text-lg text-[#243A5E] leading-[1.75] max-w-2xl mx-auto font-normal">
          Actionable intelligence on federal proposal development, security-cleared recruitment, AI-driven compliance, and agile staffing strategies.
        </p>

        <!-- Search Bar -->
        <div class="scroll-reveal delay-200 mt-8 max-w-xl mx-auto">
          <div class="relative">
            <svg class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              id="blog-search-input"
              placeholder="Search insights by topic, RFP keywords, or clearance..."
              class="w-full pl-12 pr-4 py-3.5 text-sm rounded-2xl border border-slate-200/90 bg-white/90 backdrop-blur-sm text-[#0B2553] shadow-[0_8px_25px_-5px_rgba(12,72,122,0.08)] focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] transition-all placeholder:text-slate-400"
            />
          </div>
        </div>

        <!-- Category Filter Pills -->
        <div class="scroll-reveal delay-250 mt-6 flex flex-wrap items-center justify-center gap-2">
          {categories.map((cat, idx) => (
            <button
              type="button"
              class={`blog-category-pill px-4 py-1.5 rounded-full text-xs font-bold transition-all cursor-pointer ${
                idx === 0
                  ? 'active bg-[#0B2553] text-white shadow-xs'
                  : 'bg-white/80 text-[#243A5E] hover:bg-white border border-slate-200/80 shadow-xs'
              }`}
              data-category={cat}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Pure CSS WaveDivider Leading into Articles Section -->
    <WaveDivider variant="wave" position="bottom" fillColor="#ffffff" />
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 2: ARTICLES DIRECTORY & FEATURED ARTICLE                          -->
  <!-- ========================================================================= -->
  <section class="relative bg-white py-16 sm:py-24" aria-label="Articles Directory">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Featured Story Spotlight (If exists) -->
      {featuredPost && (
        <div id="featured-article-card" class="scroll-reveal group relative rounded-3xl bg-gradient-to-br from-[#F4F8FC] to-white border border-slate-200/90 p-6 sm:p-10 shadow-[0_12px_35px_-8px_rgba(12,72,122,0.08)] hover:shadow-[0_20px_45px_-8px_rgba(12,72,122,0.14)] transition-all duration-300 overflow-hidden">
          <!-- Top Accent Stripe -->
          <div class="absolute top-0 inset-x-0 h-1.5 bg-[#FF3130]"></div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <!-- Image Frame with Zoom Hover -->
            <div class="lg:col-span-6 aspect-[16/10] overflow-hidden rounded-2xl bg-slate-100 border border-slate-200 relative shadow-sm">
              <img
                src={featuredPost.image}
                alt={featuredPost.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="eager"
              />
              <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-white/95 text-[#FF3130] border border-red-200/80 shadow-xs backdrop-blur-sm">
                Featured Analysis
              </span>
            </div>

            <!-- Content Column -->
            <div class="lg:col-span-6 space-y-4">
              <div class="flex items-center gap-2 text-xs font-semibold text-slate-500">
                <span class="text-[#FF3130] uppercase tracking-wider">{featuredPost.category}</span>
                <span>•</span>
                <span>{featuredPost.readTime}</span>
                <span>•</span>
                <span>{featuredPost.date}</span>
              </div>

              <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0B2553] tracking-tight leading-snug group-hover:text-[#0C487A] transition-colors">
                <a href={`/blog/${featuredPost.slug}`}>
                  {featuredPost.title}
                </a>
              </h2>

              <p class="text-sm sm:text-base text-[#243A5E] leading-relaxed font-normal">
                {featuredPost.excerpt}
              </p>

              <div class="pt-2 flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-full bg-[#0B2553] text-white flex items-center justify-center font-bold text-xs">
                    UC
                  </div>
                  <div>
                    <p class="text-xs font-bold text-[#0B2553]">{featuredPost.author}</p>
                    <p class="text-[11px] text-slate-400">Unity Compass Editorial</p>
                  </div>
                </div>

                <a
                  href={`/blog/${featuredPost.slug}`}
                  class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#FF3130] hover:text-[#E02625] group-hover:translate-x-1 transition-all"
                >
                  <span>Read Article</span>
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      )}

      <!-- All Articles Grid -->
      <div id="blog-posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {blogPosts.map((post, idx) => (
          <article
            class="blog-post-card group relative rounded-3xl bg-white border border-slate-200/90 p-6 sm:p-7 shadow-[0_10px_30px_-6px_rgba(12,72,122,0.06)] hover:shadow-[0_20px_45px_-8px_rgba(12,72,122,0.14)] hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between overflow-hidden"
            data-title={post.title.toLowerCase()}
            data-category={post.category}
            data-excerpt={post.excerpt.toLowerCase()}
          >
            <!-- Top Color Stripe -->
            <div class={`absolute top-0 inset-x-0 h-1.5 ${idx % 2 === 0 ? 'bg-[#0B2553]' : 'bg-[#FF3130]'}`}></div>

            <div>
              <!-- Cover Image with Zoom Effect -->
              <a href={`/blog/${post.slug}`} class="block aspect-[16/10] overflow-hidden rounded-2xl bg-slate-100 mb-5 border border-slate-200/80 relative">
                <img
                  src={post.image}
                  alt={post.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </a>

              <!-- Meta Pill Row -->
              <div class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-2.5">
                <span class="text-[#FF3130] uppercase tracking-wider text-[11px] font-bold">
                  {post.category}
                </span>
                <span>•</span>
                <span>{post.readTime}</span>
              </div>

              <!-- Title -->
              <h3 class="text-lg font-bold text-[#0B2553] tracking-tight leading-snug group-hover:text-[#0C487A] transition-colors line-clamp-2">
                <a href={`/blog/${post.slug}`}>
                  {post.title}
                </a>
              </h3>

              <!-- Excerpt -->
              <p class="text-xs sm:text-sm text-[#243A5E] mt-2.5 leading-relaxed line-clamp-3 font-normal">
                {post.excerpt}
              </p>
            </div>

            <!-- Footer Author & Date -->
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-400 font-medium">
                {post.date}
              </span>
              <a
                href={`/blog/${post.slug}`}
                class="inline-flex items-center gap-1 font-bold text-[#FF3130] hover:text-[#E02625] group-hover:translate-x-1 transition-all"
              >
                <span>Read</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- No Articles Found Empty State -->
      <div id="no-blogs-found" class="hidden text-center py-16 px-6 rounded-3xl border border-dashed border-slate-300 bg-slate-50/70">
        <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-red-50 text-[#FF3130] flex items-center justify-center">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
        </div>
        <h4 class="text-lg font-bold text-[#0B2553]">No articles found</h4>
        <p class="text-xs sm:text-sm text-[#243A5E] mt-1.5 max-w-md mx-auto">
          We couldn't find any articles matching your search query. Try searching for broader terms like "OASIS+", "staffing", or "capture".
        </p>
      </div>

    </div>
  </section>
</MainLayout>

<!-- Client-side Interactive Search & Category Filter Script -->
<script>
  const searchInput = document.getElementById('blog-search-input') as HTMLInputElement;
  const categoryPills = document.querySelectorAll<HTMLButtonElement>('.blog-category-pill');
  const postCards = document.querySelectorAll<HTMLElement>('.blog-post-card');
  const noBlogsFound = document.getElementById('no-blogs-found');
  const featuredArticleCard = document.getElementById('featured-article-card');

  let activeCategory = 'All';

  function filterPosts() {
    const query = searchInput?.value.toLowerCase().trim() || '';
    let visibleCount = 0;

    postCards.forEach((card) => {
      const title = card.getAttribute('data-title') || '';
      const category = card.getAttribute('data-category') || '';
      const excerpt = card.getAttribute('data-excerpt') || '';

      const matchesSearch = !query || title.includes(query) || excerpt.includes(query) || category.toLowerCase().includes(query);
      const matchesCategory = activeCategory === 'All' || category === activeCategory;

      if (matchesSearch && matchesCategory) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    // Toggle featured card if filtering by category or query
    if (featuredArticleCard) {
      if (query || activeCategory !== 'All') {
        featuredArticleCard.style.display = 'none';
      } else {
        featuredArticleCard.style.display = 'block';
      }
    }

    if (noBlogsFound) {
      if (visibleCount === 0) {
        noBlogsFound.classList.remove('hidden');
      } else {
        noBlogsFound.classList.add('hidden');
      }
    }
  }

  searchInput?.addEventListener('input', filterPosts);

  categoryPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      categoryPills.forEach((p) => {
        p.classList.remove('bg-[#0B2553]', 'text-white');
        p.classList.add('bg-white/80', 'text-[#243A5E]');
      });

      pill.classList.add('bg-[#0B2553]', 'text-white');
      pill.classList.remove('bg-white/80', 'text-[#243A5E]');

      activeCategory = pill.getAttribute('data-category') || 'All';
      filterPosts();
    });
  });
</script>
