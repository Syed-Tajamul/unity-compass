---
/**
 * index.astro - Insights & GovCon Intelligence Hub
 * 
 * Fully harmonized with Unity Compass Design System:
 * - Sky blueprint split-screen Hero with 3D isometric visual (blog-960.webp)
 * - Harmonized animations, floating levitation, and blur-to-sharp scroll-reveals
 * - Clean search bar & category filter pills
 * - Uniform articles grid with continuous animated gradient border on cards
 * - Smooth elevation and zoom hover effects
 * - Pure CSS WaveDivider transition
 */
import MainLayout from '../../layouts/MainLayout.astro';
import WaveDivider from '../../components/WaveDivider.astro';
import { blogPosts as fallbackPosts, type BlogPost } from '../../data/blogPosts';
import { supabase, isSupabaseConfigured } from '../../lib/supabase';

let blogPosts: BlogPost[] = fallbackPosts;

if (isSupabaseConfigured && supabase) {
  try {
    const { data, error } = await supabase
      .from('blogs')
      .select('*')
      .eq('is_published', true)
      .order('created_at', { ascending: false });

    if (!error && data && data.length > 0) {
      blogPosts = data.map((d: any) => ({
        slug: d.slug,
        title: d.title,
        date: d.date,
        author: d.author || 'Unity Compass Team',
        readTime: d.read_time || '5 min read',
        category: d.category,
        excerpt: d.excerpt,
        image: d.image,
        contentBlocks: Array.isArray(d.content_blocks) ? d.content_blocks : JSON.parse(d.content_blocks || '[]'),
      }));
    }
  } catch (err) {
    console.error('Failed to load blogs from Supabase, using local fallback:', err);
  }
}

const categories = ['All', ...Array.from(new Set(blogPosts.map((p) => p.category)))];
---

<MainLayout
  title="Insights & Intelligence - Unity Compass | GovCon Strategies"
  description="Actionable intelligence on federal proposal development, security-cleared recruitment, AI-driven compliance, and agile staffing strategies across DoD and civilian agencies."
>
  <!-- ========================================================================= -->
  <!-- SECTION 1: HERO (Sophisticated Split-Screen Layout with 3D Visual)         -->
  <!-- ========================================================================= -->
  <section
    class="relative min-h-[560px] sm:min-h-[600px] lg:min-h-[640px] flex items-center overflow-hidden bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] pt-16 sm:pt-20 lg:pt-24 pb-20 sm:pb-28"
    aria-labelledby="blog-hero-heading"
  >
    <!-- Technical Blueprint Check Pattern (Matching Homepage & Careers) -->
    <div
      class="absolute inset-0 opacity-[0.24] mix-blend-multiply pointer-events-none"
      style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.08) 1px, transparent 1px);"
      aria-hidden="true"
    ></div>

    <!-- Soft Ambient Radial Blue Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[radial-gradient(circle,rgba(12,72,122,0.11)_0%,rgba(30,64,175,0.05)_45%,transparent_70%)] rounded-full blur-3xl pointer-events-none -z-10" aria-hidden="true"></div>

    <div class="max-w-7xl xl:max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-[0.94fr_1.06fr] gap-8 items-center">
        
        <!-- LEFT COLUMN: Headline, Description & CTAs -->
        <div class="max-w-2xl">
          <!-- Headline with Homepage Hero Line-Height & Signature Animated Radiant Gradient -->
          <h1
            id="blog-hero-heading"
            class="hero-heading-reveal text-3xl sm:text-4xl lg:text-[2.75rem] xl:text-[3.15rem] font-extrabold tracking-tight leading-[1.18] sm:leading-[1.20]"
          >
            <span class="hero-shimmer-title-line hero-shimmer-title-line-1 block">
              Insights, Trends &amp;
            </span>
            <span class="hero-shimmer-title-line hero-shimmer-title-line-2 block">
              Capture Strategies.
            </span>
          </h1>

          <!-- Description with Relaxed Homepage Hero Line-Height -->
          <p class="hero-subheading-reveal mt-5 sm:mt-6 text-base sm:text-lg text-[#243A5E] leading-[1.78] sm:leading-[1.82] font-normal max-w-xl">
            Actionable intelligence on federal proposal development, security-cleared recruitment, AI-driven compliance, and agile staffing strategies across DoD and civilian environments.
          </p>

          <!-- Primary CTA Button (Explore Articles) -->
          <div class="hero-cta-btn-1 mt-8 sm:mt-10 flex flex-wrap items-center gap-4">
            <a
              href="#articles"
              class="inline-flex items-center justify-center gap-3 px-8 sm:px-9 py-4 rounded-md sm:rounded-lg bg-gradient-to-r from-[#FF3130] to-[#E02625] hover:from-[#E02625] hover:to-[#C61E1D] text-white text-base font-bold shadow-[0_8px_24px_-4px_rgba(255,49,48,0.25)] hover:shadow-[0_12px_28px_-2px_rgba(255,49,48,0.35)] cursor-pointer whitespace-nowrap transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
            >
              <span>Explore Articles</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- RIGHT COLUMN: 3D Isometric Art Sized Exactly as in career.astro & about-us.astro -->
        <div class="hero-artwork-reveal relative mx-auto w-full max-w-2xl flex items-center justify-center" aria-hidden="true">
          <!-- Ambient Blue Shadow Diffusion & Ground Glow -->
          <div class="absolute inset-x-[12%] bottom-[5%] h-[24%] rounded-full bg-[#0C487A]/15 blur-3xl pointer-events-none"></div>
          
          <!-- Clean 3D Transparent Illustration (Sized to max-w-2xl with blog-float levitation) -->
          <img
            src="/images/blog-960.webp"
            srcset="/images/blog-960.webp 960w, /images/blog.webp 2444w"
            sizes="(min-width: 1280px) 672px, (min-width: 1024px) 52vw, 100vw"
            alt="Unity Compass GovCon Insights & Intelligence"
            class="blog-float relative h-auto w-full object-contain drop-shadow-[0_24px_22px_rgba(15,39,74,0.14)]"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="2444"
            height="1375"
            onerror="this.src='/images/blog.png'"
          />
        </div>

      </div>
    </div>

    <!-- Pure CSS WaveDivider Leading into Articles Section -->
    <WaveDivider variant="wave" position="bottom" fillColor="#ffffff" />
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 2: ARTICLES DIRECTORY, SEARCH & CATEGORY HUB                      -->
  <!-- ========================================================================= -->
  <section id="articles" class="relative bg-white pt-16 sm:pt-24 pb-24 sm:pb-32" aria-labelledby="articles-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 sm:space-y-16">
      
      <!-- Section Heading with Gradient Shimmer & Homepage Line-Height -->
      <div class="text-center max-w-3xl mx-auto">
        <h2
          id="articles-heading"
          class="blog-reveal text-2xl sm:text-3xl md:text-4xl lg:text-[2.65rem] font-extrabold tracking-tight leading-[1.32] sm:leading-[1.40] text-center"
        >
          <span class="service-shimmer-center service-shimmer-line-1 block pb-2.5 pt-1">Explore Latest Articles &amp; Advisory Briefs</span>
        </h2>

        <!-- Brand Accent Bar -->
        <div class="blog-reveal blog-delay-1 w-24 h-1.5 rounded-full bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130] mx-auto mt-4 mb-5"></div>

        <p class="blog-reveal blog-delay-1 mt-2 text-base sm:text-lg text-[#243A5E] leading-[1.78] sm:leading-[1.82] font-normal max-w-2xl mx-auto">
          Curated strategies, contracting best practices, and executive insights from our senior capture directors.
        </p>
      </div>

      <!-- Search & Category Filter Bar -->
      <div class="blog-reveal blog-delay-2 bg-slate-50/80 rounded-3xl border border-slate-200/90 p-5 sm:p-7 shadow-[0_10px_30px_-6px_rgba(12,72,122,0.06)] space-y-5">
        <!-- Live Search Input -->
        <div class="relative max-w-2xl mx-auto">
          <svg class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            id="blog-search-input"
            placeholder="Search insights by topic, RFP keywords, or clearance..."
            class="w-full pl-12 pr-4 py-3.5 text-sm rounded-2xl border border-slate-200 bg-white text-[#0B2553] shadow-xs focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] transition-all placeholder:text-slate-400 font-medium"
          />
        </div>

        <!-- Category Filter Pills -->
        <div class="flex flex-wrap items-center justify-center gap-2 pt-1" role="tablist" aria-label="Article Categories">
          {categories.map((cat, idx) => (
            <button
              type="button"
              class={`blog-category-pill px-4 py-2 rounded-md sm:rounded-lg text-xs sm:text-sm font-bold transition-all cursor-pointer shadow-xs ${
                idx === 0
                  ? 'active bg-[#0B2553] text-white shadow-md'
                  : 'bg-white text-[#243A5E] hover:bg-slate-100 hover:text-[#0B2553] border border-slate-200/80'
              }`}
              data-category={cat}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- All Articles Grid with Viewport Stagger & Smooth Elevation -->
      <div id="blog-posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {blogPosts.map((post, idx) => (
          <article
            class="blog-post-card blog-reveal group relative rounded-2xl sm:rounded-3xl bg-white border border-slate-200/90 p-6 sm:p-7 shadow-[0_10px_30px_-6px_rgba(12,72,122,0.06)] hover:shadow-[0_22px_45px_-8px_rgba(12,72,122,0.14)] hover:-translate-y-2 transition-all duration-300 flex flex-col justify-between overflow-hidden"
            style={`transition-delay: ${idx * 90}ms;`}
            data-title={post.title.toLowerCase()}
            data-category={post.category}
            data-excerpt={post.excerpt.toLowerCase()}
          >
            <div>
              <!-- Cover Image with Zoom Effect -->
              <a href={`/blog/${post.slug}`} class="block aspect-[16/10] overflow-hidden rounded-2xl bg-slate-100 mb-5 border border-slate-200/80 relative group/img">
                <img
                  src={post.image}
                  alt={post.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <!-- Subtle gradient vignette on hover -->
                <div class="absolute inset-0 bg-gradient-to-t from-[#0B2553]/15 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
              </a>

              <!-- Meta Pill Row -->
              <div class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-3">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-red-50 text-[#FF3130] border border-red-100">
                  {post.category}
                </span>
                <span>•</span>
                <span class="text-slate-500 font-medium">{post.readTime}</span>
              </div>

              <!-- Title -->
              <h3 class="text-lg sm:text-xl font-extrabold text-[#0B2553] tracking-tight leading-snug group-hover:text-[#0C487A] transition-colors line-clamp-2">
                <a href={`/blog/${post.slug}`}>
                  {post.title}
                </a>
              </h3>

              <!-- Excerpt -->
              <p class="text-xs sm:text-sm text-[#243A5E] mt-3 leading-relaxed line-clamp-3 font-normal">
                {post.excerpt}
              </p>
            </div>

            <!-- Footer Author, Date & Read CTA -->
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-400 font-medium">
                {post.date}
              </span>
              <a
                href={`/blog/${post.slug}`}
                class="inline-flex items-center gap-1.5 font-bold text-xs uppercase tracking-wider text-[#FF3130] hover:text-[#E02625] group-hover:translate-x-1 transition-all"
              >
                <span>Read Article</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- No Articles Found Empty State -->
      <div id="no-blogs-found" class="hidden text-center py-16 px-6 rounded-2xl sm:rounded-3xl border border-dashed border-slate-300 bg-slate-50/70">
        <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-red-50 text-[#FF3130] flex items-center justify-center">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
        </div>
        <h4 class="text-lg font-bold text-[#0B2553]">No articles found</h4>
        <p class="text-xs sm:text-sm text-[#243A5E] mt-1.5 max-w-md mx-auto">
          We couldn't find any articles matching your search query. Try searching for broader terms like "OASIS+", "staffing", or "capture".
        </p>
      </div>

    </div>
  </section>
</MainLayout>

<!-- ========================================================================= -->
<!-- GLOBAL STYLES & ANIMATIONS: Viewport Reveal, Levitation, Shimmer, Borders  -->
<!-- ========================================================================= -->
<style is:global>
  /* Viewport Scroll Reveal (Harmonized with about-us.astro, career.astro, contact.astro) */
  .blog-reveal {
    opacity: 0;
    transform: translateY(28px);
    filter: blur(6px);
    will-change: opacity, transform, filter;
    transition:
      opacity 750ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 750ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 750ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .blog-reveal.is-visible {
    opacity: 1 !important;
    transform: translateY(0) !important;
    filter: blur(0) !important;
  }

  .blog-delay-1 { transition-delay: 90ms; }
  .blog-delay-2 { transition-delay: 180ms; }
  .blog-delay-3 { transition-delay: 270ms; }
  .blog-delay-4 { transition-delay: 360ms; }
  .blog-delay-5 { transition-delay: 450ms; }

  /* Floating Levitation on Hero Visual */
  @keyframes blogFloatLevitation {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .blog-float {
    animation: blogFloatLevitation 6.5s ease-in-out infinite;
  }

  /* Center-Aligned Continuous Radiant Color Shimmer Sweep */
  .service-shimmer-center {
    background: linear-gradient(
      90deg,
      #0F274A 0%,
      #1E40AF 22%,
      #2563EB 42%,
      #DC2626 58%,
      #EF4444 72%,
      #0F274A 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    will-change: background-position;
    width: fit-content;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
    padding-bottom: 0.16em;
    padding-top: 0.05em;
    overflow: visible;
  }

  .service-shimmer-line-1 {
    animation: servicePageShimmer1 9.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @keyframes servicePageShimmer1 {
    0% { background-position: 0% 50%; }
    48% { background-position: 100% 50%; }
    52% { background-position: 100% 50%; }
    100% { background-position: 200% 50%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-reveal {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
      transition: none !important;
    }
    .blog-float {
      animation: none !important;
    }
    .service-shimmer-center {
      animation: none !important;
      background: none !important;
      -webkit-text-fill-color: #0F274A !important;
      color: #0F274A !important;
    }
  }
</style>

<!-- ========================================================================= -->
<!-- CLIENT SCRIPTS: LIVE SEARCH, CATEGORY FILTER & VIEWPORT OBSERVER          -->
<!-- ========================================================================= -->
<script>
  function initBlogPage() {
    // 1. Viewport Scroll-Reveal Observer (Matching about-us, career, contact)
    const revealElements = document.querySelectorAll<HTMLElement>('.blog-reveal');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reducedMotion || !('IntersectionObserver' in window)) {
      revealElements.forEach((el) => el.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver(
        (entries, currentObserver) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            currentObserver.unobserve(entry.target);
          });
        },
        { rootMargin: '0px 0px -6% 0px', threshold: 0.1 }
      );

      revealElements.forEach((el) => observer.observe(el));
    }

    // 2. Interactive Search & Category Filter
    const searchInput = document.getElementById('blog-search-input') as HTMLInputElement;
    const categoryPills = document.querySelectorAll<HTMLButtonElement>('.blog-category-pill');
    const postCards = document.querySelectorAll<HTMLElement>('.blog-post-card');
    const noBlogsFound = document.getElementById('no-blogs-found');

    let activeCategory = 'All';

    function filterPosts() {
      const query = searchInput?.value.toLowerCase().trim() || '';
      let visibleCount = 0;
      let visibleIndex = 0;

      postCards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const category = card.getAttribute('data-category') || '';
        const excerpt = card.getAttribute('data-excerpt') || '';

        const matchesSearch = !query || title.includes(query) || excerpt.includes(query) || category.toLowerCase().includes(query);
        const matchesCategory = activeCategory === 'All' || category === activeCategory;

        if (matchesSearch && matchesCategory) {
          card.style.display = 'flex';
          card.style.transitionDelay = `${visibleIndex * 60}ms`;
          card.classList.add('is-visible');
          visibleIndex++;
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noBlogsFound) {
        if (visibleCount === 0) {
          noBlogsFound.classList.remove('hidden');
        } else {
          noBlogsFound.classList.add('hidden');
        }
      }
    }

    searchInput?.addEventListener('input', filterPosts);

    categoryPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        categoryPills.forEach((p) => {
          p.classList.remove('active', 'bg-[#0B2553]', 'text-white', 'shadow-md');
          p.classList.add('bg-white', 'text-[#243A5E]', 'border', 'border-slate-200/80');
        });

        pill.classList.add('active', 'bg-[#0B2553]', 'text-white', 'shadow-md');
        pill.classList.remove('bg-white', 'text-[#243A5E]', 'border', 'border-slate-200/80');

        activeCategory = pill.getAttribute('data-category') || 'All';
        filterPosts();
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBlogPage, { once: true });
  } else {
    initBlogPage();
  }
  document.addEventListener('astro:page-load', initBlogPage);
</script>
