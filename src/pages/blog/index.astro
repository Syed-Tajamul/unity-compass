---
import MainLayout from '../../layouts/MainLayout.astro';
import { blogPosts } from '../../data/blogPosts';
---

<MainLayout
  title="Blog - Unity Compass | GovCon Insights & Growth Strategies"
  description="Explore actionable tips, industry trends, and proven strategies on proposal capture, federal contracting, and agile staffing from Unity Compass."
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-slate-900 to-brand-dark text-white py-16 sm:py-24 border-b border-slate-800 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center max-w-3xl">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-brand-red/20 text-red-400 border border-brand-red/30 mb-4">
        Industry Intelligence
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight">
        Insights, Strategies & Growth Hacks for Modern Businesses
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
        Explore actionable tips, industry trends, and proven strategies to scale your brand, win federal proposals, and grow faster.
      </p>
    </div>
  </section>

  <!-- Blog Articles Grid -->
  <section class="py-16 sm:py-24 bg-slate-50" aria-label="Blog Articles">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {blogPosts.map((post) => (
          <article class="gov-card flex flex-col justify-between group">
            <div>
              <div class="aspect-[16/10] overflow-hidden rounded-lg bg-slate-100 mb-4 border border-slate-200">
                <img
                  src={post.image}
                  alt={post.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                  width="400"
                  height="250"
                />
              </div>

              <div class="flex items-center gap-2 text-xs text-slate-400 mb-2">
                <span class="font-semibold text-brand-red">{post.category}</span>
                <span>•</span>
                <span>{post.readTime}</span>
              </div>

              <h2 class="text-lg font-bold text-slate-900 group-hover:text-brand-navy transition-colors line-clamp-2">
                <a href={`/blog/${post.slug}`}>
                  {post.title}
                </a>
              </h2>

              <p class="text-xs sm:text-sm text-slate-600 mt-2 line-clamp-3 leading-relaxed">
                {post.excerpt}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-400">{post.date}</span>
              <a
                href={`/blog/${post.slug}`}
                class="font-semibold text-brand-navy group-hover:text-brand-red inline-flex items-center gap-1 transition-colors"
              >
                <span>Read Full Article</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</MainLayout>

