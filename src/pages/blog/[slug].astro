---
/**
 * [slug].astro - Executive Editorial Article & Intelligence Publication
 * 
 * Harmonized with Unity Compass Design System:
 * - Sky blueprint canvas header with technical 16px checks & ambient glows
 * - Breadcrumbs & category badge styling
 * - Interactive multi-image gallery with high-resolution preview
 * - Structured content blocks (Headings, quotes, lists, images)
 * - Related articles cards matching signature card styling
 * - Pure CSS WaveDivider transition
 */
import MainLayout from '../../layouts/MainLayout.astro';
import WaveDivider from '../../components/WaveDivider.astro';
import { blogPosts as fallbackBlogPosts, type BlogPost } from '../../data/blogPosts';
import { supabase, isSupabaseConfigured } from '../../lib/supabase';

export async function getStaticPaths() {
  let posts: BlogPost[] = fallbackBlogPosts;

  if (isSupabaseConfigured && supabase) {
    try {
      const { data, error } = await supabase
        .from('blogs')
        .select('*')
        .eq('is_published', true);

      if (!error && data && data.length > 0) {
        posts = data.map((d: any) => ({
          slug: d.slug,
          title: d.title,
          date: d.date,
          author: d.author || 'Unity Compass Team',
          readTime: d.read_time || '5 min read',
          category: d.category,
          excerpt: d.excerpt,
          image: d.image,
          galleryImages: Array.isArray(d.gallery_images) ? d.gallery_images : (d.gallery_images ? JSON.parse(d.gallery_images) : []),
          relatedSlugs: Array.isArray(d.related_slugs) ? d.related_slugs : (d.related_slugs ? JSON.parse(d.related_slugs) : []),
          contentBlocks: Array.isArray(d.content_blocks) ? d.content_blocks : JSON.parse(d.content_blocks || '[]'),
          metadata: d.metadata || {},
        }));
      }
    } catch (err) {
      console.error('Failed to load blog paths from Supabase, using local fallback:', err);
    }
  }

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, allPosts: posts },
  }));
}

interface Props {
  post: BlogPost;
  allPosts?: BlogPost[];
}

const { post, allPosts = fallbackBlogPosts } = Astro.props;

// Intelligently calculate related posts:
const otherPosts = allPosts.filter((p) => p.slug !== post.slug);
let relatedPosts: BlogPost[] = [];

if (post.relatedSlugs && post.relatedSlugs.length > 0) {
  const manual = otherPosts.filter((p) => post.relatedSlugs!.includes(p.slug));
  relatedPosts.push(...manual);
}

if (relatedPosts.length < 3) {
  const sameCategory = otherPosts.filter(
    (p) => p.category === post.category && !relatedPosts.some((r) => r.slug === p.slug)
  );
  relatedPosts.push(...sameCategory);
}

if (relatedPosts.length < 3) {
  const fallbackRem = otherPosts.filter((p) => !relatedPosts.some((r) => r.slug === p.slug));
  relatedPosts.push(...fallbackRem);
}

relatedPosts = relatedPosts.slice(0, 3);
---

<MainLayout
  title={`${post.title} - Unity Compass`}
  description={post.excerpt}
  ogImage={post.image}
>
  <!-- ========================================================================= -->
  <!-- SECTION 1: EDITORIAL HEADER                                               -->
  <!-- ========================================================================= -->
  <section class="relative overflow-hidden bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] pt-16 sm:pt-20 lg:pt-24 pb-24 sm:pb-32 lg:pb-36" aria-labelledby="article-title-heading">
    <!-- Technical Blueprint Check Pattern -->
    <div
      class="absolute inset-0 opacity-[0.24] mix-blend-multiply pointer-events-none"
      style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.08) 1px, transparent 1px);"
      aria-hidden="true"
    ></div>

    <!-- Soft Ambient Radial Blue Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[radial-gradient(circle,rgba(12,72,122,0.11)_0%,rgba(30,64,175,0.05)_45%,transparent_70%)] rounded-full blur-3xl pointer-events-none -z-10" aria-hidden="true"></div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <!-- Breadcrumb Bar -->
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#0B2553] transition-colors">Home</a>
        <span>/</span>
        <a href="/blog" class="hover:text-[#0B2553] transition-colors">Insights &amp; Blog</a>
        <span>/</span>
        <span class="text-[#0B2553] truncate max-w-xs">{post.title}</span>
      </nav>

      <!-- Category Pill -->
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-[#FF3130]/10 text-[#FF3130] border border-[#FF3130]/20 mb-4">
        {post.category}
      </span>

      <!-- Headline -->
      <h1 id="article-title-heading" class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0B2553] tracking-tight leading-[1.18]">
        {post.title}
      </h1>

      <!-- Meta Bar -->
      <div class="mt-6 flex flex-wrap items-center gap-4 text-xs sm:text-sm text-slate-500 pt-5 border-t border-slate-200/80">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full bg-[#0B2553] text-white flex items-center justify-center font-bold text-xs">
            UC
          </div>
          <span class="font-bold text-[#0B2553]">{post.author}</span>
        </div>
        <span>&bull;</span>
        <time datetime={post.date}>{post.date}</time>
        <span>&bull;</span>
        <span class="font-medium text-[#FF3130]">{post.readTime}</span>
      </div>
    </div>

    <!-- Pure CSS WaveDivider Transition -->
    <WaveDivider variant="wave" position="bottom" fillColor="#ffffff" />
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 2: ARTICLE BODY & MULTI-IMAGE GALLERY                             -->
  <!-- ========================================================================= -->
  <article class="py-16 sm:py-24 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Primary Feature Hero Image -->
      <div class="rounded-3xl overflow-hidden border border-slate-200/90 shadow-[0_12px_35px_-8px_rgba(12,72,122,0.12)] mb-12 bg-slate-100">
        <img
          src={post.image}
          alt={post.title}
          class="w-full h-auto object-cover max-h-[520px]"
          width="1200"
          height="675"
        />
      </div>

      <!-- Content Blocks Rendering -->
      <div class="space-y-6 text-[#243A5E] leading-relaxed">
        {post.contentBlocks.map((block) => {
          const tag = (block.tag || '').toUpperCase();
          
          if (tag.startsWith('H')) {
            return (
              <h3 class="text-2xl sm:text-3xl font-extrabold text-[#0B2553] tracking-tight pt-8 pb-3 border-b border-slate-100 mt-8">
                {block.text}
              </h3>
            );
          }
          if (tag === 'LI') {
            return (
              <div class="flex items-start gap-3 pl-2 py-1">
                <span class="w-5 h-5 rounded-full bg-red-50 text-[#FF3130] flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <p class="text-base text-[#243A5E] leading-relaxed m-0 font-normal">{block.text}</p>
              </div>
            );
          }
          if (tag === 'IMG' || tag === 'IMAGE' || block.image) {
            return (
              <figure class="my-10 rounded-3xl overflow-hidden border border-slate-200 bg-slate-50 shadow-sm">
                <img
                  src={block.image || block.text}
                  alt={block.caption || post.title}
                  class="w-full h-auto object-cover max-h-[500px]"
                  loading="lazy"
                />
                {block.caption && (
                  <figcaption class="p-3.5 text-center text-xs text-slate-500 bg-slate-50 border-t border-slate-100 italic">
                    {block.caption}
                  </figcaption>
                )}
              </figure>
            );
          }
          return (
            <p class="text-base sm:text-lg text-[#243A5E] leading-relaxed font-normal">
              {block.text}
            </p>
          );
        })}
      </div>

      <!-- Multiple Gallery Images (if article has gallery_images) -->
      {post.galleryImages && post.galleryImages.length > 0 && (
        <div class="mt-16 pt-10 border-t border-slate-200">
          <span class="text-xs font-bold uppercase tracking-wider text-[#FF3130] block mb-2">Visual Gallery</span>
          <h3 class="text-2xl font-extrabold text-[#0B2553] tracking-tight mb-6">Program &amp; Solution Imagery</h3>
          
          <div class={`grid gap-8 ${post.galleryImages.length === 1 ? 'grid-cols-1' : post.galleryImages.length === 2 ? 'grid-cols-1 sm:grid-cols-2' : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3'}`}>
            {post.galleryImages.map((imgUrl, idx) => (
              <div class="group relative aspect-[16/10] overflow-hidden rounded-2xl border border-slate-200/90 bg-slate-100 shadow-[0_4px_20px_-4px_rgba(12,72,122,0.06)] hover:shadow-[0_12px_30px_-6px_rgba(12,72,122,0.14)] transition-all">
                <img
                  src={imgUrl}
                  alt={`${post.title} gallery asset ${idx + 1}`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Strategic GovCon Advisory CTA Box -->
      <div class="mt-16 relative overflow-hidden rounded-2xl sm:rounded-3xl bg-gradient-to-br from-[#0B2553] via-[#0C3860] to-[#081832] p-8 sm:p-10 text-white shadow-xl border border-blue-900/40">
        <div
          class="absolute inset-0 pointer-events-none opacity-20"
          style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(255, 255, 255, 0.1) 1px, transparent 1px), linear-gradient(to bottom, rgba(255, 255, 255, 0.1) 1px, transparent 1px);"
          aria-hidden="true"
        ></div>
        
        <div class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
          <div class="max-w-xl">
            <span class="text-xs font-bold uppercase tracking-wider text-[#FF3130] bg-red-900/40 px-2.5 py-1 rounded-full border border-red-500/30">Strategic Advisory</span>
            <h3 class="text-xl sm:text-2xl font-extrabold text-white mt-2">Speak with a Unity Compass GovCon Specialist</h3>
            <p class="text-xs sm:text-sm text-slate-300 mt-1 leading-relaxed">
              Explore how our capture, staffing, and compliance methodologies can support your active solicitations.
            </p>
          </div>
          <a
            href="/contact"
            class="shrink-0 inline-flex items-center gap-2 px-6 py-3 rounded-md sm:rounded-lg text-xs font-bold uppercase tracking-wider text-white bg-[#FF3130] hover:bg-[#E02625] shadow-lg shadow-[#FF3130]/30 active:scale-[0.98] transition-all cursor-pointer"
          >
            <span>Book Consultation</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Navigation Footer -->
      <div class="mt-10 pt-6 border-t border-slate-100 flex items-center justify-between">
        <a href="/blog" class="text-xs font-bold uppercase tracking-wider text-[#0B2553] hover:text-[#FF3130] inline-flex items-center gap-2 transition-colors">
          <span aria-hidden="true">&larr;</span>
          <span>Back to All Publications</span>
        </a>
      </div>

    </div>
  </article>

  <!-- ========================================================================= -->
  <!-- SECTION 3: RELATED ARTICLES                                               -->
  <!-- ========================================================================= -->
  {relatedPosts.length > 0 && (
    <section class="py-16 sm:py-20 bg-slate-50 border-t border-slate-200/80" aria-label="Related Articles">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-8">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-[#FF3130]">More from Insights</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0B2553] tracking-tight mt-1">
              Related Insights &amp; Strategies
            </h2>
          </div>
          <a href="/blog" class="text-xs font-bold uppercase tracking-wider text-[#0B2553] hover:text-[#FF3130] transition-colors hidden sm:block">
            View All &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {relatedPosts.map((rel, idx) => (
            <article class="group relative rounded-2xl sm:rounded-3xl bg-white border border-slate-200/90 p-6 shadow-[0_10px_30px_-6px_rgba(12,72,122,0.06)] hover:shadow-[0_20px_45px_-8px_rgba(12,72,122,0.14)] hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between overflow-hidden">
              <div class={`absolute top-0 inset-x-0 h-1.5 ${idx % 2 === 0 ? 'bg-[#0B2553]' : 'bg-[#FF3130]'}`}></div>

              <div>
                <a href={`/blog/${rel.slug}`} class="block aspect-[16/10] overflow-hidden rounded-2xl bg-slate-100 mb-4 border border-slate-200">
                  <img
                    src={rel.image}
                    alt={rel.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </a>
                <span class="text-[11px] font-bold uppercase tracking-wider text-[#FF3130]">{rel.category}</span>
                <h3 class="text-base font-bold text-[#0B2553] group-hover:text-[#0C487A] transition-colors mt-1.5 line-clamp-2">
                  <a href={`/blog/${rel.slug}`}>{rel.title}</a>
                </h3>
              </div>

              <div class="mt-6 pt-3 border-t border-slate-100 text-xs text-slate-400 flex items-center justify-between font-medium">
                <span>{rel.readTime}</span>
                <span class="font-bold text-[#FF3130] group-hover:translate-x-1 transition-transform">Read &rarr;</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</MainLayout>
