---
import MainLayout from '../../layouts/MainLayout.astro';
import Button from '../../components/Button.astro';
import { blogPosts as fallbackBlogPosts, type BlogPost } from '../../data/blogPosts';
import { supabase, isSupabaseConfigured } from '../../lib/supabase';

export async function getStaticPaths() {
  let posts: BlogPost[] = fallbackBlogPosts;

  if (isSupabaseConfigured && supabase) {
    try {
      const { data, error } = await supabase
        .from('blogs')
        .select('*')
        .eq('is_published', true);

      if (!error && data && data.length > 0) {
        posts = data.map((d: any) => ({
          slug: d.slug,
          title: d.title,
          date: d.date,
          author: d.author || 'Unity Compass Team',
          readTime: d.read_time || '5 min read',
          category: d.category,
          excerpt: d.excerpt,
          image: d.image,
          contentBlocks: Array.isArray(d.content_blocks) ? d.content_blocks : JSON.parse(d.content_blocks || '[]'),
        }));
      }
    } catch (err) {
      console.error('Failed to load blog paths from Supabase, using local fallback:', err);
    }
  }

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

// Filter related posts (exclude current)
const relatedPosts = fallbackBlogPosts.filter((p) => p.slug !== post.slug).slice(0, 3);
---

<MainLayout
  title={`${post.title} - Unity Compass`}
  description={post.excerpt}
  ogImage={post.image}
>
  <!-- Article Header / Breadcrumb -->
  <section class="bg-gradient-to-b from-slate-900 to-brand-dark text-white py-14 sm:py-20 border-b border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/blog" class="hover:text-white transition-colors">Blog</a>
        <span>/</span>
        <span class="text-slate-300 truncate max-w-xs">{post.title}</span>
      </nav>

      <!-- Category Pill -->
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-brand-red/20 text-red-400 border border-brand-red/30 mb-4">
        {post.category}
      </span>

      <!-- Title -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
        {post.title}
      </h1>

      <!-- Meta Info -->
      <div class="mt-6 flex flex-wrap items-center gap-4 text-xs sm:text-sm text-slate-400 pt-4 border-t border-slate-800">
        <span class="text-white font-medium">{post.author}</span>
        <span>•</span>
        <time datetime={post.date}>{post.date}</time>
        <span>•</span>
        <span>{post.readTime}</span>
      </div>
    </div>
  </section>

  <!-- Article Body -->
  <article class="py-16 sm:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Feature Image -->
      <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-elevated mb-12 bg-slate-100">
        <img
          src={post.image}
          alt={post.title}
          class="w-full h-auto object-cover max-h-[500px]"
          width="1200"
          height="675"
        />
      </div>

      <!-- Content Render -->
      <div class="prose prose-slate max-w-none space-y-6 text-slate-700 leading-relaxed">
        {post.contentBlocks.map((block) => {
          if (block.tag.startsWith('H')) {
            return (
              <h3 class="text-2xl font-bold text-slate-900 tracking-tight pt-6 pb-2 border-b border-slate-100">
                {block.text}
              </h3>
            );
          }
          if (block.tag === 'LI') {
            return (
              <div class="flex items-start gap-3 pl-4">
                <span class="w-1.5 h-1.5 rounded-full bg-brand-red mt-2.5 shrink-0"></span>
                <p class="text-base text-slate-700 leading-relaxed m-0">{block.text}</p>
              </div>
            );
          }
          return (
            <p class="text-base sm:text-lg text-slate-700 leading-relaxed">
              {block.text}
            </p>
          );
        })}
      </div>

      <!-- Share / Consultation Box -->
      <div class="mt-16 p-8 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-brand-red">Need Strategic Advisory?</span>
          <h3 class="text-xl font-bold text-slate-900 mt-1">Speak with a Unity Compass GovCon Specialist</h3>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">
            Let's discuss how our capture, staffing, and compliance methodologies can support your upcoming solicitations.
          </p>
        </div>
        <Button href="/contact" variant="primary" size="md" class="shrink-0">
          Book a Consultation &rarr;
        </Button>
      </div>

      <!-- Back to Blog Link -->
      <div class="mt-8 pt-6 border-t border-slate-100 flex items-center justify-between">
        <a href="/blog" class="text-sm font-semibold text-brand-navy hover:text-brand-red inline-flex items-center gap-1.5 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Back to All Publications</span>
        </a>
      </div>

    </div>
  </article>

  <!-- Related Posts Section -->
  {relatedPosts.length > 0 && (
    <section class="py-16 bg-slate-50 border-t border-slate-200" aria-label="Related Articles">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight mb-8">
          Related Insights & Strategies
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedPosts.map((rel) => (
            <article class="gov-card flex flex-col justify-between group">
              <div>
                <div class="aspect-[16/10] overflow-hidden rounded-lg bg-slate-100 mb-4 border border-slate-200">
                  <img
                    src={rel.image}
                    alt={rel.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                    width="400"
                    height="250"
                  />
                </div>
                <span class="text-xs font-semibold text-brand-red">{rel.category}</span>
                <h3 class="text-base font-bold text-slate-900 group-hover:text-brand-navy transition-colors mt-1 line-clamp-2">
                  <a href={`/blog/${rel.slug}`}>{rel.title}</a>
                </h3>
              </div>
              <div class="mt-4 pt-3 border-t border-slate-100 text-xs text-slate-400 flex items-center justify-between">
                <span>{rel.readTime}</span>
                <span class="font-semibold text-brand-navy group-hover:text-brand-red">Read &rarr;</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</MainLayout>

