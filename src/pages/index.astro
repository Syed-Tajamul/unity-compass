---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import HomeIntroBanner from '../components/HomeIntroBanner.astro';
import OurMission from '../components/OurMission.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import HeroStatsBand from '../components/HeroStatsBand.astro';
import Testimonials from '../components/Testimonials.astro';
import LogoCarousel from '../components/LogoCarousel.astro';
import ContactCTA from '../components/ContactCTA.astro';
import HomeBlogPreview from '../components/HomeBlogPreview.astro';
---

<MainLayout
  title="Unity Compass | Government Contracting Consulting & Staffing"
  description="Unity Compass delivers strategic proposal development, OASIS+ readiness support, security-cleared recruitment, staffing solutions, and IT consulting to help federal contractors and commercial firms win and perform."
>
  <!-- 1. Executive Hero Section -->
  <Hero />

  <!-- 2. Performance Credentials & Key Metrics Section (Directly Below Hero) -->
  <HeroStatsBand />

  <!-- 3. Defense Industry Giants & Prime Partner Ecosystem (Directly Below Metrics) -->
  <LogoCarousel />

  <!-- 4. Our Services — Bold & Highly Animated Carousel (Directly After Brand Section) -->
  <ServicesGrid />

  <!-- 5. Value Proposition & Core Purpose Banner -->
  <HomeIntroBanner />

  <!-- 6. Our Mission — The Four Bearings Interactive Compass Navigation -->
  <OurMission />

  <!-- 7. What Our Clients Say — Testimonials Section -->
  <Testimonials />

  <!-- 9. Final High-Conversion Constellation Call-to-Action -->
  <ContactCTA />

  <!-- 10. Industry Insights & Publications -->
  <HomeBlogPreview />
</MainLayout>
