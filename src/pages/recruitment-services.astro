const hubspotMeetingUrl = 'https://meetings.hubspot.com/aroosa1?uuid=6b1bf327-e7db-4a82-94e9-c023536d3178';
---

<MainLayout
  title="Security-Cleared Recruitment - Unity Compass"
  description="End-to-end federal recruitment services focused on permanent and long-term hiring for government programs requiring cleared and clearance-eligible professionals."
>
  <div class="text-slate-800 overflow-hidden" id="recruitment-page-root">

    <!-- ===================================================================== -->
    <!-- SECTION 1: HERO & PRACTICE OVERVIEW                                   -->
    <!-- Top: Centered Shimmer Heading (Page Top Before Image)                 -->
    <!-- Middle Row: Image (~68%) | Practice Areas Menu (~32%)                 -->
    <!-- Bottom Row: Headline + Narrative (~56%) | 4 Capabilities Cards (~44%) -->
    <!-- Background: PURE WHITE                                                -->
    <!-- ===================================================================== -->
    <section class="relative pt-12 sm:pt-16 lg:pt-20 pb-16 sm:pb-20 bg-white overflow-hidden" aria-labelledby="service-hero-heading">
      
      <!-- Subtle Radial Ambient Glows -->
      <div class="absolute top-1/4 -left-32 w-[600px] h-[600px] bg-[radial-gradient(circle,rgba(40,121,182,0.08)_0%,transparent_70%)] rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute -top-20 -right-32 w-[600px] h-[600px] bg-[radial-gradient(circle,rgba(30,64,175,0.05)_0%,transparent_70%)] rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="max-w-7xl xl:max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-12 sm:space-y-16">
        
        <!-- PART 1: PAGE TOP CENTERED HEADER (Before Image) -->
        <div class="text-center max-w-4xl mx-auto space-y-4">
          <h1
            id="service-hero-heading"
            class="hero-heading-reveal text-3xl sm:text-4xl lg:text-[2.85rem] font-extrabold tracking-tight leading-tight text-[#0B2553]"
          >
            <span class="service-shimmer-center service-shimmer-line-1 inline-block pb-1">Security-Cleared Recruitment</span>
          </h1>
          <div class="w-24 h-1.5 rounded-full bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130] mx-auto hero-subheading-reveal"></div>
        </div>

        <!-- PART 2: SHOWCASE FRAME (Image ~68%) + PRACTICE MENU (~32%) -->
        <div class="flex flex-col lg:flex-row items-stretch gap-8 lg:gap-8 xl:gap-10">
          
          <!-- Image Column (~68% Width: Unclipped Graphic Artwork with Corner Badge 100% Visible) -->
          <div class="w-full lg:w-[68%] relative flex justify-center items-center hero-image-reveal">
            <div class="relative w-full group h-full flex flex-col justify-center">
              
              <!-- Soft Dynamic Ambient Glow Aura -->
              <div class="absolute -inset-4 bg-gradient-to-tr from-[#0C487A]/20 via-[#1E40AF]/15 to-[#0C487A]/10 rounded-3xl blur-2xl pointer-events-none opacity-80 group-hover:opacity-100 transition-opacity duration-500" aria-hidden="true"></div>
              
              <!-- Refined Image Window Frame -->
              <div class="relative rounded-3xl overflow-hidden border border-slate-200/90 bg-white shadow-[0_20px_50px_-12px_rgba(11,37,83,0.16)] w-full">
                
                <img
                  src="/images/service3.png"
                  alt="Security-Cleared Recruitment"
                  class="w-full h-auto aspect-[2752/1536] object-contain object-center group-hover:scale-[1.015] transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] select-none block"
                  width="2752"
                  height="1536"
                  loading="eager"
                />

                <!-- High-End Specular Glass Sheen Overlay -->
                <div class="absolute inset-0 bg-gradient-to-tr from-black/5 via-transparent to-white/10 pointer-events-none"></div>

                <!-- Glowing Top Accent Line on Hover -->
                <div class="absolute inset-x-0 top-0 h-1.5 rounded-t-3xl bg-gradient-to-r from-[#0C487A] via-[#103E6B] to-[#1E40AF] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

              </div>

            </div>
          </div>

          <!-- Practice Areas Menu Column (~32% Width: Current Page Excluded) -->
          <div class="w-full lg:w-[32%] flex flex-col justify-center hero-menu-reveal">
            <div class="rounded-3xl border border-slate-200/90 bg-white/95 backdrop-blur-md p-4 sm:p-5 shadow-[0_12px_36px_-10px_rgba(11,37,83,0.08)] flex flex-col justify-center space-y-2.5 h-full">
              
              <div class="space-y-2 flex-1 flex flex-col justify-center py-2">
                {otherFederalServices.map((service, idx) => (
                  <a
                    href={service.href}
                    class="group relative flex items-center justify-between px-4 sm:px-5 py-3.5 sm:py-4 rounded-2xl text-slate-700 font-semibold text-sm transition-all duration-300 border border-slate-200/60 hover:border-[#0C487A]/30 hover:bg-gradient-to-r hover:from-[#0C487A] hover:via-[#103E6B] hover:to-[#1E40AF] hover:text-white hover:shadow-[0_10px_25px_-5px_rgba(12,72,122,0.45)] hover:scale-[1.02] cursor-pointer"
                    style={`--stagger-delay: ${idx * 40}ms;`}
                  >
                    <div class="flex items-center gap-3 min-w-0 pr-2">
                      <span class="w-2.5 h-2.5 rounded-full bg-slate-300 group-hover:bg-[#0C487A] group-hover:shadow-[0_0_8px_rgba(12,72,122,0.4)] transition-all duration-300 shrink-0"></span>
                      <span class="leading-snug transition-colors duration-300">{service.name}</span>
                    </div>
                    <svg class="w-4 h-4 text-slate-400 group-hover:text-white group-hover:translate-x-1 transition-all duration-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                ))}
              </div>

            </div>
          </div>

        </div>

        <!-- PART 3: HEADLINE + NARRATIVE (56%) + 4 SQUARES (44%) IN BELOW ROW -->
        <div class="pt-8 sm:pt-10 border-t border-slate-100 flex flex-col lg:flex-row items-center gap-10 lg:gap-12 xl:gap-14">
          
          <!-- Narrative Column (~56% Width: Exact user headline & narrative paragraphs + HubSpot CTA) -->
          <div class="w-full lg:w-[56%] space-y-5 text-left reveal-on-scroll reveal-left">
            
            <h2 class="text-xl sm:text-2xl lg:text-[1.65rem] font-bold text-[#0B2553] leading-snug sm:leading-[1.42]">
              Your Partner in Federal Recruitment Services
            </h2>
            <div class="w-16 h-1 rounded-full bg-gradient-to-r from-[#0C487A] to-[#FF3130] mb-3"></div>

            <div class="space-y-4 pt-1">
              <p class="text-base sm:text-lg text-slate-600 leading-[2] sm:leading-[2.05] font-normal">
                Unity Compass provides end-to-end federal recruitment services focused on permanent and long-term hiring for government programs requiring cleared and clearance-eligible professionals. We manage the complete recruitment lifecycle from <strong class="font-bold text-[#0C487A]">clearance-aware sourcing and vetting</strong> to interviews, selection, and onboarding.
              </p>

              <p class="text-base sm:text-lg text-slate-600 leading-[2] sm:leading-[2.05] font-normal">
                Our recruiters understand federal hiring requirements, labor categories, and contract mandates. We source both active and passive cleared candidates through trusted networks, targeted outreach, and federal-focused recruiting channels to ensure access to <strong class="font-bold text-[#0C487A]">highly qualified talent.</strong>
              </p>
            </div>

            <!-- Direct User Action Button: Book a Meeting (HubSpot) -->
            <div class="pt-3">
              <a
                href={hubspotMeetingUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-3 px-7 sm:px-8 py-3.5 rounded-2xl bg-gradient-to-r from-[#0C487A] via-[#103E6B] to-[#1E40AF] text-white font-bold text-base shadow-[0_12px_28px_-6px_rgba(12,72,122,0.45)] hover:shadow-[0_18px_36px_-6px_rgba(12,72,122,0.55)] hover:scale-[1.03] active:scale-[0.98] transition-all duration-300 group"
              >
                <span>Book a Meeting</span>
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>

          </div>

          <!-- 4 Square Animated Cards Column (~44% Width: 2x2 Grid with Two-Layer Sliding Profile Card Animation) -->
          <div class="w-full lg:w-[44%] reveal-on-scroll reveal-right delay-150">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5 w-full max-w-lg mx-auto lg:mx-0">
              {recruitmentCapabilities.map((card, idx) => (
                <div
                  class="square-slide-card group relative cursor-pointer"
                  style={`transition-delay: ${idx * 60}ms;`}
                >
                  <!-- Slide 1: Top Slide (Icon + Title, glides UP on hover) -->
                  <div class="square-slide square-slide-top absolute inset-x-0 top-0 rounded-3xl bg-gradient-to-br from-[#0C487A] via-[#103E6B] to-[#1E40AF] p-4 text-center text-white border border-white/15 shadow-[0_8px_20px_rgba(12,72,122,0.18)] flex flex-col items-center justify-center">
                    <!-- Ambient Glow -->
                    <div class="absolute inset-0 rounded-3xl bg-white/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>

                    <!-- Icon Wrap with Subtle Pulse Ring Affordance -->
                    <div class="square-icon-wrap relative w-11 h-11 rounded-2xl bg-white/15 backdrop-blur-md border border-white/25 flex items-center justify-center text-white mb-2 shadow-inner transition-all duration-500">
                      <div class="absolute -inset-1 rounded-2xl border border-white/30 opacity-70 animate-ping-slow pointer-events-none"></div>
                      <svg class="square-icon-svg w-6 h-6 transition-all duration-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d={card.icon} />
                      </svg>
                    </div>

                    <!-- Title -->
                    <h3 class="square-title text-sm sm:text-base font-bold text-white tracking-tight leading-snug px-1 transition-all duration-500 line-clamp-2">
                      {card.title}
                    </h3>

                    <!-- Subtle Federal Visual Affordance Pill (No 'hover me' text!) -->
                    <div class="square-affordance-pill flex items-center gap-1.5 mt-2 transition-opacity duration-300 group-hover:opacity-0">
                      <span class="w-1.5 h-1.5 rounded-full bg-[#FF3130] animate-pulse"></span>
                      <span class="w-6 h-0.5 rounded-full bg-white/40"></span>
                      <span class="w-1.5 h-1.5 rounded-full bg-blue-300/80"></span>
