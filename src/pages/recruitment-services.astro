  /* ========================================================================= */
  /* Unique "Prism Spotlight Stage" Animation for "Our Expertise"              */
  /* ========================================================================= */
  .why-card-spotlight {
    position: relative;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.45s ease,
                opacity 0.45s ease,
                filter 0.45s ease;
    will-change: transform, box-shadow, opacity;
    transform: translateY(0) scale(1);
  }

  /* Dynamic Specular Spotlight Glow following cursor position */
  .why-card-spotlight::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      450px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(12, 72, 122, 0.08),
      transparent 65%
    );
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
    z-index: 1;
  }

  .why-card-spotlight:hover::before {
    opacity: 1;
  }

  /* Smooth 3D Spring Lift & Radiant Elevation on Hover */
  .why-card-spotlight:hover {
    transform: translateY(-12px) scale(1.035);
    box-shadow: 0 28px 60px -15px rgba(12, 72, 122, 0.22),
                0 0 0 1.5px rgba(12, 72, 122, 0.35);
    z-index: 25;
  }

  /* Sibling Softening: When any card is hovered, non-hovered siblings gently soften */
  #expertise-cards-grid.has-active-card .why-card-spotlight:not(.is-active-card) {
    opacity: 0.72;
    filter: saturate(0.85);
    transform: translateY(0) scale(0.985);
  }

  /* Floating Icon Badge with Independent Physics-Based Lift */
  .why-card-spotlight .card-icon-badge {
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.4s ease,
                background-color 0.3s ease;
  }

  .why-card-spotlight:hover .card-icon-badge {
    transform: translateY(-4px) scale(1.12);
    box-shadow: 0 10px 22px rgba(12, 72, 122, 0.22);
  }

  /* ========================================================================= */
  /* Continuous Radiant Shimmer Sweep                                          */
  /* ========================================================================= */
  .service-shimmer-center {
    background: linear-gradient(90deg, #0F274A 0%, #1E40AF 22%, #2563EB 42%, #DC2626 58%, #EF4444 72%, #0F274A 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    will-change: background-position;
    width: fit-content;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
    padding-bottom: 0.16em;
    padding-top: 0.05em;
    overflow: visible;
  }
  .service-shimmer-line-1 { animation: servicePageShimmer1 9.5s cubic-bezier(0.4, 0, 0.2, 1) infinite; }
  @keyframes servicePageShimmer1 {
    0% { background-position: 0% 50%; }
    48% { background-position: 100% 50%; }
    52% { background-position: 100% 50%; }
    100% { background-position: 200% 50%; }
  }

  /* Accessibility: Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .service-shimmer-center { animation: none !important; background: none !important; -webkit-text-fill-color: #0F274A !important; color: #0F274A !important; }
    .hero-heading-reveal, .hero-subheading-reveal, .hero-image-reveal, .hero-menu-reveal { animation: none !important; opacity: 1 !important; transform: none !important; filter: none !important; }
    .shuttle-card, .why-card-spotlight { transition: none !important; transform: none !important; }
    .shuttle-fill-layer { transition: none !important; display: none !important; }
