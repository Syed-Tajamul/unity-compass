    filter: saturate(0.85);
  }

  /* Hide scrollbar */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* ========================================================================= */
  /* Square Two-Layer Sliding Profile Card Animation (Hero 2x2 Grid)           */
  /* Slide 1 (Icon+Title) shifts up, Slide 2 (Description) shifts down         */
  /* ========================================================================= */
  .square-slide-card {
    position: relative;
    width: 100%;
    height: 155px;
    perspective: 1000px;
  }

  .square-slide-card:hover {
    z-index: 50;
  }

  .square-slide {
    width: 100%;
    will-change: transform, opacity, height;
  }

  /* Slide 1: Top Slide (Icon + Title, solid gradient background, sits on top at rest) */
  .square-slide-top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: auto;
    height: 155px;
    z-index: 2;
