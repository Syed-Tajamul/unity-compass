<!-- Client Script: Scroll Reveals, Cursor Physics & Smooth Auto-Gliding Agency Carousel -->
<script is:inline>
  function initRecruitmentPageInteractions() {
    // 1. Viewport Scroll Reveal Observer (Soft blur & upward drift)
    function initScrollReveals() {
      const revealElements = document.querySelectorAll(
        '.reveal-on-scroll, .reveal-from-left, .reveal-from-right'
      );

      if (!('IntersectionObserver' in window)) {
        revealElements.forEach((el) => el.classList.add('is-revealed'));
        document.querySelectorAll('.cascade-item').forEach((item) => item.classList.add('is-revealed'));
        return;
      }

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              obs.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -50px 0px', threshold: 0.1 }
      );

      revealElements.forEach((el) => observer.observe(el));

      // Cascading Bullet Items Observer inside "Who We Serve" Boxes
      const cascadeItemObserver = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const target = entry.target;
              const idx = parseInt(target.getAttribute('data-cascade-index') || '0', 10);
              setTimeout(() => {
                target.classList.add('is-revealed');
              }, idx * 85 + 100);
              obs.unobserve(target);
            }
          });
        },
        { rootMargin: '0px 0px -40px 0px', threshold: 0.12 }
      );

      document.querySelectorAll('.cascade-item').forEach((item) => cascadeItemObserver.observe(item));
    }
    initScrollReveals();

    // 2. Who We Serve Cards: Dynamic Specular Cursor Spotlight
    const whoServeCards = document.querySelectorAll('.who-serve-card');
    whoServeCards.forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
        card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
      });
    });

    // 3. Expertise Spotlight Stage
    const expertiseGrid = document.getElementById('expertise-cards-grid');
    if (expertiseGrid) {
      const cards = expertiseGrid.querySelectorAll('.why-card-spotlight');
      cards.forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
          card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
        });
        card.addEventListener('mouseenter', () => {
          expertiseGrid.classList.add('has-active-card');
          card.classList.add('is-active-card');
        });
        card.addEventListener('mouseleave', () => {
          expertiseGrid.classList.remove('has-active-card');
          card.classList.remove('is-active-card');
        });
      });
    }

    // 4. Smooth Auto-Moving Agency Carousel with Pause-on-Hover & Floating Controls
    const track = document.getElementById('agency-carousel-track');
    const prevBtn = document.getElementById('agency-carousel-prev');
    const nextBtn = document.getElementById('agency-carousel-next');
    const dotsContainer = document.getElementById('agency-carousel-dots');

    if (track) {
      const cards = track.querySelectorAll('.agency-compact-card');
      const dots = dotsContainer ? dotsContainer.querySelectorAll('button') : [];
      const distinctCount = 7;
      let isHovered = false;
      let manualPauseTimeout = null;
      const speed = 0.85; // Continuous smooth pixels per animation frame
      let animId = null;

      // Continuous auto-glide loop
      function autoGlide() {
        if (!isHovered) {
          track.scrollLeft += speed;
          // Seamless infinite reset when first set finishes
          const halfWidth = track.scrollWidth / 2;
          if (track.scrollLeft >= halfWidth) {
            track.scrollLeft -= halfWidth;
          }
        }
        animId = requestAnimationFrame(autoGlide);
      }
      animId = requestAnimationFrame(autoGlide);

      // Pause when hovering over the track or any agency card
      track.addEventListener('mouseenter', () => {
        isHovered = true;
        track.classList.add('has-hovered-card');
      });

      track.addEventListener('mouseleave', () => {
        isHovered = false;
        track.classList.remove('has-hovered-card');
      });

      // Pointer / Touch support for mobile devices
      track.addEventListener('pointerdown', () => {
        isHovered = true;
      });

      track.addEventListener('pointerup', () => {
        clearTimeout(manualPauseTimeout);
        manualPauseTimeout = setTimeout(() => {
          isHovered = false;
        }, 2000);
      });

      // Update Pagination Dots based on current scroll position
      function updateActiveDot() {
        if (!dots.length) return;
        const cardWidth = cards[0] ? cards[0].offsetWidth + 24 : 264;
        const normalizedScroll = track.scrollLeft % (cardWidth * distinctCount);
        const activeIdx = Math.min(Math.round(normalizedScroll / cardWidth), distinctCount - 1);

        dots.forEach((dot, idx) => {
          if (idx === activeIdx) {
            dot.classList.add('w-6', 'bg-[#0C487A]');
            dot.classList.remove('bg-slate-300');
          } else {
            dot.classList.remove('w-6', 'bg-[#0C487A]');
            dot.classList.add('bg-slate-300');
          }
        });
      }

      track.addEventListener('scroll', updateActiveDot, { passive: true });

      // Prev / Next button interactions with smooth glide & loop protection
      function pauseAndScroll(delta) {
        isHovered = true;
        clearTimeout(manualPauseTimeout);

        // If scrolling left near beginning, seamlessly shift to second set
        if (delta < 0 && track.scrollLeft <= 5) {
          track.scrollLeft += track.scrollWidth / 2;
        }

        track.scrollBy({ left: delta, behavior: 'smooth' });

        manualPauseTimeout = setTimeout(() => {
          isHovered = false;
        }, 2500);
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          const cardWidth = cards[0] ? cards[0].offsetWidth + 24 : 264;
          pauseAndScroll(-cardWidth);
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          const cardWidth = cards[0] ? cards[0].offsetWidth + 24 : 264;
          pauseAndScroll(cardWidth);
        });
      }

      // Dot click handler
      dots.forEach((dot, idx) => {
        dot.addEventListener('click', () => {
          const cardWidth = cards[0] ? cards[0].offsetWidth + 24 : 264;
          isHovered = true;
          clearTimeout(manualPauseTimeout);
          track.scrollTo({ left: idx * cardWidth, behavior: 'smooth' });
          manualPauseTimeout = setTimeout(() => {
            isHovered = false;
          }, 2500);
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRecruitmentPageInteractions);
  } else {
    initRecruitmentPageInteractions();
  }
  document.addEventListener('astro:page-load', initRecruitmentPageInteractions);
</script>

<style>
  /* ========================================================================= */
