<!-- Client Script: Interactive Expertise Prism Spotlight Stage & Mouse Tracking -->
<script is:inline>
  function initExpertiseCardInteractions() {
    const cardsGrid = document.getElementById('expertise-cards-grid');
    if (!cardsGrid) return;
    const cards = cardsGrid.querySelectorAll('.why-card-spotlight');

    cards.forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });

      card.addEventListener('mouseenter', () => {
        cardsGrid.classList.add('has-active-card');
        card.classList.add('is-active-card');
      });

      card.addEventListener('mouseleave', () => {
        cardsGrid.classList.remove('has-active-card');
        card.classList.remove('is-active-card');
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initExpertiseCardInteractions);
  } else {
    initExpertiseCardInteractions();
  }
  document.addEventListener('astro:page-load', initExpertiseCardInteractions);
</script>

<style>
  /* ========================================================================= */
  /* Initial Page Load Soft-Reveal                                             */
  /* ========================================================================= */
  @keyframes heroSoftReveal {
    0% { opacity: 0; transform: translateY(16px); filter: blur(8px); }
    100% { opacity: 1; transform: translateY(0); filter: blur(0); }
  }
  .hero-heading-reveal { animation: heroSoftReveal 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both; will-change: opacity, transform, filter; }
  .hero-subheading-reveal { animation: heroSoftReveal 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both; will-change: opacity, transform, filter; }
