  }

  /* Compact Agency Carousel Cards with Spotlight Focus & Hover Lift */
  .agency-compact-card {
    position: relative;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1),
