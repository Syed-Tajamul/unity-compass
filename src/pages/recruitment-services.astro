  .hero-subheading-reveal { animation: heroSoftReveal 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both; will-change: opacity, transform, filter; }
  .hero-image-reveal { animation: heroSoftReveal 1.5s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both; will-change: opacity, transform, filter; }
  .hero-menu-reveal { animation: heroSoftReveal 1.5s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both; will-change: opacity, transform, filter; }

  /* Floating Squares */
  @keyframes floatSubtle1 { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-5px); } }
  @keyframes floatSubtle2 { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(5px); } }
  .animate-float-subtle-1 { animation: floatSubtle1 5s ease-in-out infinite; }
  .animate-float-subtle-2 { animation: floatSubtle2 6s ease-in-out infinite 0.6s; }
  .animate-float-subtle-1:hover, .animate-float-subtle-2:hover { animation-play-state: paused; }

  /* Shuttle Card Animation */
  .shuttle-card { will-change: transform, box-shadow; }
  .shuttle-fill-layer { will-change: transform; }

  /* Executive Persona Cards ("Who We Serve") */
  .who-serve-card {
    position: relative;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.4s ease;
    will-change: transform, box-shadow;
  }

  .who-serve-card::before {
    content: '';
