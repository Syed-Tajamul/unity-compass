<!-- Client Script: Interactive Persona Switcher, Agency Vault Carousel, & Card Physics -->
<script is:inline>
  function initRecruitmentPageInteractions() {
    // 1. Expertise Spotlight Stage
    const expertiseGrid = document.getElementById('expertise-cards-grid');
    if (expertiseGrid) {
      const cards = expertiseGrid.querySelectorAll('.why-card-spotlight');
      cards.forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
          card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
        });
        card.addEventListener('mouseenter', () => {
          expertiseGrid.classList.add('has-active-card');
          card.classList.add('is-active-card');
        });
        card.addEventListener('mouseleave', () => {
          expertiseGrid.classList.remove('has-active-card');
          card.classList.remove('is-active-card');
        });
      });
    }

    // 2. Who We Serve Persona Switcher
    const tabSmb = document.getElementById('tab-btn-smb');
    const tabGc = document.getElementById('tab-btn-gc');
    const panelSmb = document.getElementById('panel-smb');
    const panelGc = document.getElementById('panel-gc');

    function activateTab(activeBtn, inactiveBtn, showPanel, hidePanel) {
      if (!activeBtn || !showPanel) return;
      activeBtn.classList.add('active-tab', 'bg-white', 'text-[#0B2553]', 'shadow-sm');
      activeBtn.classList.remove('text-slate-600');
      activeBtn.setAttribute('aria-selected', 'true');

      if (inactiveBtn) {
        inactiveBtn.classList.remove('active-tab', 'bg-white', 'text-[#0B2553]', 'shadow-sm');
        inactiveBtn.classList.add('text-slate-600');
        inactiveBtn.setAttribute('aria-selected', 'false');
      }

      showPanel.classList.remove('hidden');
      showPanel.classList.add('animate-fadeInUp');
      if (hidePanel) {
        hidePanel.classList.add('hidden');
        hidePanel.classList.remove('animate-fadeInUp');
      }
    }

    if (tabSmb && tabGc && panelSmb && panelGc) {
      // Initialize active style
      tabSmb.classList.add('bg-white', 'text-[#0B2553]', 'shadow-sm');

      tabSmb.addEventListener('click', () => {
        activateTab(tabSmb, tabGc, panelSmb, panelGc);
      });

      tabGc.addEventListener('click', () => {
        activateTab(tabGc, tabSmb, panelGc, panelSmb);
      });
    }

    // 3. Agency Vault Carousel Interactions
    const track = document.getElementById('agency-carousel-track');
    const prevBtn = document.getElementById('agency-carousel-prev');
    const nextBtn = document.getElementById('agency-carousel-next');
    const dotsContainer = document.getElementById('agency-carousel-dots');

    if (track) {
      const cards = track.querySelectorAll('.agency-vault-card');
      const dots = dotsContainer ? dotsContainer.querySelectorAll('button') : [];

      function updateActiveDot() {
        if (!dots.length) return;
        const scrollLeft = track.scrollLeft;
        const cardWidth = cards[0] ? cards[0].offsetWidth + 24 : 360;
        const activeIdx = Math.min(Math.round(scrollLeft / cardWidth), dots.length - 1);

        dots.forEach((dot, idx) => {
          if (idx === activeIdx) {
            dot.classList.add('w-8', 'bg-[#0C487A]');
            dot.classList.remove('bg-slate-300');
          } else {
            dot.classList.remove('w-8', 'bg-[#0C487A]');
            dot.classList.add('bg-slate-300');
          }
        });
      }

      track.addEventListener('scroll', updateActiveDot, { passive: true });

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          const cardWidth = cards[0] ? cards[0].offsetWidth + 24 : 360;
          track.scrollBy({ left: -cardWidth, behavior: 'smooth' });
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          const cardWidth = cards[0] ? cards[0].offsetWidth + 24 : 360;
          track.scrollBy({ left: cardWidth, behavior: 'smooth' });
        });
      }

      dots.forEach((dot, idx) => {
        dot.addEventListener('click', () => {
          const cardWidth = cards[0] ? cards[0].offsetWidth + 24 : 360;
          track.scrollTo({ left: idx * cardWidth, behavior: 'smooth' });
        });
      });

      // Mouse Spotlight on Agency Cards
      cards.forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
          card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
        });
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRecruitmentPageInteractions);
  } else {
    initRecruitmentPageInteractions();
  }
