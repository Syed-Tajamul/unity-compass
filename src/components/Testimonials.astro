---
/**
 * Testimonials.astro - Executive GovCon Client Testimonials Section
 * 
 * Harmonized Theme & Visual Continuity:
 * - Positioned directly after "Our Mission: Navigating Federal Complexity with Clarity, Compliance, and Confidence"
 * - Exact same background as Defense Industry Giants section (bg-white with 16px checks grid and radial blue glow)
 * - Complete 2-line headline with unbroken continuous radiant color shimmer animation
 * - Signature animated tri-color blended accent bar (Navy to Royal to Red)
 * - Removed visible "Chief Technology Officer" label while preserving accessible reference
 * - Automatic transition every 4.5 seconds with pause on hover/focus and circular arrow controls
 */

import { testimonials } from '../data/testimonials';
---

<section
  id="testimonials"
  class="relative py-20 sm:py-24 lg:py-28 bg-white overflow-hidden scroll-mt-16 border-t border-slate-200/80"
  aria-labelledby="testimonials-heading"
>
  <!-- Minute Checks Pattern Overlay (Identical 16px × 16px grid as Defense Primes section) -->
  <div
    class="absolute inset-0 pointer-events-none opacity-30 mix-blend-multiply"
    style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.08) 1px, transparent 1px);"
    aria-hidden="true"
  ></div>

  <!-- Soft Ambient Radial Blue Glow centered on section (Matching Defense Primes) -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4/5 h-64 bg-[radial-gradient(ellipse,rgba(40,121,182,0.07)_0%,transparent_70%)] pointer-events-none"
    aria-hidden="true"
  ></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Top Header Group: Centered in Middle Matching Above Sections -->
    <div class="text-center max-w-4xl mx-auto mb-12 sm:mb-16 testimonial-header-wrap">
      
      <!-- Main Headline with Tight Cohesive Line-Height & Continuous Blended Color Shimmer Animation -->
      <h2
        id="testimonials-heading"
        class="testimonial-heading-reveal text-2xl sm:text-3xl md:text-4xl lg:text-[2.65rem] font-extrabold tracking-tight leading-[1.18] sm:leading-[1.22] lg:leading-[1.24] max-w-4xl mx-auto text-center"
      >
        <span class="testimonial-shimmer-line testimonial-shimmer-line-1">What Our Clients Say:</span>
        <span class="testimonial-shimmer-line testimonial-shimmer-line-2">Proven Track Record Across Federal Engagements</span>
      </h2>

      <!-- Accessible Exact Heading Anchor -->
      <span class="sr-only">What Our Clients Say</span>

      <!-- Animated Brand Accent Bar (Navy-to-Red Dynamic Pulse) -->
      <div class="w-24 h-1.5 rounded-full bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130] section-accent-line mx-auto mt-4 mb-5"></div>

      <!-- Supporting Narrative Description (Verbatim Phrase Preserved) -->
      <p class="testimonial-subheading-reveal text-sm sm:text-base lg:text-[1.05rem] text-slate-600 max-w-2xl mx-auto font-normal leading-relaxed text-center">
        Trusted by federal primes, defense contractors, and emerging commercial leaders across the United States. We believe in the power of strong relationships and transparent communication.
      </p>
    </div>

    <!-- Elegant Clean Testimonial Showcase -->
    <div
      class="max-w-4xl mx-auto testimonial-showcase-wrap"
      id="testimonial-slider-container"
      role="region"
      aria-roledescription="carousel"
      aria-label="Client Testimonials"
    >
      <!-- Glassmorphic Testimonial Card Frame -->
      <div class="relative bg-white/95 backdrop-blur-xl rounded-3xl p-8 sm:p-12 lg:p-14 border border-slate-200/90 shadow-[0_20px_50px_-15px_rgba(11,37,83,0.10),0_0_0_1px_rgba(255,255,255,0.9)_inset] transition-all duration-300">
        
        <!-- Subtle Brand Red Quotation Icon Badge -->
        <div class="flex justify-center mb-6" aria-hidden="true">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#0C487A] via-[#1E40AF] to-[#FF3130] text-white flex items-center justify-center shadow-md shadow-[#0C487A]/20">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
            </svg>
          </div>
        </div>

        <!-- Slides Viewport -->
        <div class="relative min-h-[190px] sm:min-h-[160px] lg:min-h-[140px] flex items-center justify-center" id="testimonial-card-frame">
          {testimonials.map((t, index) => (
            <div
              class={`testimonial-slide transition-all duration-600 ease-in-out absolute inset-0 flex flex-col items-center justify-center text-center ${
                index === 0
                  ? 'opacity-100 translate-y-0 pointer-events-auto z-10'
                  : 'opacity-0 translate-y-3 pointer-events-none z-0'
              }`}
              data-index={index}
              role="tabpanel"
              aria-label={`Testimonial ${index + 1} of ${testimonials.length}`}
            >
              <!-- Verbatim Authentic Client Quote -->
              <blockquote class="text-base sm:text-lg lg:text-[1.18rem] text-slate-800 font-medium leading-[1.78] max-w-3xl mx-auto select-text">
                &ldquo;{t.quote}&rdquo;
              </blockquote>

              <!-- Accessible role reference for verification (label visually removed per user request) -->
              {t.authorRole && (
                <span class="sr-only">{t.authorRole}</span>
              )}
            </div>
          ))}
        </div>

        <!-- Navigation Controls: Circular Arrows & Pagination Indicator Pills -->
        <div class="flex items-center justify-between mt-8 pt-6 border-t border-slate-100/90 gap-4">
          
          <!-- Left Arrow Button -->
          <button
            type="button"
            id="testimonial-prev-btn"
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-white border border-slate-200 text-[#0B2553] hover:text-white hover:bg-[#0C487A] hover:border-[#0C487A] active:bg-[#FF3130] active:border-[#FF3130] flex items-center justify-center transition-all duration-200 shadow-sm active:scale-95 cursor-pointer group"
            aria-label="Previous quote"
          >
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
            </svg>
          </button>

          <!-- Pagination Indicator Dots -->
          <div
            class="flex items-center justify-center gap-2"
            role="tablist"
            aria-label="Testimonial pagination"
          >
            {testimonials.map((_, index) => (
              <button
                type="button"
                class={`testimonial-dot h-2 rounded-full transition-all duration-300 cursor-pointer ${
                  index === 0 ? 'bg-[#FF3130] w-8' : 'bg-slate-200 hover:bg-slate-300 w-2.5'
                }`}
                data-index={index}
                aria-label={`Go to slide ${index + 1}`}
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
              />
            ))}
          </div>

          <!-- Right Arrow Button -->
          <button
            type="button"
            id="testimonial-next-btn"
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-white border border-slate-200 text-[#0B2553] hover:text-white hover:bg-[#0C487A] hover:border-[#0C487A] active:bg-[#FF3130] active:border-[#FF3130] flex items-center justify-center transition-all duration-200 shadow-sm active:scale-95 cursor-pointer group"
            aria-label="Next quote"
          >
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
            </svg>
          </button>

        </div>

      </div>

    </div>

  </div>
</section>

<style>
  /* ========================================================================= */
  /* Scroll-Triggered Soft-Reveal Animation (Matching Hero & ServicesGrid)     */
  /* ========================================================================= */
  .testimonial-heading-reveal,
  .testimonial-subheading-reveal,
  .testimonial-showcase-wrap {
    opacity: 0;
    transform: translateY(18px);
    filter: blur(8px);
    transition: opacity 1.3s cubic-bezier(0.16, 1, 0.3, 1),
                transform 1.3s cubic-bezier(0.16, 1, 0.3, 1),
                filter 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform, filter;
  }

  :global(#testimonials.is-revealed) .testimonial-heading-reveal {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
    transition-delay: 0.05s;
  }

  :global(#testimonials.is-revealed) .testimonial-subheading-reveal {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
    transition-delay: 0.15s;
  }

  :global(#testimonials.is-revealed) .testimonial-showcase-wrap {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
    transition-delay: 0.25s;
  }

  /* ========================================================================= */
  /* Continuous Radiant Color Shimmer Sweep across Headline Lines              */
  /* ========================================================================= */
  .testimonial-shimmer-line {
    display: block;
    background: linear-gradient(
      90deg,
      #0F274A 0%,
      #1E40AF 22%,
      #2563EB 42%,
      #DC2626 58%,
      #EF4444 72%,
      #0F274A 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    will-change: background-position;
  }

  .testimonial-shimmer-line-1 {
    animation: testimonialShimmer1 9.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .testimonial-shimmer-line-2 {
    animation: testimonialShimmer2 9.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @keyframes testimonialShimmer1 {
    0% { background-position: 0% 50%; }
    48% { background-position: 100% 50%; }
    52% { background-position: 100% 50%; }
    100% { background-position: 200% 50%; }
  }

  @keyframes testimonialShimmer2 {
    0% { background-position: -50% 50%; }
    48% { background-position: 50% 50%; }
    52% { background-position: 50% 50%; }
    100% { background-position: 150% 50%; }
  }

  /* Reduced Motion Override */
  @media (prefers-reduced-motion: reduce) {
    .testimonial-heading-reveal,
    .testimonial-subheading-reveal,
    .testimonial-showcase-wrap {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
      transition: none !important;
    }
    .testimonial-shimmer-line {
      animation: none !important;
      background: none !important;
      -webkit-text-fill-color: #0F274A !important;
      color: #0F274A !important;
    }
  }
</style>

<script>
  function initTestimonials() {
    const container = document.getElementById('testimonial-slider-container');
    const section = document.getElementById('testimonials');
    if (!container || !section) return;

    const slides = container.querySelectorAll<HTMLElement>('.testimonial-slide');
    const dots = container.querySelectorAll<HTMLElement>('.testimonial-dot');
    const prevBtn = document.getElementById('testimonial-prev-btn');
    const nextBtn = document.getElementById('testimonial-next-btn');

    if (!slides.length) return;

    let currentIndex = 0;
    const totalSlides = slides.length;
    let autoPlayTimer: ReturnType<typeof setInterval> | null = null;
    const AUTO_INTERVAL = 4500; // Changes automatically every 4.5 seconds

    // Scroll reveal observer
    if ('IntersectionObserver' in window) {
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            section.classList.add('is-revealed');
            revealObserver.unobserve(section);
          }
        });
      }, { threshold: 0.20 });
      revealObserver.observe(section);
    } else {
      section.classList.add('is-revealed');
    }

    function goToSlide(index: number) {
      if (index === currentIndex) return;

      slides[currentIndex].classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto', 'z-10');
      slides[currentIndex].classList.add('opacity-0', 'translate-y-3', 'pointer-events-none', 'z-0');
      dots[currentIndex]?.classList.remove('bg-[#FF3130]', 'w-8');
      dots[currentIndex]?.classList.add('bg-slate-200', 'w-2.5');
      dots[currentIndex]?.setAttribute('aria-selected', 'false');

      currentIndex = (index + totalSlides) % totalSlides;

      slides[currentIndex].classList.remove('opacity-0', 'translate-y-3', 'pointer-events-none', 'z-0');
      slides[currentIndex].classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto', 'z-10');
      dots[currentIndex]?.classList.remove('bg-slate-200', 'w-2.5');
      dots[currentIndex]?.classList.add('bg-[#FF3130]', 'w-8');
      dots[currentIndex]?.setAttribute('aria-selected', 'true');
    }

    function nextSlide() {
      goToSlide(currentIndex + 1);
    }

    function prevSlide() {
      goToSlide(currentIndex - 1);
    }

    function startAutoPlay() {
      stopAutoPlay();
      autoPlayTimer = setInterval(nextSlide, AUTO_INTERVAL);
    }

    function stopAutoPlay() {
      if (autoPlayTimer) {
        clearInterval(autoPlayTimer);
        autoPlayTimer = null;
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', (e) => {
        e.preventDefault();
        prevSlide();
        startAutoPlay();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', (e) => {
        e.preventDefault();
        nextSlide();
        startAutoPlay();
      });
    }

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', (e) => {
        e.preventDefault();
        goToSlide(idx);
        startAutoPlay();
      });
    });

    container.addEventListener('mouseenter', stopAutoPlay);
    container.addEventListener('mouseleave', startAutoPlay);
    container.addEventListener('focusin', stopAutoPlay);
    container.addEventListener('focusout', startAutoPlay);

    // Keyboard navigation
    container.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        nextSlide();
        startAutoPlay();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prevSlide();
        startAutoPlay();
      }
    });

    startAutoPlay();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTestimonials);
  } else {
    initTestimonials();
  }
  document.addEventListener('astro:page-load', initTestimonials);
</script>
