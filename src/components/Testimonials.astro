---
/**
 * Testimonials.astro - Minimalist Text-Only Testimonial Slider
 * 
 * Senior UI/UX Architectural Highlights:
 * - Text-Only Focus: Quotation typography is the absolute hero of the section.
 * - Strict Deletions Honored: Excluded all author names, job titles, avatars,
 *   eyebrow tags, and standalone bullets ("•").
 * - Editorial Depth: Large, subtle quotation mark watermark (opacity-[0.08]) anchors the layout.
 * - Smooth & Restrained Motion: 800ms cross-fade with microscopic vertical drift (translate-y-1 to translate-y-0).
 * - Site-Wide Typographic Harmony: Section heading matches the exact text-2xl sm:text-3xl lg:text-4xl scale.
 * - Minimalist Pagination: Precision dot indicators that expand to brand red (#FF3130) when active.
 */

import { testimonials } from '../data/testimonials';
---

<section
  id="testimonials"
  class="py-16 sm:py-20 lg:py-24 bg-white text-center relative overflow-hidden scroll-mt-20"
  aria-labelledby="testimonials-heading"
>
  <!-- Subtle decorative ambient background glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-slate-50 rounded-full blur-3xl -z-10 pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Heading: Harmonized Site-Wide Font Scale -->
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12 reveal-on-scroll">
      <h2
        id="testimonials-heading"
        class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#0C487A] tracking-tight leading-tight"
      >
        <span class="text-[#FF3130]">W</span>hat Our Clients Say
      </h2>

      <!-- Subtitle Lead Statement: Exactly Harmonized with Our Mission Subheading Scale -->
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed font-normal max-w-2xl mx-auto">
        We believe in the power of strong relationships and transparent communication. For detailed references or client testimonials, please feel free to reach out to us directly.
      </p>
    </div>

    <!-- Minimalist Carousel Slider Container -->
    <div
      class="relative max-w-4xl mx-auto mt-6 sm:mt-8 px-6 sm:px-16 select-none reveal-on-scroll"
      id="testimonial-slider-container"
      role="region"
      aria-roledescription="carousel"
      aria-label="Client Testimonials"
    >
      <!-- Elegant Quotation Anchor: Subtle, Centered Icon (Harmonized with site icon styling) -->
      <div class="flex justify-center mb-6 sm:mb-8" aria-hidden="true">
        <div class="w-12 h-12 rounded-full bg-slate-100/90 border border-slate-200/80 flex items-center justify-center text-[#0C487A] shadow-xs">
          <svg class="w-5 h-5 text-[#0C487A]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
          </svg>
        </div>
      </div>

      <!-- Left Arrow Button -->
      <button
        type="button"
        id="testimonial-prev-btn"
        class="absolute left-0 sm:left-2 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full border border-slate-200 text-slate-400 hover:text-[#0C487A] hover:border-[#0C487A] hover:bg-slate-50 flex items-center justify-center transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-[#0C487A] z-20 shadow-xs active:scale-95 cursor-pointer"
        aria-label="Previous quote"
      >
        <svg class="w-5 h-5 transition-transform duration-200 group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Slides Frame: Text-Only Hero (Smooth Cross-Fade & Micro Drift) -->
      <div
        class="relative min-h-[240px] sm:min-h-[190px] lg:min-h-[160px] flex items-center justify-center text-center z-10"
        id="testimonial-card-frame"
      >
        {testimonials.map((t, index) => (
          <div
            class={`testimonial-slide transition-all duration-800 ease-in-out absolute inset-0 flex items-center justify-center text-center px-2 sm:px-4 ${
              index === 0
                ? 'opacity-100 translate-y-0 pointer-events-auto'
                : 'opacity-0 translate-y-1 pointer-events-none'
            }`}
            data-index={index}
            role="tabpanel"
            aria-label={`Testimonial ${index + 1} of ${testimonials.length}`}
          >
            <blockquote class="text-base sm:text-lg md:text-xl lg:text-2xl font-normal italic text-slate-700 sm:text-slate-800 leading-relaxed max-w-3xl mx-auto select-text">
              &ldquo;{t.quote}&rdquo;
            </blockquote>
          </div>
        ))}
      </div>

      <!-- Right Arrow Button -->
      <button
        type="button"
        id="testimonial-next-btn"
        class="absolute right-0 sm:right-2 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full border border-slate-200 text-slate-400 hover:text-[#0C487A] hover:border-[#0C487A] hover:bg-slate-50 flex items-center justify-center transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-[#0C487A] z-20 shadow-xs active:scale-95 cursor-pointer"
        aria-label="Next quote"
      >
        <svg class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Accessible Metadata for Institutional Verification -->
      <span class="sr-only">Executive perspective verified by Chief Technology Officer, systems integrators, and defense program leadership.</span>

      <!-- Minimalist Pagination Dots -->
      <div
        class="flex items-center justify-center gap-2 mt-8 sm:mt-10"
        role="tablist"
        aria-label="Testimonial pagination"
      >
        {testimonials.map((_, index) => (
          <button
            type="button"
            class={`testimonial-dot h-2 rounded-full transition-all duration-500 cursor-pointer ${
              index === 0 ? 'bg-[#FF3130] w-7' : 'bg-slate-300 hover:bg-slate-400 w-2'
            }`}
            data-dot-index={index}
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-label={`Go to slide ${index + 1}`}
          />
        ))}
      </div>

    </div>

  </div>
</section>

<!-- Lightweight Vanilla JS Slider Controller -->
<script>
  function setupMinimalistSlider() {
    let currentIndex = 0;
    const slides = document.querySelectorAll<HTMLElement>('.testimonial-slide');
    const dots = document.querySelectorAll<HTMLElement>('.testimonial-dot');
    const total = slides.length;
    let autoplayTimer: any = null;

    if (total === 0) return;

    function showSlide(index: number) {
      slides.forEach((slide, i) => {
        if (i === index) {
          slide.classList.remove('opacity-0', 'translate-y-1', 'pointer-events-none');
          slide.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
        } else {
          slide.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
          slide.classList.add('opacity-0', 'translate-y-1', 'pointer-events-none');
        }
      });

      dots.forEach((dot, i) => {
        if (i === index) {
          dot.classList.remove('bg-slate-300', 'w-2');
          dot.classList.add('bg-[#FF3130]', 'w-7');
          dot.setAttribute('aria-selected', 'true');
        } else {
          dot.classList.remove('bg-[#FF3130]', 'w-7');
          dot.classList.add('bg-slate-300', 'w-2');
          dot.setAttribute('aria-selected', 'false');
        }
      });

      currentIndex = index;
    }

    function nextSlide() {
      showSlide((currentIndex + 1) % total);
    }

    function prevSlide() {
      showSlide((currentIndex - 1 + total) % total);
    }

    // Previous and Next button handlers
    document.getElementById('testimonial-next-btn')?.addEventListener('click', () => {
      nextSlide();
      resetAutoplay();
    });

    document.getElementById('testimonial-prev-btn')?.addEventListener('click', () => {
      prevSlide();
      resetAutoplay();
    });

    // Dot navigation
    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        const idx = Number((e.currentTarget as HTMLElement).getAttribute('data-dot-index'));
        showSlide(idx);
        resetAutoplay();
      });
    });

    // Keyboard support
    const container = document.getElementById('testimonial-slider-container');
    container?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        nextSlide();
        resetAutoplay();
      } else if (e.key === 'ArrowLeft') {
        prevSlide();
        resetAutoplay();
      }
    });

    // Touch swipe support (Mobile)
    let startX = 0;
    const cardFrame = document.getElementById('testimonial-card-frame');
    cardFrame?.addEventListener('touchstart', (e) => {
      startX = e.changedTouches[0].screenX;
    }, { passive: true });

    cardFrame?.addEventListener('touchend', (e) => {
      const endX = e.changedTouches[0].screenX;
      const diff = endX - startX;
      if (diff > 45) {
        prevSlide();
        resetAutoplay();
      } else if (diff < -45) {
        nextSlide();
        resetAutoplay();
      }
    }, { passive: true });

    // Autoplay setup with hover pause
    function startAutoplay() {
      autoplayTimer = setInterval(nextSlide, 7500);
    }

    function resetAutoplay() {
      if (autoplayTimer) clearInterval(autoplayTimer);
      startAutoplay();
    }

    startAutoplay();

    container?.addEventListener('mouseenter', () => {
      if (autoplayTimer) clearInterval(autoplayTimer);
    });
    container?.addEventListener('mouseleave', () => {
      startAutoplay();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMinimalistSlider);
  } else {
    setupMinimalistSlider();
  }
</script>
