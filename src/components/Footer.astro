---
import { Instagram, Linkedin, Mail, MapPin, Phone } from 'lucide-astro';
import { footerLinks } from '../data/navigation';
import { companyInfo } from '../data/company';
---

<footer class="footer-frame" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>

  <div class="footer-shell">
    <div class="footer-columns">
      <section class="footer-brand" aria-label="About Unity Compass">
        <a
          href="/"
          class="inline-block rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-[#D20F39] focus-visible:ring-offset-4"
          aria-label="Unity Compass home"
        >
          <img
            src="/images/unity-compass-clean.png"
            alt="Unity Compass"
            class="h-10 w-auto sm:h-11"
            width="488"
            height="89"
          />
        </a>

        <p class="mt-5 max-w-sm text-base font-semibold leading-7 text-[#D20F39] sm:text-lg">
          Your partner in government contracting success!
        </p>
        <p class="mt-3 max-w-sm text-sm leading-7 text-slate-600 sm:text-base sm:leading-8">
          Unity Compass is a government contracting consulting and staffing firm dedicated to helping commercial businesses and federal contractors compete, qualify, and perform in complex federal environments.
        </p>
      </section>

      <nav aria-labelledby="footer-services-heading">
        <h3 id="footer-services-heading" class="footer-title">Core services</h3>
        <ul class="footer-link-list" role="list">
          {footerLinks.services.map((item) => (
            <li><a href={item.href} class="footer-link">{item.name}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-labelledby="footer-company-heading">
        <h3 id="footer-company-heading" class="footer-title">Company</h3>
        <ul class="footer-link-list" role="list">
          {footerLinks.company.map((item) => (
            <li>
              <a
                href={item.href}
                target={item.href.endsWith('.pdf') ? '_blank' : undefined}
                rel={item.href.endsWith('.pdf') ? 'noopener noreferrer' : undefined}
                class="footer-link"
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <section aria-labelledby="footer-connect-heading">
        <h3 id="footer-connect-heading" class="footer-title">Connect with us</h3>
        <address class="mt-4 not-italic">
          <ul class="space-y-5 text-sm text-slate-600 sm:text-base" role="list">
            <li class="flex items-start gap-4">
              <MapPin class="mt-1 h-5 w-5 shrink-0 text-[#D20F39]" aria-hidden="true" stroke-width={1.8} />
              <span class="leading-7">
                {companyInfo.address.street}<br />
                {companyInfo.address.city} {companyInfo.address.state} {companyInfo.address.zip}
              </span>
            </li>
            <li class="flex items-center gap-4">
              <Phone class="h-5 w-5 shrink-0 text-[#D20F39]" aria-hidden="true" stroke-width={1.8} />
              <span>
                Toll free:
                <a href={`tel:${companyInfo.phoneRaw}`} class="footer-contact-link">{companyInfo.phone}</a>
              </span>
            </li>
            <li class="flex items-center gap-4">
              <Mail class="h-5 w-5 shrink-0 text-[#D20F39]" aria-hidden="true" stroke-width={1.8} />
              <a href={`mailto:${companyInfo.email}`} class="footer-contact-link break-all">{companyInfo.email}</a>
            </li>
          </ul>
        </address>
      </section>
    </div>

    <div class="footer-lower">
      <div class="footer-divider" aria-hidden="true">
        <span></span>
        <span class="footer-compass-mark">
          <span class="footer-compass-axis"></span>
          <span class="footer-compass-north"></span>
          <span class="footer-compass-south"></span>
        </span>
        <span></span>
      </div>

      <div class="footer-meta">
        <div class="flex items-center gap-4" aria-label="Unity Compass social media">
          <a
            href={companyInfo.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-link"
            aria-label="LinkedIn"
          >
            <Linkedin class="h-5 w-5" aria-hidden="true" stroke-width={1.8} />
          </a>
          <a
            href={companyInfo.social.twitter}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-link"
            aria-label="X (Twitter)"
          >
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
            </svg>
          </a>
          <a
            href={companyInfo.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-link"
            aria-label="Instagram"
          >
            <Instagram class="h-5 w-5" aria-hidden="true" stroke-width={1.8} />
          </a>
        </div>

        <p class="text-center text-xs text-slate-500 sm:text-sm">
          Copyright &copy; 2026 Unity Compass&nbsp; | &nbsp;By Unity Compass
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-frame {
    position: relative;
    overflow: hidden;
    width: 100%;
    border-top: 1px solid rgba(203, 213, 225, 0.82);
    background-color: #eef4fb;
    background-image:
      linear-gradient(to right, rgba(12, 72, 122, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(12, 72, 122, 0.035) 1px, transparent 1px);
    background-size: 24px 24px;
    color: #475569;
  }

  .footer-shell {
    display: flex;
    max-width: 80rem;
    margin: 0 auto;
    padding: 4rem 1rem 2rem;
    flex-direction: column;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.75rem;
  }

  .footer-title {
    color: #10295b;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }

  .footer-link-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .footer-link,
  .footer-contact-link {
    position: relative;
    color: #526078;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .footer-contact-link {
    color: #10295b;
  }

  .footer-link::after,
  .footer-contact-link::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -0.18rem;
    left: 0;
    height: 2px;
    border-radius: 9999px;
    background: #d20f39;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 220ms ease;
  }

  .footer-link:hover,
  .footer-contact-link:hover {
    color: #d20f39;
  }

  .footer-link:hover::after,
  .footer-contact-link:hover::after {
    transform: scaleX(1);
  }

  .footer-lower {
    margin-top: 3.5rem;
  }

  .footer-divider {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.25rem;
  }

  .footer-divider > span:first-child,
  .footer-divider > span:last-child {
    height: 2px;
    background: #cbd8e8;
  }

  .footer-compass-mark {
    position: relative;
    display: block;
    width: 3.25rem;
    height: 3.25rem;
    border: 2px solid #cad7e6;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 9px 22px -14px rgba(15, 39, 74, 0.5);
  }

  .footer-compass-axis {
    position: absolute;
    top: 50%;
    left: 0.6rem;
    width: calc(100% - 1.2rem);
    height: 2px;
    background: #9eabc0;
    transform: translateY(-50%);
  }

  .footer-compass-north,
  .footer-compass-south {
    position: absolute;
    left: 50%;
    width: 0;
    height: 0;
    transform: translateX(-50%);
  }

  .footer-compass-north {
    top: 0.2rem;
    border-right: 0.32rem solid transparent;
    border-bottom: 1.4rem solid #d20f39;
    border-left: 0.32rem solid transparent;
  }

  .footer-compass-south {
    bottom: 0.2rem;
    border-top: 1.4rem solid #10295b;
    border-right: 0.32rem solid transparent;
    border-left: 0.32rem solid transparent;
  }

  .footer-meta {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .footer-social-link {
    display: inline-flex;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    border: 1px solid #d4deea;
    border-radius: 0.85rem;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 8px 18px -14px rgba(15, 39, 74, 0.55);
    color: #10295b;
    transition: color 200ms ease, border-color 200ms ease, transform 200ms ease, box-shadow 200ms ease;
  }

  .footer-social-link:hover {
    border-color: rgba(210, 15, 57, 0.42);
    box-shadow: 0 12px 24px -14px rgba(210, 15, 57, 0.55);
    color: #d20f39;
    transform: translateY(-2px);
  }

  .footer-link:focus-visible,
  .footer-contact-link:focus-visible,
  .footer-social-link:focus-visible {
    outline: 2px solid #d20f39;
    outline-offset: 4px;
  }

  @media (min-width: 640px) {
    .footer-shell {
      padding-right: 1.5rem;
      padding-left: 1.5rem;
    }

    .footer-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem 4rem;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .footer-shell {
      padding-right: 2rem;
      padding-left: 2rem;
    }

    .footer-columns {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.82fr) minmax(0, 0.88fr) minmax(0, 1.08fr);
      gap: 2rem;
    }

    .footer-brand {
      grid-column: auto;
    }
  }

  @media (min-width: 1280px) {
    .footer-columns {
      gap: 3.25rem;
    }
  }

  @media (max-width: 639px) {
    .footer-lower {
      margin-top: 3rem;
    }

    .footer-divider {
      gap: 0.75rem;
    }

    .footer-meta {
      flex-direction: column;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-link,
    .footer-contact-link,
    .footer-social-link {
      transition: none;
    }
  }
</style>
