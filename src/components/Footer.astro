---
/**
 * Footer.astro - Executive GovCon Enterprise Light Footer
 * 
 * Harmonized Theme & Visual Continuity:
 * - Light sky-to-slate blueprint canvas (#F4F8FC via #EBF3FA to #DFEDF8) matching Hero & ContactCTA
 * - Minute 16px × 16px technical blueprint checks overlay
 * - Soft ambient radial blue and red glows
 * - Official Verbatim Tagline with radiant multi-color shimmer sweep matching headline typography
 * - Verbatim Unity Compass corporate narrative
 * - Crisp, elegant navigation columns with hover horizontal glide
 * - Interactive social media pills and contact details
 * - 100% harmonious typography and palette consistency across the entire website
 */

import { footerLinks } from '../data/navigation';
import { companyInfo } from '../data/company';
---

<footer class="relative bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] text-slate-700 border-t border-slate-200/90 overflow-hidden" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>

  <!-- Minute Checks Pattern Overlay (Matching Hero & ServicesGrid) -->
  <div
    class="absolute inset-0 pointer-events-none opacity-35 mix-blend-multiply"
    style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.08) 1px, transparent 1px);"
    aria-hidden="true"
  ></div>

  <!-- Ambient Subtle Radial Glows -->
  <div class="absolute -top-32 left-1/4 w-96 h-96 bg-[radial-gradient(circle,rgba(40,121,182,0.12)_0%,transparent_70%)] pointer-events-none blur-3xl" aria-hidden="true"></div>
  <div class="absolute -bottom-32 right-10 w-96 h-96 bg-[radial-gradient(circle,rgba(255,49,48,0.08)_0%,transparent_70%)] pointer-events-none blur-3xl" aria-hidden="true"></div>

  <!-- Main Footer Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8">
      
      <!-- Brand & Mission Column (Spans 2 cols on lg) -->
      <div class="lg:col-span-2 space-y-5">
        <a
          href="/"
          class="inline-block focus:outline-none focus:ring-2 focus:ring-[#FF3130] rounded-lg group"
          aria-label="Unity Compass Home"
        >
          <img
            src="/images/Green-Minimal-Travel-Business-Logo.png"
            alt="Unity Compass"
            class="h-10 w-auto object-contain group-hover:opacity-90 transition-opacity duration-200"
            width="180"
            height="52"
          />
        </a>

        <!-- Required Official Tagline with Continuous Radiant Shimmer Sweep -->
        <p class="footer-tagline-shimmer text-base sm:text-lg font-extrabold tracking-tight">
          Your Partner in Government Contracting Success!
        </p>

        <!-- Verbatim Authentic Corporate Narrative -->
        <p class="text-sm text-slate-600 leading-relaxed max-w-sm font-normal">
          Unity Compass is a government contracting consulting and staffing firm dedicated to helping commercial businesses and federal contractors compete, qualify, and perform in complex federal environments.
        </p>
      </div>

      <!-- Core Services Column -->
      <div>
        <h3 class="text-sm font-bold text-[#0B2553] tracking-tight mb-4">
          Core Services
        </h3>
        <ul class="space-y-3 text-sm">
          {footerLinks.services.map((item) => (
            <li>
              <a href={item.href} class="footer-link">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company & Navigation Links Column -->
      <div>
        <h3 class="text-sm font-bold text-[#0B2553] tracking-tight mb-4">
          Company
        </h3>
        <ul class="space-y-3 text-sm">
          {footerLinks.company.map((item) => (
            <li>
              <a
                href={item.href}
                target={item.href.endsWith('.pdf') ? '_blank' : undefined}
                rel={item.href.endsWith('.pdf') ? 'noopener noreferrer' : undefined}
                class="footer-link"
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Address & Direct Contact Column -->
      <div>
        <h3 class="text-sm font-bold text-[#0B2553] tracking-tight mb-4">
          Headquarters
        </h3>
        <ul class="space-y-3.5 text-sm text-slate-600 font-normal">
          <li class="flex items-start gap-3">
            <svg class="w-4 h-4 text-[#FF3130] shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <div class="leading-snug">
              <div class="text-[#0B2553] font-semibold">Executive Office:</div>
              <div>2153 Wainwright CT Unit 1B</div>
              <div>Frederick MD 21702-6418</div>
            </div>
          </li>

          <li class="flex items-center gap-3">
            <svg class="w-4 h-4 text-[#FF3130] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <div>
              <span class="text-slate-500 text-xs mr-1">Toll Free:</span>
              <a href="tel:+18009791514" class="footer-link font-medium">
                +1 800 979 1514
              </a>
            </div>
          </li>

          <li class="flex items-center gap-3">
            <svg class="w-4 h-4 text-[#FF3130] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <div>
              <span class="text-slate-500 text-xs mr-1">Direct:</span>
              <a href="mailto:sales@unitycompass.com" class="footer-link font-medium">
                sales@unitycompass.com
              </a>
            </div>
          </li>
        </ul>

        <!-- Social Media Links -->
        <div class="mt-6 pt-4 border-t border-slate-200/90">
          <div class="text-xs font-bold uppercase tracking-wider text-[#0B2553] mb-2.5">Connect With Us:</div>
          <div class="flex items-center gap-2.5">
            <a
              href={companyInfo.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2.5 rounded-xl bg-white hover:bg-[#FF3130] text-slate-600 hover:text-white transition-all duration-200 border border-slate-200/90 shadow-xs hover:scale-105 active:scale-95 cursor-pointer"
              aria-label="LinkedIn"
              title="LinkedIn"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>

            <a
              href={companyInfo.social.twitter}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2.5 rounded-xl bg-white hover:bg-[#FF3130] text-slate-600 hover:text-white transition-all duration-200 border border-slate-200/90 shadow-xs hover:scale-105 active:scale-95 cursor-pointer"
              aria-label="X (Twitter)"
              title="X (Twitter)"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>

            <a
              href={companyInfo.social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2.5 rounded-xl bg-white hover:bg-[#FF3130] text-slate-600 hover:text-white transition-all duration-200 border border-slate-200/90 shadow-xs hover:scale-105 active:scale-95 cursor-pointer"
              aria-label="Instagram"
              title="Instagram"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright & Legal Line -->
    <div class="mt-14 pt-8 border-t border-slate-200/90 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 font-normal">
      <p>&copy; 2026 All Rights Reserved.</p>

      <div class="flex items-center gap-6">
        <a href="/privacy-policy" class="footer-bottom-link">
          Privacy Policy
        </a>
        <a href="javascript:void(0)" class="footer-bottom-link cursor-pointer">
          Contact Us
        </a>
        <span class="text-slate-400">Frederick, MD 21702-6418, USA</span>
      </div>
    </div>
  </div>
</footer>

<style>
  /* ========================================================================= */
  /* Elegant Footer Navigation Links: Color Animation & Animated Underline     */
  /* ========================================================================= */
  .footer-link {
    position: relative;
    display: inline-block;
    color: #475569; /* text-slate-600 */
    text-decoration: none;
    transition: color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, color;
  }

  .footer-link::after {
    content: '';
    position: absolute;
    bottom: -2.5px;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, #FF3130 0%, #E02424 60%, #1E40AF 100%);
    border-radius: 9999px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .footer-link:hover {
    color: #FF3130 !important;
    transform: translateX(4px);
  }

  .footer-link:hover::after {
    transform: scaleX(1);
  }

  /* Bottom Legal Links with Smooth Expanding Underline */
  .footer-bottom-link {
    position: relative;
    display: inline-block;
    color: #64748B; /* text-slate-500 */
    text-decoration: none;
    transition: color 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .footer-bottom-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1.5px;
    background-color: #FF3130;
    border-radius: 9999px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .footer-bottom-link:hover {
    color: #FF3130 !important;
  }

  .footer-bottom-link:hover::after {
    transform: scaleX(1);
  }

  /* ========================================================================= */
  /* Continuous Radiant Color Shimmer Sweep across Footer Tagline              */
  /* ========================================================================= */
  .footer-tagline-shimmer {
    background: linear-gradient(
      90deg,
      #0F274A 0%,
      #1E40AF 22%,
      #2563EB 42%,
      #DC2626 58%,
      #EF4444 72%,
      #0F274A 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    will-change: background-position;
    animation: footerShimmer 9.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @keyframes footerShimmer {
    0% { background-position: 0% 50%; }
    48% { background-position: 100% 50%; }
    52% { background-position: 100% 50%; }
    100% { background-position: 200% 50%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-tagline-shimmer {
      animation: none !important;
      background: none !important;
      -webkit-text-fill-color: #0F274A !important;
      color: #0F274A !important;
    }
  }
</style>
