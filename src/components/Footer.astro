---
/**
 * Footer.astro - Executive GovCon Enterprise Light Footer with Wavy Divider
 * 
 * Harmonized Theme & Visual Continuity:
 * - Pure CSS SVG Wave Section Divider (wsd-01) creating an organic transition from the white section above into the footer
 * - Light sky-to-slate blueprint canvas (#F4F8FC via #EBF3FA to #DFEDF8) matching Hero
 * - Minute 16px × 16px technical blueprint checks overlay
 * - Soft ambient radial blue and red glows
 * - Official Tagline in brand red (#FF3130)
 * - Verbatim Unity Compass corporate narrative
 * - Crisp, elegant navigation columns with hover horizontal glide
 * - Interactive social media pills and contact details
 * - 100% harmonious typography and palette consistency
 */

import { footerLinks } from '../data/navigation';
import { companyInfo } from '../data/company';
import WaveDivider from './WaveDivider.astro';
import Icon from './Icon.astro';

const currentYear = new Date().getFullYear();
---

<footer class="relative bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] text-slate-700 overflow-hidden" aria-labelledby="footer-heading">
  <!-- Pure CSS SVG Wave Section Divider (wsd-01) Leading from White Canvas into Footer Gradient -->
  <WaveDivider variant="wave" position="top" fillColor="#ffffff" />

  <h2 id="footer-heading" class="sr-only">Footer</h2>

  <!-- Minute Checks Pattern Overlay (Matching Hero & ServicesGrid) -->
  <div
    class="absolute inset-0 pointer-events-none opacity-35 mix-blend-multiply"
    style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.08) 1px, transparent 1px);"
    aria-hidden="true"
  ></div>

  <!-- Ambient Subtle Radial Glows -->
  <div class="absolute -top-32 left-1/4 w-96 h-96 bg-[radial-gradient(circle,rgba(40,121,182,0.12)_0%,transparent_70%)] pointer-events-none blur-3xl" aria-hidden="true"></div>
  <div class="absolute -bottom-32 right-10 w-96 h-96 bg-[radial-gradient(circle,rgba(255,49,48,0.08)_0%,transparent_70%)] pointer-events-none blur-3xl" aria-hidden="true"></div>

  <!-- Main Footer Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 sm:pt-28 lg:pt-32 pb-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
      
      <!-- Brand & Mission Column (Spans 2 cols on lg) -->
      <div class="lg:col-span-2 space-y-5">
        <a
          href="/"
          class="inline-block focus:outline-none focus:ring-2 focus:ring-[#FF3130] rounded-lg group"
          aria-label="Unity Compass Home"
        >
          <img
            src="/images/Green-Minimal-Travel-Business-Logo.png"
            alt="Unity Compass"
            class="h-10 w-auto object-contain group-hover:opacity-90 transition-opacity duration-200"
            width="180"
            height="52"
          />
        </a>

        <!-- Official Tagline in Brand Red -->
        <p class="text-base sm:text-lg font-extrabold tracking-tight text-[#FF3130]">
          Your Partner in Government Contracting Success!
        </p>

        <!-- Verbatim Authentic Corporate Narrative -->
        <p class="text-sm text-slate-600 leading-relaxed max-w-sm font-normal">
          Unity Compass is a government contracting consulting and staffing firm dedicated to helping commercial businesses and federal contractors compete, qualify, and perform in complex federal environments.
        </p>
      </div>

      <!-- Core Services Column -->
      <div>
        <h3 class="text-sm font-bold text-[#0B2553] tracking-tight mb-4">
          Core Services
        </h3>
        <ul class="space-y-3 text-sm">
          {footerLinks.services.map((item) => (
            <li>
              <a href={item.href} class="footer-link">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company & Navigation Links Column -->
      <div>
        <h3 class="text-sm font-bold text-[#0B2553] tracking-tight mb-4">
          Company
        </h3>
        <ul class="space-y-3 text-sm">
          {footerLinks.company.map((item) => (
            <li>
              <a
                href={item.href}
                data-astro-prefetch={item.href === '/about-us' ? 'hover' : undefined}
                target={item.href.endsWith('.pdf') ? '_blank' : undefined}
                rel={item.href.endsWith('.pdf') ? 'noopener noreferrer' : undefined}
                class="footer-link"
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <section aria-labelledby="footer-connect-heading">
                <h3 id="footer-connect-heading" class="text-sm font-bold text-[#0B2553] tracking-tight mb-4">
         Connect with us
        </h3>
        <address class="mt-4 not-italic">
          <ul class="space-y-5 text-sm text-slate-600 sm:text-base" role="list">
            <li class="flex items-start gap-2">
              <Icon name="MapPin" class="mt-1 h-5 w-5 shrink-0 text-[#D20F39]" aria-hidden="true" stroke-width={1.8} />
              <span class="leading-7">
                {companyInfo.address.street}<br />
                {companyInfo.address.city} {companyInfo.address.state} {companyInfo.address.zip}
              </span>
            </li>
            <li class="flex items-center gap-2">
              <Icon name="Phone" class="h-5 w-5 shrink-0 text-[#D20F39]" aria-hidden="true" stroke-width={1.8} />
              <span>
                <a href={`tel:${companyInfo.phoneRaw}`} class="footer-contact-link">{companyInfo.phone}</a>
              </span>
            </li>
            <li class="flex items-center gap-2">
              <Icon name="Mail" class="h-5 w-5 shrink-0 text-[#D20F39]" aria-hidden="true" stroke-width={1.8} />
              <a href={`mailto:${companyInfo.email}`} class="footer-contact-link break-all">{companyInfo.email}</a>
            </li>
          </ul>
        </address>
      </section>
    </div>

    <div class="footer-lower">
      <div class="footer-divider" aria-hidden="true">
        <span></span>
        <img
          src="/favicon.png"
          alt=""
          class="footer-compass-mark"
          width="300"
          height="300"
          loading="lazy"
          decoding="async"
        />
        <span></span>
      </div>

      <div class="footer-meta flex flex-col sm:flex-row gap-4 sm:items-center sm:justify-between">
        <div class="flex items-center gap-4" aria-label="Unity Compass social media">
          <a
            href={companyInfo.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-link rounded-full"
            aria-label="LinkedIn"
          >
            <Icon name="Linkedin" class="h-5 w-5" aria-hidden="true" stroke-width={1.8} />
          </a>
          <a
            href={companyInfo.social.twitter}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-link rounded-full"
            aria-label="X (Twitter)"
          >
            <Icon name="Twitter" class="h-5 w-5" aria-hidden="true" stroke-width={1.8} />
          </a>
          <a
            href={companyInfo.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-link rounded-full"
            aria-label="Instagram"
          >
            <Icon name="Instagram" class="h-5 w-5" aria-hidden="true" stroke-width={1.8} />
          </a>
        </div>

        <!-- Bottom Copyright & Legal Line -->
        <div class="text-sm text-slate-500 font-normal">
          <p>Copyright &copy; <time class="font-bold" datetime={String(currentYear)} data-current-year>{currentYear}</time> Unity Compass <strong>| By Unity Compass</strong></p>
        </div>
      </div>
    </div>

  </div>
</footer>

<script>
  const year = String(new Date().getFullYear());
  document.querySelectorAll<HTMLTimeElement>('[data-current-year]').forEach((element) => {
    element.dateTime = year;
    element.textContent = year;
  });
</script>

<style>
  /* ========================================================================= */
  /* Elegant Footer Navigation Links: Color Animation & Animated Underline     */
  /* ========================================================================= */
  .footer-link {
    position: relative;
    display: inline-block;
    color: #475569; /* text-slate-600 */
    text-decoration: none;
    transition: color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, color;
  }

  .footer-link::after {
    content: '';
    position: absolute;
    bottom: -2.5px;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, #FF3130 0%, #E02424 60%, #1E40AF 100%);
    border-radius: 9999px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .footer-link:hover {
    color: #FF3130 !important;
    transform: translateX(4px);
  }

  .footer-link:hover::after {
    transform: scaleX(1);
  }

  .footer-divider {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.25rem;
  }

  .footer-divider > span:first-child,
  .footer-divider > span:last-child {
    height: 2px;
    background: #cbd8e8;
  }

  .footer-compass-mark {
    display: block;
    width: 3.75rem;
    height: 3.75rem;
    object-fit: contain;
    filter: drop-shadow(0 10px 16px rgba(15, 39, 74, 0.18));
  }

  .footer-social-link {
    display: inline-flex;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    border: 1px solid #d4deea;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 8px 18px -14px rgba(15, 39, 74, 0.55);
    color: #10295b;
    transition: color 200ms ease, border-color 200ms ease, transform 200ms ease, box-shadow 200ms ease;
  }

  .footer-social-link:hover {
    border-color: rgba(210, 15, 57, 0.42);
    box-shadow: 0 12px 24px -14px rgba(210, 15, 57, 0.55);
    color: #d20f39;
    transform: translateY(-2px);
  }

  .footer-bottom-link:hover {
    color: #FF3130 !important;
  }

  .footer-bottom-link:hover::after {
    transform: scaleX(1);
  }
</style>
