---
import { companyInfo } from '../data/company';
---

<div class="bg-[#0C3860] text-slate-200 text-xs py-2 px-4 border-b border-sky-900/60">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
    <!-- Announcement Notice -->
    <div class="flex items-center gap-2 text-center sm:text-left">
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-brand-red text-white uppercase tracking-wider">
        GovCon Update
      </span>
      <span class="text-slate-300 font-medium">
        Now assisting businesses with <span class="text-white font-semibold">GSA OASIS+</span> & SBIR.
      </span>
      <a href="javascript:void(0)" class="text-red-400 hover:text-red-300 underline underline-offset-2 ml-1 transition-colors cursor-pointer">
        Inquire now &rarr;
      </a>
    </div>

    <!-- Direct Contact Quick Links -->
    <div class="hidden md:flex items-center gap-5 text-slate-300">
      <a href={`tel:${companyInfo.phoneRaw}`} class="flex items-center gap-1.5 hover:text-white transition-colors">
        <svg class="w-3.5 h-3.5 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>{companyInfo.phone}</span>
      </a>

      <span class="text-slate-700">|</span>

      <a href={`mailto:${companyInfo.email}`} class="flex items-center gap-1.5 hover:text-white transition-colors">
        <svg class="w-3.5 h-3.5 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span>{companyInfo.email}</span>
      </a>

      <span class="text-slate-700">|</span>

      <a
        href={companyInfo.capabilityPdf}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-slate-300 hover:text-white transition-colors"
      >
        <svg class="w-3.5 h-3.5 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>Capability Statement</span>
      </a>
    </div>
  </div>
</div>

