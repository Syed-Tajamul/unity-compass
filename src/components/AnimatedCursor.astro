---
/**
 * AnimatedCursor.astro - Executive Compass Navigational Reticle Cursor Follower
 * 
 * Brand Harmony & GovCon Aesthetics:
 * - Dual-layer precision navigation follower:
 *   1. Inner Precision Micro-Dot: Sharp Needle Red (#FF3130) with soft radiant beacon glow.
 *   2. Outer Navigational Reticle Ring: Smooth 38px gliding compass circle with fine hairline
 *      cardinal tick marks (North, East, South, West notches).
 * - Interactive States:
 *   - Hovering over buttons/links/tabs: Ring expands to 56px, border transitions to vibrant red (#FF3130)
 *     with translucent red aura and illuminated cardinal ticks.
 *   - Clicking (mousedown): Elastic snap-in pulse (scale 0.85) for tactile visual response.
 *   - Offscreen/Idle: Graceful fade-out when mouse leaves the viewport.
 * - Hardware Accelerated: Uses requestAnimationFrame + translate3d for butter-smooth 60fps/120fps motion.
 * - Fully Non-Intrusive: pointer-events: none ensures zero interference with clicks, text selection, or OS cursor.
 * - Auto-disabled on touch/mobile screens (@media (pointer: coarse)) and prefers-reduced-motion.
 */
---

<div id="compass-cursor-wrap" class="compass-cursor-container" aria-hidden="true">
  <!-- Outer Floating Navigational Reticle Ring with 4 Cardinal Compass Ticks -->
  <div id="compass-cursor-ring" class="compass-cursor-ring">
    <span class="compass-tick compass-tick-n"></span>
    <span class="compass-tick compass-tick-e"></span>
    <span class="compass-tick compass-tick-s"></span>
    <span class="compass-tick compass-tick-w"></span>
  </div>

  <!-- Inner Pinpoint Needle-Red Precision Micro-Dot -->
  <div id="compass-cursor-dot" class="compass-cursor-dot"></div>
</div>

<style>
  .compass-cursor-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 99999;
    overflow: hidden;
  }

  /* -------------------------------------------------- */
  /* Inner Precision Micro-Dot                          */
  /* -------------------------------------------------- */
  .compass-cursor-dot {
    position: fixed;
    top: 0;
    left: 0;
    width: 6px;
    height: 6px;
    margin-top: -3px;
    margin-left: -3px;
    border-radius: 50%;
    background: #FF3130;
    box-shadow: 0 0 10px rgba(255, 49, 48, 0.7), 0 0 4px rgba(255, 49, 48, 0.9);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  /* -------------------------------------------------- */
  /* Outer Compass Navigational Reticle Ring            */
  /* -------------------------------------------------- */
  .compass-cursor-ring {
    position: fixed;
    top: 0;
    left: 0;
    width: 38px;
    height: 38px;
    margin-top: -19px;
    margin-left: -19px;
    border-radius: 50%;
    border: 1.5px solid rgba(12, 72, 122, 0.40);
    background: radial-gradient(circle, rgba(12, 72, 122, 0.04) 0%, transparent 70%);
    box-shadow: 0 0 16px rgba(12, 72, 122, 0.10);
    pointer-events: none;
    opacity: 0;
    transition: width 0.32s cubic-bezier(0.16, 1, 0.3, 1),
                height 0.32s cubic-bezier(0.16, 1, 0.3, 1),
                margin 0.32s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.25s ease,
                background 0.25s ease,
                box-shadow 0.25s ease,
                opacity 0.3s ease;
    will-change: transform, opacity;
  }

  /* 4 Cardinal Compass Rose Notches */
  .compass-tick {
    position: absolute;
    background: rgba(12, 72, 122, 0.5);
    transition: background-color 0.25s ease, transform 0.25s ease;
  }

  .compass-tick-n {
    top: -3px;
    left: 50%;
    width: 1.5px;
    height: 5px;
    transform: translateX(-50%);
  }

  .compass-tick-s {
    bottom: -3px;
    left: 50%;
    width: 1.5px;
    height: 5px;
    transform: translateX(-50%);
  }

  .compass-tick-e {
    right: -3px;
    top: 50%;
    width: 5px;
    height: 1.5px;
    transform: translateY(-50%);
  }

  .compass-tick-w {
    left: -3px;
    top: 50%;
    width: 5px;
    height: 1.5px;
    transform: translateY(-50%);
  }

  /* -------------------------------------------------- */
  /* Active Hover State (Over Interactive Elements)     */
  /* -------------------------------------------------- */
  .compass-cursor-ring.is-hovering {
    width: 54px;
    height: 54px;
    margin-top: -27px;
    margin-left: -27px;
    border-color: #FF3130;
    background: radial-gradient(circle, rgba(255, 49, 48, 0.12) 0%, rgba(12, 72, 122, 0.04) 60%, transparent 80%);
    box-shadow: 0 0 24px rgba(255, 49, 48, 0.35), 0 0 8px rgba(255, 49, 48, 0.2) inset;
  }

  .compass-cursor-ring.is-hovering .compass-tick {
    background: #FF3130;
  }

  .compass-cursor-ring.is-hovering .compass-tick-n {
    transform: translateX(-50%) translateY(-2px);
  }

  .compass-cursor-ring.is-hovering .compass-tick-s {
    transform: translateX(-50%) translateY(2px);
  }

  .compass-cursor-ring.is-hovering .compass-tick-e {
    transform: translateY(-50%) translateX(2px);
  }

  .compass-cursor-ring.is-hovering .compass-tick-w {
    transform: translateY(-50%) translateX(-2px);
  }

  .compass-cursor-dot.is-hovering {
    transform: scale(1.4);
    box-shadow: 0 0 14px rgba(255, 49, 48, 0.9);
  }

  /* Click Down Pulse State */
  .compass-cursor-ring.is-clicking {
    transform: scale(0.82) !important;
    border-color: #FF3130;
    transition: transform 0.12s ease-out;
  }

  .compass-cursor-dot.is-clicking {
    transform: scale(0.7) !important;
  }

  /* -------------------------------------------------- */
  /* Mobile, Touch Devices & Reduced Motion Overrides   */
  /* -------------------------------------------------- */
  @media (pointer: coarse), (hover: none) {
    .compass-cursor-container {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .compass-cursor-container {
      display: none !important;
    }
  }
</style>

<script>
  function initCompassCursor() {
    const wrap = document.getElementById('compass-cursor-wrap');
    const ring = document.getElementById('compass-cursor-ring');
    const dot = document.getElementById('compass-cursor-dot');

    if (!wrap || !ring || !dot) return;

    // Disable if touch screen or reduced motion
    const isTouch = window.matchMedia('(pointer: coarse)').matches;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (isTouch || prefersReducedMotion) return;

    let mouseX = -100;
    let mouseY = -100;
    let ringX = -100;
    let ringY = -100;
    let isVisible = false;
    let isHovering = false;
    let isClicking = false;
    let animId: number | null = null;
    let idleTimeout: ReturnType<typeof setTimeout> | null = null;

    // Linear Interpolation factor (0.16 produces smooth, responsive aerodynamic lag)
    const LERP = 0.16;

    // 1. Mouse Movement Tracker
    function onMouseMove(e: MouseEvent) {
      mouseX = e.clientX;
      mouseY = e.clientY;

      if (!isVisible) {
        isVisible = true;
        ring.style.opacity = '1';
        dot.style.opacity = '1';
        ringX = mouseX;
        ringY = mouseY;
      }

      // Dot follows immediately with 0ms lag
      dot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0)`;

      // Reset idle fade-out
      if (idleTimeout) clearTimeout(idleTimeout);
      idleTimeout = setTimeout(() => {
        if (!isHovering) {
          ring.style.opacity = '0.4';
        }
      }, 3500);
    }

    // 2. Continuous 60fps/120fps Ring Damping Loop
    function render() {
      if (isVisible) {
        ringX += (mouseX - ringX) * LERP;
        ringY += (mouseY - ringY) * LERP;

        const scale = isClicking ? ' scale(0.82)' : '';
        ring.style.transform = `translate3d(${ringX.toFixed(2)}px, ${ringY.toFixed(2)}px, 0)${scale}`;
      }

      animId = requestAnimationFrame(render);
    }

    // 3. Hover Detection over Interactive Elements (Event Delegation)
    function checkInteractive(target: HTMLElement | null): boolean {
      if (!target) return false;
      return Boolean(
        target.closest(
          'a, button, input, textarea, select, [role="button"], [role="tab"], .cursor-pointer, [data-interactive], summary'
        )
      );
    }

    function onMouseOver(e: MouseEvent) {
      const target = e.target as HTMLElement | null;
      if (checkInteractive(target)) {
        if (!isHovering) {
          isHovering = true;
          ring.classList.add('is-hovering');
          dot.classList.add('is-hovering');
          ring.style.opacity = '1';
        }
      } else {
        if (isHovering) {
          isHovering = false;
          ring.classList.remove('is-hovering');
          dot.classList.remove('is-hovering');
        }
      }
    }

    // 4. Click Micro-Interactions
    function onMouseDown() {
      isClicking = true;
      ring.classList.add('is-clicking');
      dot.classList.add('is-clicking');
    }

    function onMouseUp() {
      isClicking = false;
      ring.classList.remove('is-clicking');
      dot.classList.remove('is-clicking');
    }

    // 5. Window Enter / Leave
    function onMouseLeave() {
      isVisible = false;
      ring.style.opacity = '0';
      dot.style.opacity = '0';
    }

    function onMouseEnter() {
      isVisible = true;
      ring.style.opacity = '1';
      dot.style.opacity = '1';
    }

    // Attach listeners
    window.addEventListener('mousemove', onMouseMove, { passive: true });
    window.addEventListener('mouseover', onMouseOver, { passive: true });
    window.addEventListener('mousedown', onMouseDown, { passive: true });
    window.addEventListener('mouseup', onMouseUp, { passive: true });
    document.addEventListener('mouseleave', onMouseLeave);
    document.addEventListener('mouseenter', onMouseEnter);

    // Start render loop
    animId = requestAnimationFrame(render);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCompassCursor);
  } else {
    initCompassCursor();
  }
  document.addEventListener('astro:page-load', initCompassCursor);
</script>

