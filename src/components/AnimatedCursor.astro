---
/**
 * AnimatedCursor.astro - Ultra-Smooth Two-Tone Brand Logo Interactive Cursor
 * 
 * Brand Harmony & GovCon Aesthetics:
 * - Replaces the crosshair/compass reticle with a sleek, minimalist dual-color design:
 *   1. Outer Ring: 34px fluid follower with an ultra-clean dual-color brand gradient
 *      blending Unity Compass Navy Blue (#0C487A) and Federal Vibrant Red (#FF3130).
 *      Gentle continuous 360° rotation adds a hypnotic, high-tech elegance.
 *   2. Center Core Dot: Precision 5px micro-dot in vibrant brand red (#FF3130) with
 *      soft radiant ambient glow.
 * - Interactive States:
 *   - Hovering over buttons/links/cards: Ring expands smoothly to 52px, gains a soft
 *     translucent dual-brand aura, and the core dot scales gracefully.
 *   - Clicking: Tactile micro-elastic compression snap (scale 0.82).
 *   - Idle: Softens opacity after 3.5s of inactivity.
 * - Hardware Accelerated: requestAnimationFrame + translate3d for 60fps/120fps glide.
 * - Non-Intrusive: pointer-events: none on all elements guarantees zero interference.
 * - Auto-disabled on touch/mobile screens (@media (pointer: coarse)) and prefers-reduced-motion.
 */
---

<div id="brand-cursor-wrap" class="brand-cursor-container" aria-hidden="true">
  <!-- Outer Floating Dual-Color Brand Follower Ring -->
  <div id="brand-cursor-ring" class="brand-cursor-ring">
    <svg class="brand-cursor-svg w-full h-full" viewBox="0 0 44 44" fill="none">
      <defs>
        <linearGradient id="cursorTwoColorGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#0C487A" />
          <stop offset="48%" stop-color="#1E40AF" />
          <stop offset="100%" stop-color="#FF3130" />
        </linearGradient>
      </defs>
      <circle
        class="brand-cursor-circle"
        cx="22"
        cy="22"
        r="19"
        stroke="url(#cursorTwoColorGrad)"
        stroke-width="1.75"
      />
    </svg>
  </div>

  <!-- Inner Center Precision Micro-Dot -->
  <div id="brand-cursor-dot" class="brand-cursor-dot"></div>
</div>

<style>
  .brand-cursor-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none !important;
    z-index: 99999;
    overflow: hidden;
  }

  /* -------------------------------------------------- */
  /* Inner Center Micro-Dot                             */
  /* -------------------------------------------------- */
  .brand-cursor-dot {
    position: fixed;
    top: 0;
    left: 0;
    width: 6px;
    height: 6px;
    margin-top: -3px;
    margin-left: -3px;
    border-radius: 50%;
    background: #FF3130;
    box-shadow: 0 0 8px rgba(255, 49, 48, 0.75), 0 0 2px rgba(255, 49, 48, 0.9);
    pointer-events: none !important;
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.25s ease;
    will-change: transform, opacity;
  }

  /* -------------------------------------------------- */
  /* Outer Dual-Color Smooth Brand Ring                 */
  /* -------------------------------------------------- */
  .brand-cursor-ring {
    position: fixed;
    top: 0;
    left: 0;
    width: 34px;
    height: 34px;
    margin-top: -17px;
    margin-left: -17px;
    border-radius: 50%;
    pointer-events: none !important;
    opacity: 0;
    transition: width 0.34s cubic-bezier(0.16, 1, 0.3, 1),
                height 0.34s cubic-bezier(0.16, 1, 0.3, 1),
                margin 0.34s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.3s ease,
                background 0.3s ease,
                filter 0.3s ease;
    will-change: transform, opacity;
  }

  /* Smooth, hypnotic rotation of the dual-color gradient */
  .brand-cursor-svg {
    display: block;
    animation: cursorSpin 6.5s linear infinite;
    transform-origin: center center;
    filter: drop-shadow(0 0 6px rgba(12, 72, 122, 0.25));
    transition: filter 0.3s ease;
  }

  .brand-cursor-circle {
    transition: stroke-width 0.3s ease;
  }

  @keyframes cursorSpin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* -------------------------------------------------- */
  /* Hover State (Over Interactive Elements)            */
  /* -------------------------------------------------- */
  .brand-cursor-ring.is-hovering {
    width: 50px;
    height: 50px;
    margin-top: -25px;
    margin-left: -25px;
    background: radial-gradient(circle, rgba(255, 49, 48, 0.08) 0%, rgba(12, 72, 122, 0.05) 55%, transparent 75%);
  }

  .brand-cursor-ring.is-hovering .brand-cursor-svg {
    filter: drop-shadow(0 0 10px rgba(255, 49, 48, 0.4)) drop-shadow(0 0 14px rgba(12, 72, 122, 0.25));
  }

  .brand-cursor-ring.is-hovering .brand-cursor-circle {
    stroke-width: 2.2;
  }

  .brand-cursor-dot.is-hovering {
    transform: scale(1.35);
    box-shadow: 0 0 12px rgba(255, 49, 48, 0.9), 0 0 4px rgba(12, 72, 122, 0.8);
  }

  /* -------------------------------------------------- */
  /* Click State (Tactile Compression Pulse)            */
  /* -------------------------------------------------- */
  .brand-cursor-ring.is-clicking {
    transform: scale(0.8) !important;
    transition: transform 0.12s ease-out;
  }

  .brand-cursor-dot.is-clicking {
    transform: scale(0.65) !important;
  }

  /* -------------------------------------------------- */
  /* Mobile, Touch Devices & Reduced Motion Overrides   */
  /* -------------------------------------------------- */
  @media (pointer: coarse), (hover: none) {
    .brand-cursor-container {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-cursor-container {
      display: none !important;
    }
    .brand-cursor-svg {
      animation: none !important;
    }
  }
</style>

<script>
  function initBrandCursor() {
    const wrap = document.getElementById('brand-cursor-wrap');
    const ring = document.getElementById('brand-cursor-ring');
    const dot = document.getElementById('brand-cursor-dot');

    if (!wrap || !ring || !dot) return;

    // Disable if touch screen or reduced motion
    const isTouch = window.matchMedia('(pointer: coarse)').matches;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (isTouch || prefersReducedMotion) return;

    let mouseX = -100;
    let mouseY = -100;
    let ringX = -100;
    let ringY = -100;
    let isVisible = false;
    let isHovering = false;
    let isClicking = false;
    let animId: number | null = null;
    let idleTimeout: ReturnType<typeof setTimeout> | null = null;

    // Fluid damping factor (0.16 produces butter-smooth, weightless follow)
    const LERP = 0.16;

    // 1. Mouse Movement Tracker
    function onMouseMove(e: MouseEvent) {
      mouseX = e.clientX;
      mouseY = e.clientY;

      if (!isVisible) {
        isVisible = true;
        ring.style.opacity = '1';
        dot.style.opacity = '1';
        ringX = mouseX;
        ringY = mouseY;
      }

      // Center dot follows 1:1 with 0ms lag
      dot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0)`;

      // Reset idle fade-out
      if (idleTimeout) clearTimeout(idleTimeout);
      idleTimeout = setTimeout(() => {
        if (!isHovering) {
          ring.style.opacity = '0.35';
        }
      }, 3500);
    }

    // 2. Continuous 60fps/120fps Ring Damping Loop
    function render() {
      if (isVisible) {
        ringX += (mouseX - ringX) * LERP;
        ringY += (mouseY - ringY) * LERP;

        const scale = isClicking ? ' scale(0.8)' : '';
        ring.style.transform = `translate3d(${ringX.toFixed(2)}px, ${ringY.toFixed(2)}px, 0)${scale}`;
      }

      animId = requestAnimationFrame(render);
    }

    // 3. Hover Detection over Interactive Elements (Event Delegation)
    function checkInteractive(target: HTMLElement | null): boolean {
      if (!target) return false;
      return Boolean(
        target.closest(
          'a, button, input, textarea, select, [role="button"], [role="tab"], .cursor-pointer, [data-interactive], summary, .square-slide-card, .shuttle-card, .why-card-spotlight'
        )
      );
    }

    function onMouseOver(e: MouseEvent) {
      const target = e.target as HTMLElement | null;
      if (checkInteractive(target)) {
        if (!isHovering) {
          isHovering = true;
          ring.classList.add('is-hovering');
          dot.classList.add('is-hovering');
          ring.style.opacity = '1';
        }
      } else {
        if (isHovering) {
          isHovering = false;
          ring.classList.remove('is-hovering');
          dot.classList.remove('is-hovering');
        }
      }
    }

    // 4. Click Micro-Interactions
    function onMouseDown() {
      isClicking = true;
      ring.classList.add('is-clicking');
      dot.classList.add('is-clicking');
    }

    function onMouseUp() {
      isClicking = false;
      ring.classList.remove('is-clicking');
      dot.classList.remove('is-clicking');
    }

    // 5. Window Enter / Leave
    function onMouseLeave() {
      isVisible = false;
      ring.style.opacity = '0';
      dot.style.opacity = '0';
    }

    function onMouseEnter() {
      isVisible = true;
      ring.style.opacity = '1';
      dot.style.opacity = '1';
    }

    // Attach listeners
    window.addEventListener('mousemove', onMouseMove, { passive: true });
    window.addEventListener('mouseover', onMouseOver, { passive: true });
    window.addEventListener('mousedown', onMouseDown, { passive: true });
    window.addEventListener('mouseup', onMouseUp, { passive: true });
    document.addEventListener('mouseleave', onMouseLeave);
    document.addEventListener('mouseenter', onMouseEnter);

    // Start render loop
    animId = requestAnimationFrame(render);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBrandCursor);
  } else {
    initBrandCursor();
  }
  document.addEventListener('astro:page-load', initBrandCursor);
</script>
