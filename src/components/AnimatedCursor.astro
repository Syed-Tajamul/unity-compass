---
/**
 * AnimatedCursor.astro - Two-Tone Minimal Dual-Dot Cursor Follower
 * 
 * Clean, modern two-dot trailing cursor:
 * - Lead Dot: Precision 6px vibrant red dot (#FF3130) positioned at exact mouse pointer with 0 latency.
 * - Follower Dot: Smooth 10px companion dot (#0C487A navy blue, semi-transparent 0.65 opacity)
 *   that fluidly glides and curves behind the lead dot using 60/120fps hardware-accelerated LERP physics.
 * - Interactive States:
 *   - Hovering over buttons/links/cards: Subtle gentle scale up and vibrant glow.
 *   - Clicking: Tactile micro-compression snap.
 *   - Idle: Softens opacity after inactivity.
 * - Fully non-intrusive: pointer-events: none on all elements.
 * - Touch & reduced-motion: Automatically disabled on mobile/touch screens and prefers-reduced-motion.
 */
---

<div id="brand-cursor-wrap" class="brand-cursor-container" aria-hidden="true">
  <!-- Follower Dot (Smoothly trails behind) -->
  <div id="brand-cursor-follower" class="brand-cursor-follower">
    <div class="brand-cursor-follower-dot"></div>
  </div>

  <!-- Lead Precision Dot (0ms lag, pins to mouse) -->
  <div id="brand-cursor-lead" class="brand-cursor-lead">
    <div class="brand-cursor-lead-dot"></div>
  </div>
</div>

<style>
  .brand-cursor-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none !important;
    z-index: 99999;
    overflow: hidden;
  }

  /* -------------------------------------------------- */
  /* Outer Translation Wrappers                         */
  /* -------------------------------------------------- */
  .brand-cursor-lead,
  .brand-cursor-follower {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none !important;
    opacity: 0;
    will-change: transform, opacity;
    transition: opacity 0.25s ease;
  }

  .brand-cursor-lead {
    z-index: 999999;
  }

  .brand-cursor-follower {
    z-index: 999998;
  }

  /* -------------------------------------------------- */
  /* Lead Dot: Precision 6px Vibrant Red Center Point   */
  /* -------------------------------------------------- */
  .brand-cursor-lead-dot {
    width: 6px;
    height: 6px;
    margin-top: -3px;
    margin-left: -3px;
    border-radius: 50%;
    background: #FF3130;
    box-shadow: 0 0 6px rgba(255, 49, 48, 0.75);
    pointer-events: none !important;
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.18s ease;
    will-change: transform;
  }

  /* -------------------------------------------------- */
  /* Follower Dot: 10px Navy Companion Trailing Behind  */
  /* -------------------------------------------------- */
  .brand-cursor-follower-dot {
    width: 10px;
    height: 10px;
    margin-top: -5px;
    margin-left: -5px;
    border-radius: 50%;
    background: #0C487A;
    opacity: 0.65;
    box-shadow: 0 0 8px rgba(12, 72, 122, 0.45);
    pointer-events: none !important;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                background-color 0.22s ease,
                opacity 0.22s ease,
                box-shadow 0.22s ease;
    will-change: transform;
  }

  /* -------------------------------------------------- */
  /* Hover State (Over Interactive Elements)            */
  /* -------------------------------------------------- */
  .brand-cursor-container.is-hovering .brand-cursor-lead-dot {
    transform: scale(1.3);
    box-shadow: 0 0 10px rgba(255, 49, 48, 0.95);
  }

  .brand-cursor-container.is-hovering .brand-cursor-follower-dot {
    transform: scale(1.4);
    background-color: #1E40AF;
    opacity: 0.8;
    box-shadow: 0 0 12px rgba(30, 64, 175, 0.6);
  }

  /* -------------------------------------------------- */
  /* Click State (Tactile Compression Snap)             */
  /* -------------------------------------------------- */
  .brand-cursor-container.is-clicking .brand-cursor-lead-dot {
    transform: scale(0.65);
  }

  .brand-cursor-container.is-clicking .brand-cursor-follower-dot {
    transform: scale(0.6);
  }

  /* -------------------------------------------------- */
  /* Mobile, Touch Devices & Reduced Motion Overrides   */
  /* -------------------------------------------------- */
  @media (pointer: coarse), (hover: none) {
    .brand-cursor-container {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-cursor-container {
      display: none !important;
    }
  }
</style>

<script>
  function initBrandCursor() {
    const wrap = document.getElementById('brand-cursor-wrap');
    const lead = document.getElementById('brand-cursor-lead');
    const follower = document.getElementById('brand-cursor-follower');

    if (!wrap || !lead || !follower) return;

    // Disable if touch screen or reduced motion
    const isTouch = window.matchMedia('(pointer: coarse)').matches;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (isTouch || prefersReducedMotion) return;

    let mouseX = -100;
    let mouseY = -100;
    let followerX = -100;
    let followerY = -100;
    let isVisible = false;
    let isHovering = false;
    let isClicking = false;
    let animId: number | null = null;
    let idleTimeout: ReturnType<typeof setTimeout> | null = null;

    // Smooth fluid damping factor for follower dot
    const LERP = 0.18;

    // 1. Mouse Movement Tracker
    function onMouseMove(e: MouseEvent) {
      mouseX = e.clientX;
      mouseY = e.clientY;

      if (!isVisible) {
        isVisible = true;
        lead.style.opacity = '1';
        follower.style.opacity = '1';
        followerX = mouseX;
        followerY = mouseY;
      }

      // Lead dot follows 1:1 with 0ms lag
      lead.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0)`;

      // Reset idle fade-out
      if (idleTimeout) clearTimeout(idleTimeout);
      lead.style.opacity = '1';
      follower.style.opacity = '1';
      idleTimeout = setTimeout(() => {
        if (!isHovering) {
          lead.style.opacity = '0.4';
          follower.style.opacity = '0.3';
        }
      }, 3500);
    }

    // 2. Continuous 60fps/120fps Follower Damping Loop
    function render() {
      if (isVisible) {
        followerX += (mouseX - followerX) * LERP;
        followerY += (mouseY - followerY) * LERP;

        follower.style.transform = `translate3d(${followerX.toFixed(2)}px, ${followerY.toFixed(2)}px, 0)`;
      }

      animId = requestAnimationFrame(render);
    }

    // 3. Hover Detection over Interactive Elements (Event Delegation)
    function checkInteractive(target: HTMLElement | null): boolean {
      if (!target) return false;
      return Boolean(
        target.closest(
          'a, button, input, textarea, select, [role="button"], [role="tab"], .cursor-pointer, [data-interactive], summary, .square-slide-card, .shuttle-card, .why-card-spotlight, .blog-post-card'
        )
      );
    }

    function onMouseOver(e: MouseEvent) {
      const target = e.target as HTMLElement | null;
      if (checkInteractive(target)) {
        if (!isHovering) {
          isHovering = true;
          wrap.classList.add('is-hovering');
        }
      } else {
        if (isHovering) {
          isHovering = false;
          wrap.classList.remove('is-hovering');
        }
      }
    }

    // 4. Click Micro-Interactions
    function onMouseDown() {
      isClicking = true;
      wrap.classList.add('is-clicking');
    }

    function onMouseUp() {
      isClicking = false;
      wrap.classList.remove('is-clicking');
    }

    // 5. Window Enter / Leave
    function onMouseLeave() {
      isVisible = false;
      lead.style.opacity = '0';
      follower.style.opacity = '0';
    }

    function onMouseEnter() {
      isVisible = true;
      lead.style.opacity = '1';
      follower.style.opacity = '1';
    }

    // Attach listeners
    window.addEventListener('mousemove', onMouseMove, { passive: true });
    window.addEventListener('mouseover', onMouseOver, { passive: true });
    window.addEventListener('mousedown', onMouseDown, { passive: true });
    window.addEventListener('mouseup', onMouseUp, { passive: true });
    document.addEventListener('mouseleave', onMouseLeave);
    document.addEventListener('mouseenter', onMouseEnter);

    // Start render loop
    animId = requestAnimationFrame(render);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBrandCursor);
  } else {
    initBrandCursor();
  }
  document.addEventListener('astro:page-load', initBrandCursor);
</script>
