---
/**
 * HiringProcess.astro - Section 04: Our Hiring Process
 * 
 * Strict Specification:
 * - Heading: "A Clear Path to Your Next Opportunity"
 * - 4-step clean process:
 *   1. Submit Your Application – Apply for a position and share your resume and relevant experience.
 *   2. Initial Review – Our recruitment team reviews your qualifications against the role requirements.
 *   3. Interview & Evaluation – Discuss your experience, technical capabilities, and suitability for the opportunity.
 *   4. Selection & Next Steps – Successful candidates proceed through the relevant selection and onboarding process.
 * - Harmonized with Unity Compass: Navy #0B2553, brand red #FF3130, connected timeline, subtle hover states.
 */

interface HiringStep {
  number: string;
  title: string;
  description: string;
  phaseBadge: string;
}

const steps: HiringStep[] = [
  {
    number: '01',
    title: 'Submit Your Application',
    description: 'Apply for an open position and share your resume and relevant professional experience through our secure portal.',
    phaseBadge: 'Step 1',
  },
  {
    number: '02',
    title: 'Initial Review',
    description: 'Our recruitment team reviews your qualifications, clearance level, and domain expertise against the specific role requirements.',
    phaseBadge: 'Step 2',
  },
  {
    number: '03',
    title: 'Interview & Evaluation',
    description: 'Discuss your experience, technical capabilities, and cultural suitability for the opportunity with our practice leadership.',
    phaseBadge: 'Step 3',
  },
  {
    number: '04',
    title: 'Selection & Next Steps',
    description: 'Successful candidates proceed through the relevant clearance verification, selection, and structured program onboarding process.',
    phaseBadge: 'Step 4',
  },
];
---

<section class="relative bg-gradient-to-b from-white via-[#F8FAFC] to-[#F1F5F9] py-20 sm:py-28 overflow-hidden border-t border-slate-200/80" aria-labelledby="hiring-process-heading">
  <!-- Technical Blueprint Check Pattern Overlay -->
  <div
    class="absolute inset-0 opacity-[0.16] mix-blend-multiply pointer-events-none"
    style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.08) 1px, transparent 1px);"
    aria-hidden="true"
  ></div>

  <!-- Soft Ambient Radial Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] h-[350px] bg-[radial-gradient(ellipse,rgba(12,72,122,0.06)_0%,transparent_70%)] pointer-events-none blur-3xl -z-10" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-[#FF3130]/10 text-[#FF3130] border border-[#FF3130]/20 mb-3.5">
        Candidate Journey
      </span>
      <h2
        id="hiring-process-heading"
        class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0B2553] tracking-tight leading-[1.18]"
      >
        A Clear Path to Your <span class="text-[#FF3130]">Next Opportunity</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[#243A5E] leading-relaxed font-normal max-w-2xl mx-auto">
        We prioritize transparency and candidate communication at every milestone of our recruitment and placement workflow.
      </p>
    </div>

    <!-- Connected 4-Step Process Timeline Container -->
    <div class="relative">
      
      <!-- Desktop Connecting Gradient Line -->
      <div
        class="hidden lg:block absolute top-12 left-16 right-16 h-0.5 bg-gradient-to-r from-[#FF3130] via-[#0B2553] to-emerald-500 z-0 opacity-25"
        aria-hidden="true"
      ></div>

      <!-- 4 Steps Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 relative z-10">
        {steps.map((step, idx) => {
          const isFirst = idx === 0;
          const isLast = idx === steps.length - 1;
          
          return (
            <div class="group relative rounded-3xl bg-white border border-slate-200/90 p-7 sm:p-8 shadow-[0_8px_24px_-6px_rgba(12,72,122,0.06)] hover:shadow-[0_16px_36px_-8px_rgba(12,72,122,0.14)] hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between overflow-hidden">
              
              <!-- Top Accent Stripe -->
              <div class={`absolute top-0 inset-x-0 h-1.5 ${
                isFirst ? 'bg-[#FF3130]' : isLast ? 'bg-emerald-500' : 'bg-[#0B2553]'
              }`}></div>

              <div>
                <!-- Step Number Bubble & Phase Badge -->
                <div class="flex items-center justify-between mb-5">
                  <div class={`w-12 h-12 rounded-2xl flex items-center justify-center font-black text-sm transition-transform duration-300 group-hover:scale-105 shadow-sm ${
                    isFirst
                      ? 'bg-red-50 text-[#FF3130] border border-red-200/70'
                      : isLast
                      ? 'bg-emerald-50 text-emerald-700 border border-emerald-200/70'
                      : 'bg-slate-100 text-[#0B2553] border border-slate-200'
                  }`}>
                    {step.number}
                  </div>

                  <span class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-slate-50 text-slate-500 border border-slate-100">
                    {step.phaseBadge}
                  </span>
                </div>

                <!-- Step Title -->
                <h3 class="text-lg font-bold text-[#0B2553] tracking-tight leading-snug group-hover:text-[#0C487A] transition-colors">
                  {step.title}
                </h3>

                <!-- Step Description -->
                <p class="text-xs sm:text-sm text-[#243A5E] mt-3 leading-relaxed font-normal">
                  {step.description}
                </p>
              </div>

              <!-- Bottom Indicator -->
              <div class="mt-6 pt-4 border-t border-slate-100 flex items-center gap-2 text-xs font-semibold text-slate-400">
                <span class={`w-2 h-2 rounded-full ${isFirst ? 'bg-[#FF3130]' : isLast ? 'bg-emerald-500' : 'bg-[#0B2553]'}`}></span>
                <span>Stage {idx + 1} of 4</span>
              </div>

            </div>
          );
        })}
      </div>

    </div>

  </div>
</section>
