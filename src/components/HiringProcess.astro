---
/**
 * HiringProcess.astro - Executive GovCon Candidate Hiring Workflow
 * 
 * Harmonized with Unity Compass Design System:
 * - Direct copy from client specification:
 *   Title: "Hiring Process"
 *   Subtitle: "Putting people first begins the moment we meet. Tell us about your skills and aspirations. Explore job opportunities that speak to your journey."
 * - 5 Structured Milestones:
 *   1. Job Opportunities and Application Submission
 *   2. Shortlisting
 *   3. Business/Technical Interview
 *   4. HR Interview
 *   5. Decision and Offer
 * - Executive visual progression with connected numbered milestones, subtle hover elevation, and brand accents (#0B2553, #FF3130, #EE8522)
 */

interface HiringStep {
  number: string;
  title: string;
  description: string;
  badge: string;
}

const steps: HiringStep[] = [
  {
    number: '01',
    title: 'Job Opportunities and Application Submission',
    description: 'Explore our open requisitions and submit your cleared resume directly through our confidential candidate portal.',
    badge: 'Initial Step',
  },
  {
    number: '02',
    title: 'Shortlisting',
    description: 'Our specialized GovCon talent directors conduct a rigorous, confidential review of your clearance level and domain credentials.',
    badge: 'Review Phase',
  },
  {
    number: '03',
    title: 'Business/Technical Interview',
    description: 'An in-depth scoping conversation with senior technical leads to evaluate mission alignment, technical depth, and past performance.',
    badge: 'Technical Scoping',
  },
  {
    number: '04',
    title: 'HR Interview',
    description: 'A transparent discussion covering total compensation, security clearance verification, premier benefits, and start dates.',
    badge: 'Benefits & Culture',
  },
  {
    number: '05',
    title: 'Decision and Offer',
    description: 'Fast-track decision and formal offer package, followed by structured, seamless program onboarding onto defense or civilian contracts.',
    badge: 'Welcome to Team',
  },
];
---

<section class="relative bg-gradient-to-b from-white via-[#F8FAFC] to-[#F1F5F9] py-20 sm:py-28 overflow-hidden border-t border-slate-200/80" aria-labelledby="hiring-process-heading">
  
  <!-- Technical Blueprint Check Pattern (Subtle) -->
  <div
    class="absolute inset-0 opacity-[0.16] mix-blend-multiply pointer-events-none"
    style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.08) 1px, transparent 1px);"
    aria-hidden="true"
  ></div>

  <!-- Ambient Radial Glows -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[650px] h-[350px] bg-[radial-gradient(ellipse,rgba(12,72,122,0.06)_0%,transparent_70%)] pointer-events-none blur-3xl -z-10" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <h2
        id="hiring-process-heading"
        class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0B2553] tracking-tight leading-[1.18]"
      >
        Hiring <span class="text-[#FF3130]">Process</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-[#243A5E] leading-relaxed font-normal max-w-2xl mx-auto">
        Putting people first begins the moment we meet. Tell us about your skills and aspirations. Explore job opportunities that speak to your journey.
      </p>
    </div>

    <!-- Connected 5-Step Process Timeline Container -->
    <div class="relative">
      
      <!-- Desktop Connecting Gradient Line -->
      <div
        class="hidden lg:block absolute top-10 left-12 right-12 h-0.5 bg-gradient-to-r from-[#FF3130] via-[#0B2553] to-emerald-500 z-0 opacity-25"
        aria-hidden="true"
      ></div>

      <!-- Steps Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 sm:gap-6 relative z-10">
        {steps.map((step, idx) => {
          const isFirst = idx === 0;
          const isLast = idx === steps.length - 1;
          
          return (
            <div class="group relative rounded-3xl bg-white border border-slate-200/90 p-6 sm:p-7 shadow-[0_8px_24px_-6px_rgba(12,72,122,0.06)] hover:shadow-[0_16px_36px_-8px_rgba(12,72,122,0.14)] hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between overflow-hidden">
              
              <!-- Top Accent Stripe -->
              <div class={`absolute top-0 inset-x-0 h-1.5 ${
                isFirst ? 'bg-[#FF3130]' : isLast ? 'bg-emerald-500' : 'bg-[#0B2553]'
              }`}></div>

              <div>
                <!-- Step Number Bubble -->
                <div class="flex items-center justify-between mb-5">
                  <div class={`w-12 h-12 rounded-2xl flex items-center justify-center font-black text-sm transition-transform duration-300 group-hover:scale-105 shadow-sm ${
                    isFirst
                      ? 'bg-red-50 text-[#FF3130] border border-red-200/70'
                      : isLast
                      ? 'bg-emerald-50 text-emerald-700 border border-emerald-200/70'
                      : 'bg-slate-100 text-[#0B2553] border border-slate-200'
                  }`}>
                    {step.number}
                  </div>

                  <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-slate-50 text-slate-500 border border-slate-100">
                    {step.badge}
                  </span>
                </div>

                <!-- Step Title -->
                <h3 class="text-base font-bold text-[#0B2553] tracking-tight leading-snug group-hover:text-[#0C487A] transition-colors">
                  {step.title}
                </h3>

                <!-- Step Description -->
                <p class="text-xs sm:text-sm text-[#243A5E] mt-3 leading-relaxed font-normal">
                  {step.description}
                </p>
              </div>

              <!-- Bottom Indicator -->
              <div class="mt-6 pt-4 border-t border-slate-100 flex items-center gap-1.5 text-[11px] font-semibold text-slate-400">
                <span class={`w-1.5 h-1.5 rounded-full ${isFirst ? 'bg-[#FF3130]' : isLast ? 'bg-emerald-500' : 'bg-[#0B2553]'}`}></span>
                <span>Stage {idx + 1} of 5</span>
              </div>

            </div>
          );
        })}
      </div>

    </div>

  </div>
</section>

