---
/**
 * JobBoard.astro - Executive GovCon Career & Job Board Component
 * 
 * Harmonized with Unity Compass Design System:
 * - Signature card elevations with top accent stripe (#FF3130 or #0B2553)
 * - GovCon clearance color coding (TS/SCI Poly, Top Secret, Secret, Public Trust)
 * - Quick filter tags & real-time search with smooth transitions
 * - Executive Application Modal with Drag & Drop resume upload to Supabase Storage
 */
import { jobPositions as fallbackPositions, type JobPosition } from '../data/jobs';
import { supabase, isSupabaseConfigured } from '../lib/supabase';

let jobPositions: JobPosition[] = fallbackPositions;

if (isSupabaseConfigured && supabase) {
  try {
    const { data, error } = await supabase
      .from('jobs')
      .select('*')
      .eq('is_active', true)
      .order('created_at', { ascending: false });

    if (!error && data && data.length > 0) {
      jobPositions = data.map((d: any) => ({
        id: d.id,
        title: d.title,
        department: d.department,
        location: d.location,
        workplaceType: d.workplace_type || 'Hybrid',
        employmentType: d.employment_type || 'Full-Time',
        clearanceLevel: d.clearance_level || 'None',
        description: d.description,
        requirements: Array.isArray(d.requirements) ? d.requirements : JSON.parse(d.requirements || '[]'),
        responsibilities: Array.isArray(d.responsibilities) ? d.responsibilities : JSON.parse(d.responsibilities || '[]'),
        postedDate: d.posted_date || 'Active',
      }));
    }
  } catch (err) {
    console.error('Failed to load jobs from Supabase, using local fallback:', err);
  }
}
---

<div class="space-y-8" id="career-job-board">
  
  <!-- ========================================================================= -->
  <!-- CONTROLS: SEARCH & MULTI-FILTER BAR                                      -->
  <!-- ========================================================================= -->
  <div class="bg-white rounded-3xl border border-slate-200/90 p-5 sm:p-7 shadow-[0_10px_30px_-6px_rgba(12,72,122,0.06)] relative overflow-hidden">
    <!-- Subtle Top Red Line -->
    <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-[#0B2553] via-[#FF3130] to-[#0B2553]"></div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-center">
      
      <!-- Search Input -->
      <div class="relative">
        <svg class="w-4 h-4 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          type="text"
          id="job-search-input"
          placeholder="Search roles or clearance..."
          class="w-full pl-11 pr-4 py-2.5 text-sm rounded-xl border border-slate-200 bg-slate-50/50 text-[#0B2553] focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white transition-all placeholder:text-slate-400"
        />
      </div>

      <!-- Department Filter -->
      <div>
        <select
          id="job-dept-filter"
          class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-200 bg-slate-50/50 text-[#0B2553] focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white transition-all cursor-pointer"
        >
          <option value="">All Departments</option>
          <option value="Proposal & Capture">Proposal & Capture</option>
          <option value="Recruitment & Talent">Recruitment & Talent</option>
          <option value="IT & Consulting">IT & Consulting</option>
          <option value="Engineering & Defense">Engineering & Defense</option>
          <option value="Operations">Operations</option>
        </select>
      </div>

      <!-- Clearance Filter -->
      <div>
        <select
          id="job-clearance-filter"
          class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-200 bg-slate-50/50 text-[#0B2553] focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white transition-all cursor-pointer"
        >
          <option value="">All Clearance Levels</option>
          <option value="TS/SCI with Polygraph">TS/SCI with Polygraph</option>
          <option value="Top Secret / SCI">Top Secret / SCI</option>
          <option value="Secret">Secret</option>
          <option value="Public Trust">Public Trust</option>
          <option value="None">Non-Cleared</option>
        </select>
      </div>

      <!-- View Switcher & Counter -->
      <div class="flex items-center justify-between sm:justify-end gap-3">
        <span class="text-xs font-semibold text-slate-500">
          <span id="job-results-count" class="font-extrabold text-[#0B2553]">{jobPositions.length}</span> Roles
        </span>
        <div class="inline-flex rounded-xl border border-slate-200 p-1 bg-slate-100/70">
          <button
            type="button"
            id="view-grid-btn"
            class="px-3 py-1.5 rounded-lg text-xs font-bold bg-white text-[#0B2553] shadow-xs flex items-center gap-1.5 transition-all cursor-pointer"
            aria-label="Grid View"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
            </svg>
            <span>Grid</span>
          </button>
          <button
            type="button"
            id="view-list-btn"
            class="px-3 py-1.5 rounded-lg text-xs font-bold text-slate-500 hover:text-[#0B2553] flex items-center gap-1.5 transition-all cursor-pointer"
            aria-label="List View"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <span>List</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- JOBS CONTAINER (Grid mode by default)                                     -->
  <!-- ========================================================================= -->
  <div id="jobs-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 transition-all duration-300">
    {jobPositions.map((job, idx) => {
      const isRedAccent = idx % 2 === 0;
      return (
        <div
          class="job-card group relative rounded-3xl bg-white border border-slate-200/90 p-7 sm:p-8 shadow-[0_10px_30px_-6px_rgba(12,72,122,0.06)] hover:shadow-[0_20px_45px_-8px_rgba(12,72,122,0.14)] hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between overflow-hidden"
          data-title={job.title.toLowerCase()}
          data-department={job.department.toLowerCase()}
          data-type={job.employmentType}
          data-clearance={job.clearanceLevel}
          data-workplace={job.workplaceType}
        >
          <!-- Top Brand Accent Stripe -->
          <div class={`absolute top-0 inset-x-0 h-1.5 ${isRedAccent ? 'bg-[#FF3130]' : 'bg-[#0B2553]'}`}></div>

          <div>
            <!-- Clearance & Workplace Badges -->
            <div class="flex flex-wrap items-center gap-2 mb-4">
              <span class={`text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full border ${
                job.clearanceLevel.includes('Poly')
                  ? 'bg-red-50 text-[#FF3130] border-red-200/80'
                  : job.clearanceLevel.includes('Top Secret')
                  ? 'bg-blue-50 text-[#0B2553] border-blue-200/80'
                  : job.clearanceLevel.includes('Secret')
                  ? 'bg-amber-50 text-amber-900 border-amber-200/80'
                  : job.clearanceLevel.includes('Trust')
                  ? 'bg-emerald-50 text-emerald-900 border-emerald-200/80'
                  : 'bg-slate-100 text-slate-700 border-slate-200'
              }`}>
                {job.clearanceLevel}
              </span>
              <span class="text-[11px] font-medium px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
                {job.employmentType}
              </span>
              <span class="text-[11px] font-medium px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
                {job.workplaceType}
              </span>
            </div>

            <!-- Title -->
            <h3 class="text-xl font-bold text-[#0B2553] tracking-tight leading-snug group-hover:text-[#0C487A] transition-colors">
              {job.title}
            </h3>

            <!-- Department & Location with Micro-Icons -->
            <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 mt-2">
              <span class="flex items-center gap-1 text-[#0C487A]">
                <svg class="w-3.5 h-3.5 text-[#EE8522]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
                {job.department}
              </span>
              <span>•</span>
              <span class="flex items-center gap-1 text-slate-600">
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                {job.location}
              </span>
            </div>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-[#243A5E] mt-3.5 leading-relaxed line-clamp-3 font-normal">
              {job.description}
            </p>

            <!-- Requirements Snippet with Checkmarks -->
            <ul class="mt-4 pt-4 border-t border-slate-100 space-y-2 text-xs text-slate-600">
              {job.requirements.slice(0, 2).map((req) => (
                <li class="flex items-start gap-2">
                  <span class="w-4 h-4 rounded-full bg-red-50 text-[#FF3130] flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                    </svg>
                  </span>
                  <span class="line-clamp-1">{req}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Card Action Footer -->
          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
            <span class="text-xs font-medium text-slate-400">
              Active requisition
            </span>
            <button
              type="button"
              class="apply-trigger-btn inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-[#FF3130] hover:bg-[#E02625] shadow-sm hover:shadow active:scale-[0.98] transition-all cursor-pointer"
              data-job-id={job.id}
              data-job-title={job.title}
            >
              <span>Apply Now</span>
              <span aria-hidden="true">&rarr;</span>
            </button>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Empty State (Hidden initially) -->
  <div id="no-jobs-found" class="hidden text-center py-16 px-6 rounded-3xl border border-dashed border-slate-300 bg-slate-50/70">
    <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-red-50 text-[#FF3130] flex items-center justify-center">
      <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <h4 class="text-lg font-bold text-[#0B2553]">No matching opportunities found</h4>
    <p class="text-xs sm:text-sm text-[#243A5E] mt-1.5 max-w-md mx-auto">
      Try loosening your search terms or filters. Alternatively, submit your general resume below to join our confidential cleared talent network.
    </p>
  </div>

  <!-- ========================================================================= -->
  <!-- GENERAL TALENT NETWORK CTA BANNER                                         -->
  <!-- ========================================================================= -->
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#0B2553] via-[#0C3860] to-[#081832] p-8 sm:p-12 text-white shadow-xl border border-blue-900/40">
    <!-- Minute Checks Pattern Overlay -->
    <div
      class="absolute inset-0 pointer-events-none opacity-20"
      style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(255, 255, 255, 0.1) 1px, transparent 1px), linear-gradient(to bottom, rgba(255, 255, 255, 0.1) 1px, transparent 1px);"
      aria-hidden="true"
    ></div>

    <!-- Ambient Red Glow -->
    <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-[radial-gradient(circle,rgba(255,49,48,0.2)_0%,transparent_70%)] pointer-events-none blur-2xl"></div>

    <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div class="max-w-2xl">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-[#FF3130]/20 text-red-300 border border-[#FF3130]/30 mb-3">
          Confidential Talent Network
        </span>
        <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white leading-tight">
          Don’t see your exact role listed?
        </h3>
        <p class="mt-2 text-sm text-slate-300 leading-relaxed font-normal">
          Unity Compass places cleared professionals across DoD, DHS, IC, and civilian agencies continuously. Submit your resume to be matched with upcoming contract awards.
        </p>
      </div>

      <button
        type="button"
        id="general-apply-btn"
        class="shrink-0 inline-flex items-center gap-2 px-6 py-3.5 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-[#FF3130] hover:bg-[#E02625] shadow-lg shadow-[#FF3130]/30 active:scale-[0.98] transition-all cursor-pointer"
      >
        <span>Submit General Resume</span>
        <span aria-hidden="true">&rarr;</span>
      </button>
    </div>
  </div>
</div>

<!-- ========================================================================= -->
<!-- APPLICATION MODAL (Drag & Drop Resume Upload to Supabase Storage)          -->
<!-- ========================================================================= -->
<div
  id="apply-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-md hidden transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <div class="bg-white rounded-3xl max-w-xl w-full p-6 sm:p-9 shadow-2xl border border-slate-200 relative max-h-[92vh] overflow-y-auto transform transition-transform duration-300">
    <!-- Top Accent Stripe -->
    <div class="absolute top-0 inset-x-0 h-1.5 bg-[#FF3130]"></div>

    <!-- Close Button -->
    <button
      type="button"
      id="close-modal-btn"
      class="absolute top-5 right-5 p-2 text-slate-400 hover:text-slate-700 rounded-full hover:bg-slate-100 transition-colors cursor-pointer"
      aria-label="Close modal"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="mb-6">
      <span class="inline-flex items-center gap-1 text-[11px] font-bold text-[#FF3130] uppercase tracking-wider bg-red-50 px-2.5 py-0.5 rounded-full border border-red-200/60">
        Candidate Application
      </span>
      <h3 id="modal-title" class="text-2xl font-extrabold text-[#0B2553] tracking-tight mt-2">
        Apply for Position
      </h3>
      <p id="modal-subtitle" class="text-xs sm:text-sm text-slate-500 mt-1">
        Target Role: <span id="modal-target-job" class="font-bold text-[#0B2553]">Senior Cleared Cloud Architect</span>
      </p>
    </div>

    <!-- Application Form -->
    <form id="job-apply-form" class="space-y-4" novalidate>
      <div id="modal-feedback" class="hidden p-3.5 rounded-xl text-xs font-semibold"></div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-1.5">
            Full Name *
          </label>
          <input
            type="text"
            id="app-name"
            required
            placeholder="John Doe"
            class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm bg-slate-50/50 text-[#0B2553] focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white transition-all"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-1.5">
            Phone Number *
          </label>
          <input
            type="tel"
            id="app-phone"
            required
            placeholder="+1 (555) 000-0000"
            class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm bg-slate-50/50 text-[#0B2553] focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white transition-all"
          />
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-1.5">
          Email Address *
        </label>
        <input
          type="email"
          id="app-email"
          required
          placeholder="john.doe@example.com"
          class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm bg-slate-50/50 text-[#0B2553] focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white transition-all"
        />
      </div>

      <!-- Resume File Upload Zone -->
      <div>
        <label class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-1.5">
          Attach Resume (PDF, DOCX up to 5MB) *
        </label>
        <div
          id="resume-dropzone"
          class="border-2 border-dashed border-slate-300 hover:border-[#FF3130] rounded-2xl p-6 text-center bg-slate-50/60 hover:bg-red-50/20 transition-all cursor-pointer relative"
        >
          <input
            type="file"
            id="app-resume"
            name="resume"
            required
            accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
          />
          <div id="dropzone-content" class="space-y-1">
            <svg class="w-8 h-8 text-[#FF3130] mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
            </svg>
            <p class="text-xs font-bold text-[#0B2553]">
              Click to upload or drag &amp; drop
            </p>
            <p class="text-[11px] text-slate-500">
              PDF or Word document (Max 5MB)
            </p>
          </div>
          <div id="file-selected-name" class="hidden text-xs font-bold text-emerald-700 bg-emerald-50 py-1 px-3 rounded-lg border border-emerald-200 inline-block mt-2"></div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="pt-4 flex items-center justify-end gap-3 border-t border-slate-100">
        <button
          type="button"
          id="cancel-modal-btn"
          class="px-4 py-2.5 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 transition-colors cursor-pointer"
        >
          Cancel
        </button>
        <button
          type="submit"
          id="submit-app-btn"
          class="px-6 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-[#FF3130] hover:bg-[#E02625] shadow-sm hover:shadow active:scale-[0.98] transition-all cursor-pointer"
        >
          Submit Application
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Client-side Interactive Filter & Upload Script -->
<script>
  const searchInput = document.getElementById('job-search-input') as HTMLInputElement;
  const deptFilter = document.getElementById('job-dept-filter') as HTMLSelectElement;
  const clearanceFilter = document.getElementById('job-clearance-filter') as HTMLSelectElement;
  const jobsContainer = document.getElementById('jobs-container');
  const resultsCount = document.getElementById('job-results-count');
  const noJobsFound = document.getElementById('no-jobs-found');
  const jobCards = document.querySelectorAll<HTMLElement>('.job-card');

  // Filter Logic
  function applyFilters() {
    const query = searchInput?.value.toLowerCase().trim() || '';
    const selectedDept = deptFilter?.value.toLowerCase() || '';
    const selectedClearance = clearanceFilter?.value || '';

    let visibleCount = 0;

    jobCards.forEach((card) => {
      const title = card.getAttribute('data-title') || '';
      const department = card.getAttribute('data-department') || '';
      const clearance = card.getAttribute('data-clearance') || '';

      const matchesSearch = !query || title.includes(query) || department.includes(query) || clearance.toLowerCase().includes(query);
      const matchesDept = !selectedDept || department.includes(selectedDept);
      const matchesClearance = !selectedClearance || clearance === selectedClearance;

      if (matchesSearch && matchesDept && matchesClearance) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (resultsCount) resultsCount.textContent = String(visibleCount);
    if (noJobsFound) {
      if (visibleCount === 0) {
        noJobsFound.classList.remove('hidden');
      } else {
        noJobsFound.classList.add('hidden');
      }
    }
  }

  searchInput?.addEventListener('input', applyFilters);
  deptFilter?.addEventListener('change', applyFilters);
  clearanceFilter?.addEventListener('change', applyFilters);

  // View switchers
  const gridBtn = document.getElementById('view-grid-btn');
  const listBtn = document.getElementById('view-list-btn');

  gridBtn?.addEventListener('click', () => {
    jobsContainer?.classList.remove('grid-cols-1');
    jobsContainer?.classList.add('md:grid-cols-2', 'lg:grid-cols-3');
    gridBtn.classList.add('bg-white', 'text-[#0B2553]', 'shadow-xs');
    gridBtn.classList.remove('text-slate-500');
    listBtn?.classList.remove('bg-white', 'text-[#0B2553]', 'shadow-xs');
    listBtn?.classList.add('text-slate-500');
  });

  listBtn?.addEventListener('click', () => {
    jobsContainer?.classList.remove('md:grid-cols-2', 'lg:grid-cols-3');
    jobsContainer?.classList.add('grid-cols-1');
    listBtn.classList.add('bg-white', 'text-[#0B2553]', 'shadow-xs');
    listBtn.classList.remove('text-slate-500');
    gridBtn?.classList.remove('bg-white', 'text-[#0B2553]', 'shadow-xs');
    gridBtn?.classList.add('text-slate-500');
  });

  // Modal Handling
  const modal = document.getElementById('apply-modal');
  const modalTargetJob = document.getElementById('modal-target-job');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const cancelModalBtn = document.getElementById('cancel-modal-btn');
  const applyForm = document.getElementById('job-apply-form') as HTMLFormElement;
  const feedbackEl = document.getElementById('modal-feedback');
  const resumeInput = document.getElementById('app-resume') as HTMLInputElement;
  const fileSelectedName = document.getElementById('file-selected-name');
  const submitAppBtn = document.getElementById('submit-app-btn') as HTMLButtonElement;

  let currentJobTitle = 'General Application';
  let currentJobId: string | null = null;

  function openModal(title: string, id: string | null) {
    currentJobTitle = title;
    currentJobId = id;
    if (modalTargetJob) modalTargetJob.textContent = title;
    if (feedbackEl) feedbackEl.classList.add('hidden');
    if (fileSelectedName) fileSelectedName.classList.add('hidden');
    applyForm?.reset();
    modal?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  // Resume File Selection Display
  resumeInput?.addEventListener('change', () => {
    if (resumeInput.files && resumeInput.files[0]) {
      const file = resumeInput.files[0];
      if (fileSelectedName) {
        fileSelectedName.textContent = `✓ Selected: ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)`;
        fileSelectedName.classList.remove('hidden');
      }
    }
  });

  document.querySelectorAll('.apply-trigger-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const title = target.getAttribute('data-job-title') || 'Target Position';
      const id = target.getAttribute('data-job-id') || null;
      openModal(title, id);
    });
  });

  document.getElementById('general-apply-btn')?.addEventListener('click', () => {
    openModal('General Talent Network (All Specializations)', null);
  });

  closeModalBtn?.addEventListener('click', closeModal);
  cancelModalBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // Form Submission & Resume Upload to Backend
  applyForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!feedbackEl || !submitAppBtn) return;

    feedbackEl.classList.add('hidden');
    feedbackEl.className = 'p-3.5 rounded-xl text-xs font-semibold mb-3';

    const name = (document.getElementById('app-name') as HTMLInputElement)?.value.trim();
    const email = (document.getElementById('app-email') as HTMLInputElement)?.value.trim();
    const phone = (document.getElementById('app-phone') as HTMLInputElement)?.value.trim();
    const file = resumeInput?.files?.[0];

    if (!name || !email || !phone) {
      feedbackEl.textContent = 'Please fill out all required candidate fields.';
      feedbackEl.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
      feedbackEl.classList.remove('hidden');
      return;
    }

    if (!file) {
      feedbackEl.textContent = 'Please select a resume file to upload.';
      feedbackEl.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
      feedbackEl.classList.remove('hidden');
      return;
    }

    // 5MB limit check
    const maxBytes = 5 * 1024 * 1024;
    if (file.size > maxBytes) {
      feedbackEl.textContent = `Resume file size exceeds the 5MB limit (${(file.size / (1024 * 1024)).toFixed(2)}MB). Please upload a smaller document.`;
      feedbackEl.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
      feedbackEl.classList.remove('hidden');
      return;
    }

    submitAppBtn.disabled = true;
    submitAppBtn.textContent = 'Uploading Resume & Submitting...';

    const formData = new FormData();
    formData.append('name', name);
    formData.append('email', email);
    formData.append('phone', phone);
    formData.append('jobTitle', currentJobTitle);
    if (currentJobId) formData.append('jobId', currentJobId);
    formData.append('resume', file);

    try {
      const res = await fetch('/api/careers/apply', {
        method: 'POST',
        body: formData,
      });

      const result = await res.json().catch(() => ({}));

      if (res.ok && result.success) {
        feedbackEl.textContent = result.message || 'Application successfully submitted! Our talent acquisition team will review your qualifications.';
        feedbackEl.classList.add('bg-emerald-50', 'text-emerald-800', 'border', 'border-emerald-200');
        feedbackEl.classList.remove('hidden');
        applyForm.reset();
        if (fileSelectedName) fileSelectedName.classList.add('hidden');

        setTimeout(() => {
          closeModal();
        }, 2200);
      } else {
        feedbackEl.textContent = result.error || 'Failed to submit application. Please try again.';
        feedbackEl.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
        feedbackEl.classList.remove('hidden');
      }
    } catch (err) {
      feedbackEl.textContent = 'Network error while submitting application. Please try again or email us directly.';
      feedbackEl.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
      feedbackEl.classList.remove('hidden');
    } finally {
      submitAppBtn.disabled = false;
      submitAppBtn.textContent = 'Submit Application';
    }
  });
</script>
