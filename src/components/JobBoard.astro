---
import { jobPositions } from '../data/jobs';
---

<div class="space-y-8" id="career-job-board">
  
  <!-- Search & Filter Controls Bar -->
  <div class="bg-white rounded-xl border border-slate-200 p-4 sm:p-5 shadow-subtle">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 items-center">
      
      <!-- Search Input -->
      <div class="relative">
        <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          type="text"
          id="job-search-input"
          placeholder="Search roles or clearance..."
          class="w-full pl-10 pr-3 py-2 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-navy focus:border-brand-navy"
        />
      </div>

      <!-- Type Filter -->
      <div>
        <select
          id="job-type-filter"
          class="w-full px-3 py-2 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-navy focus:border-brand-navy bg-white"
        >
          <option value="">All Employment Types</option>
          <option value="Full-Time">Full-Time</option>
          <option value="Contract">Contract</option>
          <option value="Temp-to-Hire">Temp-to-Hire</option>
          <option value="Part-Time">Part-Time</option>
        </select>
      </div>

      <!-- Clearance Filter -->
      <div>
        <select
          id="job-clearance-filter"
          class="w-full px-3 py-2 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-navy focus:border-brand-navy bg-white"
        >
          <option value="">All Clearance Levels</option>
          <option value="TS/SCI with Polygraph">TS/SCI with Polygraph</option>
          <option value="Top Secret / SCI">Top Secret / SCI</option>
          <option value="Secret">Secret</option>
          <option value="Public Trust">Public Trust</option>
          <option value="None">Non-Cleared</option>
        </select>
      </div>

      <!-- View Switcher -->
      <div class="flex items-center justify-end gap-2">
        <span class="text-xs text-slate-400 hidden lg:inline">View:</span>
        <div class="inline-flex rounded-lg border border-slate-200 p-0.5 bg-slate-50">
          <button
            type="button"
            id="view-grid-btn"
            class="px-3 py-1.5 rounded-md text-xs font-semibold bg-white text-slate-900 shadow-xs flex items-center gap-1.5 transition-all"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
            </svg>
            <span>Grid</span>
          </button>
          <button
            type="button"
            id="view-list-btn"
            class="px-3 py-1.5 rounded-md text-xs font-semibold text-slate-500 hover:text-slate-900 flex items-center gap-1.5 transition-all"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <span>List</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Job Count Status -->
  <div class="flex items-center justify-between text-xs text-slate-500 px-1">
    <p><span id="job-results-count" class="font-bold text-slate-900">{jobPositions.length}</span> positions available</p>
    <p>Direct placement with federal primes & defense agencies</p>
  </div>

  <!-- Jobs Container (Grid mode by default) -->
  <div id="jobs-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 transition-all duration-200">
    {jobPositions.map((job) => (
      <div
        class="job-card gov-card flex flex-col justify-between hover:border-brand-navy/30"
        data-title={job.title.toLowerCase()}
        data-department={job.department.toLowerCase()}
        data-type={job.employmentType}
        data-clearance={job.clearanceLevel}
        data-workplace={job.workplaceType}
      >
        <div>
          <!-- Clearance & Type Badges -->
          <div class="flex flex-wrap items-center gap-1.5 mb-3">
            <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded ${
              job.clearanceLevel.includes('Poly')
                ? 'bg-red-50 text-brand-red border border-red-200'
                : job.clearanceLevel.includes('Secret')
                ? 'bg-amber-50 text-amber-800 border border-amber-200'
                : 'bg-slate-100 text-slate-700 border border-slate-200'
            }`}>
              {job.clearanceLevel}
            </span>
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-600">
              {job.employmentType}
            </span>
            <span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-600">
              {job.workplaceType}
            </span>
          </div>

          <!-- Title -->
          <h3 class="text-lg font-bold text-slate-900 tracking-tight leading-snug">
            {job.title}
          </h3>

          <p class="text-xs font-medium text-brand-slate mt-1">
            {job.department} • {job.location}
          </p>

          <p class="text-xs text-slate-600 mt-3 leading-relaxed line-clamp-3">
            {job.description}
          </p>

          <!-- Requirements snippet -->
          <ul class="mt-4 pt-3 border-t border-slate-100 space-y-1.5 text-xs text-slate-500">
            {job.requirements.slice(0, 2).map((req) => (
              <li class="flex items-start gap-1.5">
                <svg class="w-3.5 h-3.5 text-brand-red shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="line-clamp-1">{req}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Card Footer Action -->
        <div class="mt-6 pt-3 border-t border-slate-100 flex items-center justify-between">
          <span class="text-[11px] text-slate-400">
            Posted {job.postedDate}
          </span>
          <button
            type="button"
            class="apply-trigger-btn text-xs font-bold px-3.5 py-1.5 rounded-lg bg-brand-red text-white hover:bg-brand-red-hover transition-colors shadow-xs"
            data-job-id={job.id}
            data-job-title={job.title}
          >
            Apply Now
          </button>
        </div>
      </div>
    ))}
  </div>

  <!-- Empty State (Hidden initially) -->
  <div id="no-jobs-found" class="hidden text-center py-12 px-4 rounded-xl border border-dashed border-slate-300 bg-slate-50">
    <svg class="w-10 h-10 text-slate-400 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <h4 class="text-base font-bold text-slate-800">No matching positions found</h4>
    <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">
      Try loosening your search terms or filters. Alternatively, submit your general resume below for upcoming cleared openings.
    </p>
  </div>

  <!-- General Application Banner -->
  <div class="mt-12 bg-slate-900 rounded-2xl p-6 sm:p-8 text-white flex flex-col md:flex-row items-center justify-between gap-6">
    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-brand-red">General Talent Network</span>
      <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-white mt-1">
        Don’t see your exact role listed?
      </h3>
      <p class="text-xs sm:text-sm text-slate-400 mt-1 max-w-xl">
        Unity Compass places cleared professionals across DoD, DHS, IC, and civilian agencies continuously. Submit your resume to be matched with upcoming contract awards.
      </p>
    </div>
    <button
      type="button"
      id="general-apply-btn"
      class="shrink-0 px-6 py-3 rounded-lg text-sm font-semibold text-white bg-brand-red hover:bg-brand-red-hover transition-colors"
    >
      Submit General Resume &rarr;
    </button>
  </div>
</div>

<!-- Application Modal with Resume Upload -->
<div id="apply-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div class="bg-white rounded-2xl max-w-xl w-full p-6 sm:p-8 shadow-2xl border border-slate-200 relative max-h-[90vh] overflow-y-auto">
    <!-- Close Button -->
    <button
      type="button"
      id="close-modal-btn"
      class="absolute top-4 right-4 p-2 text-slate-400 hover:text-slate-600 rounded-lg hover:bg-slate-100"
      aria-label="Close modal"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="mb-5">
      <span class="text-xs font-bold text-brand-red uppercase tracking-wider">Candidate Application</span>
      <h3 id="modal-title" class="text-xl font-bold text-slate-900 tracking-tight mt-0.5">
        Apply for Position
      </h3>
      <p id="modal-subtitle" class="text-xs text-slate-500 mt-0.5">
        Target Role: <span id="modal-target-job" class="font-semibold text-slate-800">Senior Cleared Cloud Architect</span>
      </p>
    </div>

    <!-- Application Form -->
    <form id="job-apply-form" class="space-y-4" novalidate>
      <div id="modal-feedback" class="hidden p-3 rounded-lg text-xs font-medium"></div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
            Full Name *
          </label>
          <input
            type="text"
            id="app-name"
            required
            placeholder="John Doe"
            class="w-full px-3 py-2 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-navy"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
            Email Address *
          </label>
          <input
            type="email"
            id="app-email"
            required
            placeholder="john@example.com"
            class="w-full px-3 py-2 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-navy"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
            Phone Number *
          </label>
          <input
            type="tel"
            id="app-phone"
            required
            placeholder="+1 (301) 555-0199"
            class="w-full px-3 py-2 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-navy"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
            Security Clearance Status *
          </label>
          <select
            id="app-clearance"
            class="w-full px-3 py-2 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-navy bg-white"
          >
            <option value="TS/SCI with Polygraph">TS/SCI with Polygraph</option>
            <option value="Top Secret / SCI">Top Secret / SCI</option>
            <option value="Secret">Secret</option>
            <option value="Public Trust">Public Trust</option>
            <option value="None">None / Clearance Eligible</option>
          </select>
        </div>
      </div>

      <!-- Resume Upload (Preserving original UJM 1MB PDF/DOC validation requirement) -->
      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
          Upload Resume (PDF, DOC, DOCX — Max 1MB) *
        </label>
        <div class="border-2 border-dashed border-slate-300 rounded-xl p-4 text-center hover:border-brand-navy transition-colors bg-slate-50">
          <input
            type="file"
            id="app-resume"
            accept=".pdf,.doc,.docx"
            required
            class="w-full text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-brand-navy file:text-white hover:file:bg-brand-deep cursor-pointer"
          />
          <p class="text-[11px] text-slate-400 mt-1">Single file up to 1MB strictly enforced for federal talent screening.</p>
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
          Brief Qualifications / Clearance Summary
        </label>
        <textarea
          id="app-notes"
          rows="3"
          placeholder="Include details on clearance investigation date, primary labor categories, and current availability..."
          class="w-full px-3 py-2 text-sm rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-navy resize-y"
        ></textarea>
      </div>

      <div class="pt-2 flex items-center justify-end gap-3">
        <button
          type="button"
          id="cancel-modal-btn"
          class="px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-800"
        >
          Cancel
        </button>
        <button
          type="submit"
          id="submit-app-btn"
          class="px-6 py-2.5 text-xs font-bold text-white bg-brand-red hover:bg-brand-red-hover rounded-lg transition-colors shadow-sm"
        >
          Submit Application
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // Filter & Search Logic
  const searchInput = document.getElementById('job-search-input') as HTMLInputElement;
  const typeFilter = document.getElementById('job-type-filter') as HTMLSelectElement;
  const clearanceFilter = document.getElementById('job-clearance-filter') as HTMLSelectElement;
  const cards = document.querySelectorAll('.job-card');
  const countEl = document.getElementById('job-results-count');
  const emptyState = document.getElementById('no-jobs-found');
  const jobsContainer = document.getElementById('jobs-container');

  function filterJobs() {
    const query = searchInput?.value.toLowerCase().trim() || '';
    const selectedType = typeFilter?.value || '';
    const selectedClearance = clearanceFilter?.value || '';

    let visibleCount = 0;

    cards.forEach((card) => {
      const el = card as HTMLElement;
      const title = el.getAttribute('data-title') || '';
      const dept = el.getAttribute('data-department') || '';
      const type = el.getAttribute('data-type') || '';
      const clearance = el.getAttribute('data-clearance') || '';

      const matchesSearch = !query || title.includes(query) || dept.includes(query) || clearance.toLowerCase().includes(query);
      const matchesType = !selectedType || type === selectedType;
      const matchesClearance = !selectedClearance || clearance === selectedClearance;

      if (matchesSearch && matchesType && matchesClearance) {
        el.style.display = '';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    if (countEl) countEl.textContent = String(visibleCount);
    if (emptyState) {
      if (visibleCount === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }
    }
  }

  searchInput?.addEventListener('input', filterJobs);
  typeFilter?.addEventListener('change', filterJobs);
  clearanceFilter?.addEventListener('change', filterJobs);

  // View Switcher Logic
  const gridBtn = document.getElementById('view-grid-btn');
  const listBtn = document.getElementById('view-list-btn');

  gridBtn?.addEventListener('click', () => {
    gridBtn.classList.replace('text-slate-500', 'text-slate-900');
    gridBtn.classList.add('bg-white', 'shadow-xs');
    listBtn?.classList.replace('text-slate-900', 'text-slate-500');
    listBtn?.classList.remove('bg-white', 'shadow-xs');

    jobsContainer?.classList.remove('grid-cols-1');
    jobsContainer?.classList.add('md:grid-cols-2', 'lg:grid-cols-3');
  });

  listBtn?.addEventListener('click', () => {
    listBtn.classList.replace('text-slate-500', 'text-slate-900');
    listBtn.classList.add('bg-white', 'shadow-xs');
    gridBtn?.classList.replace('text-slate-900', 'text-slate-500');
    gridBtn?.classList.remove('bg-white', 'shadow-xs');

    jobsContainer?.classList.remove('md:grid-cols-2', 'lg:grid-cols-3');
    jobsContainer?.classList.add('grid-cols-1');
  });

  // Modal & Resume Upload Logic
  const modal = document.getElementById('apply-modal');
  const targetJobEl = document.getElementById('modal-target-job');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const cancelModalBtn = document.getElementById('cancel-modal-btn');
  const applyForm = document.getElementById('job-apply-form') as HTMLFormElement;
  const feedbackEl = document.getElementById('modal-feedback');
  const submitAppBtn = document.getElementById('submit-app-btn') as HTMLButtonElement;
  const resumeInput = document.getElementById('app-resume') as HTMLInputElement;

  function openModal(title: string) {
    if (targetJobEl) targetJobEl.textContent = title;
    if (feedbackEl) feedbackEl.classList.add('hidden');
    modal?.classList.remove('hidden');
  }

  function closeModal() {
    modal?.classList.add('hidden');
    applyForm?.reset();
  }

  document.querySelectorAll('.apply-trigger-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const title = target.getAttribute('data-job-title') || 'Selected Role';
      openModal(title);
    });
  });

  document.getElementById('general-apply-btn')?.addEventListener('click', () => {
    openModal('General Talent Network (All Specializations)');
  });

  closeModalBtn?.addEventListener('click', closeModal);
  cancelModalBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // Form Submission & Resume Validation (1MB limit strictly enforced)
  applyForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!feedbackEl || !submitAppBtn) return;

    feedbackEl.classList.add('hidden');
    feedbackEl.className = 'p-3 rounded-lg text-xs font-medium mb-3';

    const name = (document.getElementById('app-name') as HTMLInputElement)?.value.trim();
    const email = (document.getElementById('app-email') as HTMLInputElement)?.value.trim();
    const phone = (document.getElementById('app-phone') as HTMLInputElement)?.value.trim();
    const file = resumeInput?.files?.[0];

    if (!name || !email || !phone) {
      feedbackEl.textContent = 'Please fill out all required candidate fields.';
      feedbackEl.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
      feedbackEl.classList.remove('hidden');
      return;
    }

    if (!file) {
      feedbackEl.textContent = 'Please select a resume file to upload.';
      feedbackEl.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
      feedbackEl.classList.remove('hidden');
      return;
    }

    // 1MB limit check
    const maxBytes = 1048576; // 1 MB
    if (file.size > maxBytes) {
      feedbackEl.textContent = `Resume file size exceeds the 1MB limit (${(file.size / (1024 * 1024)).toFixed(2)}MB). Please upload a smaller document.`;
      feedbackEl.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
      feedbackEl.classList.remove('hidden');
      return;
    }

    submitAppBtn.disabled = true;
    submitAppBtn.textContent = 'Submitting Application...';

    setTimeout(() => {
      submitAppBtn.disabled = false;
      submitAppBtn.textContent = 'Submit Application';
      feedbackEl.textContent = 'Application successfully submitted! Our talent acquisition team will review your qualifications and clearance status.';
      feedbackEl.classList.add('bg-green-50', 'text-green-800', 'border', 'border-green-200');
      feedbackEl.classList.remove('hidden');
      applyForm.reset();

      setTimeout(() => {
        closeModal();
      }, 2000);
    }, 1000);
  });
</script>

