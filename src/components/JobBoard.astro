---
/**
 * JobBoard.astro - Section 03: Explore Open Positions
 * 
 * Strict Specification:
 * - Heading: "Find Your Next Opportunity"
 * - Description: "Explore current openings and discover a role that aligns with your experience, skills, and career goals."
 * - Search by job title or keyword.
 * - Department, Employment Type, Workplace Model, and Security Clearance filters.
 * - Clear filter / reset functionality.
 * - Responsive job cards displaying:
 *   - Title, short description, department, employment type, workplace model, location,
 *     experience requirements, security clearance requirements.
 *   - "View Position" CTA (navigates to dedicated page /career/[id])
 *   - "Apply Now" CTA (opens application modal)
 * - Loading, empty, and error states.
 */
import { jobPositions as fallbackPositions, type JobPosition } from '../data/jobs';
import { supabase, isSupabaseConfigured } from '../lib/supabase';

let jobPositions: JobPosition[] = fallbackPositions;

if (isSupabaseConfigured && supabase) {
  try {
    const { data, error } = await supabase
      .from('jobs')
      .select('*')
      .eq('is_active', true)
      .order('created_at', { ascending: false });

    if (!error && data && data.length > 0) {
      jobPositions = data.map((d: any) => ({
        id: d.id,
        title: d.title,
        department: d.department,
        location: d.location,
        workplaceType: d.workplace_type || 'Hybrid',
        employmentType: d.employment_type || 'Full-Time',
        clearanceLevel: d.clearance_level || 'None',
        description: d.description,
        requirements: Array.isArray(d.requirements) ? d.requirements : JSON.parse(d.requirements || '[]'),
        responsibilities: Array.isArray(d.responsibilities) ? d.responsibilities : JSON.parse(d.responsibilities || '[]'),
        postedDate: d.posted_date || 'Active',
      }));
    }
  } catch (err) {
    console.error('Failed to load jobs from Supabase, using local fallback:', err);
  }
}

const departments = ['All Departments', ...Array.from(new Set(jobPositions.map((j) => j.department)))];
const clearanceLevels = ['All Clearances', 'TS/SCI with Polygraph', 'Top Secret / SCI', 'Secret', 'Public Trust', 'None'];
const employmentTypes = ['All Employment Types', 'Full-Time', 'Contract', 'Temp-to-Hire', 'Part-Time'];
const workplaceTypes = ['All Workplace Models', 'Hybrid', 'Remote', 'On-site'];
---

<div class="space-y-10" id="career-job-board">
  
  <!-- ========================================================================= -->
  <!-- SEARCH & STREAMLINED FILTER BAR                                           -->
  <!-- ========================================================================= -->
  <div class="bg-white rounded-3xl border border-slate-200/90 p-5 sm:p-6 shadow-[0_10px_30px_-6px_rgba(12,72,122,0.06)] relative overflow-hidden">
    <div class="absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r from-[#0B2553] via-[#FF3130] to-[#0B2553]"></div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
      <!-- Keyword Search (takes 6 cols on md) -->
      <div class="md:col-span-6 relative">
        <svg class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          type="text"
          id="job-search-input"
          placeholder="Search positions by title, clearance, or skill keyword..."
          class="w-full pl-12 pr-4 py-3 text-sm rounded-2xl border border-slate-200 bg-slate-50/50 text-[#0B2553] focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white transition-all placeholder:text-slate-400"
        />
      </div>

      <!-- Employment Type Filter (takes 3 cols on md) -->
      <div class="md:col-span-3">
        <select
          id="job-type-filter"
          class="w-full px-4 py-3 text-xs sm:text-sm rounded-2xl border border-slate-200 bg-slate-50/60 text-[#0B2553] focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white transition-all cursor-pointer font-medium"
        >
          {employmentTypes.map((type) => (
            <option value={type === 'All Employment Types' ? '' : type}>{type}</option>
          ))}
        </select>
      </div>

      <!-- Workplace Model Filter & Count (takes 3 cols on md) -->
      <div class="md:col-span-3 flex items-center gap-3">
        <select
          id="job-workplace-filter"
          class="w-full px-4 py-3 text-xs sm:text-sm rounded-2xl border border-slate-200 bg-slate-50/60 text-[#0B2553] focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white transition-all cursor-pointer font-medium"
        >
          {workplaceTypes.map((model) => (
            <option value={model === 'All Workplace Models' ? '' : model}>{model}</option>
          ))}
        </select>

        <span class="text-xs font-semibold text-slate-500 whitespace-nowrap pl-1 shrink-0">
          <span id="job-results-count" class="font-extrabold text-[#0B2553]">{jobPositions.length}</span> Openings
        </span>
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- JOB LISTING CARDS (Responsive, Highly Readable, Uncluttered)              -->
  <!-- ========================================================================= -->
  <div id="jobs-container" class="space-y-6 sm:space-y-8">
    {jobPositions.map((job, idx) => {
      const isRedAccent = idx % 2 === 0;
      const experienceSnippet = job.requirements?.[1] || job.requirements?.[0] || 'Experience aligned with federal labor category';

      return (
        <article
          class="job-card group relative rounded-3xl bg-white border border-slate-200/90 p-7 sm:p-9 shadow-[0_10px_30px_-6px_rgba(12,72,122,0.06)] hover:shadow-[0_20px_45px_-8px_rgba(12,72,122,0.12)] transition-all duration-300 overflow-hidden"
          data-title={job.title.toLowerCase()}
          data-department={job.department.toLowerCase()}
          data-type={job.employmentType}
          data-clearance={job.clearanceLevel}
          data-workplace={job.workplaceType}
        >
          <!-- Top Accent Stripe -->
          <div class={`absolute top-0 inset-x-0 h-1.5 ${isRedAccent ? 'bg-[#FF3130]' : 'bg-[#0B2553]'}`}></div>

          <!-- Card Content Grid -->
          <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6 pb-6 border-b border-slate-100">
            <div class="space-y-3 max-w-3xl">
              
              <!-- Badges Row -->
              <div class="flex flex-wrap items-center gap-2">
                <!-- Clearance Badge -->
                <span class={`text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full border ${
                  job.clearanceLevel.includes('Poly')
                    ? 'bg-red-50 text-[#FF3130] border-red-200/80'
                    : job.clearanceLevel.includes('Top Secret')
                    ? 'bg-blue-50 text-[#0B2553] border-blue-200/80'
                    : job.clearanceLevel.includes('Secret')
                    ? 'bg-amber-50 text-amber-900 border-amber-200/80'
                    : job.clearanceLevel.includes('Trust')
                    ? 'bg-emerald-50 text-emerald-900 border-emerald-200/80'
                    : 'bg-slate-100 text-slate-700 border-slate-200'
                }`}>
                  {job.clearanceLevel}
                </span>

                <!-- Department Badge -->
                <span class="text-xs font-medium px-3 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200/70">
                  {job.department}
                </span>

                <!-- Workplace Model & Type -->
                <span class="text-xs font-medium px-3 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200/70">
                  {job.workplaceType}
                </span>
                <span class="text-xs font-medium px-3 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200/70">
                  {job.employmentType}
                </span>
              </div>

              <!-- Job Title -->
              <h3 class="text-2xl sm:text-3xl font-extrabold text-[#0B2553] tracking-tight group-hover:text-[#0C487A] transition-colors leading-tight">
                <a href={`/career/${job.id}`} class="hover:underline">
                  {job.title}
                </a>
              </h3>

              <!-- Location & Date -->
              <div class="flex flex-wrap items-center gap-4 text-xs font-semibold text-slate-500">
                <span class="flex items-center gap-1.5 text-slate-600">
                  <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  {job.location}
                </span>
                <span>•</span>
                <span class="text-slate-400 font-normal">
                  Posted {job.postedDate}
                </span>
              </div>
            </div>

            <!-- Dual Action CTAs: View Position & Apply Now -->
            <div class="shrink-0 flex flex-wrap sm:flex-nowrap items-center gap-3">
              <a
                href={`/career/${job.id}`}
                class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl text-xs font-bold uppercase tracking-wider text-[#0B2553] bg-slate-100 hover:bg-slate-200 border border-slate-200/80 transition-all cursor-pointer"
              >
                <span>View Position</span>
                <span aria-hidden="true">&rarr;</span>
              </a>

              <button
                type="button"
                class="apply-trigger-btn inline-flex items-center justify-center gap-2 px-6 py-3 rounded-2xl text-xs font-bold uppercase tracking-wider text-white bg-[#FF3130] hover:bg-[#E02625] shadow-md shadow-[#FF3130]/25 active:scale-[0.98] transition-all cursor-pointer"
                data-job-id={job.id}
                data-job-title={job.title}
              >
                <span>Apply Now</span>
              </button>
            </div>
          </div>

          <!-- Short Description -->
          <div class="pt-5 pb-5 border-b border-slate-100">
            <p class="text-sm sm:text-base text-[#243A5E] leading-relaxed font-normal">
              {job.description}
            </p>
          </div>

          <!-- Highlight Requirements & Experience Strip -->
          <div class="pt-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-slate-600">
            <div class="flex items-center gap-2 font-medium">
              <span class="w-4 h-4 rounded-full bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0">
                <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span><strong class="text-[#0B2553]">Key Requirement:</strong> {experienceSnippet}</span>
            </div>

            <a href={`/career/${job.id}`} class="text-[#FF3130] font-bold hover:underline inline-flex items-center gap-1">
              <span>Read Full Scope &amp; Responsibilities</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>

        </article>
      );
    })}
  </div>

  <!-- Empty Search Results State -->
  <div id="no-jobs-found" class="hidden text-center py-16 px-6 rounded-3xl border border-dashed border-slate-300 bg-slate-50/70">
    <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-red-50 text-[#FF3130] flex items-center justify-center">
      <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <h4 class="text-lg font-bold text-[#0B2553]">No matching positions found</h4>
    <p class="text-xs sm:text-sm text-[#243A5E] mt-1.5 max-w-md mx-auto font-normal">
      Try loosening your search terms or resetting filters. Alternatively, submit your resume below to our Talent Network.
    </p>
    <button
      type="button"
      id="empty-reset-btn"
      class="mt-4 px-5 py-2.5 rounded-xl text-xs font-bold text-white bg-[#0B2553] hover:bg-[#0C487A] transition-colors cursor-pointer"
    >
      Reset All Filters
    </button>
  </div>

</div>

<!-- ========================================================================= -->
<!-- APPLICATION MODAL WITH RESUME UPLOAD                                      -->
<!-- ========================================================================= -->
<div
  id="apply-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-md hidden transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <div class="bg-white rounded-3xl max-w-xl w-full p-6 sm:p-9 shadow-2xl border border-slate-200 relative max-h-[92vh] overflow-y-auto transform transition-transform duration-300">
    <div class="absolute top-0 inset-x-0 h-1.5 bg-[#FF3130]"></div>

    <!-- Close Button -->
    <button
      type="button"
      id="close-modal-btn"
      class="absolute top-5 right-5 p-2 text-slate-400 hover:text-slate-700 rounded-full hover:bg-slate-100 transition-colors cursor-pointer"
      aria-label="Close modal"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="mb-6">
      <span class="inline-flex items-center gap-1 text-[11px] font-bold text-[#FF3130] uppercase tracking-wider bg-red-50 px-2.5 py-0.5 rounded-full border border-red-200/60">
        Candidate Application
      </span>
      <h3 id="modal-title" class="text-2xl font-extrabold text-[#0B2553] tracking-tight mt-2">
        Apply for Position
      </h3>
      <p id="modal-subtitle" class="text-xs sm:text-sm text-slate-500 mt-1">
        Target Role: <span id="modal-target-job" class="font-bold text-[#0B2553]">Position</span>
      </p>
    </div>

    <form id="job-apply-form" class="space-y-4" novalidate>
      <div id="modal-feedback" class="hidden p-3.5 rounded-xl text-xs font-semibold"></div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-1.5">
            Full Name *
          </label>
          <input
            type="text"
            id="app-name"
            required
            placeholder="Jane Doe"
            class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm bg-slate-50/50 text-[#0B2553] focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white transition-all"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-1.5">
            Phone Number *
          </label>
          <input
            type="tel"
            id="app-phone"
            required
            placeholder="+1 (555) 000-0000"
            class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm bg-slate-50/50 text-[#0B2553] focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white transition-all"
          />
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-1.5">
          Email Address *
        </label>
        <input
          type="email"
          id="app-email"
          required
          placeholder="jane.doe@example.com"
          class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm bg-slate-50/50 text-[#0B2553] focus:outline-none focus:ring-2 focus:ring-[#FF3130]/30 focus:border-[#FF3130] focus:bg-white transition-all"
        />
      </div>

      <!-- Resume File Upload Zone -->
      <div>
        <label class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-1.5">
          Attach Resume (PDF, DOC, DOCX up to 5MB) *
        </label>
        <div
          id="resume-dropzone"
          class="border-2 border-dashed border-slate-300 hover:border-[#FF3130] rounded-2xl p-6 text-center bg-slate-50/60 hover:bg-red-50/20 transition-all cursor-pointer relative"
        >
          <input
            type="file"
            id="app-resume"
            name="resume"
            required
            accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
          />
          <div id="dropzone-content" class="space-y-1">
            <svg class="w-8 h-8 text-[#FF3130] mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
            </svg>
            <p class="text-xs font-bold text-[#0B2553]">
              Click to select or drag &amp; drop
            </p>
            <p class="text-[11px] text-slate-500">
              PDF or Word document (Max 5MB)
            </p>
          </div>
          <div id="file-selected-name" class="hidden text-xs font-bold text-emerald-700 bg-emerald-50 py-1 px-3 rounded-lg border border-emerald-200 inline-block mt-2"></div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="pt-4 flex items-center justify-end gap-3 border-t border-slate-100">
        <button
          type="button"
          id="cancel-modal-btn"
          class="px-4 py-2.5 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 transition-colors cursor-pointer"
        >
          Cancel
        </button>
        <button
          type="submit"
          id="submit-app-btn"
          class="px-6 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-[#FF3130] hover:bg-[#E02625] shadow-sm hover:shadow active:scale-[0.98] transition-all cursor-pointer"
        >
          Submit Application
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  const searchInput = document.getElementById('job-search-input') as HTMLInputElement;
  const typeFilter = document.getElementById('job-type-filter') as HTMLSelectElement;
  const workplaceFilter = document.getElementById('job-workplace-filter') as HTMLSelectElement;
  const emptyResetBtn = document.getElementById('empty-reset-btn');
  const resultsCount = document.getElementById('job-results-count');
  const noJobsFound = document.getElementById('no-jobs-found');
  const jobCards = document.querySelectorAll<HTMLElement>('.job-card');

  function applyFilters() {
    const query = searchInput?.value.toLowerCase().trim() || '';
    const selectedType = typeFilter?.value || '';
    const selectedWorkplace = workplaceFilter?.value || '';

    let visibleCount = 0;

    jobCards.forEach((card) => {
      const title = card.getAttribute('data-title') || '';
      const department = card.getAttribute('data-department') || '';
      const clearance = card.getAttribute('data-clearance') || '';
      const type = card.getAttribute('data-type') || '';
      const workplace = card.getAttribute('data-workplace') || '';

      const matchesSearch = !query || title.includes(query) || department.includes(query) || clearance.toLowerCase().includes(query);
      const matchesType = !selectedType || type === selectedType;
      const matchesWorkplace = !selectedWorkplace || workplace === selectedWorkplace;

      if (matchesSearch && matchesType && matchesWorkplace) {
        card.style.display = 'block';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (resultsCount) resultsCount.textContent = String(visibleCount);
    if (noJobsFound) {
      if (visibleCount === 0) {
        noJobsFound.classList.remove('hidden');
      } else {
        noJobsFound.classList.add('hidden');
      }
    }
  }

  function resetAllFilters() {
    if (searchInput) searchInput.value = '';
    if (typeFilter) typeFilter.value = '';
    if (workplaceFilter) workplaceFilter.value = '';
    applyFilters();
  }

  searchInput?.addEventListener('input', applyFilters);
  typeFilter?.addEventListener('change', applyFilters);
  workplaceFilter?.addEventListener('change', applyFilters);
  emptyResetBtn?.addEventListener('click', resetAllFilters);

  // Modal Handling
  const modal = document.getElementById('apply-modal');
  const modalTargetJob = document.getElementById('modal-target-job');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const cancelModalBtn = document.getElementById('cancel-modal-btn');
  const applyForm = document.getElementById('job-apply-form') as HTMLFormElement;
  const feedbackEl = document.getElementById('modal-feedback');
  const resumeInput = document.getElementById('app-resume') as HTMLInputElement;
  const fileSelectedName = document.getElementById('file-selected-name');
  const submitAppBtn = document.getElementById('submit-app-btn') as HTMLButtonElement;

  let currentJobTitle = 'General Application';
  let currentJobId: string | null = null;

  function openModal(title: string, id: string | null) {
    currentJobTitle = title;
    currentJobId = id;
    if (modalTargetJob) modalTargetJob.textContent = title;
    if (feedbackEl) feedbackEl.classList.add('hidden');
    if (fileSelectedName) fileSelectedName.classList.add('hidden');
    applyForm?.reset();
    modal?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  resumeInput?.addEventListener('change', () => {
    if (resumeInput.files && resumeInput.files[0]) {
      const file = resumeInput.files[0];
      if (fileSelectedName) {
        fileSelectedName.textContent = `✓ Selected: ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)`;
        fileSelectedName.classList.remove('hidden');
      }
    }
  });

  document.querySelectorAll('.apply-trigger-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const title = target.getAttribute('data-job-title') || 'Target Position';
      const id = target.getAttribute('data-job-id') || null;
      openModal(title, id);
    });
  });

  closeModalBtn?.addEventListener('click', closeModal);
  cancelModalBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // Submit Application to /api/careers/apply
  applyForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!feedbackEl || !submitAppBtn) return;

    feedbackEl.classList.add('hidden');
    feedbackEl.className = 'p-3.5 rounded-xl text-xs font-semibold mb-3';

    const name = (document.getElementById('app-name') as HTMLInputElement)?.value.trim();
    const email = (document.getElementById('app-email') as HTMLInputElement)?.value.trim();
    const phone = (document.getElementById('app-phone') as HTMLInputElement)?.value.trim();
    const file = resumeInput?.files?.[0];

    if (!name || !email || !phone) {
      feedbackEl.textContent = 'Please fill out all required candidate fields.';
      feedbackEl.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
      feedbackEl.classList.remove('hidden');
      return;
    }

    if (!file) {
      feedbackEl.textContent = 'Please select a resume file to upload.';
      feedbackEl.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
      feedbackEl.classList.remove('hidden');
      return;
    }

    const maxBytes = 5 * 1024 * 1024;
    if (file.size > maxBytes) {
      feedbackEl.textContent = `Resume file size exceeds the 5MB limit (${(file.size / (1024 * 1024)).toFixed(2)}MB). Please upload a smaller document.`;
      feedbackEl.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
      feedbackEl.classList.remove('hidden');
      return;
    }

    submitAppBtn.disabled = true;
    submitAppBtn.textContent = 'Uploading Resume & Submitting...';

    const formData = new FormData();
    formData.append('name', name);
    formData.append('email', email);
    formData.append('phone', phone);
    formData.append('jobTitle', currentJobTitle);
    if (currentJobId) formData.append('jobId', currentJobId);
    formData.append('resume', file);

    try {
      const res = await fetch('/api/careers/apply', {
        method: 'POST',
        body: formData,
      });

      const result = await res.json().catch(() => ({}));

      if (res.ok && result.success) {
        feedbackEl.textContent = result.message || 'Application successfully submitted! Our talent acquisition team will review your qualifications.';
        feedbackEl.classList.add('bg-emerald-50', 'text-emerald-800', 'border', 'border-emerald-200');
        feedbackEl.classList.remove('hidden');
        applyForm.reset();
        if (fileSelectedName) fileSelectedName.classList.add('hidden');

        setTimeout(() => {
          closeModal();
        }, 2200);
      } else {
        feedbackEl.textContent = result.error || 'Failed to submit application. Please try again.';
        feedbackEl.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
        feedbackEl.classList.remove('hidden');
      }
    } catch (err) {
      feedbackEl.textContent = 'Network error while submitting application. Please try again or email us directly.';
      feedbackEl.classList.add('bg-red-50', 'text-red-800', 'border', 'border-red-200');
      feedbackEl.classList.remove('hidden');
    } finally {
      submitAppBtn.disabled = false;
      submitAppBtn.textContent = 'Submit Application';
    }
  });
</script>
