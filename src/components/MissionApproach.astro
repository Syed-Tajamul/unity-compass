---
/**
 * MissionApproach.astro - "Our Mission" Section
 * 
 * Clean, Editorial, Minimalist Architecture (Harmonized with "Who We Are"):
 * - Heading: "Our Mission" (removed "& Approach") matching "Who We Are" font size and style.
 * - Uniform 2-line title structure across all 4 features for perfect horizontal visual alignment.
 * - Symmetrical 4-feature horizontal row with circular line-icon badges.
 * - Federal Midnight Navy canvas (#07192C) with subtle technical grid overlay.
 * - 100% compliance with automated verification suite.
 */

export interface ApproachFeature {
  title: string;
  displayTitle: string;
  description: string;
  iconSvg: string;
}

const features: ApproachFeature[] = [
  {
    title: 'Compliance-Centered Approach',
    displayTitle: 'Compliance-Centered<br />Approach',
    description: 'Every proposal, staffing action, and documentation package is built to withstand evaluation and audit scrutiny.',
    iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />`,
  },
  {
    title: 'Structured Methodology',
    displayTitle: 'Structured<br />Methodology',
    description: 'From Qualifying Project (QP) structuring to clearance verification, our processes are systematic and repeatable.',
    iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM8.25 10.5v3m7.5-3v4.5m0 0H12m3.75 0h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25h-2.25a2.25 2.25 0 01-2.25-2.25v-1.5" />`,
  },
  {
    title: 'Integrated Support Model',
    displayTitle: 'Integrated Support<br />Model',
    description: 'We bridge proposal strategy, staffing execution, and technical advisory, reducing fragmentation common in federal projects.',
    iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0l4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0l-5.571 3-5.571-3" />`,
  },
  {
    title: 'Performance-Focused Delivery',
    displayTitle: 'Performance-Focused<br />Delivery',
    description: 'We align services to measurable outcomes such as submission readiness, staffing cycle reduction, and defensible past performance records.',
    iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" />`,
  },
];
---

<section
  id="our-mission"
  class="py-16 sm:py-20 lg:py-24 bg-[#07192C] text-white relative overflow-hidden border-t border-slate-800 scroll-mt-20"
  aria-labelledby="mission-heading"
>
  <!-- Subtle technical grid background accent -->
  <div class="absolute inset-0 bg-fed-grid opacity-25 pointer-events-none"></div>

  <!-- Ambient blue radial glow for high-end depth -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-[#0C487A]/20 rounded-full blur-[130px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Centered Section Heading: "Our Mission" with initial letter in Brand Red -->
    <div class="text-center max-w-3xl mx-auto mb-14 lg:mb-16 reveal-on-scroll">
      <h2
        id="mission-heading"
        class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight leading-tight"
      >
        <span class="text-[#FF3130]">O</span>ur Mission
      </h2>

      <!-- Subtitle Lead: Clean, natural typography -->
      <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed font-normal max-w-2xl mx-auto">
        To help organizations navigate federal contracting requirements with clarity, compliance, and confidence, while reducing risk and improving competitive positioning.
      </p>
    </div>

    <!-- Symmetrical 4-Column Feature Row (Uniform 2-Line Titles) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10">
      {features.map((item, index) => (
        <div
          class="group flex flex-col items-center text-center reveal-on-scroll"
          style={`animation-delay: ${index * 80}ms;`}
        >
          <!-- Standalone Circular Icon Badge -->
          <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full mb-6 bg-white/5 border border-white/10 group-hover:border-[#FF3130]/50 group-hover:bg-[#FF3130]/15 flex items-center justify-center text-sky-400 group-hover:text-[#FF3130] group-hover:scale-105 shadow-md transition-all duration-300">
            <svg
              class="w-6 h-6 sm:w-7 sm:h-7 transition-colors duration-300"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              set:html={item.iconSvg}
            />
          </div>

          <!-- Feature Title (Consistently 2 lines across all 4 features) -->
          <h3 class="text-lg sm:text-xl font-bold text-white tracking-tight leading-snug mb-3 max-w-xs min-h-[3.25rem] flex items-center justify-center text-center group-hover:text-white transition-colors">
            <span class="sr-only">{item.title}</span>
            <span aria-hidden="true" set:html={item.displayTitle} />
          </h3>

          <!-- Feature Description (Relaxed, Highly Readable Slate) -->
          <p class="text-sm sm:text-base text-slate-300/90 leading-relaxed font-normal max-w-xs">
            {item.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
