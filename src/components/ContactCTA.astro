---
/**
 * ContactCTA.astro - Executive GovCon High-Conversion Call-to-Action Section
 * 
 * Harmonized Theme & Visual Continuity:
 * - Executive sky-to-slate gradient canvas (#F4F8FC via #EBF3FA to #DFEDF8)
 * - Minute 16px × 16px technical blueprint checks overlay
 * - Soft ambient radial blue glow
 * - Continuous radiant multi-line color shimmer animation across headline
 * - Signature animated tri-color blended accent bar (Navy to Royal to Red)
 * - Floating glassmorphic card with subtle blueprint star watermark
 * - Sleek executive CTA button with hover micro-glide and disabled presentation mode
 * - Verbatim Unity Compass consultation message and compliance credentials
 */
---

<section
  id="contact-cta"
  class="relative py-20 sm:py-24 lg:py-28 bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] overflow-hidden scroll-mt-16 border-t border-slate-200/80"
  aria-labelledby="cta-heading"
>
  <!-- Minute Checks Pattern Overlay (Identical 16px × 16px grid as Hero & Mission) -->
  <div
    class="absolute inset-0 pointer-events-none opacity-35 mix-blend-multiply"
    style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.08) 1px, transparent 1px);"
    aria-hidden="true"
  ></div>

  <!-- Soft Ambient Radial Blue Glow centered behind card -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4/5 max-w-4xl h-80 bg-[radial-gradient(ellipse,rgba(40,121,182,0.14)_0%,transparent_70%)] pointer-events-none blur-3xl"
    aria-hidden="true"
  ></div>

  <!-- Container -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 xl:px-12 relative z-10">
    
    <!-- Floating Glassmorphic Executive CTA Card -->
    <div
      class="cta-card-reveal w-full rounded-3xl shadow-[0_24px_60px_-15px_rgba(11,37,83,0.12),0_0_0_1px_rgba(255,255,255,0.9)_inset] overflow-hidden relative border border-slate-200/90 bg-white/95 backdrop-blur-xl p-8 sm:p-14 lg:p-16 text-center transition-all duration-300"
    >
      <!-- Ambient Compass Watermark in Background -->
      <div class="absolute -right-16 -bottom-16 w-64 h-64 opacity-5 pointer-events-none select-none text-[#0C487A]" aria-hidden="true">
        <svg viewBox="0 0 100 100" fill="currentColor">
          <circle cx="50" cy="50" r="45" fill="none" stroke="currentColor" stroke-width="2"/>
          <path d="M50 5 L55 45 L95 50 L55 55 L50 95 L45 55 L5 50 L45 45 Z"/>
        </svg>
      </div>

      <!-- Content Container -->
      <div class="relative z-10 max-w-3xl mx-auto flex flex-col items-center gap-5">
        
        <!-- Main Headline with Tight Cohesive Line-Height & Continuous Blended Color Shimmer Animation -->
        <h2
          id="cta-heading"
          class="cta-heading-reveal text-2xl sm:text-3xl md:text-4xl lg:text-[2.65rem] font-extrabold tracking-tight leading-[1.18] sm:leading-[1.22] lg:leading-[1.24] max-w-3xl mx-auto text-center"
        >
          <span class="cta-shimmer-line cta-shimmer-line-1">Ready to Make a Difference for</span>
          <span class="cta-shimmer-line cta-shimmer-line-2">Your Organization?</span>
        </h2>

        <!-- Accessible Exact Heading Anchor -->
        <span class="sr-only">Ready to Make a Difference for Your Organization?</span>

        <!-- Animated Brand Accent Bar (Navy-to-Red Dynamic Pulse) -->
        <div class="w-24 h-1.5 rounded-full bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130] section-accent-line mx-auto mt-2 mb-3"></div>

        <!-- Subtext: Verbatim Unity Compass -->
        <p class="cta-subheading-reveal text-slate-600 text-sm sm:text-base lg:text-[1.05rem] font-normal leading-relaxed max-w-2xl mx-auto">
          If you're ready to see how we can make a difference for your organization, Contact Us today. Let's discuss how we can support your next big project.
        </p>

        <!-- Primary Action Button -->
        <div class="mt-4 cta-action-reveal">
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-3 px-9 sm:px-11 py-4 rounded-2xl bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#0C487A] hover:from-[#FF3130] hover:via-[#DC2626] hover:to-[#FF3130] text-white text-sm sm:text-base font-bold shadow-lg shadow-[#0C487A]/25 hover:shadow-red-500/25 transform hover:-translate-y-1 active:translate-y-0 transition-all duration-300 cursor-pointer group"
          >
            <span>Get in Touch</span>
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  /* ========================================================================= */
  /* Scroll-Triggered Soft-Reveal Animation (Matching Hero & ServicesGrid)     */
  /* ========================================================================= */
  .cta-heading-reveal,
  .cta-subheading-reveal,
  .cta-card-reveal,
  .cta-action-reveal {
    opacity: 0;
    transform: translateY(18px);
    filter: blur(8px);
    transition: opacity 1.3s cubic-bezier(0.16, 1, 0.3, 1),
                transform 1.3s cubic-bezier(0.16, 1, 0.3, 1),
                filter 1.3s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform, filter;
  }

  :global(#contact-cta.is-revealed) .cta-card-reveal {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  :global(#contact-cta.is-revealed) .cta-heading-reveal {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
    transition-delay: 0.08s;
  }

  :global(#contact-cta.is-revealed) .cta-subheading-reveal {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
    transition-delay: 0.16s;
  }

  :global(#contact-cta.is-revealed) .cta-action-reveal {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
    transition-delay: 0.24s;
  }

  /* ========================================================================= */
  /* Continuous Radiant Color Shimmer Sweep across Headline Lines              */
  /* ========================================================================= */
  .cta-shimmer-line {
    display: block;
    background: linear-gradient(
      90deg,
      #0F274A 0%,
      #1E40AF 22%,
      #2563EB 42%,
      #DC2626 58%,
      #EF4444 72%,
      #0F274A 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    will-change: background-position;
  }

  .cta-shimmer-line-1 {
    animation: ctaShimmer1 9.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .cta-shimmer-line-2 {
    animation: ctaShimmer2 9.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @keyframes ctaShimmer1 {
    0% { background-position: 0% 50%; }
    48% { background-position: 100% 50%; }
    52% { background-position: 100% 50%; }
    100% { background-position: 200% 50%; }
  }

  @keyframes ctaShimmer2 {
    0% { background-position: -50% 50%; }
    48% { background-position: 50% 50%; }
    52% { background-position: 50% 50%; }
    100% { background-position: 150% 50%; }
  }

  /* Reduced Motion Override */
  @media (prefers-reduced-motion: reduce) {
    .cta-heading-reveal,
    .cta-subheading-reveal,
    .cta-card-reveal,
    .cta-action-reveal {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
      transition: none !important;
    }
    .cta-shimmer-line {
      animation: none !important;
      background: none !important;
      -webkit-text-fill-color: #0F274A !important;
      color: #0F274A !important;
    }
  }
</style>

<script>
  function initContactCta() {
    const section = document.getElementById('contact-cta');
    if (!section) return;

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            section.classList.add('is-revealed');
            observer.unobserve(section);
          }
        });
      }, { threshold: 0.25 });
      observer.observe(section);
    } else {
      section.classList.add('is-revealed');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactCta);
  } else {
    initContactCta();
  }
  document.addEventListener('astro:page-load', initContactCta);
</script>
