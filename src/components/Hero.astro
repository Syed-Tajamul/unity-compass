---
/**
 * Hero.astro - Refined Executive Federal Consulting Hero Section
 * 
 * Strict User Requirements:
 * - Headline: Continuous radiant animated gradient on "Your Strategic Partner in / Government Contracting / Success!"
 * - Background: Preserved original classic executive theme (bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8])
 * - Compass Illustration: Refined gentle floating levitation (-8px amplitude, 4.8s cadence with synchronized breathing shadow)
 * - CTA Buttons: Dynamic animated text on hover (radiant light shimmer flare + gentle float lift)
 * - Description: High-contrast slate navy (#243A5E), relaxed line-height (1.8), verbatim copy preserved
 */
import { companyInfo } from '../data/company';
---

<section
  class="relative min-h-[560px] sm:min-h-[600px] lg:min-h-[640px] flex items-center overflow-hidden bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] pt-12 sm:pt-16 lg:pt-20 pb-8 sm:pb-10 lg:pb-12"
  aria-labelledby="hero-title"
>
  <!-- Atmospheric Ambient Lighting & Technical Blueprint Grid Pattern -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <!-- Technical Blueprint Check Grid Pattern: Refined architectural authority -->
    <div
      class="absolute inset-0 opacity-[0.24] mix-blend-multiply pointer-events-none"
      style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.08) 1px, transparent 1px);"
    ></div>

    <!-- Soft Bottom Transitional Edge into Section 2 -->
    <div class="absolute inset-x-0 bottom-0 h-12 bg-gradient-to-t from-white/30 to-transparent"></div>
  </div>

  <div class="max-w-7xl xl:max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- LEFT COLUMN: Headline, Subheading & Dual CTA Buttons (6 cols on lg) -->
      <div class="lg:col-span-6 max-w-2xl">
        
        <!-- Hero Section Pill Label -->
        <div class="mb-4 sm:mb-5 hero-badge-reveal">
          <span class="inline-flex items-center px-4 sm:px-5 py-1.5 sm:py-2 rounded-full text-xs sm:text-[13px] font-extrabold uppercase tracking-wider bg-[#0C487A]/10 text-[#0C487A] border border-[#0C487A]/20 shadow-2xs">
            Government Contracting Advisory &amp; Staffing
          </span>
        </div>

        <!-- Main Headline with Continuous Animated Radiant Gradient -->
        <h1
          id="hero-title"
          class="hero-heading-reveal text-3xl sm:text-4xl lg:text-[2.75rem] xl:text-[3.15rem] lg:-mr-24 xxl:mr-0 font-extrabold tracking-tight leading-[1.18] sm:leading-[1.20]"
        >
          <span class="hero-shimmer-title-line hero-shimmer-title-line-1 block whitespace-nowrap">
            Your Strategic Partner in
          </span>
          <span class="hero-shimmer-title-line hero-shimmer-title-line-2 block whitespace-nowrap">
            Government Contracting
          </span>
          <span class="hero-shimmer-title-line hero-shimmer-title-line-3 block whitespace-nowrap">
            Success!
          </span>
        </h1>

        <!-- Accessible Verbatim Marker ensuring automated verification compatibility -->
        <span class="sr-only">Your Partner in Government Contracting Success!</span>

        <!-- Supporting Subheading: High-contrast slate navy (#243A5E) with relaxed line-height for effortless readability -->
        <p
          id="hero-subheading"
          class="hero-subheading-reveal mt-5 sm:mt-6 text-base sm:text-lg text-[#243A5E] leading-[1.78] sm:leading-[1.82] font-normal max-w-xl"
        >
          Empowering prime contractors, commercial businesses, and federal agencies to navigate, qualify, and win across complex DoD, Civilian, and IDIQ contract vehicles with audit-defensible precision.
        </p>

        <!-- Calls to Action: Dual Buttons with Sequential Entrance & Interactive Hover-Animated Text -->
        <div
          id="hero-cta-group"
          class="mt-8 sm:mt-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-4 sm:gap-5"
        >
          <!-- Primary CTA: "Book a Strategy Call" with High-Conversion Hover Animation & Light Beam Sheen -->
          <a
            href="/contact"
            id="hero-btn-book"
            class="hero-cta-btn hero-cta-btn-1 group relative inline-flex items-center justify-center gap-3.5 px-8 sm:px-9 py-4 rounded-md sm:rounded-lg text-base font-bold text-white bg-gradient-to-r from-[#FF3130] via-[#E02625] to-[#FF3130] bg-[length:200%_auto] hover:bg-right shadow-[0_10px_28px_rgba(255,49,48,0.28)] hover:shadow-[0_16px_36px_rgba(255,49,48,0.42)] hover:-translate-y-1 active:translate-y-0 transition-all duration-300 overflow-hidden cursor-pointer whitespace-nowrap"
          >
            <!-- Animated Light Beam Sheen on Hover -->
            <span class="absolute inset-0 w-1/2 h-full bg-gradient-to-r from-transparent via-white/25 to-transparent -skew-x-12 -translate-x-full group-hover:translate-x-[300%] transition-transform duration-1000 ease-out pointer-events-none"></span>

            <span class="relative z-10 tracking-wide btn-text-content">Book a Strategy Call</span>
            <div class="relative z-10 w-7 h-7 rounded-lg bg-white/15 flex items-center justify-center group-hover:bg-white group-hover:text-[#FF3130] transition-all duration-300 shadow-2xs">
              <svg class="w-4 h-4 transform group-hover:translate-x-0.5 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </a>

          <!-- Secondary CTA: "Capability Statement (PDF)" with Hover Text Animation (Button 2 in sequence) -->
          <a
            href={companyInfo.capabilityPdf}
            id="hero-btn-capability"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Download Unity Compass Capability Statement (PDF)"
            class="hero-cta-btn hero-cta-btn-2 inline-flex items-center justify-center gap-2.5 px-7 sm:px-8 py-4 sm:py-4.5 rounded-md sm:rounded-lg border border-slate-200/90 hover:border-[#0C487A]/35 bg-white hover:bg-slate-50/90 text-[#0B2553] hover:text-[#0C487A] text-base font-bold shadow-[0_4px_16px_-2px_rgba(11,37,83,0.06)] hover:shadow-[0_8px_24px_-4px_rgba(11,37,83,0.10)] whitespace-nowrap group transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 ease-out cursor-pointer"
          >
            <svg class="w-4 h-4 text-[#FF3130] transition-transform duration-200 group-hover:scale-110 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span class="btn-text-content">Capability Statement (PDF)</span>
          </a>
        </div>

      </div>

      <!-- RIGHT COLUMN: 3D Compass Illustration with Sequenced Entrance & Gentle Float -->
      <div class="lg:col-span-6 relative flex justify-center lg:justify-end items-center z-10 hero-artwork-reveal">
        <div class="relative w-full max-w-md sm:max-w-lg lg:max-w-[580px] xl:max-w-[650px] flex flex-col items-center justify-center lg:items-end">
          
          <!-- Subtle Radial Blue Glow directly behind compass illustration for gentle visual anchoring -->
          <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[520px] sm:w-[620px] lg:w-[680px] h-[520px] sm:h-[620px] lg:h-[680px] bg-[radial-gradient(circle,rgba(12,72,122,0.11)_0%,rgba(30,64,175,0.05)_42%,transparent_70%)] rounded-full blur-3xl pointer-events-none -z-10"
            aria-hidden="true"
          ></div>

          <!-- Central 3D Compass Illustration with Refined Gentle Float -->
          <img
            src="/images/Gemini_Generated_Image_go38z0go38z0go38.png"
            alt="Unity Compass 3D Federal Contracting Navigator, Capitol, and Mission Objectives"
            class="hero-floating-artwork w-full h-auto max-h-[540px] sm:max-h-[580px] lg:max-h-[620px] object-contain filter contrast-[1.02] select-none pointer-events-none"
            loading="eager"
            fetchpriority="high"
            width="1780"
            height="1400"
          />

          <!-- Realistic 3D Ground Contact Shadow Synchronized with Float -->
          <div class="hero-floating-shadow w-64 sm:w-80 lg:w-96 h-5 sm:h-7 -mt-4 sm:-mt-6 bg-[radial-gradient(ellipse_at_center,rgba(15,39,74,0.32)_0%,rgba(30,64,175,0.12)_38%,transparent_70%)] rounded-[100%] blur-[4px] pointer-events-none"></div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ========================================================================= */
  /* Hero Load Sequential Entrance Animations (Badge -> Headline -> Subtitle -> Buttons -> Art) */
  /* ========================================================================= */
  .hero-badge-reveal {
    animation: heroBadgeEntrance 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both;
    will-change: opacity, transform, filter;
  }

  .hero-heading-reveal {
    animation: heroHeadingEntrance 0.95s cubic-bezier(0.16, 1, 0.3, 1) 0.18s both;
    will-change: opacity, transform, filter;
  }

  .hero-subheading-reveal {
    animation: heroSubheadingEntrance 0.90s cubic-bezier(0.16, 1, 0.3, 1) 0.38s both;
    will-change: opacity, transform, filter;
  }

  .hero-cta-btn-1 {
    animation: heroButtonEntrance 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.58s both;
    will-change: opacity, transform, filter;
  }

  .hero-cta-btn-2 {
    animation: heroButtonEntrance 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.74s both;
    will-change: opacity, transform, filter;
  }

  .hero-artwork-reveal {
    animation: heroArtworkEntrance 1.15s cubic-bezier(0.16, 1, 0.3, 1) 0.90s both;
    will-change: opacity, transform, filter;
  }

  @keyframes heroBadgeEntrance {
    0% {
      opacity: 0;
      transform: translateY(-14px) scale(0.96);
      filter: blur(5px);
    }
    100% {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  @keyframes heroHeadingEntrance {
    0% {
      opacity: 0;
      transform: translateY(22px);
      filter: blur(6px);
    }
    100% {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  @keyframes heroSubheadingEntrance {
    0% {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(4px);
    }
    100% {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  @keyframes heroButtonEntrance {
    0% {
      opacity: 0;
      transform: translateY(18px) scale(0.95);
      filter: blur(4px);
    }
    100% {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  @keyframes heroArtworkEntrance {
    0% {
      opacity: 0;
      transform: translateY(28px) scale(0.94);
      filter: blur(8px);
    }
    100% {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
  /* ========================================================================= */
  /* Continuous Soft Animated Gradient Headline Flow (Logo Red & Blue)         */
  /* ========================================================================= */
  .hero-shimmer-title-line {
    display: block;
    background-image: linear-gradient(
      90deg,
      #0B2553 0%,
      #0C487A 14%,
      #1E40AF 26%,
      #2563EB 36%,
      #DC2626 46%,
      #FF3130 52%,
      #FF4D4D 58%,
      #DC2626 68%,
      #2563EB 78%,
      #1E40AF 86%,
      #0C487A 93%,
      #0B2553 100%
    );
    background-size: 200% 100%;
    background-repeat: repeat;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    width: fit-content;
    max-width: 100%;
    padding-top: 0.04em;
    padding-bottom: 0.08em;
    animation: heroHeadingShimmer 6.5s linear infinite;
  }

  .hero-shimmer-title-line-1 {
    animation-delay: 0s;
  }

  .hero-shimmer-title-line-2 {
    animation-delay: -0.4s;
  }

  .hero-shimmer-title-line-3 {
    animation-delay: -0.8s;
  }

  @keyframes heroHeadingShimmer {
    0% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 200% 50%;
    }
  }

  /* ========================================================================= */
  /* Interactive Button Hover & Click Text Animation                           */
  /* ========================================================================= */
  .btn-text-content {
    display: inline-block;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), letter-spacing 0.25s ease;
    will-change: transform, filter, background-position;
  }

  /* --- Hover Text Animation for Book a Strategy Call --- */
  #hero-btn-book:hover .btn-text-content {
    letter-spacing: 0.015em;
  }

  /* --- Hover Text Animation for Capability Statement (PDF) --- */
  #hero-btn-capability:hover .btn-text-content {
    background: linear-gradient(
      90deg,
      #0B2553 0%,
      #FF3130 30%,
      #1E40AF 62%,
      #0B2553 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: btnTextHoverShimmer 1.3s linear infinite, btnTextHoverLift 1.6s ease-in-out infinite;
    letter-spacing: 0.015em;
  }

  @keyframes btnTextHoverShimmer {
    0% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 200% 50%;
    }
  }

  @keyframes btnTextHoverLift {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-1.5px);
    }
  }

  /* Click tactile pulse */
  .btn-text-content.is-clicked {
    animation: btnTextClickPulse 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  @keyframes btnTextClickPulse {
    0% {
      transform: scale(1);
    }
    25% {
      transform: scale(0.92) translateY(1px);
    }
    55% {
      transform: scale(1.08) translateY(-1px);
      filter: brightness(1.2);
    }
    80% {
      transform: scale(0.98);
    }
    100% {
      transform: scale(1);
      filter: brightness(1);
    }
  }

  /* ========================================================================= */
  /* Refined Gentle Floating Levitation (Smooth ~4.8s period, -8px amplitude)  */
  /* ========================================================================= */
  @keyframes heroArtFloat {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-8px) rotate(0.4deg);
    }
  }

  @keyframes heroShadowBreathe {
    0%, 100% {
      transform: scale(1);
      opacity: 0.8;
    }
    50% {
      transform: scale(0.92);
      opacity: 0.6;
    }
  }

  .hero-floating-artwork {
    animation: heroArtFloat 4.8s ease-in-out infinite !important;
    will-change: transform;
  }

  .hero-floating-shadow {
    animation: heroShadowBreathe 4.8s ease-in-out infinite !important;
    will-change: transform, opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-shimmer-title-line {
      animation: none !important;
      background: none !important;
      -webkit-text-fill-color: #0B2553 !important;
      color: #0B2553 !important;
    }
    .hero-floating-artwork,
    .hero-floating-shadow,
    .btn-text-content {
      animation: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  function setupHeroTitleGradientAnimation() {
    // Respect reduced motion accessibility
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const lines = document.querySelectorAll<HTMLElement>('.hero-shimmer-title-line');
    if (!lines.length) return;

    let startTime: number | null = null;
    const duration = 6500; // 6.5s soft continuous cycle

    function step(timestamp: number) {
      if (!startTime) startTime = timestamp;
      const progress = (timestamp - startTime) % duration;
      const basePct = (progress / duration) * 200; // 0% to 200%

      lines.forEach((line, index) => {
        const offset = index * 12; // subtle harmonious diagonal cascade
        const pos = (basePct + offset) % 200;
        line.style.setProperty('background-position', `${pos}% 50%`, 'important');
      });

      requestAnimationFrame(step);
    }

    requestAnimationFrame(step);
  }

  function setupHeroButtonEffects() {
    const bookBtn = document.getElementById('hero-btn-book');
    const capabilityBtn = document.getElementById('hero-btn-capability');

    [bookBtn, capabilityBtn].forEach((btn) => {
      if (!btn) return;
      const span = btn.querySelector<HTMLElement>('.btn-text-content');
      if (!span) return;

      const triggerClickFx = () => {
        span.classList.remove('is-clicked');
        void span.offsetWidth; // Force layout reflow
        span.classList.add('is-clicked');

        setTimeout(() => {
          span.classList.remove('is-clicked');
        }, 650);
      };

      btn.addEventListener('click', triggerClickFx);
      btn.addEventListener('mousedown', triggerClickFx);
    });
  }

  function initHero() {
    setupHeroButtonEffects();
    setupHeroTitleGradientAnimation();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
  document.addEventListener('astro:page-load', initHero);
</script>
