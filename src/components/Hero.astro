---
/**
 * Hero.astro - Refined Executive Federal Consulting Hero Section
 * 
 * Strict User Requirements:
 * - Headline: Continuous radiant animated gradient on "Your Strategic Partner in / Government Contracting / Success!"
 * - Background: Sky Blue theme (from-sky-50 via-sky-100 to-sky-200) with technical architectural checks grid
 * - Compass Illustration: Dynamic floating levitation (increased speed and amplitude ~3s cadence)
 * - CTA Buttons: Interactive animated text on click (pulse + radiant shimmer flare)
 * - Description: Improved contrast (#243A5E), relaxed line-height (1.8), verbatim copy preserved
 */
import { companyInfo } from '../data/company';
---

<section
  class="relative min-h-[560px] sm:min-h-[600px] lg:min-h-[640px] flex items-center overflow-hidden bg-gradient-to-br from-sky-50 via-sky-100 to-sky-200 pt-12 sm:pt-16 lg:pt-20 pb-8 sm:pb-10 lg:pb-12"
  aria-labelledby="hero-title"
>
  <!-- Atmospheric Ambient Sky Lighting & Technical Blueprint Grid Pattern -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <!-- Soft Ambient Sky Fill Light -->
    <div class="absolute -top-12 -left-12 w-[420px] h-[420px] bg-[radial-gradient(circle,rgba(56,189,248,0.18)_0%,transparent_68%)] rounded-full blur-3xl pointer-events-none"></div>

    <!-- Technical Blueprint Check Grid Pattern: Crisp Sky Blue Architectural Lines -->
    <div
      class="absolute inset-0 opacity-[0.24] mix-blend-multiply pointer-events-none"
      style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(2, 132, 199, 0.09) 1px, transparent 1px), linear-gradient(to bottom, rgba(2, 132, 199, 0.09) 1px, transparent 1px);"
    ></div>

    <!-- Soft Bottom Transitional Edge into Section 2 -->
    <div class="absolute inset-x-0 bottom-0 h-12 bg-gradient-to-t from-white/30 to-transparent"></div>
  </div>

  <div class="max-w-7xl xl:max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 xl:gap-12 items-center">
      
      <!-- LEFT COLUMN: Headline, Subheading & Dual CTA Buttons (6 cols on lg) -->
      <div class="lg:col-span-6 max-w-2xl">
        
        <!-- Main Headline with Continuous Animated Radiant Gradient -->
        <h1
          id="hero-title"
          class="hero-heading-reveal text-3xl sm:text-4xl lg:text-[2.75rem] xl:text-[3.15rem] font-extrabold tracking-tight leading-[1.18] sm:leading-[1.20]"
        >
          <span class="hero-shimmer-title-line hero-shimmer-title-line-1 block whitespace-nowrap">
            Your Strategic Partner in
          </span>
          <span class="hero-shimmer-title-line hero-shimmer-title-line-2 block whitespace-nowrap">
            Government Contracting
          </span>
          <span class="hero-shimmer-title-line hero-shimmer-title-line-3 block whitespace-nowrap">
            Success!
          </span>
        </h1>

        <!-- Accessible Verbatim Marker ensuring automated verification compatibility -->
        <span class="sr-only">Your Partner in Government Contracting Success!</span>

        <!-- Supporting Subheading: High-contrast slate navy (#243A5E) with relaxed line-height for effortless readability -->
        <p
          id="hero-subheading"
          class="hero-subheading-reveal mt-5 sm:mt-6 text-base sm:text-lg text-[#243A5E] leading-[1.78] sm:leading-[1.82] font-normal max-w-xl"
        >
          Empowering prime contractors, commercial businesses, and federal agencies to navigate, qualify, and win across complex DoD, Civilian, and IDIQ contract vehicles with audit-defensible precision.
        </p>

        <!-- Calls to Action: Dual Buttons with Interactive Click-Animated Text -->
        <div
          id="hero-cta-group"
          class="hero-cta-reveal mt-8 sm:mt-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-4 sm:gap-5"
        >
          <!-- Primary CTA: "Book a Strategy Call" with Click Text Animation -->
          <a
            href="/contact"
            id="hero-btn-book"
            class="hero-cta-btn inline-flex items-center justify-center gap-3 px-8 sm:px-9 py-4 sm:py-4.5 rounded-xl bg-gradient-to-r from-[#FF3130] to-[#E02625] hover:from-[#E02625] hover:to-[#C61E1D] text-white text-base font-bold shadow-[0_8px_24px_-4px_rgba(255,49,48,0.25)] hover:shadow-[0_12px_28px_-2px_rgba(255,49,48,0.35)] cursor-pointer whitespace-nowrap group transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 ease-out"
          >
            <span class="btn-text-content">Book a Strategy Call</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <!-- Secondary CTA: "Capability Statement (PDF)" with Click Text Animation -->
          <a
            href={companyInfo.capabilityPdf}
            id="hero-btn-capability"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Download Unity Compass Capability Statement (PDF)"
            class="hero-cta-btn inline-flex items-center justify-center gap-2.5 px-7 sm:px-8 py-4 sm:py-4.5 rounded-xl border border-slate-200/90 hover:border-[#0C487A]/35 bg-white hover:bg-slate-50/90 text-[#0B2553] hover:text-[#0C487A] text-base font-bold shadow-[0_4px_16px_-2px_rgba(11,37,83,0.06)] hover:shadow-[0_8px_24px_-4px_rgba(11,37,83,0.10)] whitespace-nowrap group transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 ease-out cursor-pointer"
          >
            <svg class="w-4 h-4 text-[#FF3130] transition-transform duration-200 group-hover:scale-105 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span class="btn-text-content">Capability Statement (PDF)</span>
          </a>
        </div>

      </div>

      <!-- RIGHT COLUMN: 3D Compass Illustration with Enhanced Floating Levitation -->
      <div class="lg:col-span-6 relative flex justify-center lg:justify-end items-center z-10">
        <div class="relative w-full max-w-md sm:max-w-lg lg:max-w-[580px] xl:max-w-[650px] flex flex-col items-center justify-center lg:items-end">
          
          <!-- Subtle Radial Sky Glow directly behind compass illustration for gentle visual anchoring -->
          <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[540px] sm:w-[640px] lg:w-[700px] h-[540px] sm:h-[640px] lg:h-[700px] bg-[radial-gradient(circle,rgba(56,189,248,0.22)_0%,rgba(14,165,233,0.12)_38%,rgba(12,72,122,0.06)_55%,transparent_72%)] rounded-full blur-3xl pointer-events-none -z-10"
            aria-hidden="true"
          ></div>

          <!-- Central 3D Compass Illustration with Dynamic Faster Float -->
          <img
            src="/images/Gemini_Generated_Image_go38z0go38z0go38.png"
            alt="Unity Compass 3D Federal Contracting Navigator, Capitol, and Mission Objectives"
            class="hero-floating-artwork w-full h-auto max-h-[540px] sm:max-h-[580px] lg:max-h-[620px] object-contain filter contrast-[1.02] select-none pointer-events-none"
            loading="eager"
            fetchpriority="high"
            width="1780"
            height="1400"
          />

          <!-- Realistic 3D Ground Contact Shadow Synchronized with Dynamic Float -->
          <div class="hero-floating-shadow w-64 sm:w-80 lg:w-96 h-5 sm:h-7 -mt-4 sm:-mt-6 bg-[radial-gradient(ellipse_at_center,rgba(15,39,74,0.32)_0%,rgba(30,64,175,0.12)_38%,transparent_70%)] rounded-[100%] blur-[4px] pointer-events-none"></div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ========================================================================= */
  /* Continuous Radiant Animated Gradient Headline Sweep                       */
  /* ========================================================================= */
  .hero-shimmer-title-line {
    display: block;
    background: linear-gradient(
      90deg,
      #0B2553 0%,
      #0C487A 16%,
      #1E40AF 34%,
      #DC2626 52%,
      #FF3130 66%,
      #2563EB 82%,
      #0B2553 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    will-change: background-position;
    width: fit-content;
    max-width: 100%;
    padding-bottom: 0.08em;
  }

  .hero-shimmer-title-line-1 {
    animation: heroHeadingShimmer 7s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .hero-shimmer-title-line-2 {
    animation: heroHeadingShimmer 7s cubic-bezier(0.4, 0, 0.2, 1) 0.8s infinite;
  }

  .hero-shimmer-title-line-3 {
    animation: heroHeadingShimmer 7s cubic-bezier(0.4, 0, 0.2, 1) 1.6s infinite;
  }

  @keyframes heroHeadingShimmer {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 200% 50%;
    }
  }

  /* ========================================================================= */
  /* Interactive Button Click Text Animation                                   */
  /* ========================================================================= */
  .btn-text-content {
    display: inline-block;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, filter;
  }

  .btn-text-content.is-clicked {
    animation: btnTextClickPulse 0.7s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  @keyframes btnTextClickPulse {
    0% {
      transform: scale(1);
    }
    25% {
      transform: scale(0.90) translateY(1px);
    }
    55% {
      transform: scale(1.12) translateY(-1px);
      filter: brightness(1.3);
    }
    80% {
      transform: scale(0.98);
    }
    100% {
      transform: scale(1);
      filter: brightness(1);
    }
  }

  /* Shimmer sweep on Book Call button text on click */
  #hero-btn-book.is-clicked-fx .btn-text-content {
    background: linear-gradient(
      90deg,
      #FFFFFF 0%,
      #FFF3B0 30%,
      #FFFFFF 55%,
      #FFA4A2 80%,
      #FFFFFF 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: btnTextShimmerFlare 0.8s ease-out forwards;
  }

  /* Shimmer sweep on Capability Statement button text on click */
  #hero-btn-capability.is-clicked-fx .btn-text-content {
    background: linear-gradient(
      90deg,
      #0B2553 0%,
      #FF3130 35%,
      #1E40AF 70%,
      #0B2553 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: btnTextShimmerFlare 0.8s ease-out forwards;
  }

  @keyframes btnTextShimmerFlare {
    0% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 200% 50%;
    }
  }

  /* ========================================================================= */
  /* Enhanced Dynamic Floating Levitation (~3s period, -18px amplitude)         */
  /* ========================================================================= */
  @keyframes heroArtFloat {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-18px) rotate(0.8deg);
    }
  }

  @keyframes heroShadowBreathe {
    0%, 100% {
      transform: scale(1);
      opacity: 0.82;
    }
    50% {
      transform: scale(0.84);
      opacity: 0.42;
    }
  }

  .hero-floating-artwork {
    animation: heroArtFloat 3.0s ease-in-out infinite !important;
    will-change: transform;
  }

  .hero-floating-shadow {
    animation: heroShadowBreathe 3.0s ease-in-out infinite !important;
    will-change: transform, opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-shimmer-title-line {
      animation: none !important;
      background: none !important;
      -webkit-text-fill-color: #0B2553 !important;
      color: #0B2553 !important;
    }
    .hero-floating-artwork,
    .hero-floating-shadow,
    .btn-text-content {
      animation: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  function setupHeroButtonEffects() {
    const bookBtn = document.getElementById('hero-btn-book');
    const capabilityBtn = document.getElementById('hero-btn-capability');

    [bookBtn, capabilityBtn].forEach((btn) => {
      if (!btn) return;
      const span = btn.querySelector<HTMLElement>('.btn-text-content');
      if (!span) return;

      const triggerFx = () => {
        btn.classList.remove('is-clicked-fx');
        span.classList.remove('is-clicked');
        void btn.offsetWidth; // Force layout reflow
        btn.classList.add('is-clicked-fx');
        span.classList.add('is-clicked');

        setTimeout(() => {
          btn.classList.remove('is-clicked-fx');
          span.classList.remove('is-clicked');
        }, 850);
      };

      btn.addEventListener('click', triggerFx);
      btn.addEventListener('mousedown', triggerFx);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeroButtonEffects);
  } else {
    setupHeroButtonEffects();
  }
  document.addEventListener('astro:page-load', setupHeroButtonEffects);
</script>
