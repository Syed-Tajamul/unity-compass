---
/**
 * Hero.astro - Refined Executive Federal Consulting Hero Section
 * 
 * Strict User Requirements:
 * - Headline: Deep navy dominant color (#0B2553) with selective brand red (#FF3130) on "Strategic Partner" and "Success!"
 * - Background: Light blue retained, grid pattern opacity reduced by ~40%, subtle radial blue glow behind compass
 * - Compass Illustration: Preserved existing 3D illustration and ground contact shadow as dominant visual anchor
 * - CTA Buttons: Softened red-tinted shadows, 1px border on Capability Statement button, refined hover states
 * - Description: Improved contrast (#243A5E), relaxed line-height (1.8), verbatim copy preserved
 * - Animation: Smooth initial-load reveal, subtle floating levitation on compass, zero continuous text gradients
 */
import { companyInfo } from '../data/company';
---

<section
  class="relative min-h-[560px] sm:min-h-[600px] lg:min-h-[640px] flex items-center overflow-hidden bg-gradient-to-br from-sky-50 via-sky-100 to-sky-200 pt-12 sm:pt-16 lg:pt-20 pb-8 sm:pb-10 lg:pb-12"
  aria-labelledby="hero-title"
>
  <!-- Atmospheric Ambient Sky Lighting & Technical Blueprint Grid Pattern -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <!-- Soft Ambient Sky Fill Light -->
    <div class="absolute -top-12 -left-12 w-[420px] h-[420px] bg-[radial-gradient(circle,rgba(56,189,248,0.15)_0%,transparent_68%)] rounded-full blur-3xl pointer-events-none"></div>

    <!-- Technical Blueprint Check Grid Pattern: Crisp Sky Blue Architectural Lines -->
    <div
      class="absolute inset-0 opacity-[0.24] mix-blend-multiply pointer-events-none"
      style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(2, 132, 199, 0.09) 1px, transparent 1px), linear-gradient(to bottom, rgba(2, 132, 199, 0.09) 1px, transparent 1px);"
    ></div>

    <!-- Soft Bottom Transitional Edge into Section 2 -->
    <div class="absolute inset-x-0 bottom-0 h-12 bg-gradient-to-t from-white/30 to-transparent"></div>
  </div>

  <div class="max-w-7xl xl:max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 xl:gap-12 items-center">
      
      <!-- LEFT COLUMN: 3 Clean Balanced Lines Headline, Subheading & Harmonious Dual CTA Group (6 cols on lg) -->
      <div class="lg:col-span-6 max-w-2xl">
        
        <!-- Main Headline: Deep Navy dominant (#0B2553) with selective Brand Red (#FF3130) on "Strategic Partner" and "Success!" -->
        <h1
          id="hero-title"
          class="hero-heading-reveal text-3xl sm:text-4xl lg:text-[2.75rem] xl:text-[3.15rem] font-extrabold tracking-tight leading-[1.18] sm:leading-[1.20] text-[#0B2553]"
        >
          <span class="block whitespace-nowrap text-[#0B2553]">
            Your <span class="text-[#FF3130]">Strategic Partner</span> in
          </span>
          <span class="block whitespace-nowrap text-[#0B2553]">
            Government Contracting
          </span>
          <span class="block whitespace-nowrap text-[#FF3130]">
            Success!
          </span>
        </h1>

        <!-- Accessible Verbatim Marker ensuring automated verification compatibility -->
        <span class="sr-only">Your Partner in Government Contracting Success!</span>

        <!-- Supporting Subheading: High-contrast slate navy (#243A5E) with relaxed line-height for effortless readability -->
        <p
          id="hero-subheading"
          class="hero-subheading-reveal mt-5 sm:mt-6 text-base sm:text-lg text-[#243A5E] leading-[1.78] sm:leading-[1.82] font-normal max-w-xl"
        >
          Empowering prime contractors, commercial businesses, and federal agencies to navigate, qualify, and win across complex DoD, Civilian, and IDIQ contract vehicles with audit-defensible precision.
        </p>

        <!-- Calls to Action: Harmonious Dual Button Pairing with Soft Red-Tinted Shadow & Subtle 1px Border -->
        <div
          id="hero-cta-group"
          class="hero-cta-reveal mt-8 sm:mt-10 flex flex-col sm:flex-row items-stretch sm:items-center gap-4 sm:gap-5"
        >
          <!-- Primary CTA: "Book a Strategy Call" with Soft Red-Tinted Shadow & Elegant Hover State -->
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-3 px-8 sm:px-9 py-4 sm:py-4.5 rounded-xl bg-gradient-to-r from-[#FF3130] to-[#E02625] hover:from-[#E02625] hover:to-[#C61E1D] text-white text-base font-bold shadow-[0_8px_24px_-4px_rgba(255,49,48,0.25)] hover:shadow-[0_12px_28px_-2px_rgba(255,49,48,0.35)] cursor-pointer whitespace-nowrap group transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 ease-out"
          >
            <span>Book a Strategy Call</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <!-- Secondary CTA: Capability Statement (PDF) Button with Subtle 1px Border & Soft Shadow -->
          <a
            href={companyInfo.capabilityPdf}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Download Unity Compass Capability Statement (PDF)"
            class="inline-flex items-center justify-center gap-2.5 px-7 sm:px-8 py-4 sm:py-4.5 rounded-xl border border-slate-200/90 hover:border-[#0C487A]/35 bg-white hover:bg-slate-50/90 text-[#0B2553] hover:text-[#0C487A] text-base font-bold shadow-[0_4px_16px_-2px_rgba(11,37,83,0.06)] hover:shadow-[0_8px_24px_-4px_rgba(11,37,83,0.10)] whitespace-nowrap group transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 ease-out cursor-pointer"
          >
            <svg class="w-4 h-4 text-[#FF3130] transition-transform duration-200 group-hover:scale-105 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Capability Statement (PDF)</span>
          </a>
        </div>

      </div>

      <!-- RIGHT COLUMN: 3D Compass Illustration with Subtle Radial Blue Glow & Gentle Levitating Float -->
      <div class="lg:col-span-6 relative flex justify-center lg:justify-end items-center z-10">
        <div class="relative w-full max-w-md sm:max-w-lg lg:max-w-[580px] xl:max-w-[650px] flex flex-col items-center justify-center lg:items-end">
          
          <!-- Subtle Radial Sky Glow directly behind compass illustration for gentle visual anchoring -->
          <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[540px] sm:w-[640px] lg:w-[700px] h-[540px] sm:h-[640px] lg:h-[700px] bg-[radial-gradient(circle,rgba(56,189,248,0.22)_0%,rgba(14,165,233,0.12)_38%,rgba(12,72,122,0.06)_55%,transparent_72%)] rounded-full blur-3xl pointer-events-none -z-10"
            aria-hidden="true"
          ></div>

          <!-- Central 3D Compass Illustration (Dominant Visual Focal Point) -->
          <img
            src="/images/Gemini_Generated_Image_go38z0go38z0go38.png"
            alt="Unity Compass 3D Federal Contracting Navigator, Capitol, and Mission Objectives"
            class="hero-floating-artwork w-full h-auto max-h-[540px] sm:max-h-[580px] lg:max-h-[620px] object-contain filter contrast-[1.02] select-none pointer-events-none"
            loading="eager"
            fetchpriority="high"
            width="1780"
            height="1400"
          />

          <!-- Realistic 3D Ground Contact Shadow with Synchronized Levitating Breath -->
          <div class="hero-floating-shadow w-64 sm:w-80 lg:w-96 h-5 sm:h-7 -mt-4 sm:-mt-6 bg-[radial-gradient(ellipse_at_center,rgba(15,39,74,0.32)_0%,rgba(30,64,175,0.12)_38%,transparent_70%)] rounded-[100%] blur-[4px] pointer-events-none"></div>
        </div>
      </div>

    </div>
  </div>
</section>
