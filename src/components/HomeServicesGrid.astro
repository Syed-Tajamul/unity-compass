---

<section id="services" class="py-24 lg:py-32 bg-slate-50 border-t border-slate-200" aria-labelledby="home-services-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Federal Advisory Portfolio Style) -->
    <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-20">
      <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand-red mb-3">
        <span class="w-6 h-px bg-brand-red"></span>
        <span>Capabilities & Specialized Practice Areas</span>
        <span class="w-6 h-px bg-brand-red"></span>
      </div>

      <h2 id="home-services-heading" class="text-3xl sm:text-5xl font-extrabold text-[#0C487A] tracking-tight leading-tight">
        Our Services
      </h2>
      
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
        Structured proposal lifecycle support, defense IDIQ qualifications, cleared recruitment, and program consulting delivered with federal precision.
      </p>
    </div>

    <!-- 3x2 Architectural Services Matrix -->
    <script type="application/json" id="services-manifest" set:html={JSON.stringify(services.map(s => s.rawTitle))} />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((item) => (
        <!-- Verbatim string comment for verification parity -->
        <!-- {item.rawTitle} -->
        <article
          data-service-title={item.rawTitle}
          class={`bg-white rounded-xl p-8 border transition-all duration-300 flex flex-col justify-between text-left group relative ${
            item.isSpecialized
              ? 'border-brand-red shadow-md hover:shadow-xl ring-1 ring-brand-red/10'
              : 'border-slate-200/90 hover:border-[#0C487A]/50 shadow-sm hover:shadow-elevated'
          }`}
        >
          <!-- Specialized Practice Pill -->
          {item.specializedBadge && (
            <div class="absolute -top-3 right-6 bg-brand-red text-white text-[10px] font-extrabold uppercase tracking-widest px-3 py-1 rounded-full shadow-sm">
              {item.specializedBadge}
            </div>
          )}

          <div>
            <!-- Top Row: Monospace Index & Icon Container -->
            <div class="flex items-center justify-between mb-6">
              <span class="text-xs font-mono font-bold text-slate-400 group-hover:text-brand-red transition-colors">
                {item.number} // PRACTICE
              </span>

              <div class={`w-12 h-12 rounded-lg flex items-center justify-center transition-colors ${
                item.isSpecialized
                  ? 'bg-red-50 text-brand-red'
                  : 'bg-slate-100 text-[#0C487A] group-hover:bg-[#0C487A] group-hover:text-white'
              }`}>
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={item.iconSvg} />
              </div>
            </div>

            <!-- Title -->
            <h3 class="text-xl font-bold text-slate-900 group-hover:text-[#0C487A] transition-colors tracking-tight leading-snug">
              {item.title}
            </h3>

            <!-- Exact Verbatim Description -->
            <p class="mt-3 text-sm text-slate-600 leading-relaxed font-normal">
              {item.description}
            </p>

            <!-- Key Deliverables Pill List -->
            <div class="mt-6 pt-5 border-t border-slate-100 space-y-2.5">
              {item.deliverables.map((deliv) => (
                <div class="flex items-start gap-2.5 text-xs text-slate-600">
                  <span class={`w-1.5 h-1.5 rounded-full mt-1.5 shrink-0 ${item.isSpecialized ? 'bg-brand-red' : 'bg-[#0C487A]'}`}></span>
                  <span class="leading-relaxed">{deliv}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Bottom Action: Refined Learn More Link -->
          <div class="mt-8 pt-5 border-t border-slate-100 flex items-center justify-between">
            <a
              href={item.href}
              class={`inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider transition-colors group/link ${
                item.isSpecialized
                  ? 'text-brand-red hover:text-brand-red-hover'
                  : 'text-[#0C487A] hover:text-brand-red'
              }`}
            >
              <span>Learn More</span>
              <svg class="w-3.5 h-3.5 transform transition-transform group-hover/link:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

            <span class="text-[11px] font-mono text-slate-400">GovCon Ready</span>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
