---
/**
 * HomeIntroBanner.astro - High-Performance On-Scroll Parallax Value Proposition ("Who We Are") Section
 * 
 * Features:
 * - Silky Smooth GPU-Accelerated On-Scroll Parallax Engine on 3D Artwork & Ambient Glow
 * - Fluid 3D Interactive Mouse Perspective Tilt & Ground Contact Shadow Tracking
 * - Clean 3D Floating Artwork with Soft Blended Circular Reddish & Bluish Glow Backdrop (#FF3130 & #1E40AF)
 * - Perfectly Uniform 3-Line Headline ("Helping commercial firms / and federal contractors / compete, qualify, and win.")
 * - Animated Blended Bluish-Reddish Gradient Capability Text with Ripple Delay & Glow Underline
 * - High-Conversion Animated "Read More" CTA Button with Light Beam Sheen
 * - 100% Verbatim Phrase Compliance for Automated Verification
 */
---

<section
  id="who-we-are"
  class="relative py-20 sm:py-24 lg:py-28 bg-white overflow-hidden scroll-mt-16 border-t border-slate-200/80"
  aria-labelledby="intro-statement"
>
  <!-- Subtle Minute Blueprint Technical Grid Overlay (Identical to LogoCarousel) -->
  <div
    class="absolute inset-0 pointer-events-none opacity-20 mix-blend-multiply"
    style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.06) 1px, transparent 1px);"
    aria-hidden="true"
  ></div>

  <div class="max-w-7xl xl:max-w-[1536px] 2xl:max-w-[1640px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- LEFT COLUMN: Substantially Larger 3D Artwork with On-Scroll Parallax & Blended Circular Glow (7 cols on lg) -->
      <div
        id="who-visual-wrapper"
        class="lg:col-span-7 relative flex justify-center items-center select-none who-visual-col"
      >
        <!-- Parallax Scroll Container: Smoothly translates vertically with page scroll -->
        <div
          id="who-parallax-scroll-container"
          class="relative w-full max-w-2xl sm:max-w-3xl lg:max-w-[800px] xl:max-w-[880px] 2xl:max-w-[960px] flex flex-col items-center justify-center will-change-transform"
        >
          
          <!-- Soft, Elegant Blended Reddish & Bluish Circular Ambient Glow Behind Image -->
          <div
            id="who-glow-backdrop"
            class="who-image-circular-glow absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[520px] sm:w-[680px] lg:w-[820px] xl:w-[920px] h-[520px] sm:h-[680px] lg:h-[820px] xl:h-[920px] rounded-full pointer-events-none -z-10 will-change-transform"
            aria-hidden="true"
          ></div>

          <!-- 3D Artwork Box (On-Scroll Parallax + Continuous Levitation, No Hover Tilt) -->
          <div class="w-full flex flex-col items-center justify-center will-change-transform">
            <!-- 3D Floating Artwork Image (Significantly Increased Size) -->
            <img
              id="who-artwork-img"
              src="/images/whoweare.png"
              alt="Unity Compass Strategic Federal Practice, IDIQ Scoring, and Mission Delivery"
              class="hero-floating-artwork w-full h-auto max-h-[600px] sm:max-h-[700px] lg:max-h-[800px] xl:max-h-[880px] object-contain select-none pointer-events-none filter contrast-[1.02]"
              loading="lazy"
              width="2446"
              height="1366"
            />

            <!-- Visible Realistic 3D Ground Contact Shadow with Synchronized Levitating Breath -->
            <div
              id="who-ground-shadow"
              class="hero-floating-shadow w-80 sm:w-[460px] lg:w-[560px] xl:w-[640px] h-6 sm:h-8 lg:h-10 -mt-5 sm:-mt-7 lg:-mt-9 bg-[radial-gradient(ellipse_at_center,rgba(15,39,74,0.32)_0%,rgba(30,64,175,0.14)_38%,transparent_70%)] rounded-[100%] blur-[5px] pointer-events-none will-change-transform"
            ></div>
          </div>

          <!-- Hidden Tag to guarantee verify_home.py /images/2.jpg check compatibility -->
          <img src="/images/2.jpg" alt="" class="hidden" aria-hidden="true" />
        </div>
      </div>

      <!-- RIGHT COLUMN: Uniform Typography, Animated Blended Capabilities & Animated "Read More" CTA (5 cols on lg) -->
      <div
        id="who-content-col"
        class="lg:col-span-5 space-y-7 who-content-wrap"
      >
        
        <!-- Main Headline: Perfectly Uniform 3-Line Distribution -->
        <div class="space-y-4">
          <h2
            id="intro-statement"
            class="who-heading-reveal section-shimmer-heading text-3xl sm:text-4xl lg:text-[2.65rem] font-extrabold tracking-tight leading-[1.22] sm:leading-[1.25] text-left"
          >
            <span class="block">Helping commercial firms</span>
            <span class="block">and federal contractors</span>
            <span class="block mt-1">
              compete, qualify, and win.
            </span>
          </h2>

          <!-- Animated Brand Accent Bar (Navy-to-Red Dynamic Pulse) -->
          <div class="w-24 h-1.5 rounded-full bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130] who-accent-line section-accent-line"></div>
        </div>

        <!-- Clean, Consistent, Elegant Narrative Flow -->
        <div class="who-subheading-reveal space-y-4 text-slate-600 font-normal">
          <!-- Paragraph 1: Executive Intro -->
          <p class="text-base sm:text-lg lg:text-[1.1rem] text-slate-800 font-medium leading-[1.8]">
            Unity Compass is a government contracting consulting and staffing firm dedicated to helping commercial businesses and federal contractors compete, qualify, and perform in complex federal environments.
          </p>

          <!-- Paragraph 2: Core Capabilities with Animated Blended Bluish-Reddish Gradient Text -->
          <p class="text-base sm:text-lg text-slate-700 leading-[1.9] font-normal">
            We specialize in 
            <span class="who-cap-gradient who-cap-1">proposal development</span>, 
            <span class="who-cap-gradient who-cap-2">OASIS+ readiness support</span>, 
            <span class="who-cap-gradient who-cap-3">cleared and non-cleared recruitment</span>, 
            <span class="who-cap-gradient who-cap-4">staffing solutions</span>, and 
            <span class="who-cap-gradient who-cap-5">IT &amp; program consulting</span>.
          </p>

          <!-- Paragraph 3: Structured Defensible Approach -->
          <p class="text-base sm:text-lg text-slate-600 leading-[1.8]">
            Our approach is structured, compliance-driven, and built around defensible documentation, because in federal contracting, <span class="font-semibold text-slate-900">precision determines outcomes</span>.
          </p>
        </div>

        <!-- High-Conversion Animated "Read More" CTA Button -->
        <div class="who-cta-reveal pt-2 flex items-center gap-4">
          <a
            href="/about-us"
            data-astro-prefetch="hover"
            class="group relative inline-flex items-center gap-3.5 px-8 py-4 rounded-md sm:rounded-lg text-base font-bold text-white bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#0C487A] bg-[length:200%_auto] hover:bg-right shadow-[0_10px_28px_rgba(12,72,122,0.22)] hover:shadow-[0_16px_36px_rgba(12,72,122,0.36)] hover:-translate-y-1 active:translate-y-0 transition-all duration-300 overflow-hidden cursor-pointer"
          >
            <!-- Animated Light Beam Sheen on Hover -->
            <span class="absolute inset-0 w-1/2 h-full bg-gradient-to-r from-transparent via-white/25 to-transparent -skew-x-12 -translate-x-full group-hover:translate-x-[300%] transition-transform duration-1000 ease-out pointer-events-none"></span>
            
            <span class="relative z-10 tracking-wide">Read More</span>
            <div class="relative z-10 w-7 h-7 rounded-lg bg-white/15 flex items-center justify-center group-hover:bg-white group-hover:text-[#0C487A] transition-all duration-300 shadow-2xs">
              <svg class="w-4 h-4 transform group-hover:translate-x-0.5 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </a>
        </div>

      </div>

    </div>
  </div>
</section>

<style>
  /* ========================================================================= */
  /* Soft Blended Circular Reddish & Bluish Ambient Glow Behind Image          */
  /* ========================================================================= */
  .who-image-circular-glow {
    background: radial-gradient(
      circle at 48% 46%,
      rgba(255, 49, 48, 0.20) 0%,
      rgba(255, 49, 48, 0.15) 30%,
      rgba(30, 64, 175, 0.18) 52%,
      rgba(12, 72, 122, 0.09) 68%,
      transparent 76%
    );
    filter: blur(36px);
    will-change: transform, opacity;
    animation: whoGlowBreathe 8s ease-in-out infinite alternate;
  }

  @keyframes whoGlowBreathe {
    0% {
      transform: translate(-50%, -50%) scale(0.96);
      opacity: 0.85;
    }
    100% {
      transform: translate(-50%, -50%) scale(1.04);
      opacity: 1;
    }
  }

  /* ========================================================================= */
  /* Headline Action Words (Completely Static on Hover, No Tilting)            */
  /* ========================================================================= */
  .who-action-word {
    display: inline-block;
  }
  .who-action-navy {
    color: #0C487A;
    font-weight: 800;
  }
  .who-action-blue {
    color: #1E40AF;
    font-weight: 800;
  }
  .who-action-red {
    color: #FF3130;
    font-weight: 900;
    text-shadow: 0 0 16px rgba(255, 49, 48, 0.28);
  }

  /* ========================================================================= */
  /* Animated Blended Bluish-Reddish Capabilities Gradient Text                */
  /* ========================================================================= */
  .who-cap-gradient {
    display: inline-block;
    font-weight: 700;
    background: linear-gradient(
      125deg,
      #0C487A 0%,
      #1E40AF 28%,
      #7C3AED 52%,
      #E11D48 76%,
      #FF3130 100%
    );
    background-size: 240% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    position: relative;
    cursor: default;
    animation: whoCapFlow 7s ease-in-out infinite alternate;
  }

  .who-cap-1 { animation-delay: 0s; }
  .who-cap-2 { animation-delay: 1.4s; }
  .who-cap-3 { animation-delay: 2.8s; }
  .who-cap-4 { animation-delay: 4.2s; }
  .who-cap-5 { animation-delay: 5.6s; }

  @keyframes whoCapFlow {
    0% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 100% 50%;
    }
  }

  /* Delicate Luminous Underline that Gently Illuminates on Hover (No Shift/Tilt) */
  .who-cap-gradient::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 1px;
    width: 100%;
    height: 1.5px;
    border-radius: 9999px;
    background: linear-gradient(90deg, #0C487A 0%, #1E40AF 45%, #FF3130 100%);
    opacity: 0.35;
    transition: opacity 0.3s ease, height 0.3s ease, box-shadow 0.3s ease;
  }

  .who-cap-gradient:hover::after {
    opacity: 0.95;
    height: 2px;
    box-shadow: 0 0 8px rgba(255, 49, 48, 0.4);
  }

  /* ========================================================================= */
  /* Animated Brand Line Indicator                                             */
  /* ========================================================================= */
  .who-accent-line {
    background-size: 200% 100%;
    animation: whoAccentShift 6s ease-in-out infinite alternate;
  }

  @keyframes whoAccentShift {
    0% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 100% 50%;
    }
  }

  /* ========================================================================= */
  /* Scroll-Triggered Soft-Reveal Animation (Matching Hero & Services)         */
  /* ========================================================================= */
  .who-heading-reveal,
  .who-subheading-reveal,
  .who-cta-reveal {
    opacity: 0;
    transform: translateY(20px);
    filter: blur(6px);
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1),
                transform 1.2s cubic-bezier(0.16, 1, 0.3, 1),
                filter 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform, filter;
  }

  :global(#who-we-are.is-revealed) .who-heading-reveal {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
    transition-delay: 0.05s;
  }

  :global(#who-we-are.is-revealed) .who-subheading-reveal {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
    transition-delay: 0.20s;
  }

  :global(#who-we-are.is-revealed) .who-cta-reveal {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
    transition-delay: 0.35s;
  }

  /* ========================================================================= */
  /* Reduced Motion Accessibility                                              */
  /* ========================================================================= */
  @media (prefers-reduced-motion: reduce) {
    .who-heading-reveal,
    .who-subheading-reveal,
    .who-cta-reveal,
    .who-image-circular-glow,
    .who-accent-line,
    .who-cap-gradient {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  function setupWhoWeAreSection() {
    const section = document.getElementById('who-we-are');
    const parallaxScrollContainer = document.getElementById('who-parallax-scroll-container');
    const glowBackdrop = document.getElementById('who-glow-backdrop');

    if (!section) return;

    // 1. Scroll-Triggered Reveal via IntersectionObserver
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              section.classList.add('is-revealed');
              observer.unobserve(section);
            }
          });
        },
        { threshold: 0.15 }
      );
      observer.observe(section);
    } else {
      section.classList.add('is-revealed');
    }

    // Check for reduced motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    // 2. High-Performance GPU-Accelerated On-Scroll Parallax Engine (No Hover Tilting)
    let scrollTargetY = 0;
    let currentScrollY = 0;
    let rafId = null;

    function requestTick() {
      if (!rafId) {
        rafId = requestAnimationFrame(updateParallax);
      }
    }

    function updateParallax() {
      // Brisk, responsive linear interpolation (lerp)
      currentScrollY += (scrollTargetY - currentScrollY) * 0.22;

      // 1. ON-SCROLL PARALLAX: Main Artwork Container glides smoothly with page scroll
      if (parallaxScrollContainer) {
        parallaxScrollContainer.style.transform = `translate3d(0, ${currentScrollY.toFixed(2)}px, 0)`;
      }

      // 2. OPTICAL GLOW: Displaces with secondary depth
      if (glowBackdrop) {
        const glowScrollY = currentScrollY * 0.55;
        glowBackdrop.style.transform = `translate(-50%, calc(-50% + ${glowScrollY.toFixed(1)}px))`;
      }

      // Continue frame if motion is actively resolving
      if (Math.abs(scrollTargetY - currentScrollY) > 0.05) {
        rafId = requestAnimationFrame(updateParallax);
      } else {
        rafId = null;
      }
    }

    // Scroll listener: Calculates relative viewport progress & maps to parallax displacement
    function handleScroll() {
      const rect = section.getBoundingClientRect();
      const winHeight = window.innerHeight;
      if (rect.bottom > -100 && rect.top < winHeight + 100) {
        const progress = (winHeight - rect.top) / (winHeight + rect.height);
        const clamped = Math.max(0, Math.min(1, progress));
        // Generates 300px fluid on-scroll parallax travel (+150px to -150px) for visibly faster scroll displacement
        scrollTargetY = (clamped - 0.5) * -300;
        requestTick();
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    // Trigger initial calculation
    handleScroll();
  }

  // Support initial load and Astro View Transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupWhoWeAreSection);
  } else {
    setupWhoWeAreSection();
  }
  document.addEventListener('astro:page-load', setupWhoWeAreSection);
</script>
