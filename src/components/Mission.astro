---
const principles = [
  {
    num: '01',
    code: 'COMPLIANCE',
    title: 'Compliance-Centered Approach',
    description: 'Every proposal, staffing action, and documentation package is built to withstand evaluation and audit scrutiny.',
    outcome: 'Eliminates Section L/M compliance risks before agency review.',
    iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
  },
  {
    num: '02',
    code: 'METHODOLOGY',
    title: 'Structured Methodology',
    description: 'From Qualifying Project (QP) structuring to clearance verification, our processes are systematic and repeatable.',
    outcome: 'Institutionalized workflows that produce reliable, audit-ready deliverables.',
    iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />`,
  },
  {
    num: '03',
    code: 'INTEGRATION',
    title: 'Integrated Support Model',
    description: 'We bridge proposal strategy, staffing execution, and technical advisory, reducing fragmentation common in federal projects.',
    outcome: 'Unifies capture strategy, workforce delivery, and program oversight.',
    iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />`,
  },
  {
    num: '04',
    code: 'PERFORMANCE',
    title: 'Performance-Focused Delivery',
    description: 'We align services to measurable outcomes such as submission readiness, staffing cycle reduction, and defensible past performance records.',
    outcome: 'Direct correlation with higher Pwin and accelerated onboarding cycles.',
    iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />`,
  },
];
---

<section id="our-mission" class="py-16 sm:py-20 lg:py-24 bg-[#07192C] text-white relative overflow-hidden border-t border-slate-800" aria-labelledby="mission-heading">
  <!-- Subtle technical grid background -->
  <div class="absolute inset-0 bg-fed-grid opacity-75 pointer-events-none"></div>

  <!-- Radial ambient glow -->
  <div class="absolute top-1/3 right-1/4 w-[500px] h-[500px] bg-[#0C487A]/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Central Editorial Mission Presentation (Visually Dominant) -->
    <div class="max-w-4xl mx-auto text-center mb-16 lg:mb-20 reveal-on-scroll">
      
      <!-- Institutional Eyebrow -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-semibold text-slate-300 tracking-wider uppercase mb-5">
        <span class="w-2 h-2 rounded-full bg-[#FF3130]"></span>
        <span>Strategic Federal Contracting Support</span>
      </div>

      <!-- Main Headline with 1st letter in Brand Red -->
      <h2 id="mission-heading" class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-tight">
        <span class="text-[#FF3130]">O</span>ur Mission
      </h2>

      <!-- Mission Statement (Commanding & Elegant) -->
      <p class="mt-6 text-lg sm:text-xl lg:text-2xl text-slate-200 font-normal leading-relaxed max-w-3xl mx-auto">
        To help organizations navigate federal contracting requirements with clarity, compliance, and confidence, while reducing risk and improving competitive positioning.
      </p>

      <div class="mt-6 flex items-center justify-center gap-3">
        <div class="h-px w-12 bg-slate-700"></div>
        <div class="w-2 h-2 rounded-full bg-[#FF3130]"></div>
        <div class="h-px w-12 bg-slate-700"></div>
      </div>
    </div>

    <!-- Structured 4-Principle Architecture (Interlocking Precision Matrix) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {principles.map((item, index) => (
        <div class={`relative group bg-[#0A2540]/80 backdrop-blur-sm rounded-2xl sm:rounded-3xl p-7 lg:p-8 border border-slate-700/70 hover:border-sky-500/50 hover:bg-[#0D2D4D] transition-all duration-300 shadow-lg flex flex-col justify-between reveal-on-scroll delay-${(index + 1) * 100}`}>
          
          <div>
            <!-- Header Row with Principle Number & Code Badge -->
            <div class="flex items-center justify-between pb-4 mb-5 border-b border-slate-700/60">
              <div class="flex items-center gap-2.5">
                <span class="text-xs font-mono font-bold tracking-wider text-[#FF3130]">
                  // {item.num}
                </span>
                <span class="text-[11px] font-mono uppercase tracking-widest text-slate-400">
                  {item.code}
                </span>
              </div>

              <div class="w-8 h-8 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-sky-400 group-hover:text-white group-hover:bg-sky-600 transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={item.iconSvg} />
              </div>
            </div>

            <!-- Title -->
            <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight group-hover:text-sky-300 transition-colors leading-snug">
              {item.title}
            </h3>

            <!-- Supporting Principle Description -->
            <p class="text-sm sm:text-base text-slate-300 mt-3.5 leading-relaxed font-normal">
              {item.description}
            </p>
          </div>

          <!-- Bottom Operational Metric Strip -->
          <div class="mt-6 pt-4 border-t border-slate-700/60 flex items-center justify-between text-xs">
            <span class="text-slate-400 font-mono text-[11px]">GovCon Impact:</span>
            <span class="text-sky-300 font-medium group-hover:text-white transition-colors">{item.outcome}</span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

