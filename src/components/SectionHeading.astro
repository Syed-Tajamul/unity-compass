---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'center',
  class: className = '',
} = Astro.props;

const isCenter = align === 'center';
---

<div class={`mb-12 md:mb-16 ${isCenter ? 'text-center mx-auto max-w-3xl' : 'max-w-2xl'} ${className}`}>
  {eyebrow && (
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-red-50 text-brand-red border border-red-100 mb-3">
      {eyebrow}
    </span>
  )}

  <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
    {title}
  </h2>

  {description && (
    <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
      {description}
    </p>
  )}
</div>

