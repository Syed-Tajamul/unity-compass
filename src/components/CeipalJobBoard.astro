---
/**
 * CeipalJobBoard.astro - Custom Executive Job Board for Unity Compass
 * 
 * Synchronized with Ceipal ATS API:
 * - 100% Unity Compass Navy (#0B2553, #0C487A) and Star-Red (#FF3130) Design Tokens
 * - Bespoke, elegant custom interactive filter dropdowns
 * - Dynamic Search by title, keyword, skill, or job code (e.g. JPC-77)
 * - Multi-column responsive card grid (2 or 3 cards per row)
 * - Staggered viewport entrance animation for job cards
 * - Executive Requisition Scope Modal with structured key stats
 * - Direct Apply Now CTAs routing to Ceipal's secure candidate portal
 */
import {
  initialCeipalJobs,
  availableStates,
  availableEmploymentTypes,
  type CeipalJob,
} from '../data/ceipalJobs';
import { companyInfo } from '../data/company';

// Top active state selections (prioritizing major GovCon corridors)
const priorityStates = ['Maryland', 'Virginia', 'District of Columbia'];
const otherStates = availableStates.filter((s) => !priorityStates.includes(s));
const sortedStates = ['All States', ...priorityStates, ...otherStates];
---

<div class="space-y-10" id="ceipal-custom-board">
  
  <!-- ========================================================================= -->
  <!-- SEARCH & BESPOKE CUSTOM FILTER BAR                                        -->
  <!-- ========================================================================= -->
  <div id="ceipal-filter-box" class="career-reveal bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 p-5 sm:p-7 shadow-[0_12px_36px_-8px_rgba(12,72,122,0.08)] relative z-30">
    <div class="absolute top-0 inset-x-0 h-1.5 rounded-t-2xl sm:rounded-t-3xl bg-gradient-to-r from-[#0B2553] via-[#FF3130] to-[#0B2553]"></div>

    <!-- Row 1: Keyword Search -->
    <div class="relative mb-5">
      <svg class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        type="text"
        id="ceipal-search-input"
        placeholder="Search positions by title, clearance, skill, or job code (e.g. 'Cloud', 'TS/SCI', 'JPC-77')..."
        class="w-full pl-12 pr-10 py-3.5 text-sm sm:text-base rounded-xl border border-slate-200 bg-slate-50/60 text-[#0B2553] focus:outline-none focus:ring-2 focus:ring-[#FF3130]/25 focus:border-[#FF3130] focus:bg-white transition-all placeholder:text-slate-400 font-medium"
      />
      <button
        type="button"
        id="ceipal-search-clear"
        class="hidden absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1 cursor-pointer"
        aria-label="Clear search"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Row 2: 2 Executive Interactive Dropdown Filters -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      
      <!-- Filter 1: State / Location -->
      <div class="custom-dropdown relative" data-filter="state">
        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1.5">
          Location / State
        </label>
        <button
          type="button"
          class="dropdown-trigger w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-200 bg-slate-50/70 hover:bg-white text-[#0B2553] font-semibold text-left flex items-center justify-between focus:outline-none focus:ring-2 focus:ring-[#FF3130]/20 focus:border-[#0C487A] transition-all cursor-pointer shadow-xs"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <span class="dropdown-selected-label truncate">All States</span>
          <svg class="dropdown-chevron w-4 h-4 text-slate-400 transition-transform duration-200 shrink-0 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <!-- Floating Options Panel -->
        <div class="dropdown-menu hidden absolute top-[calc(100%+6px)] left-0 right-0 bg-white border border-slate-200/90 rounded-xl shadow-xl shadow-slate-900/10 p-1.5 z-50 max-h-60 overflow-y-auto space-y-0.5">
          {sortedStates.map((st) => (
            <button
              type="button"
              class={`dropdown-option w-full px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold text-slate-700 hover:text-[#0C487A] hover:bg-blue-50/70 flex items-center justify-between text-left transition-colors cursor-pointer ${st === 'All States' ? 'bg-blue-50/50 text-[#0C487A]' : ''}`}
              data-value={st === 'All States' ? '' : st}
            >
              <span class="truncate">{st}</span>
              <svg class={`dropdown-check w-4 h-4 text-[#0C487A] shrink-0 ${st === 'All States' ? '' : 'hidden'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </button>
          ))}
        </div>
      </div>

      <!-- Filter 2: Employment Type -->
      <div class="custom-dropdown relative" data-filter="type">
        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1.5">
          Employment Type
        </label>
        <button
          type="button"
          class="dropdown-trigger w-full px-3.5 py-2.5 text-xs sm:text-sm rounded-xl border border-slate-200 bg-slate-50/70 hover:bg-white text-[#0B2553] font-semibold text-left flex items-center justify-between focus:outline-none focus:ring-2 focus:ring-[#FF3130]/20 focus:border-[#0C487A] transition-all cursor-pointer shadow-xs"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <span class="dropdown-selected-label truncate">All Employment Types</span>
          <svg class="dropdown-chevron w-4 h-4 text-slate-400 transition-transform duration-200 shrink-0 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <!-- Floating Options Panel -->
        <div class="dropdown-menu hidden absolute top-[calc(100%+6px)] left-0 right-0 bg-white border border-slate-200/90 rounded-xl shadow-xl shadow-slate-900/10 p-1.5 z-50 max-h-60 overflow-y-auto space-y-0.5">
          {availableEmploymentTypes.map((t) => (
            <button
              type="button"
              class={`dropdown-option w-full px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold text-slate-700 hover:text-[#0C487A] hover:bg-blue-50/70 flex items-center justify-between text-left transition-colors cursor-pointer ${t === 'All Employment Types' ? 'bg-blue-50/50 text-[#0C487A]' : ''}`}
              data-value={t === 'All Employment Types' ? '' : t}
            >
              <span class="truncate">{t}</span>
              <svg class={`dropdown-check w-4 h-4 text-[#0C487A] shrink-0 ${t === 'All Employment Types' ? '' : 'hidden'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </button>
          ))}
        </div>
      </div>

    </div>

    <!-- Active Filter Quick Reset Bar -->
    <div id="ceipal-filter-actions" class="hidden mt-4 pt-3.5 border-t border-slate-100 flex items-center justify-between">
      <span class="text-xs font-semibold text-slate-500">
        Filtered Results
      </span>
      <button
        type="button"
        id="ceipal-reset-btn"
        class="text-xs text-[#FF3130] hover:text-[#E02625] font-bold hover:underline inline-flex items-center gap-1.5 cursor-pointer transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Reset Filters</span>
      </button>
    </div>

  </div>

  <!-- ========================================================================= -->
  <!-- MULTI-COLUMN JOB CARDS GRID (2 or 3 in a row)                             -->
  <!-- ========================================================================= -->
  <div id="ceipal-jobs-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <!-- Populated by client script with smooth staggered entrance animation -->
  </div>

  <!-- Empty State (When search has 0 matches) -->
  <div id="ceipal-empty-state" class="hidden bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 p-12 text-center max-w-xl mx-auto shadow-sm">
    <div class="w-14 h-14 rounded-full bg-red-50 text-[#FF3130] flex items-center justify-center mx-auto mb-4">
      <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <h3 class="text-lg font-bold text-[#0B2553] mb-1.5">No Matching Openings Found</h3>
    <p class="text-xs sm:text-sm text-slate-500 mb-6 leading-relaxed">
      We couldn't find any positions matching your selected criteria. Try adjusting your search term, clearing location filters, or connect with our recruitment team.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <button
        type="button"
        id="ceipal-empty-reset"
        class="px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-[#0B2553] hover:bg-[#0C487A] transition-colors cursor-pointer"
      >
        Clear All Filters
      </button>
      <a
        href="#talent-network"
        class="px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-[#FF3130] bg-red-50 hover:bg-red-100 transition-colors"
      >
        Connect With Recruiter
      </a>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- DYNAMIC PAGINATION CONTROLS                                               -->
  <!-- ========================================================================= -->
  <div id="ceipal-pagination" class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-slate-200">
    <div class="text-xs text-slate-500 font-medium">
      Page <span id="ceipal-current-page" class="font-bold text-[#0B2553]">1</span> of <span id="ceipal-total-pages" class="font-bold text-[#0B2553]">{Math.ceil(initialCeipalJobs.length / 9)}</span>
    </div>

    <div class="flex items-center gap-1.5" id="ceipal-page-buttons">
      <!-- Buttons generated dynamically -->
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- ACCESSIBLE EXECUTIVE REQUISITION SCOPE MODAL                              -->
  <!-- ========================================================================= -->
  <div
    id="ceipal-details-modal"
    class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 sm:p-6"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
  >
    <div class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 max-w-3xl w-full max-h-[88vh] flex flex-col shadow-2xl relative overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      
      <!-- Top Brand Color Stripe -->
      <div class="h-1.5 bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130]"></div>

      <!-- Modal Header -->
      <div class="p-6 sm:p-8 border-b border-slate-100 bg-white">
        <div class="flex items-start justify-between gap-4">
          <div class="space-y-2">
            <!-- Badges -->
            <div class="flex flex-wrap items-center gap-2">
              <span id="modal-job-code" class="px-2.5 py-0.5 rounded text-[11px] font-mono font-bold bg-slate-100 text-slate-700"></span>
              <span id="modal-type" class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-[#0B2553] border border-blue-200/60"></span>
            </div>
            <!-- Title -->
            <h3 id="modal-title" class="text-xl sm:text-2xl font-extrabold text-[#0B2553] tracking-tight leading-snug"></h3>
            <!-- Location & Date -->
            <p id="modal-meta" class="text-xs sm:text-sm text-slate-500 font-medium"></p>
          </div>

          <button
            type="button"
            id="modal-close-btn"
            class="p-2 rounded-xl text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors cursor-pointer shrink-0"
            aria-label="Close dialog"
          >
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- 4-Stat Key Highlights Grid (Must-Known Fields from Ceipal) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-5 pt-5 border-t border-slate-100">
          <!-- Stat 1: Location -->
          <div class="p-3 rounded-xl bg-slate-50/80 border border-slate-200/70">
            <div class="flex items-center gap-1.5 text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">
              <svg class="w-3.5 h-3.5 text-[#FF3130]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              </svg>
              <span>Location</span>
            </div>
            <p id="modal-stat-location" class="text-xs sm:text-sm font-bold text-[#0B2553] truncate">-</p>
          </div>

          <!-- Stat 2: Employment Type -->
          <div class="p-3 rounded-xl bg-slate-50/80 border border-slate-200/70">
            <div class="flex items-center gap-1.5 text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">
              <svg class="w-3.5 h-3.5 text-[#0C487A]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>Type</span>
            </div>
            <p id="modal-stat-type" class="text-xs sm:text-sm font-bold text-[#0B2553] truncate">-</p>
          </div>

          <!-- Stat 3: Experience Required -->
          <div class="p-3 rounded-xl bg-slate-50/80 border border-slate-200/70">
            <div class="flex items-center gap-1.5 text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">
              <svg class="w-3.5 h-3.5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>Experience</span>
            </div>
            <p id="modal-stat-experience" class="text-xs sm:text-sm font-bold text-[#0B2553] truncate">-</p>
          </div>

          <!-- Stat 4: Compensation -->
          <div class="p-3 rounded-xl bg-slate-50/80 border border-slate-200/70">
            <div class="flex items-center gap-1.5 text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">
              <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Compensation</span>
            </div>
            <p id="modal-stat-pay" class="text-xs sm:text-sm font-bold text-emerald-800 truncate">-</p>
          </div>
        </div>
      </div>

      <!-- Modal Body (Scrollable Requisition Description) -->
      <div class="p-6 sm:p-8 overflow-y-auto space-y-4 flex-1 text-sm text-[#243A5E] leading-relaxed bg-slate-50/40">
        <div>
          <h4 class="text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-2.5 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#FF3130]"></span>
            <span>Position Scope & Qualifications</span>
          </h4>
          <div id="modal-description" class="text-sm sm:text-base text-slate-700 bg-white p-6 sm:p-7 rounded-2xl border border-slate-200/80 leading-relaxed shadow-xs font-normal"></div>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="p-5 sm:p-6 bg-white border-t border-slate-100 flex flex-wrap items-center justify-between gap-4">
        <p class="text-xs text-slate-500 hidden sm:flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Verified Ceipal Candidate Portal Requisition.</span>
        </p>

        <div class="flex items-center gap-3 w-full sm:w-auto justify-end">
          <button
            type="button"
            id="modal-cancel-btn"
            class="px-5 py-2.5 rounded-xl text-xs font-bold text-slate-600 hover:text-slate-800 hover:bg-slate-100 transition-colors cursor-pointer"
          >
            Close
          </button>
          <a
            id="modal-apply-btn"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-gradient-to-r from-[#FF3130] to-[#E02625] hover:from-[#E02625] hover:to-[#C61E1D] shadow-md shadow-[#FF3130]/25 transition-all cursor-pointer"
          >
            <span>Apply Now</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

    </div>
  </div>

</div>

<!-- Card Entrance Animation Styles (is:global required for dynamically inserted cards) -->
<style is:global>
  .ceipal-card-animate {
    opacity: 0;
    transform: translateY(28px);
    will-change: opacity, transform;
    transition:
      opacity 650ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 650ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ceipal-card-animate.is-visible {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }
</style>

<!-- Inlined Initial Dataset so client renders instantly without waiting for network -->
<script define:vars={{ initialJobs: initialCeipalJobs }}>
  window.__INITIAL_CEIPAL_JOBS__ = initialJobs;
</script>

<!-- Master Client Controller: Search, Custom Filter Dropdowns, Pagination, Modal & Viewport Reveal -->
<script>
  interface Job {
    id: string;
    jobCode: string;
    title: string;
    location: string;
    state: string;
    country: string;
    employmentType: string;
    experience: string;
    payRate: string;
    summary: string;
    fullDescription: string;
    updatedDate: string;
    applyUrl: string;
  }

  const jobsData: Job[] = (window as any).__INITIAL_CEIPAL_JOBS__ || [];
  const ITEMS_PER_PAGE = 9; // Maximum 10 cards per page: 3x3 balanced grid across 3 columns
  let currentPage = 1;

  // Active Filter State
  const activeFilters = {
    keyword: '',
    state: '',
    type: '',
  };

  // DOM Elements
  const listEl = document.getElementById('ceipal-jobs-list');
  const emptyEl = document.getElementById('ceipal-empty-state');
  const searchInput = document.getElementById('ceipal-search-input') as HTMLInputElement | null;
  const searchClear = document.getElementById('ceipal-search-clear');
  const filterActionsBar = document.getElementById('ceipal-filter-actions');
  const resetBtn = document.getElementById('ceipal-reset-btn');
  const emptyResetBtn = document.getElementById('ceipal-empty-reset');
  const curPageEl = document.getElementById('ceipal-current-page');
  const totalPagesEl = document.getElementById('ceipal-total-pages');
  const pageButtonsEl = document.getElementById('ceipal-page-buttons');

  // Modal Elements
  const modalEl = document.getElementById('ceipal-details-modal');
  const modalCloseBtn = document.getElementById('modal-close-btn');
  const modalCancelBtn = document.getElementById('modal-cancel-btn');
  const modalTitle = document.getElementById('modal-title');
  const modalJobCode = document.getElementById('modal-job-code');
  const modalType = document.getElementById('modal-type');
  const modalMeta = document.getElementById('modal-meta');
  const modalStatLocation = document.getElementById('modal-stat-location');
  const modalStatType = document.getElementById('modal-stat-type');
  const modalStatExperience = document.getElementById('modal-stat-experience');
  const modalStatPay = document.getElementById('modal-stat-pay');
  const modalDescription = document.getElementById('modal-description');
  const modalApplyBtn = document.getElementById('modal-apply-btn') as HTMLAnchorElement | null;

  // Setup Custom Interactive Dropdowns
  function setupCustomDropdowns() {
    const dropdownWrappers = document.querySelectorAll<HTMLElement>('.custom-dropdown');

    dropdownWrappers.forEach((wrapper) => {
      const filterKey = wrapper.getAttribute('data-filter') as keyof typeof activeFilters;
      const triggerBtn = wrapper.querySelector<HTMLButtonElement>('.dropdown-trigger');
      const menu = wrapper.querySelector<HTMLElement>('.dropdown-menu');
      const chevron = wrapper.querySelector<SVGElement>('.dropdown-chevron');
      const label = wrapper.querySelector<HTMLElement>('.dropdown-selected-label');
      const options = wrapper.querySelectorAll<HTMLButtonElement>('.dropdown-option');

      if (!triggerBtn || !menu || !filterKey) return;

      // Toggle dropdown menu
      triggerBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !menu.classList.contains('hidden');

        // Close all other open dropdowns first
        closeAllDropdowns();

        if (!isOpen) {
          menu.classList.remove('hidden');
          chevron?.classList.add('rotate-180');
          triggerBtn.setAttribute('aria-expanded', 'true');
        }
      });

      // Option selection
      options.forEach((opt) => {
        opt.addEventListener('click', (e) => {
          e.stopPropagation();
          const val = opt.getAttribute('data-value') || '';
          const optText = opt.querySelector('span')?.textContent || '';

          activeFilters[filterKey] = val;

          // Update trigger label
          if (label) label.textContent = optText;

          // Update checkmark state
          options.forEach((o) => {
            const isSelected = o === opt;
            const check = o.querySelector('.dropdown-check');
            if (isSelected) {
              o.classList.add('bg-blue-50/50', 'text-[#0C487A]');
              check?.classList.remove('hidden');
            } else {
              o.classList.remove('bg-blue-50/50', 'text-[#0C487A]');
              check?.classList.add('hidden');
            }
          });

          // Close menu
          menu.classList.add('hidden');
          chevron?.classList.remove('rotate-180');
          triggerBtn.setAttribute('aria-expanded', 'false');

          // Trigger reactive re-render
          currentPage = 1;
          renderJobs();
        });
      });
    });

    // Close on click outside
    document.addEventListener('click', () => closeAllDropdowns());

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAllDropdowns();
    });
  }

  function closeAllDropdowns() {
    document.querySelectorAll('.dropdown-menu').forEach((m) => m.classList.add('hidden'));
    document.querySelectorAll('.dropdown-chevron').forEach((c) => c.classList.remove('rotate-180'));
    document.querySelectorAll('.dropdown-trigger').forEach((t) => t.setAttribute('aria-expanded', 'false'));
  }

  function getFilteredJobs(): Job[] {
    const q = (searchInput?.value || '').trim().toLowerCase();
    const st = activeFilters.state;
    const typ = activeFilters.type;

    return jobsData.filter((j) => {
      // Keyword Match (Title, Code, Location, Description)
      if (q) {
        const inTitle = j.title.toLowerCase().includes(q);
        const inCode = j.jobCode.toLowerCase().includes(q);
        const inLoc = j.location.toLowerCase().includes(q);
        const inDesc = j.fullDescription.toLowerCase().includes(q);
        if (!inTitle && !inCode && !inLoc && !inDesc) return false;
      }

      // State Filter
      if (st && !j.state.toLowerCase().includes(st.toLowerCase())) return false;

      // Type Filter
      if (typ && !j.employmentType.toLowerCase().includes(typ.toLowerCase())) return false;

      return true;
    });
  }

  function decodeHtmlEntities(str: string): string {
    if (!str) return '';
    return str
      .replace(/&nbsp;/gi, ' ')
      .replace(/&ndash;/gi, '–')
      .replace(/&mdash;/gi, '—')
      .replace(/&rsquo;/gi, '’')
      .replace(/&lsquo;/gi, '‘')
      .replace(/&rdquo;/gi, '”')
      .replace(/&ldquo;/gi, '“')
      .replace(/&bull;/gi, '•')
      .replace(/&hellip;/gi, '…')
      .replace(/&middot;/gi, '·')
      .replace(/&amp;/gi, '&')
      .replace(/&lt;/gi, '<')
      .replace(/&gt;/gi, '>')
      .replace(/&quot;/gi, '"')
      .replace(/&#39;/gi, "'")
      .replace(/&#(\d+);/g, (match, dec) => {
        try {
          return String.fromCharCode(parseInt(dec, 10));
        } catch (e) {
          return match;
        }
      });
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  const ACTION_VERBS_REGEX = /^(Follow|Perform|Develop|Support|Manage|Review|Translate|Maintain|Collaborate|Coordinate|Document|Design|Install|Configure|Monitor|Ensure|Provide|Create|Participate|Work|Analyze|Execute|Interface|Demonstrate|Assist|Lead|Drive|Build|Write|Test|Deploy|Operate)\b/i;

  const EXACT_HEADING_TITLES = new Set([
    'position overview', 'role overview', 'job overview', 'overview', 'about the role', 'about the position',
    'position summary', 'job summary', 'role summary', 'summary', 'job description', 'role description',
    'position details', 'details', 'mission scope', 'scope of work',
    'key responsibilities', 'responsibilities', 'primary responsibilities', 'core responsibilities',
    'major responsibilities', 'duties & responsibilities', 'duties and responsibilities', 'duties',
    'essential duties', 'key duties', 'specific responsibilities',
    'qualifications', 'key qualifications', 'required qualifications', 'basic qualifications',
    'minimum qualifications', 'preferred qualifications', 'desired qualifications', 'must-have qualifications',
    'additional qualifications', 'requirements', 'job requirements', 'minimum requirements', 'key requirements',
    'core requirements', 'technical requirements', 'clearance requirements', 'security clearance requirements',
    'education & experience', 'education and experience', 'education', 'certifications', 'preferred skills',
    'technical skills', 'required skills', 'key skills', 'core skills', 'skills', 'benefits', 'what we offer',
    'compensation', 'about us', 'about unity compass'
  ]);

  function isSectionHeading(line: string): string | null {
    const clean = line.replace(/^[*_#\s]+/, '').replace(/[*_#\s:]+$/, '').trim();
    if (clean.length < 3 || clean.length > 50) return null;

    if (/\.\s*$/.test(line) || ACTION_VERBS_REGEX.test(clean)) return null;

    const colonIdx = line.indexOf(':');
    if (colonIdx !== -1) {
      const afterColon = line.slice(colonIdx + 1).trim();
      if (afterColon.length > 0) return null;
    }

    const cleanLower = clean.toLowerCase();
    if (EXACT_HEADING_TITLES.has(cleanLower)) {
      return clean;
    }

    if (/:\s*$/.test(line)) {
      const words = clean.split(/\s+/);
      if (words.length <= 4 && /(overview|summary|responsibilities|duties|qualifications|requirements|skills|education|certifications|benefits)/i.test(clean)) {
        return clean;
      }
    }

    return null;
  }

  function parseMetaLine(line: string): { label: string; value: string } | null {
    const m = line.match(/^([A-Za-z0-9\s/&–—\-]{2,35})\s*:\s*(.+)$/);
    if (!m) return null;
    const label = m[1].trim();
    const value = m[2].trim();
    if (value.length > 0 && !/^(Note|Please note|Important|Remember|For example|Example|Warning)$/i.test(label)) {
      return { label, value };
    }
    return null;
  }

  const META_NOISE_REGEX = /(citizenship|dual citizen|eligible|security clearance|clearance required|days onsite|transition period|going to \d|substituted with years)/i;

  function cleanCardSummary(job: Job): string {
    const text = job.fullDescription || job.summary || '';
    if (!text) {
      return `Explore requisition details, mission responsibilities, and qualifications for this position.`;
    }

    let decoded = decodeHtmlEntities(text);
    decoded = decoded
      .replace(/<(?:br|div|p|h[1-6]|li)[\s/]*>/gi, '\n')
      .replace(/<[^>]+>/g, ' ')
      .replace(/<[a-zA-Z\/][^>\n]*$/gm, '')
      .replace(/\r\n/g, '\n')
      .replace(/\r/g, '\n');

    decoded = decodeHtmlEntities(decoded);

    const normalized = decoded.replace(
      /([^\r\n])\s+(Job Title|Position Title|Position Name|Role|Job Location|Location|Pay Rate|Rates?|Salary Range?|Salary|Employment Type|Job Type|Shift|Work Schedule|Travel Required|Travel|Security Clearance|Clearance Required|Clearance Level|Clearance|Citizenship|Workplace Model|Work Model|Years of Experience|Certifications?)\s*:\s*/gi,
      '$1\n$2: '
    );

    const rawLines = normalized
      .split('\n')
      .map((l) => l.replace(/<[^>]*>/g, '').replace(/<[a-zA-Z\/].*$/g, '').trim())
      .filter((l) => l.length > 0);

    for (const line of rawLines) {
      if (isSectionHeading(line)) continue;

      const meta = parseMetaLine(line);
      if (meta) {
        if (META_NOISE_REGEX.test(meta.label) || META_NOISE_REGEX.test(meta.value)) continue;
        const sentences = meta.value.split(/(?<=[.!?])\s+/);
        if (sentences.length > 1 && meta.value.length > 40) {
          const potential = sentences.slice(1).join(' ').trim();
          if (potential.length > 25 && !META_NOISE_REGEX.test(potential)) {
            return potential.length > 180 ? potential.slice(0, 180).trim() + '...' : potential;
          }
        }
        continue;
      }

      if (META_NOISE_REGEX.test(line)) continue;

      const cleanLine = line.replace(/^[•\-\*▪–\d\.\)]\s*/, '').trim();
      if (
        cleanLine.toLowerCase() === (job.title || '').toLowerCase() ||
        cleanLine.toLowerCase().startsWith((job.title || '').toLowerCase() + ' –') ||
        cleanLine.toLowerCase().startsWith((job.title || '').toLowerCase() + ' -')
      ) {
        continue;
      }
      if (cleanLine.length >= 25) {
        return cleanLine.length > 180 ? cleanLine.slice(0, 180).trim() + '...' : cleanLine;
      }
    }

    return `Explore requisition details, mission responsibilities, and qualifications for this position.`;
  }

  function renderFormattedScope(rawDesc: string): string {
    if (!rawDesc) return '<p class="text-slate-400 italic">No detailed requisition scope provided.</p>';

    let decoded = decodeHtmlEntities(rawDesc);

    // Replace block tags with newlines
    decoded = decoded
      .replace(/<(?:br|div|p|h[1-6]|li)[\s/]*>/gi, '\n')
      .replace(/<[^>]+>/g, ' ')
      // Strip any unclosed or truncated tags at end of line/string
      .replace(/<[a-zA-Z\/][^>\n]*$/gm, '')
      .replace(/\r\n/g, '\n')
      .replace(/\r/g, '\n');

    decoded = decodeHtmlEntities(decoded);

    const normalized = decoded.replace(
      /([^\r\n])\s+(Job Title|Position Title|Position Name|Role|Job Location|Location|Pay Rate|Rates?|Salary Range?|Salary|Employment Type|Job Type|Shift|Work Schedule|Travel Required|Travel|Security Clearance|Clearance Required|Clearance Level|Clearance|Citizenship|Workplace Model|Work Model|Years of Experience|Certifications?)\s*:\s*/gi,
      '$1\n$2: '
    );

    const rawLines = normalized
      .split('\n')
      .map((l) => l.replace(/<[^>]*>/g, '').replace(/<[a-zA-Z\/].*$/g, '').trim())
      .filter((l) => l.length > 0);

    const sections: {
      heading: string | null;
      metaItems: { label: string; value: string }[];
      listItems: string[];
      paragraphs: string[];
    }[] = [];

    let currentSec: {
      heading: string | null;
      metaItems: { label: string; value: string }[];
      listItems: string[];
      paragraphs: string[];
    } = { heading: null, metaItems: [], listItems: [], paragraphs: [] };
    sections.push(currentSec);

    for (const line of rawLines) {
      const heading = isSectionHeading(line);
      if (heading) {
        currentSec = { heading, metaItems: [], listItems: [], paragraphs: [] };
        sections.push(currentSec);
        continue;
      }

      const meta = parseMetaLine(line);
      if (meta && currentSec.paragraphs.length === 0 && currentSec.listItems.length === 0) {
        currentSec.metaItems.push(meta);
        continue;
      }

      const bulletMatch = /^[•\-\*▪–]\s*(.+)$/.exec(line) || /^\d+[\.\)]\s*(.+)$/.exec(line);
      if (bulletMatch) {
        const text = bulletMatch[1].trim();
        if (text.length > 0) currentSec.listItems.push(text);
        continue;
      }

      if (currentSec.heading && /responsibilities|duties|qualifications|requirements|skills/i.test(currentSec.heading)) {
        if (line.length > 0) currentSec.listItems.push(line);
        continue;
      }

      if (meta) {
        currentSec.paragraphs.push(
          `<span class="font-extrabold text-[#0B2553]">${escapeHtml(meta.label)}:</span> <span class="text-slate-600 font-medium">${escapeHtml(meta.value)}</span>`
        );
        continue;
      }

      if (line.length > 0) {
        currentSec.paragraphs.push(line);
      }
    }

    let html = '';

    for (const sec of sections) {
      sec.listItems = sec.listItems.filter((i) => i.trim().length > 0);
      sec.paragraphs = sec.paragraphs.filter((p) => p.trim().length > 0);

      const hasContent = sec.metaItems.length > 0 || sec.listItems.length > 0 || sec.paragraphs.length > 0;
      if (!hasContent) continue;

      if (sec.heading) {
        html += `<h4 class="text-xs sm:text-sm font-extrabold text-[#0B2553] uppercase tracking-wider flex items-center gap-2 mt-5 mb-2.5 pt-2 border-t border-slate-100 first:mt-0 first:pt-0 first:border-0"><span class="w-2 h-2 rounded-full bg-[#FF3130] shrink-0"></span><span>${escapeHtml(sec.heading)}</span></h4>`;
      }

      if (sec.metaItems.length > 0) {
        html += '<div class="bg-slate-50/80 rounded-xl p-3.5 sm:p-4 border border-slate-200/80 mb-4 space-y-1.5">';
        for (const m of sec.metaItems) {
          html += `<div class="flex items-baseline gap-2 py-0.5 text-xs sm:text-sm"><span class="font-extrabold text-[#0B2553] shrink-0">${escapeHtml(m.label)}:</span><span class="text-slate-600 font-medium">${escapeHtml(m.value)}</span></div>`;
        }
        html += '</div>';
      }

      for (const p of sec.paragraphs) {
        const content = p.startsWith('<span class="font-extrabold') ? p : escapeHtml(p);
        html += `<p class="text-xs sm:text-sm text-slate-700 leading-relaxed font-normal mb-3">${content}</p>`;
      }

      if (sec.listItems.length > 0) {
        html += '<ul class="space-y-2.5 my-3">';
        for (const item of sec.listItems) {
          html += `<li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-700 leading-relaxed font-normal"><span class="w-1.5 h-1.5 rounded-full bg-[#0C487A] mt-2 shrink-0"></span><span>${escapeHtml(item)}</span></li>`;
        }
        html += '</ul>';
      }
    }

    return html;
  }

  function renderJobs() {
    const filtered = getFilteredJobs();
    const total = filtered.length;
    const totalPages = Math.ceil(total / ITEMS_PER_PAGE) || 1;

    if (currentPage > totalPages) currentPage = 1;

    const startIdx = (currentPage - 1) * ITEMS_PER_PAGE;
    const endIdx = Math.min(startIdx + ITEMS_PER_PAGE, total);
    const visibleJobs = filtered.slice(startIdx, endIdx);

    // Update Counts
    if (curPageEl) curPageEl.textContent = String(currentPage);
    if (totalPagesEl) totalPagesEl.textContent = String(totalPages);

    // Toggle Search Clear Button & Reset Bar
    const hasActiveFilters = Boolean(
      (searchInput?.value || '').trim() ||
      activeFilters.state ||
      activeFilters.type
    );

    if (filterActionsBar) filterActionsBar.classList.toggle('hidden', !hasActiveFilters);
    if (searchClear) searchClear.classList.toggle('hidden', !(searchInput?.value || '').trim());

    // Toggle Empty State vs List
    if (total === 0) {
      if (listEl) listEl.innerHTML = '';
      if (emptyEl) emptyEl.classList.remove('hidden');
      if (pageButtonsEl) pageButtonsEl.innerHTML = '';
      return;
    }

    if (emptyEl) emptyEl.classList.add('hidden');

    // Build Cards HTML (3x3 executive grid)
    if (listEl) {
      listEl.innerHTML = visibleJobs.map((j, index) => {
        const hasPay = Boolean(j.payRate && j.payRate !== 'Not Specified' && j.payRate !== 'N/A');
        const hasExp = Boolean(j.experience && j.experience !== 'N/A' && j.experience.trim().length > 0);
        const cardSummary = cleanCardSummary(j);

        return `
          <div
            class="job-card ceipal-card-animate group relative flex flex-col justify-between rounded-2xl sm:rounded-3xl bg-white border border-slate-200/90 p-6 sm:p-7 shadow-[0_10px_30px_-6px_rgba(12,72,122,0.06)] hover:shadow-[0_20px_45px_-8px_rgba(12,72,122,0.14)] hover:-translate-y-1.5 transition-all duration-300 overflow-hidden"
            data-job-id="${j.id}"
            style="transition-delay: ${(index % 9) * 75}ms;"
          >
            <!-- Top Color Stripe -->
            <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130] opacity-80 group-hover:opacity-100 group-hover:h-1.5 transition-all duration-300"></div>

            <!-- Card Upper Section -->
            <div>
              <!-- Badges & Posted Date -->
              <div class="flex items-center justify-between gap-2 mb-3">
