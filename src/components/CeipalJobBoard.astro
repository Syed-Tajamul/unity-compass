            </div>

            <!-- Card Actions Footer -->
            <div class="pt-3.5 border-t border-slate-100 flex items-center justify-between gap-2 mt-auto">
              <button
                type="button"
                class="view-details-btn text-xs font-bold text-[#0C487A] hover:text-[#0B2553] hover:underline inline-flex items-center gap-1 cursor-pointer py-1.5 transition-colors"
                data-id="${j.id}"
              >
                <span>View Scope</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </button>

              <a
                href="${j.applyUrl}"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-lg text-xs font-bold uppercase tracking-wider text-white bg-gradient-to-r from-[#FF3130] to-[#E02625] hover:from-[#E02625] hover:to-[#C61E1D] shadow-[0_4px_14px_rgba(255,49,48,0.22)] hover:shadow-[0_6px_20px_rgba(255,49,48,0.32)] transform hover:-translate-y-0.5 active:translate-y-0 transition-all cursor-pointer"
              >
                <span>Apply Now</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>

          </div>
        `;
      }).join('');

      // Trigger Viewport Animated Stagger
      triggerCardRevealAnimation();
    }

    // Attach Click Events to "View Scope" buttons
    document.querySelectorAll('.view-details-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
        const job = jobsData.find((j) => j.id === id);
        if (job) openModal(job);
      });
    });

    renderPagination(totalPages);
  }

  // Viewport Observer for Job Cards & Filter Box Entrance Animation
  function triggerCardRevealAnimation() {
    // Observe filter container if not already visible
    const filterBox = document.getElementById('ceipal-filter-box');
    if (filterBox && !filterBox.classList.contains('is-visible')) {
      if (!('IntersectionObserver' in window)) {
        filterBox.classList.add('is-visible');
      } else {
        const filterObserver = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.05, rootMargin: '0px 0px -30px 0px' }
        );
        filterObserver.observe(filterBox);
      }
    }

    const cards = document.querySelectorAll<HTMLElement>('.ceipal-card-animate:not(.is-visible)');
    if (!cards.length) return;

    if (!('IntersectionObserver' in window)) {
      cards.forEach((c) => c.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.05, rootMargin: '0px 0px -30px 0px' }
    );

    cards.forEach((c) => observer.observe(c));
  }

  function renderPagination(totalPages: number) {
    if (!pageButtonsEl) return;

    if (totalPages <= 1) {
      pageButtonsEl.innerHTML = '';
      return;
    }

    let html = '';

    // Prev Button
    html += `
      <button
        type="button"
        class="page-nav-btn px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold ${currentPage === 1 ? 'opacity-40 cursor-not-allowed text-slate-400' : 'text-[#0B2553] hover:bg-slate-100 cursor-pointer'} transition-colors"
        data-page="${currentPage - 1}"
        ${currentPage === 1 ? 'disabled' : ''}
      >
        Previous
      </button>
    `;

    // Smart Page Number Buttons calculation
    const getPageNumbers = (current: number, total: number): (number | string)[] => {
      if (total <= 7) {
        return Array.from({ length: total }, (_, i) => i + 1);
      }
      if (current <= 3) {
        return [1, 2, 3, 4, '...', total];
      }
      if (current >= total - 2) {
        return [1, '...', total - 3, total - 2, total - 1, total];
      }
      return [1, '...', current - 1, current, current + 1, '...', total];
    };

    const pages = getPageNumbers(currentPage, totalPages);
    pages.forEach((p) => {
      if (p === '...') {
        html += `<span class="px-2 py-1 text-xs text-slate-400 select-none">...</span>`;
      } else {
        const isActive = p === currentPage;
        html += `
          <button
            type="button"
            class="page-num-btn w-8 h-8 rounded-lg text-xs font-bold transition-all ${
              isActive
                ? 'bg-[#FF3130] text-white shadow-xs'
                : 'text-[#0B2553] hover:bg-slate-100 border border-slate-200'
            } cursor-pointer"
            data-page="${p}"
          >
            ${p}
          </button>
        `;
      }
    });

    // Next Button
    html += `
      <button
        type="button"
        class="page-nav-btn px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold ${currentPage === totalPages ? 'opacity-40 cursor-not-allowed text-slate-400' : 'text-[#0B2553] hover:bg-slate-100 cursor-pointer'} transition-colors"
        data-page="${currentPage + 1}"
        ${currentPage === totalPages ? 'disabled' : ''}
      >
        Next
      </button>
    `;

    pageButtonsEl.innerHTML = html;

    // Attach Pagination Click Handlers
    pageButtonsEl.querySelectorAll('.page-num-btn, .page-nav-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const targetPage = parseInt((e.currentTarget as HTMLElement).getAttribute('data-page') || '1', 10);
        if (targetPage >= 1 && targetPage <= totalPages && targetPage !== currentPage) {
          currentPage = targetPage;
          renderJobs();
          // Smooth scroll to top of job board
          const container = document.getElementById('ceipal-custom-board');
          if (container) {
            container.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });
  }

  function openModal(job: Job) {
    if (!modalEl) return;
    if (modalTitle) modalTitle.textContent = job.title;
    if (modalJobCode) {
      if (job.jobCode) {
        modalJobCode.textContent = job.jobCode;
        modalJobCode.classList.remove('hidden');
      } else {
        modalJobCode.classList.add('hidden');
      }
    }
    if (modalType) {
      if (job.employmentType) {
        modalType.textContent = job.employmentType;
        modalType.classList.remove('hidden');
      } else {
        modalType.classList.add('hidden');
      }
    }
    if (modalMeta) {
      const metaParts = [job.location, job.updatedDate ? `Posted ${job.updatedDate}` : ''].filter(Boolean);
      modalMeta.textContent = metaParts.join(' · ');
    }

    // 4 Key Stats (STRICT: 100% Real API Data from Ceipal)
    if (modalStatLocation) modalStatLocation.textContent = job.location || 'Not Specified';
    if (modalStatType) modalStatType.textContent = job.employmentType || 'Not Specified';
    if (modalStatExperience) modalStatExperience.textContent = (job.experience && job.experience !== 'N/A') ? job.experience : 'Not Specified';
    if (modalStatPay) {
      modalStatPay.textContent = (job.payRate && job.payRate !== 'Not Specified' && job.payRate !== 'N/A') ? job.payRate : 'Competitive / Inquire';
    }

    if (modalDescription) {
      modalDescription.innerHTML = renderFormattedScope(job.fullDescription || job.summary);
    }

    if (modalApplyBtn) {
      modalApplyBtn.href = job.applyUrl;
    }

    modalEl.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!modalEl) return;
    modalEl.classList.add('hidden');
    document.body.style.overflow = '';
  }

  // Event Listeners for Keyword Search
  searchInput?.addEventListener('input', () => {
    currentPage = 1;
    renderJobs();
  });

  searchClear?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    currentPage = 1;
    renderJobs();
  });

  function resetAllFilters() {
    if (searchInput) searchInput.value = '';
    activeFilters.keyword = '';
    activeFilters.state = '';
    activeFilters.type = '';

    // Reset dropdown trigger labels and active options
    document.querySelectorAll<HTMLElement>('.custom-dropdown').forEach((wrapper) => {
      const filterKey = wrapper.getAttribute('data-filter');
      const label = wrapper.querySelector<HTMLElement>('.dropdown-selected-label');
      const options = wrapper.querySelectorAll<HTMLButtonElement>('.dropdown-option');

      let defaultLabel = 'All Options';
      if (filterKey === 'state') defaultLabel = 'All States';
      if (filterKey === 'type') defaultLabel = 'All Employment Types';

      if (label) label.textContent = defaultLabel;

      options.forEach((opt, idx) => {
        const check = opt.querySelector('.dropdown-check');
        if (idx === 0) {
          opt.classList.add('bg-blue-50/50', 'text-[#0C487A]');
          check?.classList.remove('hidden');
        } else {
          opt.classList.remove('bg-blue-50/50', 'text-[#0C487A]');
          check?.classList.add('hidden');
        }
      });
    });

    currentPage = 1;
    renderJobs();
  }

  resetBtn?.addEventListener('click', resetAllFilters);
  emptyResetBtn?.addEventListener('click', resetAllFilters);

  // Modal Close Events
  modalCloseBtn?.addEventListener('click', closeModal);
  modalCancelBtn?.addEventListener('click', closeModal);
  modalEl?.addEventListener('click', (e) => {
    if (e.target === modalEl) closeModal();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  // Initialize
  setupCustomDropdowns();
  renderJobs();

  // Background hydration: Fetch fresh live requisitions from Ceipal endpoint
  // to ensure any new positions added by recruiters update seamlessly
  (async function hydrateLiveJobs() {
    try {
      const res = await fetch('/api/jobs?page=all');
      if (res.ok) {
        const payload = await res.json();
        if (payload.success && Array.isArray(payload.jobs) && payload.jobs.length > 0) {
          jobsData.length = 0;
          jobsData.push(...payload.jobs);
          renderJobs();
        }
      }
    } catch (e) {
      // Gracefully silent fallback to initial dataset
    }
  })();
</script>
