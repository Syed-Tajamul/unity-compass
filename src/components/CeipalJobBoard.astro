---
/**
 * CeipalJobBoard.astro - Unity Compass job board
 *
 * Layout: search bar on top, collapsible filters in a left sidebar, job cards on the right.
 * - Multi-select filters (location, work model, employment type) with live counts
 * - Grid or list view (remembered per visitor), sort, pagination
 * - "View Scope" opens the role details modal; "Apply now" goes to the Ceipal candidate portal
 * - Background refresh from /api/jobs
 */
import {
  initialCeipalJobs,
  availableStates,
  availableEmploymentTypes,
  availableWorkplaceTypes,
} from '../data/ceipalJobs';

const priorityStates = ['Maryland', 'Virginia', 'District of Columbia'];
const states = [
  ...priorityStates.filter((s) => availableStates.includes(s)),
  ...availableStates.filter((s) => !s.startsWith('All') && !priorityStates.includes(s)),
];
const VISIBLE_STATES = 6;

const filterGroups = [
  { key: 'state', title: 'Location', options: states },
  { key: 'workplace', title: 'Work model', options: availableWorkplaceTypes.filter((w) => !w.startsWith('All')) },
  { key: 'type', title: 'Employment type', options: availableEmploymentTypes.filter((t) => !t.startsWith('All')) },
];
---

<div id="ceipal-custom-board" class="scroll-mt-28 space-y-6">

  <!-- ===================== Search ===================== -->
  <form id="uc-search-form" role="search" class="flex flex-col gap-2 rounded-lg bg-[#0B2553] p-4 sm:flex-row sm:p-5">
    <label for="ceipal-search-input" class="sr-only">Search roles</label>
    <div class="relative flex-1">
      <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        id="ceipal-search-input"
        type="search"
        autocomplete="off"
        placeholder="Job title, skill, city, or job code"
        class="w-full rounded-md border-0 bg-white py-3 pl-12 pr-10 text-[15px] text-[#0B2553] placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-[#FF3130] [&::-webkit-search-cancel-button]:appearance-none [&::-webkit-search-decoration]:appearance-none"
      />
      <button type="button" id="ceipal-search-clear" class="absolute right-3 top-1/2 hidden -translate-y-1/2 rounded p-1 text-slate-400 hover:text-slate-600" aria-label="Clear search">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>
    <button type="submit" class="rounded-md bg-[#FF3130] px-7 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#E02625] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white">
      Search
    </button>
  </form>

  <div class="grid items-start gap-6 lg:grid-cols-[264px_minmax(0,1fr)]">

    <!-- Mobile filter toggle -->
    <button
      type="button"
      id="uc-filters-toggle"
      aria-expanded="false"
      aria-controls="uc-filters"
      class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-[#0B2553] lg:hidden"
    >
      <span class="flex items-center gap-2">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h18M6 12h12M10 20h4" /></svg>
        Filters
        <span id="uc-filters-count" class="hidden rounded-full bg-[#0C487A] px-2 py-0.5 text-[11px] text-white"></span>
      </span>
      <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
    </button>

    <!-- ===================== Sidebar ===================== -->
    <aside id="uc-filters" class="hidden rounded-2xl border border-slate-200 bg-white px-4 pb-2 lg:block" aria-label="Filter roles">
      <div class="flex items-center justify-between py-4">
        <p class="text-[15px] font-semibold text-[#0B2553]">Filters</p>
        <button type="button" id="ceipal-reset-btn" class="invisible text-[13px] font-semibold text-[#FF3130] hover:underline">Clear all</button>
      </div>

      {filterGroups.map((group) => (
        <details open class="group border-t border-slate-100">
          <summary class="flex cursor-pointer list-none items-center justify-between py-3 text-[13px] font-semibold text-[#0B2553] [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-2">
              {group.title}
              <span class="uc-group-badge hidden rounded-full bg-[#0C487A] px-2 py-0.5 text-[10px] font-semibold text-white" data-group={group.key}></span>
            </span>
            <svg class="h-4 w-4 text-slate-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>

          <div class="space-y-0.5 pb-3">
            {group.options.map((option, i) => (
              <label class={`flex cursor-pointer items-center gap-2.5 rounded-lg px-2 py-1.5 text-sm text-slate-700 transition-colors hover:bg-slate-50 ${group.key === 'state' && i >= VISIBLE_STATES ? 'uc-state-extra hidden' : ''}`}>
                <input
                  type="checkbox"
                  class="uc-facet h-4 w-4 shrink-0 rounded border-slate-300 text-[#0C487A] focus:ring-2 focus:ring-[#0C487A] focus:ring-offset-0"
                  data-facet={group.key}
                  value={option}
                />
                <span class="flex-1 truncate">{option}</span>
                <span class="uc-count min-w-[24px] rounded-full bg-slate-100 px-1.5 text-center text-[11px] text-slate-500"></span>
              </label>
            ))}
            {group.key === 'state' && states.length > VISIBLE_STATES && (
              <button type="button" id="uc-states-more" aria-expanded="false" class="mt-1 px-2 text-[13px] font-semibold text-[#0C487A] hover:underline">
                Show {states.length - VISIBLE_STATES} more
              </button>
            )}
          </div>
        </details>
      ))}
    </aside>

    <!-- ===================== Results ===================== -->
    <div class="min-w-0">
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
        <p aria-live="polite" class="text-[15px] font-semibold text-[#0B2553]">
          <span id="uc-results-count">{initialCeipalJobs.length} open roles</span>
          <span id="uc-results-scope" class="ml-1 text-[13px] font-normal text-slate-500">across all programs</span>
        </p>
        <div class="flex items-center gap-2">
          <label class="sr-only" for="uc-sort">Sort roles</label>
          <select id="uc-sort" class="rounded-lg border-slate-200 py-1.5 pl-3 pr-8 text-[13px] text-[#0B2553] focus:border-[#0C487A] focus:ring-[#0C487A]">
            <option value="recent">Newest first</option>
            <option value="title">Title A to Z</option>
          </select>
          <div class="flex rounded-lg bg-slate-100 p-0.5" role="group" aria-label="Layout">
            <button type="button" data-layout="grid" aria-pressed="true" aria-label="Grid view"
              class="uc-layout rounded-md p-1.5 text-slate-400 aria-pressed:bg-white aria-pressed:text-[#0B2553] aria-pressed:shadow-sm">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z" /></svg>
            </button>
            <button type="button" data-layout="list" aria-pressed="false" aria-label="List view"
              class="uc-layout rounded-md p-1.5 text-slate-400 aria-pressed:bg-white aria-pressed:text-[#0B2553] aria-pressed:shadow-sm">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
            </button>
          </div>
        </div>
      </div>

      <div id="uc-active" class="mb-4 flex flex-wrap gap-2 empty:hidden"></div>

      <div id="ceipal-jobs-list" class="grid grid-cols-1 gap-5 sm:grid-cols-2 2xl:grid-cols-3"></div>

      <div id="ceipal-empty-state" class="hidden rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center">
        <svg class="mx-auto h-10 w-10 text-slate-300" viewBox="0 0 48 48" fill="none" aria-hidden="true"><circle cx="24" cy="24" r="21" stroke="currentColor" stroke-width="2" /><path d="M24 7l4 17-4 17-4-17z" fill="currentColor" /></svg>
        <p class="mt-3 text-lg font-semibold text-[#0B2553]">No roles match these filters</p>
        <p class="mx-auto mt-1 max-w-md text-sm leading-relaxed text-slate-500">Remove a filter above, or clear them all to see every opening.</p>
        <button type="button" id="ceipal-empty-reset" class="mt-5 rounded-xl bg-[#0B2553] px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[#0C487A]">
          Clear all filters
        </button>
      </div>

      <nav id="ceipal-pagination" aria-label="Job pages" class="mt-8 flex flex-wrap items-center justify-between gap-4">
        <p id="uc-showing" class="text-[13px] text-slate-500"></p>
        <div id="ceipal-page-buttons" class="flex items-center gap-1.5"></div>
      </nav>
    </div>
  </div>

  <!-- ===================== Resume prompt ===================== -->
  <div class="flex flex-col gap-4 rounded-2xl border border-slate-200 bg-white p-5 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-4">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#E6EFF8] text-[#0C487A]">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" /></svg>
      </span>
      <div>
        <p class="font-semibold text-[#0B2553]">Don't see your role?</p>
        <p class="text-sm text-slate-500">Many roles are filled before they're posted. Send your resume and a recruiter will match you.</p>
      </div>
    </div>
    <a href="#talent-network" class="shrink-0 rounded-md border border-[#0B2553] px-5 py-2.5 text-center text-sm font-semibold text-[#0B2553] transition-colors hover:bg-[#0B2553] hover:text-white">
      Send your resume
    </a>
  </div>

  <!-- ===================== Role details modal ===================== -->
  <div id="ceipal-details-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-[#0B2553]/60 p-4 sm:p-6" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="flex max-h-[88vh] w-full max-w-2xl flex-col overflow-hidden rounded-2xl bg-white shadow-2xl">
      <div class="border-b border-slate-100 p-6">
        <div class="flex items-start justify-between gap-4">
          <div class="flex flex-wrap items-center gap-2">
            <span id="modal-clearance" class="rounded-full bg-[#E6EFF8] px-2.5 py-0.5 text-xs font-semibold text-[#0C487A]"></span>
            <span id="modal-job-code" class="font-mono text-[11px] text-slate-400"></span>
          </div>
          <button type="button" id="modal-close-btn" class="rounded-lg p-1.5 text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700" aria-label="Close role details">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>
        <h3 id="modal-title" class="mt-3 text-xl font-bold leading-snug text-[#0B2553] sm:text-2xl"></h3>
        <p id="modal-meta" class="mt-1 text-sm text-slate-500"></p>
        <dl class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
          <div class="rounded-xl bg-slate-50 p-3"><dt class="text-xs text-slate-500">Pay</dt><dd id="modal-stat-pay" class="mt-0.5 text-sm font-semibold text-[#0B2553]"></dd></div>
          <div class="rounded-xl bg-slate-50 p-3"><dt class="text-xs text-slate-500">Work model</dt><dd id="modal-stat-model" class="mt-0.5 text-sm font-semibold text-[#0B2553]"></dd></div>
          <div class="rounded-xl bg-slate-50 p-3"><dt class="text-xs text-slate-500">Employment</dt><dd id="modal-stat-type" class="mt-0.5 text-sm font-semibold text-[#0B2553]"></dd></div>
          <div class="rounded-xl bg-slate-50 p-3"><dt class="text-xs text-slate-500">Posted</dt><dd id="modal-stat-date" class="mt-0.5 text-sm font-semibold text-[#0B2553]"></dd></div>
        </dl>
      </div>
      <div class="flex-1 overflow-y-auto p-6">
        <p class="mb-2 text-sm font-semibold text-[#0B2553]">About the role</p>
        <div id="modal-description" class="whitespace-pre-line text-[15px] leading-relaxed text-slate-700"></div>
      </div>
      <div class="flex justify-end gap-3 border-t border-slate-100 p-4 sm:p-5">
        <button type="button" id="modal-cancel-btn" class="rounded-md border border-slate-200 px-5 py-2.5 text-sm font-semibold text-[#0B2553] transition-colors hover:border-[#0C487A]">Close</button>
        <a id="modal-apply-btn" href="#" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-md border border-transparent bg-[#FF3130] px-6 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[#E02625]">
          Apply now<span class="sr-only"> (opens in a new tab)</span>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
        </a>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ initialJobs: initialCeipalJobs }}>
  window.__INITIAL_CEIPAL_JOBS__ = initialJobs;
</script>

<script>
  interface Job {
    id: string;
    jobCode: string;
    title: string;
    location: string;
    state: string;
    country: string;
    employmentType: string;
    workplaceType: string;
    clearanceLevel: string;
    payRate: string;
    summary: string;
    fullDescription: string;
    updatedDate: string;
    applyUrl: string;
  }

  type Facet = 'state' | 'workplace' | 'type';
  type Layout = 'grid' | 'list';
  const FACETS: Facet[] = ['state', 'workplace', 'type'];
  const PER_PAGE = 8;
  const LAYOUT_KEY = 'uc-job-board-layout';
  const GRID_CLASSES = 'grid grid-cols-1 gap-5 sm:grid-cols-2 2xl:grid-cols-3';
  const LIST_CLASSES = 'flex flex-col gap-3';

  let jobsData: Job[] = (window as any).__INITIAL_CEIPAL_JOBS__ || [];
  let keyword = '';
  let sortBy: 'recent' | 'title' = 'recent';
  let currentPage = 1;
  let layout: Layout = 'grid';
  let lastFocus: HTMLElement | null = null;
  const selected: Record<Facet, Set<string>> = {
    state: new Set(),
    workplace: new Set(),
    type: new Set(),
  };

  try {
    const saved = localStorage.getItem(LAYOUT_KEY);
    if (saved === 'grid' || saved === 'list') layout = saved;
  } catch {
    // Storage unavailable; keep the default
  }

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const board = $('ceipal-custom-board')!;
  const searchInput = $<HTMLInputElement>('ceipal-search-input')!;
  const listEl = $('ceipal-jobs-list')!;
  const emptyEl = $('ceipal-empty-state')!;
  const paginationEl = $('ceipal-pagination')!;
  const pageButtonsEl = $('ceipal-page-buttons')!;
  const modalEl = $('ceipal-details-modal')!;
  const filtersEl = $('uc-filters')!;
  const filtersToggle = $('uc-filters-toggle')!;
  const facetInputs = Array.from(board.querySelectorAll<HTMLInputElement>('.uc-facet'));

  // ---------- helpers ----------
  const ESC: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
  const esc = (s: unknown = '') => String(s ?? '').replace(/[&<>"']/g, (c) => ESC[c]);
  const safeUrl = (u = '') => (/^https?:\/\//i.test(u) ? u : '#');
  const hasPay = (p?: string) => Boolean(p && !/not specified/i.test(p));
  const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;
  const isCleared = (c = '') => /secret|sci|poly/i.test(c);

  function ageDays(date: string): number {
    const t = Date.parse(date);
    return Number.isNaN(t) ? Infinity : Math.floor((Date.now() - t) / 864e5);
  }

  function formatDescription(desc = ''): string {
    return desc.replace(/&nbsp;/g, ' ').replace(/\r\n/g, '\n').replace(/\n{3,}/g, '\n\n').trim();
  }

  // ---------- filtering ----------
  function facetMatches(j: Job, facet: Facet, value: string): boolean {
    switch (facet) {
      case 'state':
        return (j.state || '').toLowerCase().includes(value.toLowerCase());
      case 'workplace':
        return j.workplaceType === value;
      case 'type':
        return (j.employmentType || '').toLowerCase().includes(value.toLowerCase());
    }
  }

  function matches(j: Job, skip?: Facet): boolean {
    if (keyword) {
      const hay = [j.title, j.jobCode, j.location, j.workplaceType, j.clearanceLevel, j.summary, j.fullDescription]
        .join(' ')
        .toLowerCase();
      if (!keyword.toLowerCase().split(/\s+/).filter(Boolean).every((t) => hay.includes(t))) return false;
    }
    for (const facet of FACETS) {
      if (facet === skip || !selected[facet].size) continue;
      if (![...selected[facet]].some((v) => facetMatches(j, facet, v))) return false;
    }
    return true;
  }

  function filteredJobs(): Job[] {
    const res = jobsData.filter((j) => matches(j));
    if (sortBy === 'title') return res.sort((a, b) => a.title.localeCompare(b.title));
    return res.sort((a, b) => (Date.parse(b.updatedDate) || 0) - (Date.parse(a.updatedDate) || 0));
  }

  const activeCount = () => FACETS.reduce((n, f) => n + selected[f].size, 0) + (keyword ? 1 : 0);

  // ---------- card markup ----------
  const ICON_PIN = '<svg class="h-4 w-4 shrink-0 text-[#FF3130]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>';
  const ICON_BUILDING = '<svg class="h-4 w-4 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>';
  const ICON_BRIEFCASE = '<svg class="h-4 w-4 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>';
  const ICON_CASH = '<svg class="h-4 w-4 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>';
  const ICON_CHEVRON = '<svg class="h-4 w-4 transition-transform group-hover/scope:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>';

  function clearanceBadge(j: Job): string {
    const cleared = isCleared(j.clearanceLevel);
    return `<span class="truncate rounded-full px-2.5 py-0.5 text-xs font-semibold ${cleared ? 'bg-[#E6EFF8] text-[#0C487A]' : 'bg-slate-100 text-slate-600'}">${esc(j.clearanceLevel || 'No clearance required')}</span>`;
  }

  function freshness(j: Job): string {
    return ageDays(j.updatedDate) <= 7
      ? '<span class="shrink-0 rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700">New</span>'
      : `<span class="shrink-0 text-xs text-slate-400">${esc(j.updatedDate)}</span>`;
  }

  function meta(j: Job): string {
    return `<span class="flex items-center gap-1.5">${ICON_PIN}<span class="truncate">${esc(j.location)}</span></span>
      <span class="flex items-center gap-1.5">${ICON_BUILDING}${esc(j.workplaceType)}</span>
      <span class="flex items-center gap-1.5">${ICON_BRIEFCASE}${esc(j.employmentType)}</span>
      ${hasPay(j.payRate) ? `<span class="flex items-center gap-1.5 font-semibold text-[#0B2553]">${ICON_CASH}${esc(j.payRate)}</span>` : ''}`;
  }

  function viewScopeLink(j: Job): string {
    return `<button type="button" data-view-job="${esc(j.id)}"
      class="group/scope inline-flex items-center gap-1 rounded text-sm font-semibold text-[#0C487A] transition-colors hover:text-[#0B2553] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0C487A] focus-visible:ring-offset-2">
      View Scope<span class="sr-only">: ${esc(j.title)}</span>
      ${ICON_CHEVRON}
    </button>`;
  }

  function applyLink(j: Job, size: string): string {
    return `<a href="${esc(safeUrl(j.applyUrl))}" target="_blank" rel="noopener noreferrer"
      class="rounded-md border border-transparent bg-[#FF3130] ${size} text-center font-semibold text-white transition-colors hover:bg-[#E02625] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF3130] focus-visible:ring-offset-2">
      Apply now<span class="sr-only"> for ${esc(j.title)} (opens in a new tab)</span>
    </a>`;
  }

  function gridCard(j: Job): string {
    return `<article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-5">
      <div class="flex items-center justify-between gap-2">${clearanceBadge(j)}${freshness(j)}</div>
      <h3 class="mt-4 text-lg font-bold leading-snug text-[#0B2553]">${esc(j.title)}</h3>
      ${j.jobCode ? `<p class="mt-0.5 font-mono text-[11px] text-slate-400">${esc(j.jobCode)}</p>` : ''}
      <div class="mt-3 flex flex-col gap-1.5 text-[13px] text-slate-500">${meta(j)}</div>
      <div class="mt-auto pt-5">
        <div class="flex items-center justify-between gap-3 border-t border-slate-100 pt-4">
          ${viewScopeLink(j)}
          ${applyLink(j, 'px-5 py-2.5 text-[13px]')}
        </div>
      </div>
    </article>`;
  }

  function listCard(j: Job): string {
    return `<article class="flex flex-col gap-4 rounded-2xl border border-slate-200 bg-white p-4 sm:flex-row sm:items-center sm:px-5">
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-2">${clearanceBadge(j)}${freshness(j)}</div>
        <h3 class="mt-2 text-base font-bold leading-snug text-[#0B2553]">${esc(j.title)}</h3>
        <div class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1 text-[13px] text-slate-500">${meta(j)}</div>
      </div>
      <div class="flex shrink-0 items-center gap-5">
        ${viewScopeLink(j)}
        ${applyLink(j, 'px-5 py-2 text-[13px]')}
      </div>
    </article>`;
  }

  // ---------- rendering ----------
  function renderFilters() {
    facetInputs.forEach((input) => {
      const facet = input.dataset.facet as Facet;
      const n = jobsData.filter((j) => matches(j, facet) && facetMatches(j, facet, input.value)).length;
      const label = input.closest('label')!;
      const countEl = label.querySelector('.uc-count');
      if (countEl) countEl.textContent = String(n);
      input.checked = selected[facet].has(input.value);
      label.classList.toggle('opacity-50', n === 0 && !input.checked);
    });

    board.querySelectorAll<HTMLElement>('.uc-group-badge').forEach((badge) => {
      const size = selected[badge.dataset.group as Facet].size;
      badge.textContent = String(size);
      badge.classList.toggle('hidden', size === 0);
    });

    const active = activeCount();
    const mobileCount = $('uc-filters-count')!;
    mobileCount.textContent = String(active);
    mobileCount.classList.toggle('hidden', active === 0);
    $('ceipal-reset-btn')!.classList.toggle('invisible', active === 0);
    $('ceipal-search-clear')!.classList.toggle('hidden', !keyword);
  }

  function tagHtml(facet: string, value: string, label: string): string {
    return `<button type="button" data-remove="${esc(facet)}" data-value="${esc(value)}"
      class="inline-flex items-center gap-1.5 rounded-full border border-[#C9DAEB] bg-white py-1 pl-3 pr-1.5 text-xs font-semibold text-[#0C487A] transition-colors hover:border-[#0C487A]">
      ${esc(label)}
      <span class="flex h-4 w-4 items-center justify-center rounded-full bg-[#E6EFF8]">
        <svg class="h-2.5 w-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"/></svg>
      </span>
      <span class="sr-only">Remove filter</span>
    </button>`;
  }

  function renderActiveTags() {
    const tags: string[] = [];
    if (keyword) tags.push(tagHtml('keyword', '', `Search: ${keyword}`));
    FACETS.forEach((facet) => selected[facet].forEach((v) => tags.push(tagHtml(facet, v, v))));
    $('uc-active')!.innerHTML = tags.join('');
  }

  function renderPagination(total: number, totalPages: number) {
    const start = (currentPage - 1) * PER_PAGE + 1;
    const end = Math.min(currentPage * PER_PAGE, total);
    $('uc-showing')!.textContent = `Showing ${start} to ${end} of ${total}`;

    if (totalPages <= 1) {
      pageButtonsEl.innerHTML = '';
      return;
    }

    const pages: (number | string)[] =
      totalPages <= 7
        ? Array.from({ length: totalPages }, (_, i) => i + 1)
        : currentPage <= 3
          ? [1, 2, 3, 4, '…', totalPages]
          : currentPage >= totalPages - 2
            ? [1, '…', totalPages - 3, totalPages - 2, totalPages - 1, totalPages]
            : [1, '…', currentPage - 1, currentPage, currentPage + 1, '…', totalPages];

    const arrow = (dir: 'prev' | 'next') => {
      const page = dir === 'prev' ? currentPage - 1 : currentPage + 1;
      const disabled = dir === 'prev' ? currentPage === 1 : currentPage === totalPages;
      const path = dir === 'prev' ? 'M15 19l-7-7 7-7' : 'M9 5l7 7-7 7';
      return `<button type="button" data-page="${page}" ${disabled ? 'disabled' : ''} aria-label="${dir === 'prev' ? 'Previous' : 'Next'} page"
        class="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white ${disabled ? 'cursor-not-allowed text-slate-300' : 'text-[#0B2553] hover:border-[#0C487A]'}">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${path}"/></svg>
      </button>`;
    };

    pageButtonsEl.innerHTML =
      arrow('prev') +
      pages
        .map((p) =>
          p === '…'
            ? '<span class="px-1 text-slate-400">…</span>'
            : `<button type="button" data-page="${p}" ${p === currentPage ? 'aria-current="page"' : ''}
                class="h-9 w-9 rounded-lg text-[13px] font-semibold ${p === currentPage ? 'bg-[#0B2553] text-white' : 'border border-slate-200 bg-white text-[#0B2553] hover:border-[#0C487A]'}">${p}</button>`
        )
        .join('') +
      arrow('next');
  }

  function renderJobs() {
    const results = filteredJobs();
    const totalPages = Math.max(1, Math.ceil(results.length / PER_PAGE));
    if (currentPage > totalPages) currentPage = 1;

    $('uc-results-count')!.textContent = plural(results.length, 'open role');
    $('uc-results-scope')!.textContent = activeCount() ? 'matching your filters' : 'across all programs';

    board.querySelectorAll<HTMLElement>('.uc-layout').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.layout === layout)));
    listEl.className = layout === 'grid' ? GRID_CLASSES : LIST_CLASSES;

    renderFilters();
    renderActiveTags();

    if (!results.length) {
      listEl.innerHTML = '';
      emptyEl.classList.remove('hidden');
      paginationEl.classList.add('hidden');
      return;
    }

    emptyEl.classList.add('hidden');
    paginationEl.classList.remove('hidden');
    const pageJobs = results.slice((currentPage - 1) * PER_PAGE, currentPage * PER_PAGE);
    listEl.innerHTML = pageJobs.map(layout === 'grid' ? gridCard : listCard).join('');
    renderPagination(results.length, totalPages);
  }

  // ---------- modal ----------
  function openModal(job: Job) {
    lastFocus = document.activeElement as HTMLElement;
    $('modal-clearance')!.textContent = job.clearanceLevel || 'No clearance required';
    $('modal-job-code')!.textContent = job.jobCode || '';
    $('modal-title')!.textContent = job.title;
    $('modal-meta')!.textContent = job.location;
    $('modal-stat-pay')!.textContent = hasPay(job.payRate) ? job.payRate : 'Ask your recruiter';
    $('modal-stat-model')!.textContent = job.workplaceType || '-';
    $('modal-stat-type')!.textContent = job.employmentType || '-';
    $('modal-stat-date')!.textContent = job.updatedDate || '-';
    $('modal-description')!.textContent = formatDescription(job.fullDescription || job.summary);
    $<HTMLAnchorElement>('modal-apply-btn')!.href = safeUrl(job.applyUrl);
    modalEl.classList.remove('hidden');
    modalEl.classList.add('flex');
    document.body.style.overflow = 'hidden';
    $('modal-close-btn')!.focus();
  }

  function closeModal() {
    if (modalEl.classList.contains('hidden')) return;
    modalEl.classList.add('hidden');
    modalEl.classList.remove('flex');
    document.body.style.overflow = '';
    lastFocus?.focus();
  }

  // ---------- actions ----------
  function setKeyword(value: string) {
    keyword = value.trim();
    searchInput.value = keyword;
    currentPage = 1;
    renderJobs();
  }

  function resetAll() {
    keyword = '';
    searchInput.value = '';
    FACETS.forEach((f) => selected[f].clear());
    currentPage = 1;
    renderJobs();
  }

  // ---------- events ----------
  $('uc-search-form')!.addEventListener('submit', (e) => {
    e.preventDefault();
    setKeyword(searchInput.value);
    listEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  searchInput.addEventListener('input', () => {
    keyword = searchInput.value.trim();
    currentPage = 1;
    renderJobs();
  });

  $('ceipal-search-clear')!.addEventListener('click', () => {
    setKeyword('');
    searchInput.focus();
  });

  facetInputs.forEach((input) =>
    input.addEventListener('change', () => {
      const set = selected[input.dataset.facet as Facet];
      input.checked ? set.add(input.value) : set.delete(input.value);
      currentPage = 1;
      renderJobs();
    })
  );

  $<HTMLSelectElement>('uc-sort')!.addEventListener('change', (e) => {
    sortBy = (e.target as HTMLSelectElement).value as typeof sortBy;
    renderJobs();
  });

  $('uc-states-more')?.addEventListener('click', (e) => {
    const btn = e.currentTarget as HTMLElement;
    const extras = board.querySelectorAll('.uc-state-extra');
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    extras.forEach((el) => el.classList.toggle('hidden', expanded));
    btn.setAttribute('aria-expanded', String(!expanded));
    btn.textContent = expanded ? `Show ${extras.length} more` : 'Show fewer';
  });

  filtersToggle.addEventListener('click', () => {
    const open = filtersToggle.getAttribute('aria-expanded') === 'true';
    filtersToggle.setAttribute('aria-expanded', String(!open));
    filtersEl.classList.toggle('hidden', open);
  });

  $('ceipal-reset-btn')!.addEventListener('click', resetAll);
  $('ceipal-empty-reset')!.addEventListener('click', resetAll);

  board.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest<HTMLElement>('button');
    if (!target) return;

    if (target.dataset.viewJob) {
      const job = jobsData.find((j) => j.id === target.dataset.viewJob);
      if (job) openModal(job);
    } else if (target.classList.contains('uc-layout')) {
      layout = target.dataset.layout as Layout;
      try {
        localStorage.setItem(LAYOUT_KEY, layout);
      } catch {
        // Ignore storage errors
      }
      renderJobs();
    } else if (target.dataset.remove) {
      if (target.dataset.remove === 'keyword') {
        keyword = '';
        searchInput.value = '';
      } else {
        selected[target.dataset.remove as Facet].delete(target.dataset.value || '');
      }
      currentPage = 1;
      renderJobs();
    } else if (target.dataset.page && target.closest('#ceipal-page-buttons')) {
      const page = Number(target.dataset.page);
      if (!page || page === currentPage) return;
      currentPage = page;
      renderJobs();
      board.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  $('modal-close-btn')!.addEventListener('click', closeModal);
  $('modal-cancel-btn')!.addEventListener('click', closeModal);
  modalEl.addEventListener('click', (e) => {
    if (e.target === modalEl) closeModal();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  // ---------- init ----------
  renderJobs();

  (async function hydrateLiveJobs() {
    try {
      const res = await fetch('/api/jobs?page=all');
      if (!res.ok) return;
      const payload = await res.json();
      if (payload.success && Array.isArray(payload.jobs) && payload.jobs.length) {
        jobsData = payload.jobs;
        renderJobs();
      }
    } catch {
      // Keep the inlined dataset
    }
  })();
</script>
