---
/**
 * CeipalJobBoard.astro - Custom Executive Job Board for Unity Compass
 * 
 * Synchronized with Ceipal ATS API:
 * - 100% Unity Compass Navy (#0B2553, #0C487A) and Star-Red (#FF3130) Design Tokens
 * - Bespoke, elegant custom interactive filter dropdowns
 * - Dynamic Search by title, keyword, skill, or job code (e.g. JPC-77)
 * - Multi-column responsive card grid (2 or 3 cards per row)
 * - Staggered viewport entrance animation for job cards
 * - Executive Requisition Scope Modal with structured key stats
 * - Direct Apply Now CTAs routing to Ceipal's secure candidate portal
 */
import {
  initialCeipalJobs,
  availableStates,
  availableClearances,
  availableEmploymentTypes,
  availableWorkplaceTypes,
  type CeipalJob,
} from '../data/ceipalJobs';
import { companyInfo } from '../data/company';

// Top active state selections (prioritizing major GovCon corridors)
const priorityStates = ['Maryland', 'Virginia', 'District of Columbia'];
const otherStates = availableStates.filter((s) => !priorityStates.includes(s));
const sortedStates = ['All States', ...priorityStates, ...otherStates];
---

<div class="space-y-10" id="ceipal-custom-board">
  
  <!-- ========================================================================= -->
  <!-- SEARCH & BESPOKE CUSTOM FILTER BAR                                        -->
  <!-- ========================================================================= -->
  <div id="ceipal-filter-box" class="career-reveal bg-white rounded-xl border border-slate-200/90 p-5 sm:p-7 shadow-[0_12px_36px_-8px_rgba(12,72,122,0.08)] relative z-30">
    <div class="absolute top-0 inset-x-0 h-1.5 rounded-t-2xl sm:rounded-t-3xl bg-gradient-to-r from-[#0B2553] via-[#FF3130] to-[#0B2553]"></div>

    <!-- Row 1: Keyword Search -->
    <div class="relative mb-5">
      <svg class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        type="text"
        id="ceipal-search-input"
        placeholder="Search positions by title, clearance, skill, or job code (e.g. 'Cloud', 'TS/SCI', 'JPC-77')..."
        class="w-full pl-12 pr-10 py-3.5 text-sm sm:text-base rounded border border-slate-200 bg-slate-50/40 text-[#0B2553] focus:outline-none focus:ring-2 focus:ring-[#0C487A] focus:border-[#0C487A] focus:bg-white transition-all placeholder:text-slate-400 font-medium"
      />
      <button
        type="button"
        id="ceipal-search-clear"
        class="hidden absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-1 cursor-pointer"
        aria-label="Clear search"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Row 2: 4 Custom Executive Interactive Dropdown Filters -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      
      <!-- Filter 1: State / Location -->
      <div class="custom-dropdown relative" data-filter="state">
        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1.5">
          Location / State
        </label>
        <button
          type="button"
          class="dropdown-trigger w-full px-3.5 py-2.5 text-xs sm:text-sm rounded border border-slate-200 bg-slate-50/40 hover:bg-white text-[#0B2553] font-semibold text-left flex items-center justify-between focus:outline-none focus:ring-2 focus:ring-[#0C487A] focus:border-[#0C487A] transition-all cursor-pointer"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <span class="dropdown-selected-label truncate">All States</span>
          <svg class="dropdown-chevron w-4 h-4 text-slate-400 transition-transform duration-200 shrink-0 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <!-- Floating Options Panel -->
        <div class="dropdown-menu hidden absolute top-[calc(100%+6px)] left-0 right-0 bg-white border border-slate-200 rounded shadow-xl shadow-slate-900/10 p-1.5 z-50 max-h-60 overflow-y-auto space-y-0.5">
          {sortedStates.map((st) => (
            <button
              type="button"
              class={`dropdown-option w-full px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold text-slate-700 hover:text-[#0C487A] hover:bg-blue-50/70 flex items-center justify-between text-left transition-colors cursor-pointer ${st === 'All States' ? 'bg-blue-50/50 text-[#0C487A]' : ''}`}
              data-value={st === 'All States' ? '' : st}
            >
              <span class="truncate">{st}</span>
              <svg class={`dropdown-check w-4 h-4 text-[#0C487A] shrink-0 ${st === 'All States' ? '' : 'hidden'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </button>
          ))}
        </div>
      </div>

      <!-- Filter 2: Security Clearance -->
      <div class="custom-dropdown relative" data-filter="clearance">
        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1.5">
          Security Clearance
        </label>
        <button
          type="button"
          class="dropdown-trigger w-full px-3.5 py-2.5 text-xs sm:text-sm rounded border border-slate-200 bg-slate-50/40 hover:bg-white text-[#0B2553] font-semibold text-left flex items-center justify-between focus:outline-none focus:ring-2 focus:ring-[#0C487A] focus:border-[#0C487A] transition-all cursor-pointer"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <span class="dropdown-selected-label truncate">All Clearances</span>
          <svg class="dropdown-chevron w-4 h-4 text-slate-400 transition-transform duration-200 shrink-0 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <!-- Floating Options Panel -->
        <div class="dropdown-menu hidden absolute top-[calc(100%+6px)] left-0 right-0 bg-white border border-slate-200 rounded shadow-xl shadow-slate-900/10 p-1.5 z-50 max-h-60 overflow-y-auto space-y-0.5">
          {availableClearances.map((c) => (
            <button
              type="button"
              class={`dropdown-option w-full px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold text-slate-700 hover:text-[#0C487A] hover:bg-blue-50/70 flex items-center justify-between text-left transition-colors cursor-pointer ${c === 'All Clearances' ? 'bg-blue-50/50 text-[#0C487A]' : ''}`}
              data-value={c === 'All Clearances' ? '' : c}
            >
              <span class="truncate">{c}</span>
              <svg class={`dropdown-check w-4 h-4 text-[#0C487A] shrink-0 ${c === 'All Clearances' ? '' : 'hidden'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </button>
          ))}
        </div>
      </div>

      <!-- Filter 3: Employment Type -->
      <div class="custom-dropdown relative" data-filter="type">
        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1.5">
          Employment Type
        </label>
        <button
          type="button"
          class="dropdown-trigger w-full px-3.5 py-2.5 text-xs sm:text-sm rounded border border-slate-200 bg-slate-50/40 hover:bg-white text-[#0B2553] font-semibold text-left flex items-center justify-between focus:outline-none focus:ring-2 focus:ring-[#0C487A] focus:border-[#0C487A] transition-all cursor-pointer"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <span class="dropdown-selected-label truncate">All Employment Types</span>
          <svg class="dropdown-chevron w-4 h-4 text-slate-400 transition-transform duration-200 shrink-0 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <!-- Floating Options Panel -->
        <div class="dropdown-menu hidden absolute top-[calc(100%+6px)] left-0 right-0 bg-white border border-slate-200 rounded shadow-xl shadow-slate-900/10 p-1.5 z-50 max-h-60 overflow-y-auto space-y-0.5">
          {availableEmploymentTypes.map((t) => (
            <button
              type="button"
              class={`dropdown-option w-full px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold text-slate-700 hover:text-[#0C487A] hover:bg-blue-50/70 flex items-center justify-between text-left transition-colors cursor-pointer ${t === 'All Employment Types' ? 'bg-blue-50/50 text-[#0C487A]' : ''}`}
              data-value={t === 'All Employment Types' ? '' : t}
            >
              <span class="truncate">{t}</span>
              <svg class={`dropdown-check w-4 h-4 text-[#0C487A] shrink-0 ${t === 'All Employment Types' ? '' : 'hidden'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </button>
          ))}
        </div>
      </div>

      <!-- Filter 4: Workplace Model -->
      <div class="custom-dropdown relative" data-filter="workplace">
        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1.5">
          Workplace Model
        </label>
        <button
          type="button"
          class="dropdown-trigger w-full px-3.5 py-2.5 text-xs sm:text-sm rounded border border-slate-200 bg-slate-50/40 hover:bg-white text-[#0B2553] font-semibold text-left flex items-center justify-between focus:outline-none focus:ring-2 focus:ring-[#0C487A] focus:border-[#0C487A] transition-all cursor-pointer"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <span class="dropdown-selected-label truncate">All Workplace Models</span>
          <svg class="dropdown-chevron w-4 h-4 text-slate-400 transition-transform duration-200 shrink-0 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <!-- Floating Options Panel -->
        <div class="dropdown-menu hidden absolute top-[calc(100%+6px)] left-0 right-0 bg-white border border-slate-200 rounded shadow-xl shadow-slate-900/10 p-1.5 z-50 max-h-60 overflow-y-auto space-y-0.5">
          {availableWorkplaceTypes.map((w) => (
            <button
              type="button"
              class={`dropdown-option w-full px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold text-slate-700 hover:text-[#0C487A] hover:bg-blue-50/70 flex items-center justify-between text-left transition-colors cursor-pointer ${w === 'All Workplace Models' ? 'bg-blue-50/50 text-[#0C487A]' : ''}`}
              data-value={w === 'All Workplace Models' ? '' : w}
            >
              <span class="truncate">{w}</span>
              <svg class={`dropdown-check w-4 h-4 text-[#0C487A] shrink-0 ${w === 'All Workplace Models' ? '' : 'hidden'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </button>
          ))}
        </div>
      </div>

    </div>

    <!-- Active Filter Quick Reset Bar -->
    <div id="ceipal-filter-actions" class="hidden mt-4 pt-3.5 border-t border-slate-100 flex items-center justify-between">
      <span class="text-xs font-semibold text-slate-500">
        Filtered Results
      </span>
      <button
        type="button"
        id="ceipal-reset-btn"
        class="text-xs text-[#FF3130] hover:text-[#E02625] font-bold hover:underline inline-flex items-center gap-1.5 cursor-pointer transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Reset Filters</span>
      </button>
    </div>

  </div>

  <!-- ========================================================================= -->
  <!-- MULTI-COLUMN JOB CARDS GRID (2 or 3 in a row)                             -->
  <!-- ========================================================================= -->
  <div id="ceipal-jobs-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <!-- Populated by client script with smooth staggered entrance animation -->
  </div>

  <!-- Empty State (When search has 0 matches) -->
  <div id="ceipal-empty-state" class="hidden bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 p-12 text-center max-w-xl mx-auto shadow-sm">
    <div class="w-14 h-14 rounded-full bg-red-50 text-[#FF3130] flex items-center justify-center mx-auto mb-4">
      <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <h3 class="text-lg font-bold text-[#0B2553] mb-1.5">No Matching Openings Found</h3>
    <p class="text-xs sm:text-sm text-slate-500 mb-6 leading-relaxed">
      We couldn't find any positions matching your selected criteria. Try adjusting your search term, clearing location filters, or connect with our recruitment team.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <button
        type="button"
        id="ceipal-empty-reset"
        class="px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-[#0B2553] hover:bg-[#0C487A] transition-colors cursor-pointer"
      >
        Clear All Filters
      </button>
      <a
        href="#talent-network"
        class="px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-[#FF3130] bg-red-50 hover:bg-red-100 transition-colors"
      >
        Connect With Recruiter
      </a>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- DYNAMIC PAGINATION CONTROLS                                               -->
  <!-- ========================================================================= -->
  <div id="ceipal-pagination" class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-slate-200">
    <div class="text-xs text-slate-500 font-medium">
      Page <span id="ceipal-current-page" class="font-bold text-[#0B2553]">1</span> of <span id="ceipal-total-pages" class="font-bold text-[#0B2553]">{Math.ceil(initialCeipalJobs.length / 9)}</span>
    </div>

    <div class="flex items-center gap-1.5" id="ceipal-page-buttons">
      <!-- Buttons generated dynamically -->
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- ACCESSIBLE EXECUTIVE REQUISITION SCOPE MODAL                              -->
  <!-- ========================================================================= -->
  <div
    id="ceipal-details-modal"
    class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 sm:p-6"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
  >
    <div class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 max-w-3xl w-full max-h-[88vh] flex flex-col shadow-2xl relative overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      
      <!-- Top Brand Color Stripe -->
      <div class="h-1.5 bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130]"></div>

      <!-- Modal Header -->
      <div class="p-6 sm:p-8 border-b border-slate-100 bg-white">
        <div class="flex items-start justify-between gap-4">
          <div class="space-y-2">
            <!-- Badges -->
            <div class="flex flex-wrap items-center gap-2">
              <span id="modal-job-code" class="px-2.5 py-0.5 rounded text-[11px] font-mono font-bold bg-slate-100 text-slate-700"></span>
              <span id="modal-clearance" class="px-3 py-0.5 rounded-full text-xs font-bold border"></span>
              <span id="modal-workplace" class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-[#0B2553]"></span>
            </div>
            <!-- Title -->
            <h3 id="modal-title" class="text-xl sm:text-2xl font-extrabold text-[#0B2553] tracking-tight leading-snug"></h3>
            <!-- Location & Date -->
            <p id="modal-meta" class="text-xs sm:text-sm text-slate-500 font-medium"></p>
          </div>

          <button
            type="button"
            id="modal-close-btn"
            class="p-2 rounded-xl text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors cursor-pointer shrink-0"
            aria-label="Close dialog"
          >
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- 4-Stat Key Highlights Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-5 pt-5 border-t border-slate-100">
          <!-- Stat 1: Location -->
          <div class="p-3 rounded-xl bg-slate-50/80 border border-slate-200/70">
            <div class="flex items-center gap-1.5 text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">
              <svg class="w-3.5 h-3.5 text-[#FF3130]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              </svg>
              <span>Location</span>
            </div>
            <p id="modal-stat-location" class="text-xs sm:text-sm font-bold text-[#0B2553] truncate">-</p>
          </div>

          <!-- Stat 2: Compensation -->
          <div class="p-3 rounded-xl bg-slate-50/80 border border-slate-200/70">
            <div class="flex items-center gap-1.5 text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">
              <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Compensation</span>
            </div>
            <p id="modal-stat-pay" class="text-xs sm:text-sm font-bold text-emerald-800 truncate">Competitive</p>
          </div>

          <!-- Stat 3: Clearance -->
          <div class="p-3 rounded-xl bg-slate-50/80 border border-slate-200/70">
            <div class="flex items-center gap-1.5 text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">
              <svg class="w-3.5 h-3.5 text-[#0C487A]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>Clearance</span>
            </div>
            <p id="modal-stat-clearance" class="text-xs sm:text-sm font-bold text-[#0B2553] truncate">-</p>
          </div>

          <!-- Stat 4: Work Model -->
          <div class="p-3 rounded-xl bg-slate-50/80 border border-slate-200/70">
            <div class="flex items-center gap-1.5 text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-1">
              <svg class="w-3.5 h-3.5 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>Work Model</span>
            </div>
            <p id="modal-stat-model" class="text-xs sm:text-sm font-bold text-[#0B2553] truncate">-</p>
          </div>
        </div>
      </div>

      <!-- Modal Body (Scrollable Requisition Description) -->
      <div class="p-6 sm:p-8 overflow-y-auto space-y-4 flex-1 text-sm text-[#243A5E] leading-relaxed bg-slate-50/40">
        <div>
          <h4 class="text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-2.5 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#FF3130]"></span>
            <span>Position Scope & Qualifications</span>
          </h4>
          <div id="modal-description" class="text-sm sm:text-base text-slate-700 bg-white p-6 rounded-2xl border border-slate-200/80 leading-relaxed shadow-xs whitespace-pre-line font-normal"></div>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="p-5 sm:p-6 bg-white border-t border-slate-100 flex flex-wrap items-center justify-between gap-4">
        <p class="text-xs text-slate-500 hidden sm:flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Verified Ceipal Candidate Portal Requisition.</span>
        </p>

        <div class="flex items-center gap-3 w-full sm:w-auto justify-end">
          <button
            type="button"
            id="modal-cancel-btn"
            class="px-5 py-2.5 rounded-xl text-xs font-bold text-slate-600 hover:text-slate-800 hover:bg-slate-100 transition-colors cursor-pointer"
          >
            Close
          </button>
          <a
            id="modal-apply-btn"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-gradient-to-r from-[#FF3130] to-[#E02625] hover:from-[#E02625] hover:to-[#C61E1D] shadow-md shadow-[#FF3130]/25 transition-all cursor-pointer"
          >
            <span>Apply Now</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>

    </div>
  </div>

</div>

<!-- Card Entrance Animation Styles (is:global required for dynamically inserted cards) -->
<style is:global>
  .ceipal-card-animate {
    opacity: 0;
    transform: translateY(28px);
    will-change: opacity, transform;
    transition:
      opacity 650ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 650ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ceipal-card-animate.is-visible {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }
</style>

<!-- Inlined Initial Dataset so client renders instantly without waiting for network -->
<script define:vars={{ initialJobs: initialCeipalJobs }}>
  window.__INITIAL_CEIPAL_JOBS__ = initialJobs;
</script>

<!-- Master Client Controller: Search, Custom Filter Dropdowns, Pagination, Modal & Viewport Reveal -->
<script>
  interface Job {
    id: string;
    jobCode: string;
    title: string;
    location: string;
    state: string;
    country: string;
    employmentType: string;
    workplaceType: string;
    clearanceLevel: string;
    payRate: string;
    summary: string;
    fullDescription: string;
    updatedDate: string;
    applyUrl: string;
  }

  const jobsData: Job[] = (window as any).__INITIAL_CEIPAL_JOBS__ || [];
  const ITEMS_PER_PAGE = 9; // Maximum 10 cards per page: 3x3 balanced grid across 3 columns
  let currentPage = 1;

  // Active Filter State
  const activeFilters = {
    keyword: '',
    state: '',
    clearance: '',
    type: '',
    workplace: '',
  };

  // DOM Elements
  const listEl = document.getElementById('ceipal-jobs-list');
  const emptyEl = document.getElementById('ceipal-empty-state');
  const searchInput = document.getElementById('ceipal-search-input') as HTMLInputElement | null;
  const searchClear = document.getElementById('ceipal-search-clear');
  const filterActionsBar = document.getElementById('ceipal-filter-actions');
  const resetBtn = document.getElementById('ceipal-reset-btn');
  const emptyResetBtn = document.getElementById('ceipal-empty-reset');
  const curPageEl = document.getElementById('ceipal-current-page');
  const totalPagesEl = document.getElementById('ceipal-total-pages');
  const pageButtonsEl = document.getElementById('ceipal-page-buttons');

  // Modal Elements
  const modalEl = document.getElementById('ceipal-details-modal');
  const modalCloseBtn = document.getElementById('modal-close-btn');
  const modalCancelBtn = document.getElementById('modal-cancel-btn');
  const modalTitle = document.getElementById('modal-title');
  const modalJobCode = document.getElementById('modal-job-code');
  const modalClearance = document.getElementById('modal-clearance');
  const modalWorkplace = document.getElementById('modal-workplace');
  const modalMeta = document.getElementById('modal-meta');
  const modalStatLocation = document.getElementById('modal-stat-location');
  const modalStatPay = document.getElementById('modal-stat-pay');
  const modalStatClearance = document.getElementById('modal-stat-clearance');
  const modalStatModel = document.getElementById('modal-stat-model');
  const modalDescription = document.getElementById('modal-description');
  const modalApplyBtn = document.getElementById('modal-apply-btn') as HTMLAnchorElement | null;

  // Setup Custom Interactive Dropdowns
  function setupCustomDropdowns() {
    const dropdownWrappers = document.querySelectorAll<HTMLElement>('.custom-dropdown');

    dropdownWrappers.forEach((wrapper) => {
      const filterKey = wrapper.getAttribute('data-filter') as keyof typeof activeFilters;
      const triggerBtn = wrapper.querySelector<HTMLButtonElement>('.dropdown-trigger');
      const menu = wrapper.querySelector<HTMLElement>('.dropdown-menu');
      const chevron = wrapper.querySelector<SVGElement>('.dropdown-chevron');
      const label = wrapper.querySelector<HTMLElement>('.dropdown-selected-label');
      const options = wrapper.querySelectorAll<HTMLButtonElement>('.dropdown-option');

      if (!triggerBtn || !menu || !filterKey) return;

      // Toggle dropdown menu
      triggerBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !menu.classList.contains('hidden');

        // Close all other open dropdowns first
        closeAllDropdowns();

        if (!isOpen) {
          menu.classList.remove('hidden');
          chevron?.classList.add('rotate-180');
          triggerBtn.setAttribute('aria-expanded', 'true');
        }
      });

      // Option selection
      options.forEach((opt) => {
        opt.addEventListener('click', (e) => {
          e.stopPropagation();
          const val = opt.getAttribute('data-value') || '';
          const optText = opt.querySelector('span')?.textContent || '';

          activeFilters[filterKey] = val;

          // Update trigger label
          if (label) label.textContent = optText;

          // Update checkmark state
          options.forEach((o) => {
            const isSelected = o === opt;
            const check = o.querySelector('.dropdown-check');
            if (isSelected) {
              o.classList.add('bg-blue-50/50', 'text-[#0C487A]');
              check?.classList.remove('hidden');
            } else {
              o.classList.remove('bg-blue-50/50', 'text-[#0C487A]');
              check?.classList.add('hidden');
            }
          });

          // Close menu
          menu.classList.add('hidden');
          chevron?.classList.remove('rotate-180');
          triggerBtn.setAttribute('aria-expanded', 'false');

          // Trigger reactive re-render
          currentPage = 1;
          renderJobs();
        });
      });
    });

    // Close on click outside
    document.addEventListener('click', () => closeAllDropdowns());

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAllDropdowns();
    });
  }

  function closeAllDropdowns() {
    document.querySelectorAll('.dropdown-menu').forEach((m) => m.classList.add('hidden'));
    document.querySelectorAll('.dropdown-chevron').forEach((c) => c.classList.remove('rotate-180'));
    document.querySelectorAll('.dropdown-trigger').forEach((t) => t.setAttribute('aria-expanded', 'false'));
  }

  function getFilteredJobs(): Job[] {
    const q = (searchInput?.value || '').trim().toLowerCase();
    const st = activeFilters.state;
    const clr = activeFilters.clearance;
    const typ = activeFilters.type;
    const wrk = activeFilters.workplace;

    return jobsData.filter((j) => {
      // Keyword Match (Title, Code, Location, Description)
      if (q) {
        const inTitle = j.title.toLowerCase().includes(q);
        const inCode = j.jobCode.toLowerCase().includes(q);
        const inLoc = j.location.toLowerCase().includes(q);
        const inDesc = j.fullDescription.toLowerCase().includes(q);
        const inClr = j.clearanceLevel.toLowerCase().includes(q);
        if (!inTitle && !inCode && !inLoc && !inDesc && !inClr) return false;
      }

      // State Filter
      if (st && !j.state.toLowerCase().includes(st.toLowerCase())) return false;

      // Clearance Filter
      if (clr && j.clearanceLevel !== clr) return false;

      // Type Filter
      if (typ && !j.employmentType.toLowerCase().includes(typ.toLowerCase())) return false;

      // Workplace Filter
      if (wrk && j.workplaceType !== wrk) return false;

      return true;
    });
  }

  function getClearanceBadgeClass(clr: string): string {
    if (clr.includes('TS/SCI') || clr.includes('Polygraph')) {
      return 'bg-red-50 text-[#FF3130] border-red-200/80';
    }
    if (clr.includes('Top Secret')) {
      return 'bg-purple-50 text-purple-700 border-purple-200/80';
    }
    if (clr.includes('Secret')) {
      return 'bg-blue-50 text-[#0B2553] border-blue-200/80';
    }
    if (clr.includes('Public Trust')) {
      return 'bg-amber-50 text-amber-800 border-amber-200/80';
    }
    return 'bg-slate-50 text-slate-600 border-slate-200';
  }

  function formatDescription(desc: string): string {
    if (!desc) return '';
    return desc
      .replace(/&nbsp;/g, ' ')
      .replace(/\r\n\r\n+/g, '\n\n')
      .replace(/\r\n/g, '\n')
      .trim();
  }

  function renderJobs() {
    const filtered = getFilteredJobs();
    const total = filtered.length;
    const totalPages = Math.ceil(total / ITEMS_PER_PAGE) || 1;

    if (currentPage > totalPages) currentPage = 1;

    const startIdx = (currentPage - 1) * ITEMS_PER_PAGE;
    const endIdx = Math.min(startIdx + ITEMS_PER_PAGE, total);
    const visibleJobs = filtered.slice(startIdx, endIdx);

    // Update Counts
    if (curPageEl) curPageEl.textContent = String(currentPage);
    if (totalPagesEl) totalPagesEl.textContent = String(totalPages);

    // Toggle Search Clear Button & Reset Bar
    const hasActiveFilters = Boolean(
      (searchInput?.value || '').trim() ||
      activeFilters.state ||
      activeFilters.clearance ||
      activeFilters.type ||
      activeFilters.workplace
    );

    if (filterActionsBar) filterActionsBar.classList.toggle('hidden', !hasActiveFilters);
    if (searchClear) searchClear.classList.toggle('hidden', !(searchInput?.value || '').trim());

    // Toggle Empty State vs List
    if (total === 0) {
      if (listEl) listEl.innerHTML = '';
      if (emptyEl) emptyEl.classList.remove('hidden');
      if (pageButtonsEl) pageButtonsEl.innerHTML = '';
      return;
    }

    if (emptyEl) emptyEl.classList.add('hidden');

    // Build Cards HTML (2 or 3 in a row grid)
    if (listEl) {
      listEl.innerHTML = visibleJobs.map((j, index) => {
        const clrClass = getClearanceBadgeClass(j.clearanceLevel);
        const hasPay = Boolean(j.payRate && j.payRate !== 'Not Specified');

        return `
          <div
            class="job-card ceipal-card-animate group relative flex flex-col justify-between rounded-2xl sm:rounded-3xl bg-white border border-slate-200/90 p-6 sm:p-7 shadow-[0_10px_30px_-6px_rgba(12,72,122,0.06)] hover:shadow-[0_20px_45px_-8px_rgba(12,72,122,0.14)] hover:-translate-y-1.5 transition-all duration-300 overflow-hidden"
            data-job-id="${j.id}"
            style="transition-delay: ${(index % 9) * 75}ms;"
          >
            
            <!-- Top Color Stripe -->
            <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130] opacity-80 group-hover:opacity-100 group-hover:h-1.5 transition-all duration-300"></div>

            <!-- Card Upper Section -->
            <div>
              <!-- Badges & Posted Date -->
              <div class="flex items-center justify-between gap-2 mb-3">
                <div class="flex flex-wrap items-center gap-1.5">
                  ${j.jobCode ? `<span class="px-2 py-0.5 rounded text-[11px] font-mono font-bold bg-slate-100 text-slate-700">${j.jobCode}</span>` : ''}
                  <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider border ${clrClass}">
                    ${j.clearanceLevel}
                  </span>
                  <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-blue-50 text-[#0B2553]">
                    ${j.workplaceType}
                  </span>
                </div>

                <div class="flex items-center gap-1 text-[11px] text-slate-400 font-medium shrink-0">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>${j.updatedDate}</span>
                </div>
              </div>

              <!-- Job Title -->
              <h3 class="text-lg sm:text-xl font-bold text-[#0B2553] group-hover:text-[#0C487A] tracking-tight leading-snug line-clamp-2 my-2.5 min-h-[3.25rem] transition-colors">
                ${j.title}
              </h3>

              <!-- Location & Pay Meta Row -->
              <div class="flex flex-wrap items-center gap-y-1.5 gap-x-3 text-xs text-slate-600 mb-3">
                <div class="flex items-center gap-1 truncate max-w-[210px]">
                  <svg class="w-3.5 h-3.5 text-[#FF3130] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span class="font-medium truncate">${j.location}</span>
                </div>

                ${hasPay ? `
                  <div class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200/70 shrink-0">
                    <svg class="w-3 h-3 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>${j.payRate}</span>
                  </div>
                ` : ''}
              </div>

              <!-- Scope Excerpt -->
              <p class="text-xs text-slate-500 leading-relaxed font-normal line-clamp-2 mb-4">
                ${j.summary}
              </p>
            </div>

            <!-- Card Actions Footer -->
            <div class="pt-3.5 border-t border-slate-100 flex items-center justify-between gap-2 mt-auto">
              <button
                type="button"
                class="view-details-btn text-xs font-bold text-[#0C487A] hover:text-[#0B2553] hover:underline inline-flex items-center gap-1 cursor-pointer py-1.5 transition-colors"
                data-id="${j.id}"
              >
                <span>View Scope</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </button>

              <a
                href="${j.applyUrl}"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-lg text-xs font-bold uppercase tracking-wider text-white bg-gradient-to-r from-[#FF3130] to-[#E02625] hover:from-[#E02625] hover:to-[#C61E1D] shadow-[0_4px_14px_rgba(255,49,48,0.22)] hover:shadow-[0_6px_20px_rgba(255,49,48,0.32)] transform hover:-translate-y-0.5 active:translate-y-0 transition-all cursor-pointer"
              >
                <span>Apply Now</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>

          </div>
        `;
      }).join('');

      // Trigger Viewport Animated Stagger
      triggerCardRevealAnimation();
    }

    // Attach Click Events to "View Scope" buttons
    document.querySelectorAll('.view-details-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
        const job = jobsData.find((j) => j.id === id);
        if (job) openModal(job);
      });
    });

    renderPagination(totalPages);
  }

  // Viewport Observer for Job Cards & Filter Box Entrance Animation
  function triggerCardRevealAnimation() {
    // Observe filter container if not already visible
    const filterBox = document.getElementById('ceipal-filter-box');
    if (filterBox && !filterBox.classList.contains('is-visible')) {
      if (!('IntersectionObserver' in window)) {
        filterBox.classList.add('is-visible');
      } else {
        const filterObserver = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.05, rootMargin: '0px 0px -30px 0px' }
        );
        filterObserver.observe(filterBox);
      }
    }

    const cards = document.querySelectorAll<HTMLElement>('.ceipal-card-animate:not(.is-visible)');
    if (!cards.length) return;

    if (!('IntersectionObserver' in window)) {
      cards.forEach((c) => c.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.05, rootMargin: '0px 0px -30px 0px' }
    );

    cards.forEach((c) => observer.observe(c));
  }

  function renderPagination(totalPages: number) {
    if (!pageButtonsEl) return;

    if (totalPages <= 1) {
      pageButtonsEl.innerHTML = '';
      return;
    }

    let html = '';

    // Prev Button
    html += `
      <button
        type="button"
        class="page-nav-btn px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold ${currentPage === 1 ? 'opacity-40 cursor-not-allowed text-slate-400' : 'text-[#0B2553] hover:bg-slate-100 cursor-pointer'} transition-colors"
        data-page="${currentPage - 1}"
        ${currentPage === 1 ? 'disabled' : ''}
      >
        Previous
      </button>
    `;

    // Smart Page Number Buttons calculation
    const getPageNumbers = (current: number, total: number): (number | string)[] => {
      if (total <= 7) {
        return Array.from({ length: total }, (_, i) => i + 1);
      }
      if (current <= 3) {
        return [1, 2, 3, 4, '...', total];
      }
      if (current >= total - 2) {
        return [1, '...', total - 3, total - 2, total - 1, total];
      }
      return [1, '...', current - 1, current, current + 1, '...', total];
    };

    const pages = getPageNumbers(currentPage, totalPages);
    pages.forEach((p) => {
      if (p === '...') {
        html += `<span class="px-2 py-1 text-xs text-slate-400 select-none">...</span>`;
      } else {
        const isActive = p === currentPage;
        html += `
          <button
            type="button"
            class="page-num-btn w-8 h-8 rounded-lg text-xs font-bold transition-all ${
              isActive
                ? 'bg-[#FF3130] text-white shadow-xs'
                : 'text-[#0B2553] hover:bg-slate-100 border border-slate-200'
            } cursor-pointer"
            data-page="${p}"
          >
            ${p}
          </button>
        `;
      }
    });

    // Next Button
    html += `
      <button
        type="button"
        class="page-nav-btn px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-semibold ${currentPage === totalPages ? 'opacity-40 cursor-not-allowed text-slate-400' : 'text-[#0B2553] hover:bg-slate-100 cursor-pointer'} transition-colors"
        data-page="${currentPage + 1}"
        ${currentPage === totalPages ? 'disabled' : ''}
      >
        Next
      </button>
    `;

    pageButtonsEl.innerHTML = html;

    // Attach Pagination Click Handlers
    pageButtonsEl.querySelectorAll('.page-num-btn, .page-nav-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const targetPage = parseInt((e.currentTarget as HTMLElement).getAttribute('data-page') || '1', 10);
        if (targetPage >= 1 && targetPage <= totalPages && targetPage !== currentPage) {
          currentPage = targetPage;
          renderJobs();
          // Smooth scroll to top of job board
          const container = document.getElementById('ceipal-custom-board');
          if (container) {
            container.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });
  }

  function openModal(job: Job) {
    if (!modalEl) return;
    if (modalTitle) modalTitle.textContent = job.title;
    if (modalJobCode) {
      modalJobCode.textContent = job.jobCode || 'REQUISITION';
    }
    if (modalClearance) {
      modalClearance.textContent = job.clearanceLevel;
      modalClearance.className = `px-3 py-0.5 rounded-full text-xs font-bold border ${getClearanceBadgeClass(job.clearanceLevel)}`;
    }
    if (modalWorkplace) modalWorkplace.textContent = `${job.workplaceType} · ${job.employmentType}`;
    if (modalMeta) modalMeta.textContent = `${job.location} · Posted ${job.updatedDate}`;

    // 4 Key Stats
    if (modalStatLocation) modalStatLocation.textContent = job.location || 'Multiple / US';
    if (modalStatPay) {
      modalStatPay.textContent = (job.payRate && job.payRate !== 'Not Specified') ? job.payRate : 'Competitive / Standard';
    }
    if (modalStatClearance) modalStatClearance.textContent = job.clearanceLevel || 'Clearance Eligible';
    if (modalStatModel) modalStatModel.textContent = `${job.workplaceType} · ${job.employmentType}`;

    if (modalDescription) {
      modalDescription.textContent = formatDescription(job.fullDescription);
    }

    if (modalApplyBtn) {
      modalApplyBtn.href = job.applyUrl;
    }

    modalEl.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!modalEl) return;
    modalEl.classList.add('hidden');
    document.body.style.overflow = '';
  }

  // Event Listeners for Keyword Search
  searchInput?.addEventListener('input', () => {
    currentPage = 1;
    renderJobs();
  });

  searchClear?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    currentPage = 1;
    renderJobs();
  });

  function resetAllFilters() {
    if (searchInput) searchInput.value = '';
    activeFilters.keyword = '';
    activeFilters.state = '';
    activeFilters.clearance = '';
    activeFilters.type = '';
    activeFilters.workplace = '';

    // Reset dropdown trigger labels and active options
    document.querySelectorAll<HTMLElement>('.custom-dropdown').forEach((wrapper) => {
      const filterKey = wrapper.getAttribute('data-filter');
      const label = wrapper.querySelector<HTMLElement>('.dropdown-selected-label');
      const options = wrapper.querySelectorAll<HTMLButtonElement>('.dropdown-option');

      let defaultLabel = 'All Options';
      if (filterKey === 'state') defaultLabel = 'All States';
      if (filterKey === 'clearance') defaultLabel = 'All Clearances';
      if (filterKey === 'type') defaultLabel = 'All Employment Types';
      if (filterKey === 'workplace') defaultLabel = 'All Workplace Models';

      if (label) label.textContent = defaultLabel;

      options.forEach((opt, idx) => {
        const check = opt.querySelector('.dropdown-check');
        if (idx === 0) {
          opt.classList.add('bg-blue-50/50', 'text-[#0C487A]');
          check?.classList.remove('hidden');
        } else {
          opt.classList.remove('bg-blue-50/50', 'text-[#0C487A]');
          check?.classList.add('hidden');
        }
      });
    });

    currentPage = 1;
    renderJobs();
  }

  resetBtn?.addEventListener('click', resetAllFilters);
  emptyResetBtn?.addEventListener('click', resetAllFilters);

  // Modal Close Events
  modalCloseBtn?.addEventListener('click', closeModal);
  modalCancelBtn?.addEventListener('click', closeModal);
  modalEl?.addEventListener('click', (e) => {
    if (e.target === modalEl) closeModal();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  // Initialize
  setupCustomDropdowns();
  renderJobs();

  // Background hydration: Fetch fresh live requisitions from Ceipal endpoint
  // to ensure any new positions added by recruiters update seamlessly
  (async function hydrateLiveJobs() {
    try {
      const res = await fetch('/api/jobs?page=all');
      if (res.ok) {
        const payload = await res.json();
        if (payload.success && Array.isArray(payload.jobs) && payload.jobs.length > 0) {
          jobsData.length = 0;
          jobsData.push(...payload.jobs);
          renderJobs();
        }
      }
    } catch (e) {
      // Gracefully silent fallback to initial dataset
    }
  })();
</script>
