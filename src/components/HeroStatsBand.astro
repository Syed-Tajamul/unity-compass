---
/**
 * HeroStatsBand.astro - Performance Credentials & Key Metrics Section
 * 
 * Positioned directly below the Hero Section, adhering to the Unified Theme:
 * - Light sky-to-slate gradient matching the Hero canvas (#F4F8FC via #EBF3FA to #DFEDF8)
 * - Minute checks pattern (16px × 16px) overlay for high-tech GovCon texture
 * - Floating glassmorphic metrics card with frosted blur and subtle shadow
 * - Deep Federal Navy figures (#0F274A) with signature needle red accents (#FF3130)
 * - Interactive hover micro-lift and animated count-up counters
 */
import AnimatedWaveDivider from './AnimatedWaveDivider.astro';
---

<section
  id="hero-stats-band"
  class="relative bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] pt-2 pb-24 sm:pb-28 lg:pb-32 overflow-hidden"
  aria-label="Federal Credentials & Track Record"
>
  <!-- Minute Checks Pattern Overlay (Matching Hero Section Canvas) -->
  <div
    class="absolute inset-0 pointer-events-none opacity-40 mix-blend-multiply"
    style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.09) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.09) 1px, transparent 1px);"
    aria-hidden="true"
  ></div>

  <!-- Soft Ambient Radial Blue Glow focused behind the metrics -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-3/4 h-36 bg-[radial-gradient(circle,rgba(40,121,182,0.12)_0%,transparent_70%)] rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <!-- Container with Floating Glassmorphic Credentials Card -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="stats-glass-card bg-white/90 backdrop-blur-xl rounded-2xl sm:rounded-3xl border border-slate-200/90 shadow-[0_16px_40px_-12px_rgba(15,39,74,0.1),0_0_0_1px_rgba(255,255,255,0.9)_inset] py-7 sm:py-9 px-5 sm:px-8 lg:px-12">
      
      <!-- Semantic List of 4 Metrics -->
      <ul class="stats-grid">
        
        <!-- Col 1: $35M+ | Awarded Contract Value -->
        <li class="stat-col col-1 group/stat">
          <div class="stat-figure-wrap">
            <span class="sr-only">$35M+</span>
            <span class="stat-figure text-[#0F274A]" aria-hidden="true">
              <span class="stat-affix text-[#FF3130] transition-transform duration-300 group-hover/stat:scale-110 inline-block">$</span><span class="count-num font-extrabold tracking-tight" data-target="35">35</span><span class="stat-affix text-[#FF3130] transition-transform duration-300 group-hover/stat:scale-110 inline-block">M+</span>
            </span>
          </div>
          <span class="stat-label text-slate-600 font-semibold group-hover/stat:text-[#0C487A] transition-colors duration-200">Awarded Contract Value</span>
        </li>

        <!-- Divider 1 -->
        <li class="stat-divider" aria-hidden="true"></li>

        <!-- Col 2: 12+ | Federal Proposals Won -->
        <li class="stat-col col-2 group/stat">
          <div class="stat-figure-wrap">
            <span class="sr-only">12+</span>
            <span class="stat-figure text-[#0F274A]" aria-hidden="true">
              <span class="count-num font-extrabold tracking-tight" data-target="12">12</span><span class="stat-affix text-[#FF3130] transition-transform duration-300 group-hover/stat:scale-110 inline-block">+</span>
            </span>
          </div>
          <span class="stat-label text-slate-600 font-semibold group-hover/stat:text-[#0C487A] transition-colors duration-200">Federal Proposals Won</span>
        </li>

        <!-- Divider 2 -->
        <li class="stat-divider" aria-hidden="true"></li>

        <!-- Col 3: 56 CLINs | GSA OASIS+ Readiness -->
        <li class="stat-col col-3 group/stat">
          <div class="stat-figure-wrap">
            <span class="sr-only">56 CLINs</span>
            <span class="stat-figure text-[#0F274A]" aria-hidden="true">
              <span class="count-num font-extrabold tracking-tight" data-target="56">56</span>
              <span class="stat-unit text-[#0C487A] uppercase text-xs sm:text-sm font-bold tracking-wider px-2 py-0.5 rounded-md bg-blue-50/90 border border-blue-200/70 ml-2 group-hover/stat:bg-blue-100/80 group-hover/stat:text-[#0B2553] transition-colors duration-200">CLINs</span>
            </span>
          </div>
          <span class="stat-label text-slate-600 font-semibold group-hover/stat:text-[#0C487A] transition-colors duration-200">GSA OASIS+ Readiness</span>
        </li>

        <!-- Divider 3 -->
        <li class="stat-divider" aria-hidden="true"></li>

        <!-- Col 4: 8 Awards | Cooperative Purchasing -->
        <li class="stat-col col-4 group/stat">
          <div class="stat-figure-wrap">
            <span class="sr-only">8 Awards</span>
            <span class="stat-figure text-[#0F274A]" aria-hidden="true">
              <span class="count-num font-extrabold tracking-tight" data-target="8">8</span>
              <span class="stat-unit text-[#0C487A] uppercase text-xs sm:text-sm font-bold tracking-wider px-2 py-0.5 rounded-md bg-blue-50/90 border border-blue-200/70 ml-2 group-hover/stat:bg-blue-100/80 group-hover/stat:text-[#0B2553] transition-colors duration-200">Awards</span>
            </span>
          </div>
          <span class="stat-label text-slate-600 font-semibold group-hover/stat:text-[#0C487A] transition-colors duration-200">Cooperative Purchasing</span>
        </li>

      </ul>

    </div>
  </div>

  <!-- Continuous 3-Layer Liquid Parallax Wave Section Divider into Section 3 (LogoCarousel white canvas) -->
  <AnimatedWaveDivider fillColor="#ffffff" />
</section>

<style>
  :root {
    --stat-figure-size: 42px;
    --stat-unit-size: 14px;
    --stat-label-size: 14px;
    --stat-border-color: rgba(15, 39, 74, 0.12);
  }

  /* Grid Layout: 4 Equal Columns on Desktop */
  .stats-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: center;
    box-sizing: border-box;
  }

  .stat-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 10px 14px;
    box-sizing: border-box;
    border-radius: 1rem;
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1),
                background-color 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stat-col:hover {
    transform: translateY(-3px);
    background-color: rgba(240, 246, 253, 0.7);
  }

  .stat-col:hover .stat-figure {
    color: #1E40AF;
  }

  /* Vertical Hairline Dividers */
  .stat-divider {
    width: 1px;
    height: 52px;
    background: linear-gradient(180deg, transparent 0%, rgba(15, 39, 74, 0.14) 20%, rgba(15, 39, 74, 0.14) 80%, transparent 100%);
    list-style: none;
  }

  /* Figures & Affixes Typography */
  .stat-figure-wrap {
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    line-height: 1;
  }

  .stat-figure {
    display: inline-flex;
    align-items: baseline;
    font-size: var(--stat-figure-size);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum" 1;
    transition: color 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .count-num {
    display: inline-block;
    font-variant-numeric: tabular-nums;
  }

  .stat-affix {
    font-weight: 800;
  }

  .stat-unit {
    align-self: center;
  }

  /* Labels Typography */
  .stat-label {
    margin-top: 10px;
    font-size: var(--stat-label-size);
    line-height: 1.35;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  @media (max-width: 1279px) and (min-width: 1024px) {
    :root {
      --stat-figure-size: 36px;
      --stat-label-size: 13px;
    }
    .stat-label {
      white-space: normal;
    }
  }

  @media (max-width: 1023px) and (min-width: 768px) {
    .stats-grid {
      grid-template-columns: 1fr 1fr;
      row-gap: 24px;
      column-gap: 20px;
    }
    .stat-divider {
      display: none;
    }
    .stat-col {
      padding: 10px 12px;
    }
    .col-3, .col-4 {
      position: relative;
    }
    .col-3::before, .col-4::before {
      content: '';
      position: absolute;
      top: -12px;
      left: 10%;
      right: 10%;
      height: 1px;
      background-color: var(--stat-border-color);
    }
    :root {
      --stat-figure-size: 34px;
      --stat-label-size: 13px;
    }
    .stat-label {
      white-space: normal;
    }
  }

  @media (max-width: 767px) {
    .stats-grid {
      grid-template-columns: 1fr 1fr;
      row-gap: 20px;
      column-gap: 12px;
    }
    .stat-divider {
      display: none;
    }
    .stat-col {
      padding: 8px 6px;
    }
    .col-3, .col-4 {
      position: relative;
    }
    .col-3::before, .col-4::before {
      content: '';
      position: absolute;
      top: -10px;
      left: 8%;
      right: 8%;
      height: 1px;
      background-color: var(--stat-border-color);
    }
    :root {
      --stat-figure-size: 30px;
      --stat-unit-size: 12px;
      --stat-label-size: 12px;
    }
    .stat-label {
      white-space: normal;
      margin-top: 6px;
      line-height: 1.25;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stat-col {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<!-- Synchronized Smooth Count-Up Animation Script -->
<script>
  function initStatsCounters() {
    const band = document.getElementById('hero-stats-band');
    if (!band) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const countElements = band.querySelectorAll<HTMLElement>('.count-num');

    function runAnimation() {
      if (prefersReducedMotion) {
        countElements.forEach((el) => {
          const target = el.getAttribute('data-target') || '';
          el.textContent = target;
        });
        return;
      }

      // Smooth count-up using requestAnimationFrame over 1400ms
      const duration = 1400;

      countElements.forEach((el) => {
        const target = parseInt(el.getAttribute('data-target') || '0', 10);
        el.textContent = '0';

        let startTime: number | null = null;

        function step(timestamp: number) {
          if (!startTime) startTime = timestamp;
          const elapsed = timestamp - startTime;
          const progress = Math.min(elapsed / duration, 1);
          // Ease-out cubic: 1 - (1 - progress)^3
          const easeProgress = 1 - Math.pow(1 - progress, 3);
          const currentVal = Math.floor(target * easeProgress);

          el.textContent = currentVal.toString();

          if (progress < 1) {
            requestAnimationFrame(step);
          } else {
            el.textContent = target.toString();
          }
        }

        requestAnimationFrame(step);
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            runAnimation();
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 }
    );

    observer.observe(band);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStatsCounters);
  } else {
    initStatsCounters();
  }
  document.addEventListener('astro:page-load', initStatsCounters);
</script>
