---
import { homeServices } from '../data/services';
import ServiceCard from './ServiceCard.astro';
---

<section id="services" class="py-24 lg:py-32 bg-[#F8FAFC] relative overflow-hidden border-t border-slate-200" aria-labelledby="services-heading">
  <!-- Subtle technical grid background -->
  <div class="absolute inset-0 bg-fed-grid-light opacity-50 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header Group -->
    <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-20 reveal-on-scroll">
      <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-[#FF3130] mb-3">
        <span class="w-6 h-px bg-[#FF3130]"></span>
        <span>Federal Consulting & Workforce Solutions</span>
        <span class="w-6 h-px bg-[#FF3130]"></span>
      </div>

      <h2 id="services-heading" class="text-3xl sm:text-5xl font-extrabold text-[#0C487A] tracking-tight leading-tight">
        Our Services
      </h2>

      <!-- Verbatim Supporting Text from Prompt -->
      <p class="text-base sm:text-lg text-slate-600 mt-4 leading-relaxed font-normal">
        Integrated consulting, staffing, and compliance solutions designed for the demands of federal contracting.
      </p>
    </div>

    <!-- 6 Services Grid (3 columns on lg, 2 on md, 1 on sm) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="services-grid">
      {homeServices.map((service, index) => (
        <ServiceCard
          number={service.number}
          id={service.id}
          title={service.title}
          description={service.description}
          deliverables={service.deliverables}
          href={service.href}
          badge={service.badge}
          iconSvg={service.iconSvg}
          delayIndex={index}
        />
      ))}
    </div>

    <!-- Bottom Advisory Note & Consultation Banner -->
    <div class="mt-16 bg-white rounded-2xl p-8 border border-slate-200/90 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6 reveal-on-scroll">
      <div class="space-y-1 text-center md:text-left">
        <div class="flex items-center justify-center md:justify-start gap-2 text-xs font-mono font-bold uppercase tracking-wider text-[#0C487A]">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Customized GovCon Delivery Model</span>
        </div>
        <h3 class="text-lg font-bold text-slate-900 tracking-tight">
          Need a Tailored Capture, OASIS+ Readiness, or Cleared Staffing Strategy?
        </h3>
        <p class="text-xs sm:text-sm text-slate-500 font-normal">
          We structure modular engagements tailored to specific RFPs, task orders, and agency compliance mandates.
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <a
          href="/contact"
          class="btn-outline-transition-navy inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg text-xs font-bold uppercase tracking-wider shadow-sm active:scale-[0.98] cursor-pointer"
        >
          <span>Schedule Scoping Call</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

  </div>
</section>

<!-- Eonyx-Inspired Interactive 3D Tilt & Mouse Spotlight Script -->
<script>
  function setupServiceCardsInteractive() {
    const cards = document.querySelectorAll<HTMLElement>('[data-service-card]');
    
    // Check if user prefers reduced motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    cards.forEach((cardContainer) => {
      const card = cardContainer.querySelector<HTMLElement>('.tilt-card');
      if (!card) return;

      const handleMouseMove = (e: MouseEvent) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        // Set spotlight CSS variables
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);

        // Subtle 3D tilt calculation (max 4.5 degrees for mature, professional feel)
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = ((y - centerY) / centerY) * -4.5;
        const rotateY = ((x - centerX) / centerX) * 4.5;

        card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-2px)`;
      };

      const handleMouseLeave = () => {
        card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0px)';
      };

      cardContainer.addEventListener('mousemove', handleMouseMove);
      cardContainer.addEventListener('mouseleave', handleMouseLeave);
    });
  }

  // Initialize on DOM load and after navigation
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupServiceCardsInteractive);
  } else {
    setupServiceCardsInteractive();
  }
</script>

