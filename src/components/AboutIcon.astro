---
/**
 * AboutIcon.astro - High-Performance Inlined SVG Icon Renderer
 * 
 * Replaces the heavy `lucide-astro` barrel import (which pulled in 1,897 .astro files
 * and caused a 15-second compilation/load stall).
 * 
 * Features:
 * - 0 external imports, 0 barrel dependency crawl
 * - Instant compile time (<1ms)
 * - Exact Lucide SVG geometry preserved
 */
import aboutIconPaths from './aboutIconPaths.json';

interface Props {
  name: string;
  class?: string;
  'stroke-width'?: number | string;
  'aria-hidden'?: boolean | 'true' | 'false';
  [key: string]: any;
}

const {
  name,
  class: className = 'h-5 w-5',
  'stroke-width': strokeWidth = 2,
  'aria-hidden': ariaHidden = true,
  ...rest
} = Astro.props;

const pathData = (aboutIconPaths as Record<string, string>)[name] || '';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['lucide', `lucide-${name.toLowerCase()}`, className]}
  aria-hidden={ariaHidden ? 'true' : undefined}
  set:html={pathData}
  {...rest}
/>

