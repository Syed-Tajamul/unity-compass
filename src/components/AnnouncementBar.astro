---
import { companyInfo } from '../data/company';
---

<div class="bg-[#F0F6FD] text-slate-600 text-xs py-2 px-4 border-b border-slate-200/80 relative z-50">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2">
    <!-- Announcement Notice -->
    <div class="flex items-center gap-2 text-center sm:text-left">
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-[#EE8522] text-white uppercase tracking-wider shadow-xs">
        GovCon Update
      </span>
      <span class="text-slate-700 font-medium">
        Assisting organizations with <span class="text-[#0B2553] font-bold">GSA OASIS+ Readiness</span> &amp; Federal Bid Capture.
      </span>
      <a href="/contact" class="text-[#3355A5] hover:text-[#EE8522] underline underline-offset-2 ml-1 transition-colors font-semibold cursor-pointer">
        Inquire now &rarr;
      </a>
    </div>

    <!-- Direct Contact Quick Links -->
    <div class="hidden md:flex items-center gap-5 text-slate-600">
      <a href={`tel:${companyInfo.phoneRaw}`} class="flex items-center gap-1.5 hover:text-[#0B2553] transition-colors">
        <svg class="w-3.5 h-3.5 text-[#EE8522]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span class="font-medium text-slate-700">{companyInfo.phone}</span>
      </a>

      <span class="text-slate-300">|</span>

      <a href={`mailto:${companyInfo.email}`} class="flex items-center gap-1.5 hover:text-[#0B2553] transition-colors">
        <svg class="w-3.5 h-3.5 text-[#EE8522]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span class="font-medium text-slate-700">{companyInfo.email}</span>
      </a>

      <span class="text-slate-300">|</span>

      <a
        href={companyInfo.capabilityPdf}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-slate-700 hover:text-[#0B2553] transition-colors font-medium"
      >
        <svg class="w-3.5 h-3.5 text-[#3355A5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>Capability Statement (PDF)</span>
      </a>
    </div>
  </div>
</div>
