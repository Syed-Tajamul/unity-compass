---
import { navigationLinks } from '../data/navigation';
import { companyInfo } from '../data/company';

const currentPath = Astro.url.pathname;

// 5 Core Service Practice Areas (OASIS+ qualification removed per user request)
const servicesDropdown = [
  {
    name: 'Proposal Development Services',
    href: '/proposal-development-services',
  },
  {
    name: 'Security-Cleared Recruitment',
    href: '/recruitment-services',
  },
  {
    name: 'Staffing Solutions',
    href: '/staffing',
  },
  {
    name: 'IT & Business Consulting',
    href: '/information-technology-and-business-consulting',
  },
  {
    name: 'Customized Support Services',
    href: '/customized-support-services',
  },
];

const resourcesDropdown = [
  {
    name: 'Insights & Blog',
    href: '/blog',
  },
  {
    name: 'Capability Statement (PDF)',
    href: '/documents/capability-statement.pdf',
    isPdf: true,
  },
];
---

<header
  id="main-header"
  class="sticky top-0 z-40 translate-y-0 border-b border-transparent bg-gradient-to-r from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] transition-[transform,background-color,box-shadow,border-color] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] will-change-transform"
>
  <!-- Subtle Minute Check Pattern Overlay -->
  <div
    class="absolute inset-0 pointer-events-none opacity-30 -z-10"
    style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.06) 1px, transparent 1px);"
    aria-hidden="true"
  ></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 transition-all duration-300" id="header-inner">
      
      <!-- Zone 1 (Left): Brand Logo -->
      <a
        href="/"
        class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-[#0C487A] rounded-lg p-1 transition-transform shrink-0"
        aria-label="Unity Compass - Home"
      >
        <img
          src="/images/Green-Minimal-Travel-Business-Logo.png"
          alt="Unity Compass - Your Partner In Government Contracting Success"
          class="h-10 sm:h-11 w-auto object-contain transition-transform duration-200 group-hover:scale-[1.02]"
          width="207"
          height="55"
        />
      </a>

      <!-- Zone 2 (Center): Horizontally Centered Desktop Navigation -->
      <nav class="hidden lg:flex flex-1 items-center justify-center gap-1 sm:gap-2 xl:gap-3.5 mx-4 whitespace-nowrap" aria-label="Main Navigation">
        
        <!-- Home Link with Signature Red Active Indicator -->
        <a
          href="/"
          class={`nav-link whitespace-nowrap px-2.5 py-2 text-sm font-semibold transition-colors ${
            currentPath === '/' ? 'text-[#FF3130] active font-bold' : 'text-slate-800 hover:text-[#0C487A]'
          }`}
        >
          <span>Home</span>
        </a>

        <!-- Services Dropdown -->
        <div class="relative group/nav py-6">
          <button
            type="button"
            class={`nav-link whitespace-nowrap inline-flex items-center gap-1 px-2.5 py-2 text-sm font-semibold transition-colors cursor-pointer ${
              currentPath.includes('proposal') || currentPath.includes('recruitment') || currentPath.includes('staffing') || currentPath.includes('consulting') || currentPath.includes('customized')
                ? 'text-[#FF3130] active font-bold'
                : 'text-slate-800 hover:text-[#0C487A]'
            }`}
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>Our Services</span>
            <svg
              class="w-3.5 h-3.5 text-current transition-transform duration-200 group-hover/nav:rotate-180 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown Panel: Solid White Card (Zero Transparency Bleed, 100% Readable) -->
          <div class="nav-dropdown-panel absolute left-0 top-full -mt-1 w-[380px] sm:w-[420px] rounded-2xl bg-white p-2.5 shadow-[0_24px_50px_-10px_rgba(15,39,74,0.22),0_0_0_1px_rgba(15,39,74,0.08)] border border-slate-200 z-50">
            <div class="space-y-0.5">
              {servicesDropdown.map((service) => (
                <a
                  href={service.href}
                  class="dropdown-link-row group/item"
                >
                  <div class="flex items-center gap-2.5 min-w-0 pr-1">
                    <span class="dropdown-pip shrink-0" aria-hidden="true"></span>
                    <span class="dropdown-link-text text-[13px] sm:text-[13.5px] font-semibold whitespace-nowrap">
                      {service.name}
                    </span>
                  </div>
                  <svg class="dropdown-arrow w-3.5 h-3.5 shrink-0 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- About Us Direct Link (Dropdown removed per user request) -->
        <a
          href="/about-us"
          class={`nav-link whitespace-nowrap px-2.5 py-2 text-sm font-semibold transition-colors ${
            currentPath.startsWith('/about-us') ? 'text-[#FF3130] active font-bold' : 'text-slate-800 hover:text-[#0C487A]'
          }`}
        >
          <span>About Us</span>
        </a>

        <!-- Resources Dropdown (Insights & Blog + Capability Statement) -->
        <div class="relative group/nav py-6">
          <button
            type="button"
            class={`nav-link whitespace-nowrap inline-flex items-center gap-1 px-2.5 py-2 text-sm font-semibold transition-colors cursor-pointer ${
              currentPath.startsWith('/blog') ? 'text-[#FF3130] active font-bold' : 'text-slate-800 hover:text-[#0C487A]'
            }`}
            aria-expanded="false"
            aria-haspopup="true"
          >
            <span>Resources</span>
            <svg
              class="w-3.5 h-3.5 text-current transition-transform duration-200 group-hover/nav:rotate-180 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown Panel: Solid White Card (Zero Transparency Bleed, 100% Readable) -->
          <div class="nav-dropdown-panel absolute left-0 top-full -mt-1 w-[290px] sm:w-[320px] rounded-2xl bg-white p-2.5 shadow-[0_24px_50px_-10px_rgba(15,39,74,0.22),0_0_0_1px_rgba(15,39,74,0.08)] border border-slate-200 z-50">
            <div class="space-y-0.5">
              {resourcesDropdown.map((item) => (
                <a
                  href={item.href}
                  target={item.isPdf ? '_blank' : undefined}
                  rel={item.isPdf ? 'noopener noreferrer' : undefined}
                  class="dropdown-link-row group/item"
                >
                  <div class="flex items-center gap-2.5 min-w-0 pr-1">
                    <span class="dropdown-pip shrink-0" aria-hidden="true"></span>
                    <span class="dropdown-link-text text-[13px] sm:text-[13.5px] font-semibold whitespace-nowrap">
                      {item.name}
                    </span>
                  </div>
                  <svg class="dropdown-arrow w-3.5 h-3.5 shrink-0 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Careers (Disabled for meeting) -->
        <a
          href="javascript:void(0)"
          class={`nav-link whitespace-nowrap px-2.5 py-2 text-sm font-semibold transition-colors cursor-pointer ${
            currentPath.startsWith('/career') ? 'text-[#FF3130] active font-bold' : 'text-slate-800 hover:text-[#0C487A]'
          }`}
        >
          <span>Careers</span>
        </a>

        <!-- Contact Us (Disabled for meeting) -->
        <a
          href="javascript:void(0)"
          class={`nav-link whitespace-nowrap px-2.5 py-2 text-sm font-semibold transition-colors cursor-pointer ${
            currentPath.startsWith('/contact') ? 'text-[#FF3130] active font-bold' : 'text-slate-800 hover:text-[#0C487A]'
          }`}
        >
          <span>Contact Us</span>
        </a>

      </nav>

      <!-- Zone 3 (Right): Pinned Action CTA Button -->
      <div class="hidden lg:flex items-center shrink-0">
        <a
          href="/contact"
          class="btn-needle-red whitespace-nowrap inline-flex items-center justify-center h-10 sm:h-11 px-5 sm:px-6 rounded-lg text-white text-xs sm:text-sm font-semibold tracking-normal shadow-xs transition-all duration-200 cursor-pointer shrink-0"
        >
          <span>Book a Strategy Call</span>
        </a>
      </div>

      <!-- Mobile Hamburger Trigger -->
      <div class="flex lg:hidden items-center gap-2">
        <a
          href={`tel:${companyInfo.phoneRaw}`}
          class="p-2 rounded-lg text-slate-700 hover:text-[#2879B6] hover:bg-slate-100 transition-colors"
          aria-label="Call Unity Compass"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </a>

        <a
          href="/contact"
          class="btn-needle-red px-3.5 py-1.5 text-xs font-semibold rounded-md cursor-pointer"
        >
          Book Call
        </a>

        <button
          type="button"
          id="mobile-menu-btn"
          class="p-2 rounded-lg text-slate-700 hover:text-[#0C487A] hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-[#0C487A] transition-colors cursor-pointer"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

</header>

<div
  id="mobile-menu-backdrop"
  class="fixed inset-0 z-40 bg-slate-950/30 opacity-0 backdrop-blur-sm pointer-events-none lg:hidden"
  aria-hidden="true"
></div>

<aside
  id="mobile-menu"
  class="fixed inset-y-0 left-0 z-50 w-4/5 -translate-x-full overflow-hidden border-r border-slate-200 bg-white shadow-[20px_0_55px_-18px_rgba(15,39,74,0.35)] lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile navigation"
  aria-hidden="true"
  inert
>
  <div class="flex h-20 items-center justify-between border-b border-slate-200 bg-gradient-to-r from-[#F4F8FC] to-[#EBF3FA] px-4 sm:px-5">
    <a href="/" class="rounded-lg focus:outline-none focus:ring-2 focus:ring-[#0C487A]" aria-label="Unity Compass - Home">
      <img
        src="/images/Green-Minimal-Travel-Business-Logo.png"
        alt="Unity Compass"
        class="h-10 w-auto object-contain"
        width="207"
        height="55"
      />
    </a>
    <button
      type="button"
      id="mobile-menu-close"
      class="flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 shadow-sm transition hover:border-[#0C487A]/30 hover:text-[#FF3130] focus:outline-none focus:ring-2 focus:ring-[#0C487A]"
      aria-label="Close navigation menu"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav class="h-[calc(100dvh-5rem)] overflow-y-auto overscroll-contain px-4 pb-8 pt-4 sm:px-5" aria-label="Mobile navigation">
    <div class="space-y-1">
      <a
        href="/"
        class={`block px-3 py-2.5 rounded-lg text-base font-semibold border-b border-slate-50 transition-colors ${
          currentPath === '/' ? 'text-[#FF3130] bg-red-50/50' : 'text-slate-800 hover:text-[#0C487A]'
        }`}
      >
        Home
      </a>

      <!-- Mobile Services List -->
      <div class="py-2 border-b border-slate-100">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block px-3 py-1 font-mono">
          Services
        </span>
        <div class="mt-1 space-y-1 pl-2">
          {servicesDropdown.map((sub) => (
            <a
              href={sub.href}
              class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:text-[#0C487A] hover:bg-slate-50 transition-colors"
            >
              {sub.name}
            </a>
          ))}
        </div>
      </div>

      <!-- Mobile About Us Direct Link -->
      <a
        href="/about-us"
        class={`block px-3 py-2.5 rounded-lg text-base font-semibold border-b border-slate-50 transition-colors ${
          currentPath.startsWith('/about-us') ? 'text-[#FF3130] bg-red-50/50' : 'text-slate-800 hover:text-[#0C487A]'
        }`}
      >
        About Us
      </a>

      <!-- Mobile Resources List -->
      <div class="py-2 border-b border-slate-100">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block px-3 py-1 font-mono">
          Resources
        </span>
        <div class="mt-1 space-y-1 pl-2">
          {resourcesDropdown.map((sub) => (
            <a
              href={sub.href}
              target={sub.isPdf ? '_blank' : undefined}
              rel={sub.isPdf ? 'noopener noreferrer' : undefined}
              class="block px-3 py-2 rounded-lg text-sm font-medium text-slate-700 hover:text-[#0C487A] hover:bg-slate-50 transition-colors"
            >
              {sub.name}
            </a>
          ))}
        </div>
      </div>

      <a
        href="javascript:void(0)"
        class={`block px-3 py-2.5 rounded-lg text-base font-semibold border-b border-slate-50 transition-colors cursor-pointer ${
          currentPath.startsWith('/career') ? 'text-[#FF3130] bg-red-50/50' : 'text-slate-800 hover:text-[#0C487A]'
        }`}
      >
        Careers
      </a>

      <a
        href="javascript:void(0)"
        class={`block px-3 py-2.5 rounded-lg text-base font-semibold border-b border-slate-50 transition-colors cursor-pointer ${
          currentPath.startsWith('/contact') ? 'text-[#FF3130] bg-red-50/50' : 'text-slate-800 hover:text-[#0C487A]'
        }`}
      >
        Contact Us
      </a>

      <!-- Mobile Drawer Footer -->
      <div class="pt-4 space-y-3">
        <a
          href={companyInfo.capabilityPdf}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 w-full py-2.5 text-sm font-semibold rounded-lg border border-slate-200 text-slate-700 bg-slate-50 hover:bg-slate-100 transition-colors"
        >
          <svg class="w-4 h-4 text-[#FF3130]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Download Capability Statement (PDF)</span>
        </a>

        <div class="text-center pt-2 text-xs text-slate-500">
          <p>Direct GovCon Advisory: <a href={`tel:${companyInfo.phoneRaw}`} class="font-bold text-[#0C487A]">{companyInfo.phone}</a></p>
        </div>
      </div>
    </div>
  </nav>
</aside>

<style>
  #main-header {
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
    transition: transform 360ms cubic-bezier(0.22, 1, 0.36, 1),
                background 220ms ease,
                border-color 220ms ease,
                box-shadow 220ms ease;
    will-change: transform;
  }

  #main-header.header-hidden {
    transform: translate3d(0, -105%, 0);
    transition-duration: 560ms, 220ms, 220ms, 220ms;
  }

  #main-header.is-scrolled {
    border-color: #E2E8F0;
    background: rgba(255, 255, 255, 0.97);
    box-shadow: 0 4px 16px -10px rgba(15, 39, 74, 0.3);
  }

  #mobile-menu-backdrop {
    transform: translateZ(0);
    transition: opacity 420ms ease-out;
    will-change: opacity;
  }

  #mobile-menu-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
    transition-duration: 260ms;
  }

  #mobile-menu {
    background-color: #FFFFFF;
    transform: translate3d(-102%, 0, 0);
    backface-visibility: hidden;
    contain: layout paint style;
    transition: transform 560ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  #mobile-menu.is-open {
    transform: translate3d(0, 0, 0);
    transition-duration: 420ms;
  }

  @media (prefers-reduced-motion: reduce) {
    #main-header,
    #mobile-menu,
    #mobile-menu-backdrop {
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  const header = document.getElementById('main-header');
  const menuButton = document.getElementById('mobile-menu-btn');
  const menuCloseButton = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('mobile-menu-backdrop');
  const desktopMedia = window.matchMedia('(min-width: 1024px)');

  let menuOpen = false;
  let lastFocusedElement: HTMLElement | null = null;

  function setMenuState(open: boolean, restoreFocus = true) {
    if (!menu || !menuButton || !backdrop) return;

    menuOpen = open;
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
    menu.setAttribute('aria-hidden', String(!open));
    menu.classList.toggle('is-open', open);
    backdrop.classList.toggle('is-open', open);
    document.body.style.overflow = open ? 'hidden' : '';

    if (open) {
      lastFocusedElement = document.activeElement instanceof HTMLElement
        ? document.activeElement
        : menuButton;
      menu.removeAttribute('inert');
      header?.classList.remove('header-hidden');
      requestAnimationFrame(() => menuCloseButton?.focus());
      return;
    }

    if (restoreFocus && lastFocusedElement) {
      lastFocusedElement.focus();
    }
    menu.setAttribute('inert', '');
  }

  menuButton?.addEventListener('click', () => setMenuState(!menuOpen));
  menuCloseButton?.addEventListener('click', () => setMenuState(false));
  backdrop?.addEventListener('click', () => setMenuState(false));

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuState(false, false));
  });

  document.addEventListener('keydown', (event) => {
    if (!menuOpen || !menu) return;

    if (event.key === 'Escape') {
      event.preventDefault();
      setMenuState(false);
      return;
    }

    if (event.key !== 'Tab') return;
    const focusableElements = Array.from(
      menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')
    );
    const firstElement = focusableElements[0];
    const lastElement = focusableElements[focusableElements.length - 1];
    if (!firstElement || !lastElement) return;

    if (event.shiftKey && document.activeElement === firstElement) {
      event.preventDefault();
      lastElement.focus();
    } else if (!event.shiftKey && document.activeElement === lastElement) {
      event.preventDefault();
      firstElement.focus();
    }
  });

  desktopMedia.addEventListener('change', (event) => {
    if (event.matches && menuOpen) setMenuState(false, false);
  });

  let previousScroll = window.scrollY;
  let accumulatedScroll = 0;
  let scrollDirection = 0;
  let scrollTicking = false;
  const HIDE_THRESHOLD = 32;
  const SHOW_THRESHOLD = 14;

  function updateHeaderOnScroll() {
    if (!header) return;

    const currentScroll = Math.max(window.scrollY, 0);
    const delta = currentScroll - previousScroll;
    const currentDirection = Math.sign(delta);
    header.classList.toggle('is-scrolled', currentScroll > 20);

    if (menuOpen || currentScroll <= 80) {
      header.classList.remove('header-hidden');
      accumulatedScroll = 0;
    } else if (currentDirection !== 0) {
      if (currentDirection !== scrollDirection) {
        accumulatedScroll = 0;
        scrollDirection = currentDirection;
      }

      accumulatedScroll += delta;

      if (accumulatedScroll >= HIDE_THRESHOLD) {
        header.classList.add('header-hidden');
        accumulatedScroll = 0;
      } else if (accumulatedScroll <= -SHOW_THRESHOLD) {
        header.classList.remove('header-hidden');
        accumulatedScroll = 0;
      }
    }

    previousScroll = currentScroll;
    scrollTicking = false;
  }

  window.addEventListener('scroll', () => {
    if (scrollTicking) return;
    scrollTicking = true;
    requestAnimationFrame(updateHeaderOnScroll);
  }, { passive: true });

  updateHeaderOnScroll();
</script>
