---
import { companyInfo } from '../data/company';
---

<!-- Global Floating Contact & Support Widget (Bottom-Right FAB) -->
<div id="floating-support-hub" class="fixed bottom-6 right-6 z-50 select-none">

  <!-- Popup Quick-Connect Modal Card -->
  <div
    id="support-hub-popover"
    class="opacity-0 pointer-events-none translate-y-3 scale-95 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] mb-3 w-[310px] sm:w-[340px] rounded-2xl bg-white/98 backdrop-blur-md border border-slate-200/90 shadow-[0_24px_55px_-12px_rgba(15,39,74,0.28),0_0_0_1px_rgba(15,39,74,0.06)] overflow-hidden"
    role="dialog"
    aria-label="Direct Support & Advisory Options"
    aria-hidden="true"
  >
    <!-- Card Top Header -->
    <div class="bg-gradient-to-r from-[#0C487A] via-[#103E6B] to-[#1E40AF] px-4 py-3.5 text-white flex items-center justify-between relative overflow-hidden">
      <!-- Ambient Glow Streak -->
      <div class="absolute -right-6 -top-6 w-24 h-24 rounded-full bg-white/10 blur-xl pointer-events-none"></div>

      <div class="flex items-center gap-2.5 min-w-0">
        <div class="w-8 h-8 rounded-xl bg-white/15 backdrop-blur-sm border border-white/20 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z" />
          </svg>
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <h4 class="text-xs font-bold uppercase tracking-wider text-blue-100 font-mono">Direct Advisory</h4>
          </div>
          <p class="text-[13px] font-semibold text-white truncate">How can we assist you today?</p>
        </div>
      </div>

      <!-- Close Button -->
      <button
        type="button"
        id="support-hub-close"
        class="w-7 h-7 rounded-lg bg-white/10 hover:bg-white/20 text-white/80 hover:text-white flex items-center justify-center transition-colors cursor-pointer shrink-0"
        aria-label="Close support menu"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Quick Action Links -->
    <div class="p-3 space-y-2">
      <!-- 1. Direct Federal Advisory Phone Call -->
      <a
        href={`tel:${companyInfo.phoneRaw}`}
        class="flex items-center gap-3 p-2.5 rounded-xl bg-slate-50 hover:bg-blue-50/80 border border-slate-200/70 hover:border-[#0C487A]/30 transition-all duration-200 group"
      >
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#0C487A] to-[#1E40AF] text-white flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-900 group-hover:text-[#0C487A] transition-colors">Toll-Free Phone Call</span>
            <span class="text-[10px] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200/60 px-1.5 py-0.5 rounded-full">Mon–Fri</span>
          </div>
          <span class="text-xs font-semibold text-[#0C487A] block font-mono tracking-tight">{companyInfo.phone}</span>
        </div>
      </a>

      <!-- 2. Book a Strategy Call -->
      <a
        href="/contact"
        class="flex items-center gap-3 p-2.5 rounded-xl bg-slate-50 hover:bg-red-50/80 border border-slate-200/70 hover:border-[#FF3130]/30 transition-all duration-200 group"
      >
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#FF3130] to-[#DC2626] text-white flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <span class="text-xs font-bold text-slate-900 group-hover:text-[#FF3130] transition-colors block">Book a Strategy Call</span>
          <span class="text-[11px] text-slate-500 block">30-minute GovCon capture consultation</span>
        </div>
        <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-[#FF3130] group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <!-- 3. Corporate Email Support -->
      <a
        href={`mailto:${companyInfo.email}`}
        class="flex items-center gap-3 p-2.5 rounded-xl bg-slate-50 hover:bg-slate-100/90 border border-slate-200/70 hover:border-slate-300 transition-all duration-200 group"
      >
        <div class="w-10 h-10 rounded-xl bg-slate-200 text-slate-700 flex items-center justify-center shrink-0 group-hover:bg-[#0C487A] group-hover:text-white transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <span class="text-xs font-bold text-slate-900 group-hover:text-[#0C487A] transition-colors block">Email Inquiries</span>
          <span class="text-[11px] text-slate-500 truncate block">{companyInfo.email}</span>
        </div>
      </a>

      <!-- 4. Download Capability Statement PDF -->
      <a
        href={companyInfo.capabilityPdf}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full py-2 px-3 rounded-lg bg-blue-50/80 hover:bg-blue-100 text-[#0C487A] text-[11.5px] font-semibold border border-blue-200/70 transition-colors"
      >
        <svg class="w-3.5 h-3.5 text-[#FF3130]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>Download Capability Statement (PDF)</span>
      </a>
    </div>
  </div>

  <!-- Main Floating Action Button (FAB Trigger) -->
  <button
    type="button"
    id="support-hub-trigger"
    class="relative flex items-center justify-center w-14 h-14 rounded-full bg-gradient-to-br from-[#0C487A] via-[#103E6B] to-[#1E40AF] text-white shadow-[0_12px_32px_rgba(12,72,122,0.38),0_4px_12px_rgba(255,49,48,0.22)] border-2 border-white/30 hover:scale-105 active:scale-95 transition-all duration-300 group cursor-pointer ml-auto"
    aria-label="Open contact and advisory options"
    aria-expanded="false"
  >
    <!-- Subtle Red/Blue Radar Ping -->
    <span class="absolute -inset-1 rounded-full border border-[#FF3130]/50 opacity-75 animate-ping-slow pointer-events-none"></span>

    <!-- Status Green Pulse Dot -->
    <span class="absolute top-0.5 right-0.5 w-3.5 h-3.5 bg-emerald-500 border-2 border-white rounded-full"></span>

    <!-- Default Icon: Headset / Phone Support -->
    <svg
      id="support-hub-icon-default"
      class="w-6 h-6 text-white transition-transform duration-300 group-hover:scale-110"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
    </svg>

    <!-- Close Icon (shown when popover is open) -->
    <svg
      id="support-hub-icon-close"
      class="w-6 h-6 text-white hidden"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

</div>

<script>
  function setupFloatingSupportHub() {
    const trigger = document.getElementById('support-hub-trigger');
    const popover = document.getElementById('support-hub-popover');
    const closeBtn = document.getElementById('support-hub-close');
    const defaultIcon = document.getElementById('support-hub-icon-default');
    const closeIcon = document.getElementById('support-hub-icon-close');

    if (!trigger || !popover) return;

    let isOpen = false;

    function openHub() {
      isOpen = true;
      popover.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3', 'scale-95');
      popover.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0', 'scale-100');
      trigger.setAttribute('aria-expanded', 'true');
      popover.setAttribute('aria-hidden', 'false');
      defaultIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    }

    function closeHub() {
      isOpen = false;
      popover.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3', 'scale-95');
      popover.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0', 'scale-100');
      trigger.setAttribute('aria-expanded', 'false');
      popover.setAttribute('aria-hidden', 'true');
      defaultIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      if (isOpen) {
        closeHub();
      } else {
        openHub();
      }
    });

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeHub();
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (isOpen && !popover.contains(e.target as Node) && !trigger.contains(e.target as Node)) {
        closeHub();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeHub();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFloatingSupportHub);
  } else {
    setupFloatingSupportHub();
  }
</script>
