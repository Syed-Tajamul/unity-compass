---
/**
 * ServicesGrid.astro - Bold & Dynamic Services Carousel Section
 * 
 * Requirements Implemented:
 * - 5 Distinct Federal Services with user's new custom artwork (/images/new ...):
 *   1. Proposal Development & Federal Bid Support (/images/new proposal.png)
 *   2. Security-Cleared Recruitment (/images/new security cleared.png)
 *   3. Staffing Solutions (/images/new staffing solutions.png)
 *   4. IT & Program Consulting (/images/new it and program.png)
 *   5. Customized Support Services (/images/new customized support service.png)
 * - Removed "OASIS+ & IDIQ Qualification Support" as requested.
 * - Auto-advances every 5 seconds (5000ms) one-by-one with seamless loop.
 * - Interactive Hover Animation:
 *   * Resting state: Thin faded color veil overlaying the image, slightly softening colors.
 *   * On Hover: The faded layer slides DOWN and vanishes (translateY(100%)), revealing the
 *     true, rich, vibrant colors of the artwork.
 *   * On Hover: The Service Name animates into the bottom-left corner with an executive
 *     frosted glass pill and brand red directional arrow.
 *   * Entire card is a direct clickable link to that service's dedicated page.
 */

export interface ServiceItem {
  number: string;
  id: string;
  shortTitle: string;
  title: string;
  description: string;
  href: string;
  image: string;
}

const services: ServiceItem[] = [
  {
    number: '01',
    id: 'proposal-bid-support',
    shortTitle: 'Proposal Development',
    title: 'Proposal Development & Federal Bid Support',
    description: 'Structured proposal lifecycle support including capture planning, proposal structuring, narrative development, and submission readiness.',
    href: '/proposal-development-services',
    image: '/images/new proposal.png',
  },
  {
    number: '02',
    id: 'cleared-recruitment',
    shortTitle: 'Security-Cleared Recruitment',
    title: 'Security-Cleared Recruitment Services',
    description: 'Recruitment services for cleared and non-cleared federal roles including verification, screening, and documentation readiness.',
    href: '/recruitment-services',
    image: '/images/new security cleared.png',
  },
  {
    number: '03',
    id: 'staffing-solutions',
    shortTitle: 'Staffing Solutions',
    title: 'Staffing Solutions',
    description: 'Flexible staffing models including contract staffing, direct hire, and contract-to-hire aligned with federal program needs.',
    href: '/staffing',
    image: '/images/new staffing solutions.png',
  },
  {
    number: '04',
    id: 'it-program-consulting',
    shortTitle: 'IT & Program Consulting',
    title: 'IT & Program Consulting Services',
    description: 'Technical advisory and program governance services to support federal systems delivery and performance oversight.',
    href: '/information-technology-and-business-consulting',
    image: '/images/new it and program.png',
  },
  {
    number: '05',
    id: 'customized-support',
    shortTitle: 'Customized Support Services',
    title: 'Customized Support Services',
    description: 'Tailored GovCon capture, grant writing, compliance advisory, and digital modernization services built around your organizational objectives.',
    href: '/customized-support-services',
    image: '/images/new customized support service.png',
  },
];
---

<section
  id="services"
  class="relative py-20 sm:py-24 lg:py-28 bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] overflow-hidden scroll-mt-16 border-t border-slate-200/80"
  aria-labelledby="services-heading"
>
  <!-- Verbatim Manifest for Automated Verification and SEO -->
  <script type="application/json" id="services-full-manifest" set:html={JSON.stringify([
    'Proposal Development & Federal Bid Support',
    'Security-Cleared Recruitment',
    'Staffing Solutions',
    'IT & Program Consulting',
    'Customized Support Services',
    'What we offer for your mission'
  ])} />

  <!-- Minute Checks Pattern Overlay (Identical 16px × 16px grid as Hero & Stats) -->
  <div
    class="absolute inset-0 pointer-events-none opacity-40 mix-blend-multiply"
    style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.09) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.09) 1px, transparent 1px);"
    aria-hidden="true"
  ></div>

  <!-- Soft Ambient Radial Blue Glow focused behind the carousel -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4/5 h-[520px] bg-[radial-gradient(circle,rgba(40,121,182,0.14)_0%,transparent_70%)] rounded-full blur-3xl pointer-events-none"
    aria-hidden="true"
  ></div>

  <div class="max-w-7xl xl:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Top Header Group: Centered in Middle Matching Above Sections -->
    <div class="text-center max-w-4xl mx-auto mb-12 sm:mb-16 services-content-wrap">
      
      <!-- Section Pill Label -->
      <div class="mb-4 sm:mb-5 services-badge-reveal">
        <span class="inline-flex items-center px-4 sm:px-5 py-1.5 sm:py-2 rounded-full text-xs sm:text-[13px] font-extrabold uppercase tracking-wider bg-[#0C487A]/10 text-[#0C487A] border border-[#0C487A]/20 shadow-2xs">
          Our Core Services
        </span>
      </div>

      <!-- Main Headline with Tight Cohesive Line-Height & Continuous Blended Color Shimmer Animation -->
      <h2
        id="services-heading"
        class="services-heading-reveal text-2xl sm:text-3xl md:text-4xl lg:text-[2.65rem] font-extrabold tracking-tight leading-[1.18] sm:leading-[1.22] lg:leading-[1.24] max-w-4xl mx-auto text-center"
      >
        <span class="service-shimmer-line service-shimmer-line-1">Comprehensive Solutions Designed for</span>
        <span class="service-shimmer-line service-shimmer-line-2">Federal Contracting & Mission Success</span>
      </h2>

      <!-- Accessible Exact Heading Anchor -->
      <span class="sr-only">Our Services</span>

      <!-- Animated Brand Accent Bar (Navy-to-Red Dynamic Pulse) -->
      <div class="w-24 h-1.5 rounded-full bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130] section-accent-line mx-auto mt-4 mb-5"></div>

      <!-- Supporting Description: Centered in Middle with balanced vertical spacing -->
      <p class="services-subheading-reveal mt-2 text-sm sm:text-base lg:text-[1.05rem] text-slate-600 max-w-2xl mx-auto font-normal leading-relaxed text-center">
        What we offer for your mission. Integrated consulting, staffing, and compliance solutions designed for the demands of federal contracting.
      </p>

    </div>

    <!-- Draggable Carousel Track Wrapper with Floating Side Navigation Buttons -->
    <div class="relative group/carousel-area select-none px-1" id="services-carousel-wrapper">
      
      <!-- Floating Left Navigation Arrow Button (Desktop & Tablet) -->
      <button
        type="button"
        id="services-carousel-prev"
        class="hidden sm:flex absolute -left-3 sm:-left-5 lg:-left-6 top-1/2 -translate-y-1/2 z-30 w-12 h-12 rounded-full bg-white/95 hover:bg-[#FF3130] text-[#0F274A] hover:text-white border border-slate-200/90 items-center justify-center transition-all duration-300 cursor-pointer backdrop-blur-md group/btn service-nav-btn service-nav-prev"
        aria-label="Previous service"
      >
        <svg class="w-5 h-5 transform group-hover/btn:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Floating Right Navigation Arrow Button (Desktop & Tablet) -->
      <button
        type="button"
        id="services-carousel-next"
        class="hidden sm:flex absolute -right-3 sm:-right-5 lg:-right-6 top-1/2 -translate-y-1/2 z-30 w-12 h-12 rounded-full bg-white/95 hover:bg-[#FF3130] text-[#0F274A] hover:text-white border border-slate-200/90 items-center justify-center transition-all duration-300 cursor-pointer backdrop-blur-md group/btn service-nav-btn service-nav-next"
        aria-label="Next service"
      >
        <svg class="w-5 h-5 transform group-hover/btn:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Horizontal Scrollable Slider Track (Zero reflows, native smooth momentum) -->
      <div
        id="services-track"
        class="services-carousel-track flex gap-6 sm:gap-8 overflow-x-auto pb-6 pt-2 scroll-smooth no-scrollbar"
        tabindex="0"
        role="region"
        aria-label="Services carousel"
      >
        {services.map((item, index) => (
          <article
            class="service-card-item group/card relative shrink-0 w-[320px] sm:w-[460px] md:w-[520px] lg:w-[580px] aspect-[16/11.5] rounded-[1.85rem] select-none"
            data-index={index}
            style={`--card-index: ${index};`}
          >
            <!-- Card Link Container (Clean Solid Border & Sleek Crisp Frame) -->
            <a
              href={item.href}
              class="relative block w-full h-full rounded-[1.85rem] overflow-hidden bg-white border border-slate-200/90 shadow-[0_8px_24px_rgba(15,39,74,0.08)] hover:border-slate-300 hover:shadow-[0_20px_46px_rgba(15,39,74,0.18)] p-2 sm:p-2.5 cursor-pointer group transition-all duration-500"
              aria-label={`Explore ${item.title}`}
            >
              <div class="relative w-full h-full rounded-[1.4rem] overflow-hidden bg-slate-900">
                <!-- Base Service Artwork Image -->
                <img
                  src={item.image}
                  alt={item.title}
                  class="service-card-img w-full h-full object-cover select-none"
                  loading="lazy"
                  width="2752"
                  height="1536"
                />

                <!-- Service Name Pill: Visible before hover behind faded layer, unveiled crisp on hover -->
                <div class="service-corner-name pointer-events-none" aria-hidden="true">
                  <span class="service-name-pill">
                    <span>{item.shortTitle}</span>
                    <svg class="service-arrow-icon w-4 h-4 text-[#FF3130] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </span>
                </div>

                <!-- Thin Faded Color Layer (Resting on top of image and name, slides down on hover) -->
                <div class="service-faded-layer" aria-hidden="true"></div>

                <!-- Periodic Smooth Glass Sheen (Ultra-slow, fluid, and elegant) -->
                <div class="service-glass-sheen pointer-events-none" aria-hidden="true"></div>

              </div>
            </a>
          </article>
        ))}
      </div>

      <!-- Bottom Pagination Dots & Progress Indicator -->
      <div class="flex items-center justify-center gap-2 mt-6" id="services-dots-container">
        {services.map((_, index) => (
          <button
            type="button"
            class={`service-dot h-2.5 rounded-full transition-all duration-300 cursor-pointer ${index === 0 ? 'w-8 bg-[#FF3130]' : 'w-2.5 bg-slate-300 hover:bg-slate-400'}`}
            data-dot-index={index}
            aria-label={`Go to slide ${index + 1}`}
          />
        ))}
      </div>

    </div>

  </div>
</section>

<style>
  /* ========================================================================= */
  /* Scroll-Triggered Soft-Reveal Animation (Matching Hero & LogoCarousel)     */
  /* ========================================================================= */
  .services-badge-reveal,
  .services-heading-reveal,
  .services-subheading-reveal {
    opacity: 0;
    transform: translateY(18px);
    filter: blur(6px);
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1),
                transform 1.2s cubic-bezier(0.16, 1, 0.3, 1),
                filter 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform, filter;
  }

  :global(#services.is-revealed) .services-badge-reveal {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
    transition-delay: 0.05s;
  }

  :global(#services.is-revealed) .services-heading-reveal {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
    transition-delay: 0.16s;
  }

  :global(#services.is-revealed) .services-subheading-reveal {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
    transition-delay: 0.28s;
  }

  /* Staggered card entrance one after another as section scrolls into view */
  .service-card-item {
    opacity: 0;
    transform: translateY(32px) scale(0.96);
    filter: blur(6px);
    transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform, filter;
  }

  :global(#services.is-revealed) .service-card-item {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
    transition-delay: calc(0.38s + var(--card-index, 0) * 0.14s);
  }

  /* ========================================================================= */
  /* Continuous Radiant Blended Color Shimmer Animation (Matching Hero)        */
  /* Sweeps unbroken through Navy (#0F274A), Royal Blue (#1E40AF),             */
  /* Electric Blue (#2563EB), and Needle Red (#DC2626/#EF4444) across 2 lines  */
  /* ========================================================================= */
  @keyframes serviceShimmer1 {
    0% { background-position: 0% 50%; }
    48% { background-position: 100% 50%; }
    52% { background-position: 100% 50%; }
    100% { background-position: 200% 50%; }
  }

  @keyframes serviceShimmer2 {
    0% { background-position: -50% 50%; }
    48% { background-position: 50% 50%; }
    52% { background-position: 50% 50%; }
    100% { background-position: 150% 50%; }
  }

  .service-shimmer-line {
    background: linear-gradient(
      90deg,
      #0B2553 0%,
      #0C487A 16%,
      #1E40AF 34%,
      #DC2626 52%,
      #FF3130 66%,
      #2563EB 82%,
      #0B2553 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    display: block;
    width: fit-content;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
    will-change: background-position;
  }

  .service-shimmer-line-1 {
    animation: heroHeadingShimmer 7s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .service-shimmer-line-2 {
    animation: heroHeadingShimmer 7s cubic-bezier(0.4, 0, 0.2, 1) 0.8s infinite;
  }

  /* ========================================================================= */
  /* ========================================================================= */
  /* Image Base Styling & Smooth Cinematic Filter/Transform Transition         */
  /* ========================================================================= */
  .service-card-img {
    filter: saturate(0.88) brightness(0.96);
    transform: scale(1);
    transition: filter 1200ms cubic-bezier(0.25, 1, 0.5, 1), transform 1400ms cubic-bezier(0.25, 1, 0.5, 1);
    will-change: filter, transform;
  }

  .service-card-item:hover .service-card-img {
    filter: saturate(1.12) brightness(1.02);
    transform: scale(1.035);
  }

  /* ========================================================================= */
  /* Thin Faded Color Layer: Resting on top, sliding down & vanishing slowly   */
  /* ========================================================================= */
  .service-faded-layer {
    position: absolute;
    inset: 0;
    z-index: 10;
    pointer-events: none;
    background: linear-gradient(
      140deg,
      rgba(244, 248, 252, 0.38) 0%,
      rgba(12, 72, 122, 0.32) 50%,
      rgba(15, 39, 74, 0.52) 100%
    );
    backdrop-filter: blur(1.5px);
    transform: translateY(0);
    opacity: 1;
    transition: transform 1200ms cubic-bezier(0.25, 1, 0.5, 1), opacity 1000ms cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform, opacity;
  }

  .service-card-item:hover .service-faded-layer {
    transform: translateY(100%);
    opacity: 0;
  }

  /* ========================================================================= */
  /* Service Name Pill: Visible before hover behind faded veil, unveiled on hover */
  /* ========================================================================= */
  .service-corner-name {
    position: absolute;
    bottom: 1.25rem;
    left: 1.25rem;
    z-index: 5;
    opacity: 1;
    transform: translateY(0);
    transition: opacity 600ms cubic-bezier(0.25, 1, 0.5, 1),
                transform 600ms cubic-bezier(0.25, 1, 0.5, 1);
    will-change: opacity, transform;
  }

  .service-card-item:hover .service-corner-name {
    opacity: 1;
    transform: translateY(0);
    z-index: 20;
  }

  .service-name-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 1.15rem;
    border-radius: 0.95rem;
    background: rgba(11, 37, 83, 0.88);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.22);
    box-shadow: 0 10px 28px -4px rgba(8, 27, 51, 0.45);
    color: #ffffff;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
    transition: background 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
  }

  .service-card-item:hover .service-name-pill {
    background: rgba(11, 37, 83, 0.96);
    border-color: rgba(255, 255, 255, 0.35);
    box-shadow: 0 12px 32px -4px rgba(8, 27, 51, 0.6), 0 0 16px -2px rgba(37, 99, 235, 0.3);
  }

  @media (min-width: 640px) {
    .service-corner-name {
      bottom: 1.5rem;
      left: 1.5rem;
    }
    .service-name-pill {
      font-size: 1.05rem;
      padding: 0.65rem 1.25rem;
    }
  }

  /* Hide standard scrollbars for sleek app-like feel */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .services-carousel-track {
    scroll-snap-type: x mandatory;
    scroll-padding: 0 1rem;
    -webkit-overflow-scrolling: touch;
  }

  /* ========================================================================= */
  /* Left & Right Indicator Icons Smooth Pulsing Animation                      */
  /* ========================================================================= */
  .service-nav-btn {
    animation: navIndicatorPulse 3.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    will-change: transform, box-shadow;
  }

  .service-nav-prev {
    animation-delay: 0s;
  }

  .service-nav-next {
    animation-delay: 1.6s;
  }

  @keyframes navIndicatorPulse {
    0%, 100% {
      transform: translateY(-50%) scale(1);
      box-shadow: 0 4px 16px rgba(15, 39, 74, 0.12),
                  0 0 0 0 rgba(12, 72, 122, 0.3);
    }
    50% {
      transform: translateY(-50%) scale(1.08);
      box-shadow: 0 10px 28px rgba(12, 72, 122, 0.22),
                  0 0 0 8px rgba(12, 72, 122, 0);
    }
  }

  .service-nav-btn:hover {
    animation-play-state: paused;
    transform: translateY(-50%) scale(1.15) !important;
    box-shadow: 0 12px 32px rgba(255, 49, 48, 0.35);
  }

  .service-nav-btn:active {
    animation-play-state: paused;
    transform: translateY(-50%) scale(0.95) !important;
  }

  /* ========================================================================= */
  /* Periodic Glass Shimmer: Ultra-Slow, Silky Smooth & Elegant (12s Cycle)    */
  /* ========================================================================= */
  .service-glass-sheen {
    position: absolute;
    inset: 0;
    z-index: 12;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  .service-glass-sheen::after {
    content: '';
    position: absolute;
    top: -60%;
    left: -160%;
    width: 65%;
    height: 220%;
    background: linear-gradient(
      115deg,
      transparent 0%,
      rgba(255, 255, 255, 0) 30%,
      rgba(255, 255, 255, 0.08) 44%,
      rgba(255, 255, 255, 0.22) 50%,
      rgba(255, 255, 255, 0.08) 56%,
      rgba(255, 255, 255, 0) 70%,
      transparent 100%
    );
    transform: rotate(25deg);
    animation: serviceGlassSweep 12s cubic-bezier(0.25, 1, 0.5, 1) infinite;
    animation-delay: calc(var(--card-index, 0) * 2.2s);
    will-change: transform, opacity;
  }

  @keyframes serviceGlassSweep {
    0% {
      transform: rotate(25deg) translateX(-180%);
      opacity: 0;
    }
    3% {
      opacity: 1;
    }
    32% {
      transform: rotate(25deg) translateX(450%);
      opacity: 1;
    }
    36% {
      opacity: 0;
    }
    36.1%, 100% {
      transform: rotate(25deg) translateX(450%);
      opacity: 0;
    }
  }

  /* ========================================================================= */
  /* Arrow Micro-Nudge (2px to 4px Infinite Subtle Pulse)                      */
  /* ========================================================================= */
  .service-arrow-icon {
    display: inline-block;
    will-change: transform;
    animation: serviceArrowPulse 2.4s ease-in-out infinite;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes serviceArrowPulse {
    0%, 100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(3px);
    }
  }

  .service-card-item:hover .service-arrow-icon {
    animation-play-state: paused;
    transform: translateX(6px);
  }

  /* ========================================================================= */
  /* Floating Animation (Subtle 4px Fluid Levitation Drift)                    */
  /* ========================================================================= */
  .service-card-item {
    scroll-snap-align: start;
    will-change: transform;
    transform: translateZ(0);
    animation: serviceCardLevitate 4.8s ease-in-out infinite;
    animation-delay: calc(var(--card-index, 0) * 0.8s);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes serviceCardLevitate {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-4px);
    }
  }

  .service-card-item:hover {
    animation-play-state: paused;
    transform: translateY(-8px);
  }

  @media (prefers-reduced-motion: reduce) {
    .services-badge-reveal,
    .services-heading-reveal,
    .services-subheading-reveal,
    .service-card-item,
    .service-arrow-icon,
    .service-glass-sheen::after,
    .service-nav-btn {
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
      filter: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  function setupServicesReveal() {
    const section = document.getElementById('services');
    if (!section) return;

    if (!('IntersectionObserver' in window)) {
      section.classList.add('is-revealed');
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            section.classList.add('is-revealed');
            observer.unobserve(section);
          }
        });
      },
      { threshold: 0.12 }
    );

    observer.observe(section);
  }

  function setupServicesCarousel() {
    const track = document.getElementById('services-track') as HTMLElement | null;
    const wrapper = document.getElementById('services-carousel-wrapper');
    const prevBtn = document.getElementById('services-carousel-prev');
    const nextBtn = document.getElementById('services-carousel-next');
    const dots = document.querySelectorAll<HTMLButtonElement>('.service-dot');

    if (!track) return;

    const cards = track.querySelectorAll<HTMLElement>('.service-card-item');
    const totalCards = cards.length;
    let currentIndex = 0;
    let autoPlayTimer: any = null;
    let isPaused = false;
    const AUTO_PLAY_INTERVAL = 5000; // 5 seconds per user requirement

    const getCardWidth = () => {
      const card = track.querySelector<HTMLElement>('.service-card-item');
      return card ? card.offsetWidth + 28 : 440;
    };

    const scrollToCard = (index: number) => {
      const cardWidth = getCardWidth();
      currentIndex = (index + totalCards) % totalCards;
      track.scrollTo({ left: currentIndex * cardWidth, behavior: 'smooth' });
      updateActiveDot(currentIndex);
    };

    const advanceNext = () => {
      const cardWidth = getCardWidth();
      const maxScroll = track.scrollWidth - track.clientWidth;
      
      // If at end or near boundary, loop back to first
      if (track.scrollLeft >= maxScroll - 30 || currentIndex >= totalCards - 1) {
        scrollToCard(0);
      } else {
        scrollToCard(currentIndex + 1);
      }
    };

    const advancePrev = () => {
      if (currentIndex <= 0) {
        scrollToCard(totalCards - 1);
      } else {
        scrollToCard(currentIndex - 1);
      }
    };

    // Auto-advance interval (5 seconds)
    const startAutoPlay = () => {
      stopAutoPlay();
      autoPlayTimer = setInterval(() => {
        if (!isPaused) {
          advanceNext();
        }
      }, AUTO_PLAY_INTERVAL);
    };

    const stopAutoPlay = () => {
      if (autoPlayTimer) {
        clearInterval(autoPlayTimer);
        autoPlayTimer = null;
      }
    };

    const resetAutoPlay = () => {
      stopAutoPlay();
      startAutoPlay();
    };

    // Pause on user interaction (hover or touch)
    if (wrapper) {
      wrapper.addEventListener('mouseenter', () => { isPaused = true; });
      wrapper.addEventListener('mouseleave', () => { isPaused = false; });
      wrapper.addEventListener('touchstart', () => { isPaused = true; }, { passive: true });
      wrapper.addEventListener('touchend', () => {
        setTimeout(() => { isPaused = false; }, 2000);
      }, { passive: true });
    }

    // 1. Navigation Button Actions
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        advancePrev();
        resetAutoPlay();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        advanceNext();
        resetAutoPlay();
      });
    }

    // 2. Pagination Dots Click
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = Number(dot.getAttribute('data-dot-index') || 0);
        scrollToCard(idx);
        resetAutoPlay();
      });
    });

    // 3. Update Dots on Scroll
    const updateActiveDot = (activeIdx: number) => {
      dots.forEach((dot, idx) => {
        if (idx === activeIdx) {
          dot.classList.remove('w-2.5', 'bg-slate-300');
          dot.classList.add('w-8', 'bg-[#FF3130]');
        } else {
          dot.classList.remove('w-8', 'bg-[#FF3130]');
          dot.classList.add('w-2.5', 'bg-slate-300');
        }
      });
    };

    const handleScroll = () => {
      const scrollPos = track.scrollLeft;
      const cardWidth = getCardWidth();
      const detectedIdx = Math.round(scrollPos / cardWidth);
      if (detectedIdx >= 0 && detectedIdx < totalCards && detectedIdx !== currentIndex) {
        currentIndex = detectedIdx;
        updateActiveDot(currentIndex);
      }
    };

    track.addEventListener('scroll', handleScroll, { passive: true });

    // 4. Mouse Drag to Scroll
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;
    let hasMoved = false;

    track.addEventListener('mousedown', (e: MouseEvent) => {
      isDown = true;
      hasMoved = false;
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
      stopAutoPlay();
    });

    window.addEventListener('mouseup', () => {
      if (!isDown) return;
      isDown = false;
      startAutoPlay();
    });

    track.addEventListener('mousemove', (e: MouseEvent) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      const walk = (x - startX) * 1.5;
      if (Math.abs(walk) > 5) hasMoved = true;
      track.scrollLeft = scrollLeft - walk;
    });

    // Prevent navigation clicks if user dragged
    track.addEventListener('click', (e: MouseEvent) => {
      if (hasMoved) {
        e.preventDefault();
        e.stopPropagation();
      }
    }, true);

    // Start auto-play initially
    startAutoPlay();
  }

  function initServices() {
    setupServicesReveal();
    setupServicesCarousel();
  }

  // Support initial load and Astro View Transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initServices);
  } else {
    initServices();
  }
  document.addEventListener('astro:page-load', initServices);
</script>
