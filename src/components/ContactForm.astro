---
import Button from './Button.astro';
---

<div class="bg-white rounded-2xl border border-slate-200/80 p-8 sm:p-10 shadow-elevated relative">
  <div class="mb-6">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-red-50 text-brand-red border border-red-100 mb-2">
      Direct Inquiry
    </span>
    <h3 class="text-2xl font-bold text-slate-900 tracking-tight">
      Send Us a Message
    </h3>
    <p class="text-sm text-slate-500 mt-1">
      Fill out the form below. Our government contracting advisory team responds within one business day.
    </p>
  </div>

  <form id="contact-form" class="space-y-5" novalidate>
    <!-- Success Banner -->
    <div id="contact-success" class="hidden p-4 rounded-xl bg-green-50 border border-green-200 text-green-800 text-sm">
      <div class="flex items-center gap-2 font-bold mb-1">
        <svg class="w-5 h-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>Message Sent Successfully</span>
      </div>
      <p>Thank you for reaching out to Unity Compass. A specialist from our GovCon advisory practice will review your requirements and follow up promptly.</p>
    </div>

    <!-- Error Banner -->
    <div id="contact-error" class="hidden p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm">
      <div class="flex items-center gap-2 font-bold mb-1">
        <svg class="w-5 h-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span>Please Check Required Fields</span>
      </div>
      <p id="contact-error-msg">Please correct highlighted fields before submitting.</p>
    </div>

    <!-- Name & Email Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label for="contact-name" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
          Your Name <span class="text-brand-red">*</span>
        </label>
        <input
          type="text"
          id="contact-name"
          name="name"
          required
          placeholder="e.g. John Miller"
          class="w-full px-4 py-2.5 rounded-lg border border-slate-300 bg-white text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy focus:border-brand-navy transition-all"
        />
      </div>

      <div>
        <label for="contact-email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
          Your Email <span class="text-brand-red">*</span>
        </label>
        <input
          type="email"
          id="contact-email"
          name="email"
          required
          placeholder="e.g. jmiller@company.com"
          class="w-full px-4 py-2.5 rounded-lg border border-slate-300 bg-white text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy focus:border-brand-navy transition-all"
        />
      </div>
    </div>

    <!-- Phone & Service Focus -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label for="contact-phone" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
          Phone Number <span class="text-brand-red">*</span>
        </label>
        <input
          type="tel"
          id="contact-phone"
          name="phone"
          required
          placeholder="e.g. +1 (301) 555-0199"
          class="w-full px-4 py-2.5 rounded-lg border border-slate-300 bg-white text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy focus:border-brand-navy transition-all"
        />
      </div>

      <div>
        <label for="contact-service" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
          Area of Interest
        </label>
        <select
          id="contact-service"
          name="service"
          class="w-full px-4 py-2.5 rounded-lg border border-slate-300 bg-white text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy focus:border-brand-navy transition-all"
        >
          <option value="General Inquiry">General GovCon Inquiry</option>
          <option value="Proposal Development">Proposal Development & RFP Capture</option>
          <option value="OASIS+ Support">GSA OASIS+ Readiness Support</option>
          <option value="Cleared Recruitment">Security-Cleared Recruitment (TS/SCI, Poly)</option>
          <option value="Staffing Solutions">Staffing Solutions (Contract, Temp-to-Hire)</option>
          <option value="IT Consulting">IT & Business Consulting</option>
          <option value="Customized Support">Customized Support Services</option>
        </select>
      </div>
    </div>

    <!-- Message -->
    <div>
      <label for="contact-message" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
        Message / Project Requirements <span class="text-brand-red">*</span>
      </label>
      <textarea
        id="contact-message"
        name="message"
        rows="4"
        required
        placeholder="Briefly describe your federal contracting goals, upcoming solicitations, or staffing requirements..."
        class="w-full px-4 py-2.5 rounded-lg border border-slate-300 bg-white text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-navy focus:border-brand-navy transition-all resize-y"
      ></textarea>
    </div>

    <!-- Submit Button -->
    <div>
      <button
        type="submit"
        id="contact-submit-btn"
        class="w-full sm:w-auto px-8 py-3.5 rounded-lg text-sm font-semibold text-white bg-brand-red hover:bg-brand-red-hover focus:outline-none focus:ring-2 focus:ring-brand-red focus:ring-offset-2 transition-all shadow-sm active:scale-[0.98] inline-flex items-center justify-center gap-2"
      >
        <span>Send Message</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </div>
  </form>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successBox = document.getElementById('contact-success');
  const errorBox = document.getElementById('contact-error');
  const errorMsg = document.getElementById('contact-error-msg');
  const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form || !successBox || !errorBox || !submitBtn) return;

    errorBox.classList.add('hidden');
    successBox.classList.add('hidden');

    const name = (document.getElementById('contact-name') as HTMLInputElement)?.value.trim();
    const email = (document.getElementById('contact-email') as HTMLInputElement)?.value.trim();
    const phone = (document.getElementById('contact-phone') as HTMLInputElement)?.value.trim();
    const message = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value.trim();

    if (!name || !email || !phone || !message) {
      if (errorMsg) errorMsg.textContent = 'Please fill out all required fields marked with an asterisk.';
      errorBox.classList.remove('hidden');
      return;
    }

    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!emailPattern.test(email)) {
      if (errorMsg) errorMsg.textContent = 'Please enter a valid business email address.';
      errorBox.classList.remove('hidden');
      return;
    }

    // Submit state
    const originalText = submitBtn.innerHTML;
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span>Sending Message...</span>';

    setTimeout(() => {
      submitBtn.disabled = false;
      submitBtn.innerHTML = originalText;
      successBox.classList.remove('hidden');
      form.reset();
    }, 800);
  });
</script>

