---
/**
 * ContactForm.astro - GovCon Direct Project Brief Form
 * 
 * Clean form card featuring:
 * - Top brand gradient bar (#0C487A to #FF3130)
 * - Modern inputs with left-aligned icons
 * - Fields: Full Name, Email Address, Phone Number, Message
 * - Privacy disclaimer
 * - Full-width Brand Red CTA button with Send icon
 * - Accessible validation with zero-reload interactive feedback
 */
---

<div class="bg-white rounded-3xl border border-slate-200/90 p-7 sm:p-9 lg:p-11 shadow-[0_20px_50px_-10px_rgba(12,72,122,0.12)] relative overflow-hidden">
  <!-- Top brand gradient border line -->
  <div class="absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130]"></div>

  <form id="contact-form" class="space-y-5" novalidate>
    <!-- Success Banner -->
    <div id="contact-success" class="hidden p-5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-sm shadow-xs animate-in fade-in duration-300">
      <div class="flex items-start gap-3">
        <div class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <div>
          <h4 class="font-bold text-emerald-950 text-base">Message Sent Successfully</h4>
          <p class="mt-1 text-emerald-800 leading-relaxed">
            Thank you for reaching out to Unity Compass. A member of our federal capture and workforce practice will review your message and follow up within one business day.
          </p>
        </div>
      </div>
    </div>

    <!-- Error Banner -->
    <div id="contact-error" class="hidden p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm shadow-xs animate-in fade-in duration-200">
      <div class="flex items-center gap-2 font-bold mb-1">
        <svg class="w-5 h-5 text-rose-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span>Please Check Required Fields</span>
      </div>
      <p id="contact-error-msg" class="text-rose-700 pl-7 text-xs sm:text-sm">Please fill out all required fields marked with an asterisk.</p>
    </div>

    <!-- Row 1: Full Name & Email Address -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
      <div>
        <label for="contact-name" class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-2">
          Full Name <span class="text-[#FF3130]">*</span>
        </label>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <input
            type="text"
            id="contact-name"
            name="name"
            required
            placeholder="John Miller"
            class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-200 bg-slate-50/40 text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0C487A] focus:border-[#0C487A] transition-all placeholder:text-slate-400"
          />
        </div>
      </div>

      <div>
        <label for="contact-email" class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-2">
          Email Address <span class="text-[#FF3130]">*</span>
        </label>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <input
            type="email"
            id="contact-email"
            name="email"
            required
            placeholder="jmiller@company.com"
            class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-200 bg-slate-50/40 text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0C487A] focus:border-[#0C487A] transition-all placeholder:text-slate-400"
          />
        </div>
      </div>
    </div>

    <!-- Row 2: Phone Number -->
    <div>
      <label for="contact-phone" class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-2">
        Phone Number <span class="text-[#FF3130]">*</span>
      </label>
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </div>
        <input
          type="tel"
          id="contact-phone"
          name="phone"
          required
          placeholder="+1 (301) 555-0199"
          class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-200 bg-slate-50/40 text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0C487A] focus:border-[#0C487A] transition-all placeholder:text-slate-400"
        />
      </div>
    </div>

    <!-- Row 3: Message / Requirements -->
    <div>
      <label for="contact-message" class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-2">
        Message / Project Requirements <span class="text-[#FF3130]">*</span>
      </label>
      <div class="relative">
        <div class="absolute top-3.5 left-3.5 pointer-events-none text-slate-400">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
          </svg>
        </div>
        <textarea
          id="contact-message"
          name="message"
          rows="5"
          required
          placeholder="Briefly describe your federal contracting goals, upcoming solicitations, or staffing requirements..."
          class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-200 bg-slate-50/40 text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0C487A] focus:border-[#0C487A] transition-all placeholder:text-slate-400 resize-y"
        ></textarea>
      </div>
    </div>

    <!-- Privacy Disclaimer Line -->
    <div class="flex items-center gap-2 text-xs text-slate-500 pt-1">
      <svg class="w-4 h-4 text-[#0C487A] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>
        By submitting this form, you agree to our <a href="/privacy-policy" class="text-[#0C487A] font-semibold underline hover:text-[#FF3130] transition-colors">Privacy Policy</a>. All communications protected under standard non-disclosure.
      </span>
    </div>

    <!-- Submit Button: Brand Red Full-Width Pill with Send Icon -->
    <div class="pt-2">
      <button
        type="submit"
        id="contact-submit-btn"
        class="w-full py-4 px-8 rounded-full text-base font-bold text-white bg-gradient-to-r from-[#FF3130] to-[#E02625] hover:from-[#E02625] hover:to-[#C61E1D] shadow-[0_8px_24px_-4px_rgba(255,49,48,0.28)] hover:shadow-[0_12px_28px_-2px_rgba(255,49,48,0.38)] transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 cursor-pointer inline-flex items-center justify-center gap-2.5"
      >
        <svg class="w-4 h-4 -rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
        <span>Send Message</span>
      </button>
    </div>
  </form>
</div>

<script>
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const successBox = document.getElementById('contact-success');
    const errorBox = document.getElementById('contact-error');
    const errorMsg = document.getElementById('contact-error-msg');
    const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;

    if (!form) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form || !successBox || !errorBox || !submitBtn) return;

      errorBox.classList.add('hidden');
      successBox.classList.add('hidden');

      const name = (document.getElementById('contact-name') as HTMLInputElement)?.value.trim();
      const email = (document.getElementById('contact-email') as HTMLInputElement)?.value.trim();
      const phone = (document.getElementById('contact-phone') as HTMLInputElement)?.value.trim();
      const message = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value.trim();

      if (!name || !email || !phone || !message) {
        if (errorMsg) errorMsg.textContent = 'Please fill out all required fields marked with an asterisk.';
        errorBox.classList.remove('hidden');
        errorBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        return;
      }

      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailPattern.test(email)) {
        if (errorMsg) errorMsg.textContent = 'Please enter a valid business or agency email address.';
        errorBox.classList.remove('hidden');
        errorBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        return;
      }

      // Submit state
      const originalText = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span>Sending Message...</span>';

      fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, phone, message }),
      })
        .then(async (res) => {
          const result = await res.json().catch(() => ({}));
          if (res.ok && result.success) {
            successBox.classList.remove('hidden');
            successBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            form.reset();
          } else {
            if (errorMsg) errorMsg.textContent = result.error || 'Failed to submit inquiry. Please try again.';
            errorBox.classList.remove('hidden');
            errorBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        })
        .catch(() => {
          if (errorMsg) errorMsg.textContent = 'Network error. Please try again or contact us directly.';
          errorBox.classList.remove('hidden');
        })
        .finally(() => {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalText;
        });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForm);
  } else {
    initContactForm();
  }
  document.addEventListener('astro:page-load', initContactForm);
</script>
