---
/**
 * ContactForm.astro - Enhanced GovCon Project & Staffing Inquiry Form
 * 
 * Features:
 * - 5 verified core service practices (Proposal Development, Cleared Recruitment, Staffing, IT Consulting, Customized Support)
 * - Security clearance level qualification selector (Public Trust through TS/SCI & Polygraph)
 * - Timeline / solicitation phase selector
 * - Organization / prime contractor details
 * - Client-side form validation with accessible error & success states
 * - Executive styling aligned with Unity Compass branding (#0B2553 navy & #FF3130 needle red)
 */
---

<div class="bg-white rounded-3xl border border-slate-200/90 p-8 sm:p-10 lg:p-12 shadow-[0_20px_50px_-10px_rgba(12,72,122,0.12)] relative overflow-hidden">
  <!-- Subtle decorative top accent line -->
  <div class="absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130]"></div>

  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-red-50 text-[#FF3130] border border-red-100 mb-3">
      <span class="w-2 h-2 rounded-full bg-[#FF3130] animate-pulse"></span>
      Direct GovCon Inquiry
    </div>
    <h3 class="text-2xl sm:text-3xl font-extrabold text-[#0B2553] tracking-tight">
      Send Us a Project Brief
    </h3>
    <p class="text-sm sm:text-base text-slate-600 mt-2 leading-relaxed">
      Provide details on your upcoming solicitation, capture requirements, or workforce needs. Our federal advisory team reviews submissions and responds within one business day under strict confidentiality.
    </p>
  </div>

  <form id="contact-form" class="space-y-6" novalidate>
    <!-- Interactive Success Banner -->
    <div id="contact-success" class="hidden p-5 rounded-2xl bg-emerald-50/90 border border-emerald-200 text-emerald-900 text-sm shadow-xs animate-in fade-in duration-300">
      <div class="flex items-start gap-3">
        <div class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <div>
          <h4 class="font-bold text-emerald-950 text-base">Inquiry Successfully Transmitted</h4>
          <p class="mt-1 text-emerald-800 leading-relaxed">
            Thank you for connecting with Unity Compass. A capture and workforce advisor has received your project brief and will follow up within 24 hours.
          </p>
        </div>
      </div>
    </div>

    <!-- Error Banner -->
    <div id="contact-error" class="hidden p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm shadow-xs animate-in fade-in duration-200">
      <div class="flex items-center gap-2 font-bold mb-1">
        <svg class="w-5 h-5 text-rose-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <span>Please Check Required Fields</span>
      </div>
      <p id="contact-error-msg" class="text-rose-700 pl-7">Please complete all required fields highlighted with an asterisk.</p>
    </div>

    <!-- Row 1: Name & Work Email -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label for="contact-name" class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-2">
          Full Name <span class="text-[#FF3130]">*</span>
        </label>
        <input
          type="text"
          id="contact-name"
          name="name"
          required
          placeholder="e.g. Sarah Jenkins"
          class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0C487A] focus:border-[#0C487A] transition-all"
        />
      </div>

      <div>
        <label for="contact-email" class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-2">
          Work / Agency Email <span class="text-[#FF3130]">*</span>
        </label>
        <input
          type="email"
          id="contact-email"
          name="email"
          required
          placeholder="e.g. sjenkins@company.com"
          class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0C487A] focus:border-[#0C487A] transition-all"
        />
      </div>
    </div>

    <!-- Row 2: Phone & Organization Name -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label for="contact-phone" class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-2">
          Direct Phone <span class="text-[#FF3130]">*</span>
        </label>
        <input
          type="tel"
          id="contact-phone"
          name="phone"
          required
          placeholder="e.g. +1 (301) 555-0199"
          class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0C487A] focus:border-[#0C487A] transition-all"
        />
      </div>

      <div>
        <label for="contact-org" class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-2">
          Organization / Prime Contractor <span class="text-[#FF3130]">*</span>
        </label>
        <input
          type="text"
          id="contact-org"
          name="organization"
          required
          placeholder="e.g. Raytheon / Apex Defense LLC"
          class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0C487A] focus:border-[#0C487A] transition-all"
        />
      </div>
    </div>

    <!-- Row 3: Service Focus & Clearance Level -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div>
        <label for="contact-service" class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-2">
          Practice Area of Interest <span class="text-[#FF3130]">*</span>
        </label>
        <select
          id="contact-service"
          name="service"
          required
          class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0C487A] focus:border-[#0C487A] transition-all cursor-pointer"
        >
          <option value="">Select practice area...</option>
          <option value="Proposal Development Services">Proposal Development Services</option>
          <option value="Security-Cleared Recruitment">Security-Cleared Recruitment</option>
          <option value="Staffing Solutions">Staffing Solutions (Contract / Temp-to-Hire)</option>
          <option value="IT & Business Consulting">IT & Business Consulting</option>
          <option value="Customized Support Services">Customized Support Services</option>
          <option value="General Advisory">Comprehensive GovCon Advisory</option>
        </select>
      </div>

      <div>
        <label for="contact-clearance" class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-2">
          Security Clearance Required
        </label>
        <select
          id="contact-clearance"
          name="clearance"
          class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0C487A] focus:border-[#0C487A] transition-all cursor-pointer"
        >
          <option value="None / Unspecified">None / Commercial Requirement</option>
          <option value="Public Trust">Public Trust (Tier 1/2/4)</option>
          <option value="Secret">Secret (DoD / Interim)</option>
          <option value="Top Secret">Top Secret (TS)</option>
          <option value="TS/SCI">Top Secret / SCI Eligible</option>
          <option value="Polygraph">TS/SCI with CI or Full-Scope Poly</option>
        </select>
      </div>
    </div>

    <!-- Row 4: Timeline / Solicitation Phase -->
    <div>
      <label for="contact-timeline" class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-2">
        Estimated Timeline / Solicitation Phase
      </label>
      <select
        id="contact-timeline"
        name="timeline"
        class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0C487A] focus:border-[#0C487A] transition-all cursor-pointer"
      >
        <option value="Immediate (< 30 Days)">Immediate / Active RFP Pursuit (&lt; 30 Days)</option>
        <option value="Short-Term (30-60 Days)">Short-Term Pipeline (30–60 Days)</option>
        <option value="Quarterly (90+ Days)">Pre-RFP / Forecasted Pursuit (90+ Days)</option>
        <option value="Standing Workforce">Ongoing Standing Workforce & Teaming Agreement</option>
      </select>
    </div>

    <!-- Row 5: Message / Project Requirements -->
    <div>
      <label for="contact-message" class="block text-xs font-bold text-[#0B2553] uppercase tracking-wider mb-2">
        Project Scope / Specific Requirements <span class="text-[#FF3130]">*</span>
      </label>
      <textarea
        id="contact-message"
        name="message"
        rows="4"
        required
        placeholder="Briefly describe your federal contracting goals, upcoming solicitation titles/NAICS codes, or technical talent requirements..."
        class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50/50 text-slate-900 text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-[#0C487A] focus:border-[#0C487A] transition-all resize-y"
      ></textarea>
    </div>

    <!-- Non-Disclosure Compliance Assurance -->
    <div class="flex items-start gap-3 p-4 rounded-xl bg-slate-50 border border-slate-100 text-xs text-slate-500">
      <svg class="w-4 h-4 text-[#0C487A] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
      </svg>
      <span>
        <strong class="font-semibold text-slate-700">Strict Confidentiality:</strong> All technical specifications, solicitation draft files, and pricing parameters submitted are handled under standard NDA practices.
      </span>
    </div>

    <!-- Submit Button -->
    <div class="pt-2">
      <button
        type="submit"
        id="contact-submit-btn"
        class="w-full sm:w-auto px-9 py-4 rounded-xl text-base font-bold text-white bg-gradient-to-r from-[#FF3130] to-[#E02625] hover:from-[#E02625] hover:to-[#C61E1D] shadow-[0_8px_24px_-4px_rgba(255,49,48,0.25)] hover:shadow-[0_12px_28px_-2px_rgba(255,49,48,0.35)] transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 cursor-pointer inline-flex items-center justify-center gap-3"
      >
        <span>Submit Project Inquiry</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </div>
  </form>
</div>

<script>
  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const successBox = document.getElementById('contact-success');
    const errorBox = document.getElementById('contact-error');
    const errorMsg = document.getElementById('contact-error-msg');
    const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;

    if (!form) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form || !successBox || !errorBox || !submitBtn) return;

      errorBox.classList.add('hidden');
      successBox.classList.add('hidden');

      const name = (document.getElementById('contact-name') as HTMLInputElement)?.value.trim();
      const email = (document.getElementById('contact-email') as HTMLInputElement)?.value.trim();
      const phone = (document.getElementById('contact-phone') as HTMLInputElement)?.value.trim();
      const org = (document.getElementById('contact-org') as HTMLInputElement)?.value.trim();
      const service = (document.getElementById('contact-service') as HTMLSelectElement)?.value.trim();
      const message = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value.trim();

      if (!name || !email || !phone || !org || !service || !message) {
        if (errorMsg) errorMsg.textContent = 'Please fill out all required fields marked with an asterisk.';
        errorBox.classList.remove('hidden');
        errorBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        return;
      }

      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailPattern.test(email)) {
        if (errorMsg) errorMsg.textContent = 'Please enter a valid work or corporate email address.';
        errorBox.classList.remove('hidden');
        errorBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        return;
      }

      // Submit state
      const originalText = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span>Transmitting Inquiry...</span>';

      setTimeout(() => {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
        successBox.classList.remove('hidden');
        successBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        form.reset();
      }, 700);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactForm);
  } else {
    initContactForm();
  }
  document.addEventListener('astro:page-load', initContactForm);
</script>
