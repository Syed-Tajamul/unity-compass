---
import { companyInfo } from '../data/company';
---

<section id="who-we-are" class="py-24 lg:py-32 bg-white relative overflow-hidden" aria-labelledby="home-about-heading">
  <!-- Subtle technical grid background accent -->
  <div class="absolute inset-0 bg-fed-grid-light opacity-60 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Editorial Architectural Visual Framing -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="relative w-full max-w-lg">
          
          <!-- Outer Architectural Bezel Frame -->
          <div class="p-2 sm:p-3 rounded-2xl bg-slate-50 border border-slate-200/90 shadow-elevated relative">
            
            <!-- Technical Coordinate Badge (Top-Right) -->
            <div class="absolute top-5 right-5 z-20 hidden sm:flex items-center gap-1.5 px-2.5 py-1 rounded bg-[#07192C]/85 backdrop-blur-md text-[10px] font-mono font-medium text-slate-300 border border-white/10">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              <span>NCR • FREDERICK HQ</span>
            </div>

            <!-- Workspace Image -->
            <div class="relative rounded-xl overflow-hidden bg-slate-900 aspect-[4/3] group">
              <img
                src="/images/2.jpg"
                alt="Unity Compass Strategic Federal Proposal and Advisory Workspace"
                class="w-full h-full object-cover transform transition-transform duration-700 ease-out group-hover:scale-105"
                loading="lazy"
                width="640"
                height="480"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#07192C]/60 via-transparent to-transparent pointer-events-none"></div>
            </div>

            <!-- Bottom Metadata Strip -->
            <div class="mt-3 px-3 py-2 flex items-center justify-between text-[11px] text-slate-500 font-medium">
              <span class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-brand-red"></span>
                <span>Active SAM.gov Entity</span>
              </span>
              <span class="font-mono text-slate-400">CAGE Code Assigned</span>
            </div>
          </div>

          <!-- Floating Executive Credential Card -->
          <div class="absolute -bottom-6 -left-3 sm:-left-6 bg-[#07192C] text-white rounded-xl p-4 sm:p-5 border border-slate-700 shadow-2xl max-w-[260px] hidden sm:block">
            <div class="flex items-center gap-2 mb-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="text-[10px] font-bold uppercase tracking-widest text-slate-300">GovCon Advisory</span>
            </div>
            <div class="text-sm font-extrabold text-white leading-tight">
              Defensible Documentation & Strategy
            </div>
            <div class="text-[11px] text-slate-400 mt-1 leading-snug">
              Precision advisory for prime and subcontractor teams nationwide.
            </div>
          </div>

        </div>
      </div>

      <!-- Right Column: Editorial Structured Narrative -->
      <div class="lg:col-span-7 space-y-7">
        
        <!-- Header Group with Signature Refined Accent -->
        <div>
          <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-brand-red mb-3">
            <span class="w-6 h-px bg-brand-red"></span>
            <span>Strategic Federal Consulting & Staffing</span>
          </div>
          
          <h2 id="home-about-heading" class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0C487A] tracking-tight leading-[1.15]">
            Who We Are
          </h2>
        </div>

        <!-- Structured Core Paragraphs with Verbatim Content -->
        <div class="space-y-4 text-base sm:text-lg text-slate-700 leading-relaxed font-normal">
          <p>
            Unity Compass is a government contracting consulting and staffing firm dedicated to helping commercial businesses and federal contractors compete, qualify, and perform in complex federal environments.
          </p>

          <p>
            We specialize in <a href="/proposal-development-services" class="font-semibold text-[#0C487A] hover:text-brand-red transition-colors underline decoration-[#0C487A]/30 hover:decoration-brand-red">proposal development</a>, <a href="/customized-support-services" class="font-semibold text-[#0C487A] hover:text-brand-red transition-colors underline decoration-[#0C487A]/30 hover:decoration-brand-red">OASIS+ readiness support</a>, cleared and non-cleared recruitment, staffing solutions, and <a href="/information-technology-and-business-consulting" class="font-semibold text-[#0C487A] hover:text-brand-red transition-colors underline decoration-[#0C487A]/30 hover:decoration-brand-red">IT & program consulting</a>.
          </p>

          <p>
            Our approach is structured, compliance-driven, and built around defensible documentation, because in federal contracting, precision determines outcomes.
          </p>
        </div>

        <!-- Visually Distinct Supporting Statement / Highlighted Message -->
        <div class="relative p-5 sm:p-6 rounded-xl bg-slate-50 border-l-4 border-brand-red border-y border-r border-slate-200/80 shadow-subtle">
          <div class="text-xs font-mono uppercase tracking-wider text-slate-500 mb-1">
            Core Operating Philosophy
          </div>
          <p class="text-base sm:text-lg font-bold text-slate-900 tracking-tight leading-snug italic">
            "In federal contracting, precision determines outcomes."
          </p>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Every submission, compliance volume, and cleared placement is engineered to eliminate evaluation risk and survive rigorous agency scrutiny.
          </p>
        </div>

        <!-- Refined Action Row -->
        <div class="pt-2 flex flex-wrap items-center gap-4">
          <!-- Primary Read More CTA -->
          <a
            href="/about-us"
            data-astro-prefetch="hover"
            class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-lg text-sm font-bold text-white bg-brand-red hover:bg-brand-red-hover transition-all duration-150 shadow-md hover:shadow-red-900/20 active:scale-[0.98]"
          >
            <span>Read More</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <!-- Secondary Capability CTA -->
          <a
            href={companyInfo.capabilityPdf}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-lg text-sm font-semibold text-slate-700 hover:text-[#0C487A] hover:bg-slate-50 border border-slate-300 transition-colors"
          >
            <svg class="w-4 h-4 text-brand-red shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Capability Statement</span>
          </a>
        </div>

      </div>

    </div>
  </div>
</section>
