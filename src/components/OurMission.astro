---
/**
 * OurMission.astro - "The Route" Scroll-Driven About Section for Unity Compass
 *
 * - Shimmer headline, eyebrow pill, animated accent bar (matches Hero / ServicesGrid / HomeIntroBanner)
 * - Blueprint grid, ambient radial glow, four-point sparkles (matches homepage)
 * - Winding navigation route over a topographic map; a compass marker travels the path on scroll
 * - Four waypoints: 01 Who We Are → 02 Our Values → 03 Our Mission → 04 Our Vision
 * - Sticky GPS bar (progress + next waypoint)
 * - Reached waypoints light up navy; the current waypoint gets the red active card treatment
 * - Stacked timeline under 760px, reduced-motion support, semantic list + live region
 */

const waypoints = [
  { num: '01', title: 'Who We Are',  coords: 'N 38.8951° · W 77.0364°', side: 'l', top: '14.18%' },
  { num: '02', title: 'Our Values',  coords: 'N 38.8977° · W 77.0365°', side: 'r', top: '38.81%' },
  { num: '03', title: 'Our Mission', coords: 'N 38.8899° · W 77.0091°', side: 'l', top: '63.43%' },
  { num: '04', title: 'Our Vision',  coords: 'N 38.8893° · W 77.0502°', side: 'r', top: '88.06%' },
];

const values = [
  { label: 'Client First', icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>' },
  { label: 'Integrity & Transparency', icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>' },
  { label: 'Innovation', icon: '<path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.3h6c0-1 .4-1.8 1-2.3A7 7 0 0 0 12 2z"/>' },
  { label: 'Quality Excellence', icon: '<circle cx="12" cy="8" r="6"/><path d="M15.48 12.89 17 22l-5-3-5 3 1.52-9.11"/>' },
  { label: 'Long-Term Partnerships', icon: '<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>' },
];

const routePath = 'M600,30 C600,110 480,110 480,190 C480,370 720,350 720,520 C720,690 480,670 480,850 C480,1030 720,1010 720,1180 C720,1260 600,1260 600,1310';
---

<section
  id="our-mission"
  class="relative py-20 sm:py-24 lg:py-28 bg-gradient-to-br from-[#F4F8FC] via-[#EBF3FA] to-[#DFEDF8] overflow-clip scroll-mt-16 border-t border-slate-200/80"
  aria-labelledby="mission-heading"
>
  <!-- Blueprint grid (matches Hero & ServicesGrid) -->
  <div
    class="absolute inset-0 pointer-events-none opacity-40 mix-blend-multiply"
    style="background-size: 16px 16px; background-image: linear-gradient(to right, rgba(12, 72, 122, 0.09) 1px, transparent 1px), linear-gradient(to bottom, rgba(12, 72, 122, 0.09) 1px, transparent 1px);"
    aria-hidden="true"
  ></div>

  <!-- Ambient radial glow -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4/5 h-[760px] bg-[radial-gradient(circle,rgba(40,121,182,0.12)_0%,transparent_70%)] rounded-full blur-3xl pointer-events-none"
    aria-hidden="true"
  ></div>

  <!-- Four-point sparkles (Unity Compass mark) -->
  <div class="mission-sparkles" aria-hidden="true">
    {[1, 2, 3, 4, 5, 6].map((n) => (
      <svg class={`sparkle-star sparkle-${n}`} viewBox="0 0 24 24" fill="currentColor"><path d="M12 0L14 9.5L24 12L14 14.5L12 24L10 14.5L0 12L10 9.5Z" /></svg>
    ))}
  </div>

  <div class="max-w-7xl xl:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Header -->
    <div class="text-center max-w-4xl mx-auto mb-10 sm:mb-12">
      <span class="mission-eyebrow mission-heading-reveal">
        <span class="mission-eyebrow-dot" aria-hidden="true"></span>
        About Unity Compass
      </span>

      <h2
        id="mission-heading"
        class="mission-heading-reveal mt-5 text-2xl sm:text-3xl md:text-4xl lg:text-[2.65rem] font-extrabold tracking-tight leading-[1.18] sm:leading-[1.22] lg:leading-[1.24] max-w-4xl mx-auto text-center"
      >
        <span class="mission-shimmer-line mission-shimmer-line-1">Every Partnership Starts</span>
        <span class="mission-shimmer-line mission-shimmer-line-2">With a Clear Route</span>
      </h2>

      <div class="w-24 h-1.5 rounded-full bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130] mission-accent-line section-accent-line mx-auto mt-4 mb-5"></div>

      <p class="mission-subheading-reveal text-sm sm:text-base lg:text-[1.05rem] text-slate-600 max-w-2xl mx-auto font-normal leading-relaxed text-center">
        Follow the path from who we are to where we're taking our clients: four waypoints that define how Unity Compass works.
      </p>
    </div>

    <div class="route-wrap">
      <!-- Sticky GPS bar -->
      <div class="route-hud" aria-hidden="true">
        <span class="route-hud-live"><i></i>Route Active</span>
        <div class="route-hud-bar"><span id="route-hud-fill"></span></div>
        <span class="route-hud-next" id="route-hud-next">Next: <b>Who We Are</b></span>
      </div>

      <!-- Map stage -->
      <div class="route-map" id="route-map">
        <svg class="route-svg" id="route-svg" viewBox="0 0 1200 1340" aria-hidden="true">
          <defs>
            <linearGradient id="ucr-route-grad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#0B2553" />
              <stop offset=".45" stop-color="#0C487A" />
              <stop offset=".75" stop-color="#1E40AF" />
              <stop offset="1" stop-color="#FF3130" />
            </linearGradient>
          </defs>

          <!-- Topographic contours -->
          <g class="route-topo" fill="none" stroke="rgba(12,72,122,0.10)" stroke-width="2">
            <ellipse cx="1060" cy="170" rx="80" ry="55" transform="rotate(-15 1060 170)" />
            <ellipse cx="1060" cy="170" rx="140" ry="95" transform="rotate(-15 1060 170)" />
            <ellipse cx="1060" cy="170" rx="200" ry="135" transform="rotate(-15 1060 170)" />
            <ellipse cx="150" cy="1200" rx="90" ry="60" transform="rotate(20 150 1200)" />
            <ellipse cx="150" cy="1200" rx="160" ry="105" transform="rotate(20 150 1200)" />
            <ellipse cx="150" cy="1200" rx="230" ry="150" transform="rotate(20 150 1200)" />
            <ellipse cx="600" cy="690" rx="60" ry="40" />
            <ellipse cx="600" cy="690" rx="110" ry="75" />
          </g>

          <!-- Compass rose watermark -->
          <g class="route-rose" transform="translate(1060 170)" fill="none" stroke="rgba(12,72,122,0.22)" stroke-width="2">
            <circle r="38" stroke-dasharray="3 5" />
            <path d="M0,-56 L0,56 M-56,0 L56,0" />
            <path d="M0,-36 L8,0 L0,36 L-8,0Z" fill="rgba(12,72,122,0.18)" />
            <text y="-64" text-anchor="middle" font-family="'Plus Jakarta Sans', sans-serif" font-weight="800" font-size="16" fill="#0C487A" stroke="none">N</text>
          </g>

          <!-- Planned route (dotted) -->
          <path d={routePath} fill="none" stroke="rgba(12,72,122,0.25)" stroke-width="5" stroke-linecap="round" stroke-dasharray="2 14" />

          <!-- Travelled route -->
          <path id="route-path" d={routePath} fill="none" stroke="url(#ucr-route-grad)" stroke-width="7" stroke-linecap="round" />

          <!-- Compass marker -->
          <g id="route-marker">
            <circle r="30" fill="rgba(255,49,48,0.14)" class="route-marker-halo" />
            <circle r="19" fill="#FFFFFF" stroke="#0C487A" stroke-width="3" />
            <path d="M-7,-8 L10,0 L-7,8 L-3,0Z" fill="#FF3130" />
          </g>
        </svg>

        <!-- Origin / Destination chips -->
        <div class="route-chip" style="left:50%;top:2.24%" aria-hidden="true">
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" /></svg></span>
          Origin
        </div>
        <div class="route-chip route-chip--dest" id="route-dest" style="left:50%;top:97.76%" aria-hidden="true">
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22V4" /><path d="M4 4h12l-2 4 2 4H4" /></svg></span>
          A Trusted Partner
        </div>

        <!-- Waypoint pins -->
        {waypoints.map((w) => (
          <span class="route-pin" style={`left:${w.side === 'l' ? 40 : 60}%;top:${w.top}`} aria-hidden="true">{w.num}</span>
        ))}

        <!-- Waypoint cards -->
        <ol class="route-cards" role="list">
          <!-- 01 Who We Are -->
          <li class="route-card route-card--l" style={`top:${waypoints[0].top}`}>
            <div class="route-card-top">
              <div class="pillar-badge-wrap">
                <div class="pillar-badge-glow"></div>
                <div class="pillar-badge-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18" /><path d="M5 21V7l7-4 7 4v14" /><path d="M9 21v-6h6v6" /><path d="M9 10h.01M15 10h.01" /></svg>
                </div>
              </div>
              <div class="route-card-meta">
                <span class="pillar-num">Waypoint 01</span>
                <span class="route-coords">{waypoints[0].coords}</span>
              </div>
            </div>
            <h3 class="pillar-title">Who We Are</h3>
            <p class="pillar-desc">
              <strong>Unity Compass (UC)</strong> specializes in IT and Business Consulting, providing Staffing, Recruitment, Proposal Development, and digital solutions for commercial and federal clients. We are dedicated to delivering results, ensuring lasting partnerships, and driving innovation and quality across every project.
            </p>
            <div class="route-tags">
              <span>Staffing</span><span>Recruitment</span><span>Proposal Development</span><span>Digital Solutions</span>
            </div>
          </li>

          <!-- 02 Our Values -->
          <li class="route-card route-card--r" style={`top:${waypoints[1].top}`}>
            <div class="route-card-top">
              <div class="pillar-badge-wrap">
                <div class="pillar-badge-glow"></div>
                <div class="pillar-badge-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" /></svg>
                </div>
              </div>
              <div class="route-card-meta">
                <span class="pillar-num">Waypoint 02</span>
                <span class="route-coords">{waypoints[1].coords}</span>
              </div>
            </div>
            <h3 class="pillar-title">Our Values</h3>
            <p class="pillar-desc">Five principles we carry through every mile of an engagement.</p>
            <ul class="route-values" role="list">
              {values.map((v) => (
                <li>
                  <span class="route-value-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={v.icon} />
                  </span>
                  {v.label}
                </li>
              ))}
            </ul>
          </li>

          <!-- 03 Our Mission -->
          <li class="route-card route-card--l" style={`top:${waypoints[2].top}`}>
            <div class="route-card-top">
              <div class="pillar-badge-wrap">
                <div class="pillar-badge-glow"></div>
                <div class="pillar-badge-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="2" /></svg>
                </div>
              </div>
              <div class="route-card-meta">
                <span class="pillar-num">Waypoint 03</span>
                <span class="route-coords">{waypoints[2].coords}</span>
              </div>
            </div>
            <h3 class="pillar-title">Our Mission</h3>
            <p class="pillar-desc pillar-desc--lead">
              To empower businesses with innovative solutions, exceptional talent, and strategic support to achieve their goals in the government marketplace.
            </p>
            <div class="route-tags route-tags--red">
              <span>Innovative Solutions</span><span>Exceptional Talent</span><span>Strategic Support</span>
            </div>
          </li>

          <!-- 04 Our Vision -->
          <li class="route-card route-card--r" style={`top:${waypoints[3].top}`}>
            <div class="route-card-top">
              <div class="pillar-badge-wrap">
                <div class="pillar-badge-glow"></div>
                <div class="pillar-badge-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /></svg>
                </div>
              </div>
              <div class="route-card-meta">
                <span class="pillar-num">Waypoint 04</span>
                <span class="route-coords">{waypoints[3].coords}</span>
              </div>
            </div>
            <h3 class="pillar-title">Our Vision</h3>
            <p class="pillar-desc pillar-desc--lead">
              To be a trusted partner for organizations seeking to make a meaningful impact across federal, state, and local markets.
            </p>
            <div class="route-markets">
              <div><strong>Federal</strong><small>Agencies &amp; Primes</small></div>
              <div><strong>State</strong><small>Statewide Programs</small></div>
              <div><strong>Local</strong><small>Municipal Partners</small></div>
            </div>
          </li>
        </ol>
      </div>
    </div>

    <div id="route-announcement" class="sr-only" aria-live="polite"></div>
  </div>
</section>

<style>
  /* ------------------------------------------------ */
  /* TOKENS (scoped to avoid clobbering :root)        */
  /* ------------------------------------------------ */
  #our-mission {
    --navy: #0C487A;
    --deep-navy: #0B2553;
    --red: #FF3130;
    --sky: #38BDF8;
    --slate-subtext: #475569;
    --route-line: rgba(12, 72, 122, 0.25);
    --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, monospace;
    font-family: var(--font-sans);
  }

  /* ------------------------------------------------ */
  /* HEADER REVEAL + SHIMMER (homepage harmony)       */
  /* ------------------------------------------------ */
  .mission-heading-reveal,
  .mission-subheading-reveal {
    opacity: 0;
    transform: translateY(18px);
    filter: blur(8px);
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1),
                transform 1.2s cubic-bezier(0.16, 1, 0.3, 1),
                filter 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(#our-mission.is-revealed) .mission-heading-reveal { opacity: 1; transform: none; filter: blur(0); transition-delay: .05s; }
  :global(#our-mission.is-revealed) .mission-subheading-reveal { opacity: 1; transform: none; filter: blur(0); transition-delay: .25s; }

  .mission-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 7px 16px; border-radius: 999px;
    background: #FFFFFF; border: 1px solid rgba(12, 72, 122, 0.14);
    box-shadow: 0 6px 18px -10px rgba(11, 37, 83, 0.35);
    font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--navy);
  }
  .mission-eyebrow-dot {
    width: 8px; height: 8px; border-radius: 50%; background: var(--red);
    box-shadow: 0 0 0 0 rgba(255, 49, 48, 0.5);
    animation: eyebrowPulse 2s ease-out infinite;
  }
  @keyframes eyebrowPulse {
    0% { box-shadow: 0 0 0 0 rgba(255, 49, 48, 0.5); }
    100% { box-shadow: 0 0 0 9px rgba(255, 49, 48, 0); }
  }

  .mission-shimmer-line {
    background: linear-gradient(90deg, #0B2553 0%, #0C487A 16%, #1E40AF 34%, #DC2626 52%, #FF3130 66%, #2563EB 82%, #0B2553 100%);
    background-size: 200% auto;
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
    display: block; width: fit-content; max-width: 100%; margin-inline: auto;
    will-change: background-position;
  }
  .mission-shimmer-line-1 { animation: heroHeadingShimmer 7s cubic-bezier(0.4, 0, 0.2, 1) infinite; }
  .mission-shimmer-line-2 { animation: heroHeadingShimmer 7s cubic-bezier(0.4, 0, 0.2, 1) 0.8s infinite; }

  .mission-accent-line { background-size: 200% 100%; animation: missionAccentShift 6s ease-in-out infinite alternate; }
  @keyframes missionAccentShift { from { background-position: 0% 50%; } to { background-position: 100% 50%; } }

  /* Sparkles */
  .mission-sparkles { position: absolute; inset: 0; pointer-events: none; z-index: 2; }
  .sparkle-star { position: absolute; color: var(--navy); opacity: .16; animation: starTwinkle 7s ease-in-out infinite alternate; }
  .sparkle-1 { top: 8%;  left: 12%; width: 14px; height: 14px; animation-delay: 0s; }
  .sparkle-2 { top: 14%; right: 14%; width: 18px; height: 18px; animation-delay: 2.2s; }
  .sparkle-3 { bottom: 18%; left: 6%; width: 12px; height: 12px; animation-delay: 4.1s; }
  .sparkle-4 { bottom: 8%; right: 10%; width: 16px; height: 16px; animation-delay: 1.5s; }
  .sparkle-5 { top: 44%; left: 4%; width: 10px; height: 10px; animation-delay: 5.3s; }
  .sparkle-6 { top: 60%; right: 4%; width: 14px; height: 14px; animation-delay: 3.4s; }
  @keyframes starTwinkle { 0%,100% { opacity: .12; transform: scale(.85); } 50% { opacity: .45; transform: scale(1.15); } }

  /* ------------------------------------------------ */
  /* ROUTE STAGE                                      */
  /* ------------------------------------------------ */
  .route-wrap { max-width: 1200px; margin: 0 auto; container-type: inline-size; }

  /* Sticky GPS bar (sits under the site header) */
  .route-hud {
    position: sticky; top: 84px; z-index: 30;
    display: flex; align-items: center; gap: 16px;
    max-width: 640px; margin: 0 auto 28px; padding: 10px 18px;
    background: rgba(255, 255, 255, 0.88); backdrop-filter: blur(10px);
    border: 1px solid rgba(12, 72, 122, 0.12); border-radius: 999px;
    box-shadow: 0 14px 34px -20px rgba(11, 37, 83, 0.45);
    font-size: 0.8rem; font-weight: 700; color: var(--deep-navy);
  }
  .route-hud-live { display: flex; align-items: center; gap: 7px; white-space: nowrap; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--navy); }
  .route-hud-live i { width: 8px; height: 8px; border-radius: 50%; background: var(--red); animation: hudBlink 1.4s ease-in-out infinite; }
  @keyframes hudBlink { 50% { opacity: .25; } }
  .route-hud-bar { flex: 1; height: 6px; border-radius: 6px; background: #E2EAF4; overflow: hidden; }
  .route-hud-bar span { display: block; height: 100%; width: 0; border-radius: 6px; background: linear-gradient(90deg, var(--navy), #1E40AF, var(--red)); }
  .route-hud-next { white-space: nowrap; color: var(--slate-subtext); font-weight: 600; }
  .route-hud-next :global(b) { color: var(--deep-navy); font-weight: 800; }

  .route-map { position: relative; width: 100%; aspect-ratio: 1200 / 1340; }
  .route-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .route-cards { margin: 0; padding: 0; list-style: none; }

  .route-rose { transform-box: fill-box; }
  .route-marker-halo { animation: haloPulse 2.2s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes haloPulse { 50% { transform: scale(1.25); opacity: .55; } }

  /* Pins */
  .route-pin {
    position: absolute; z-index: 15;
    width: 46px; height: 46px; transform: translate(-50%, -50%);
    display: grid; place-items: center; border-radius: 50%;
    background: #FFFFFF; border: 2px solid rgba(12, 72, 122, 0.22);
    font-family: var(--font-mono); font-size: .85rem; font-weight: 800; color: rgba(12, 72, 122, 0.45);
    transition: all .45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .route-pin.is-reached { background: var(--navy); border-color: var(--navy); color: #FFFFFF; box-shadow: 0 0 0 8px rgba(12, 72, 122, 0.12); }
  .route-pin.is-current { background: var(--red); border-color: var(--red); box-shadow: 0 0 0 8px rgba(255, 49, 48, 0.16); transform: translate(-50%, -50%) scale(1.08); }
  .route-pin.is-current::after { content: ""; position: absolute; inset: -9px; border-radius: 50%; border: 2px solid rgba(255, 49, 48, 0.4); animation: pinRing 2s ease-out infinite; }
  @keyframes pinRing { to { transform: scale(1.6); opacity: 0; } }

  /* Origin / destination chips */
  .route-chip {
    position: absolute; z-index: 15; transform: translate(-50%, -50%);
    display: flex; align-items: center; gap: 8px; padding: 6px 16px 6px 6px; border-radius: 999px;
    background: var(--deep-navy); color: #FFFFFF; font-size: .82rem; font-weight: 800; white-space: nowrap;
    box-shadow: 0 12px 26px -12px rgba(11, 37, 83, 0.6);
  }
  .route-chip span { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: rgba(255, 255, 255, 0.16); }
  .route-chip svg { width: 16px; height: 16px; }
  .route-chip--dest { background: #94A3B8; box-shadow: none; transition: background .5s ease, box-shadow .5s ease; }
  .route-chip--dest.is-arrived { background: var(--red); box-shadow: 0 12px 26px -12px rgba(255, 49, 48, 0.65); }

  /* Cards (WhyChooseUs harmony) */
  .route-card {
    position: absolute; z-index: 10; width: 35%;
    transform: translateY(-50%) scale(.97);
    padding: 24px 26px; border-radius: 24px;
    background: #FFFFFF; border: 2px solid #F1F5F9;
    box-shadow: 0 10px 35px -5px rgba(11, 37, 83, 0.08);
    opacity: .5; filter: grayscale(.65);
    transition: opacity .55s ease, filter .55s ease, transform .55s cubic-bezier(0.16, 1, 0.3, 1), border-color .3s ease, box-shadow .3s ease;
  }
  .route-card--l { left: 0; }
  .route-card--r { right: 0; }
  .route-card.is-reached { opacity: 1; filter: none; transform: translateY(-50%) scale(1); }
  .route-card.is-current {
    border-color: var(--red);
    box-shadow: 0 20px 45px -10px rgba(11, 37, 83, 0.16), 0 0 25px rgba(255, 49, 48, 0.18);
  }

  /* Dashed connector from card to pin */
  .route-card::after {
    content: ""; position: absolute; top: 50%; width: 14.3%;
    border-top: 2px dashed var(--route-line); transition: border-color .45s ease;
  }
  .route-card--l::after { left: 100%; }
  .route-card--r::after { right: 100%; }
  .route-card.is-reached::after { border-top-color: var(--navy); }
  .route-card.is-current::after { border-top-color: var(--red); }

  .route-card-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .route-card-meta { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; text-align: right; }
  .route-coords { font-family: var(--font-mono); font-size: .68rem; color: #94A3B8; letter-spacing: .02em; }

  .pillar-badge-wrap { position: relative; width: 48px; height: 48px; flex-shrink: 0; }
  .pillar-badge-glow { position: absolute; inset: -4px; border-radius: 50%; background: radial-gradient(circle, rgba(255, 49, 48, 0.35) 0%, transparent 70%); opacity: 0; transition: opacity .4s ease; }
  .pillar-badge-icon {
    position: relative; width: 48px; height: 48px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: var(--navy); color: #FFFFFF; box-shadow: 0 6px 18px rgba(12, 72, 122, 0.25); transition: all .3s ease;
  }
  .route-card.is-current .pillar-badge-glow { opacity: 1; animation: badgePulse 2.8s ease-in-out infinite alternate; }
  .route-card.is-current .pillar-badge-icon { background: var(--red); box-shadow: 0 8px 25px rgba(255, 49, 48, 0.38); }
  @keyframes badgePulse { from { transform: scale(.95); opacity: .45; } to { transform: scale(1.15); opacity: .85; } }

  .pillar-num { font-family: var(--font-mono); font-size: .8rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--navy); transition: color .3s ease; }
  .route-card.is-current .pillar-num { color: var(--red); }
  .pillar-title { margin: 0 0 8px; font-size: 1.3rem; font-weight: 800; line-height: 1.3; color: var(--deep-navy); }
  .pillar-desc { margin: 0; font-size: .9rem; line-height: 1.65; color: var(--slate-subtext); }
  .pillar-desc strong { color: var(--deep-navy); font-weight: 700; }
  .pillar-desc--lead { font-size: .98rem; color: #1E293B; }

  .route-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
  .route-tags span { padding: 5px 12px; border-radius: 999px; font-size: .75rem; font-weight: 700; color: var(--navy); background: #F1F6FC; border: 1px solid #E2EAF4; }
  .route-tags--red span { background: #FFF0F0; border-color: #FFD3D2; color: #C81E1E; }

  .route-values { list-style: none; margin: 14px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .route-values li {
    display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 12px;
    background: #F6F9FD; border: 1px solid #E8EFF7;
    font-size: .8rem; font-weight: 700; line-height: 1.3; color: var(--deep-navy);
    transition: transform .25s ease, border-color .25s ease, background .25s ease;
  }
  .route-values li:hover { transform: translateY(-2px); background: #FFFFFF; border-color: rgba(12, 72, 122, 0.25); }
  .route-values li:last-child { grid-column: 1 / -1; }
  .route-value-icon { flex-shrink: 0; width: 30px; height: 30px; border-radius: 9px; display: grid; place-items: center; background: var(--navy); color: #FFFFFF; }
  .route-values li:nth-child(even) .route-value-icon { background: var(--red); }
  .route-value-icon svg { width: 16px; height: 16px; }

  .route-markets { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 14px; }
  .route-markets div { padding: 12px 8px; border-radius: 12px; background: #F6F9FD; border: 1px solid #E8EFF7; text-align: center; }
  .route-markets strong { display: block; font-size: .9rem; font-weight: 800; color: var(--deep-navy); }
  .route-markets small { display: block; margin-top: 2px; font-size: .7rem; color: var(--slate-subtext); }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  /* ------------------------------------------------ */
  /* TABLET (container 760–1080px)                    */
  /* ------------------------------------------------ */
  @container (max-width: 1080px) {
    .route-card { padding: 18px 20px; border-radius: 20px; }
    .route-coords { display: none; }
    .pillar-title { font-size: 1.1rem; }
    .pillar-desc { font-size: .82rem; }
    .pillar-desc--lead { font-size: .88rem; }
    .route-values { grid-template-columns: 1fr; gap: 6px; }
    .route-values li { padding: 6px 8px; }
    .route-pin { width: 38px; height: 38px; font-size: .75rem; }
  }

  /* ------------------------------------------------ */
  /* MOBILE (container < 760px): stacked route        */
  /* ------------------------------------------------ */
  @container (max-width: 760px) {
    .route-hud { display: none; }
    .route-map { aspect-ratio: auto; padding-left: 34px; }
    .route-map::before {
      content: ""; position: absolute; left: 11px; top: 10px; bottom: 10px; width: 3px; border-radius: 3px;
      background: linear-gradient(180deg, var(--deep-navy), var(--navy), #1E40AF, var(--red));
    }
    .route-svg, .route-pin, .route-chip { display: none; }
    .route-cards { display: flex; flex-direction: column; gap: 20px; }
    .route-card, .route-card.is-reached {
      position: relative; top: auto !important; width: 100%;
      transform: none; opacity: 1; filter: none;
    }
    .route-card::after {
      left: -31px !important; right: auto !important; width: 16px; height: 16px;
      border: 3px solid var(--navy) !important; border-radius: 50%; background: #FFFFFF; transform: translateY(-50%);
    }
    .route-card:nth-child(3)::after { border-color: var(--red) !important; }
    .route-values { grid-template-columns: 1fr 1fr; }
  }
  @container (max-width: 420px) {
    .route-values, .route-markets { grid-template-columns: 1fr; }
  }

  /* ------------------------------------------------ */
  /* REDUCED MOTION                                   */
  /* ------------------------------------------------ */
  @media (prefers-reduced-motion: reduce) {
    .mission-heading-reveal, .mission-subheading-reveal { opacity: 1 !important; transform: none !important; filter: none !important; }
    #our-mission *, #our-mission *::after { animation: none !important; transition: none !important; }
  }
</style>

<script>
  function initOurMissionSection() {
    const section = document.getElementById('our-mission');
    if (!section || section.dataset.routeInit === 'true') return;
    section.dataset.routeInit = 'true';

    const map = document.getElementById('route-map');
    const svg = document.getElementById('route-svg');
    const route = document.getElementById('route-path') as SVGPathElement | null;
    const marker = document.getElementById('route-marker');
    const fill = document.getElementById('route-hud-fill');
    const next = document.getElementById('route-hud-next');
    const dest = document.getElementById('route-dest');
    const announce = document.getElementById('route-announcement');
    const pins = Array.from(section.querySelectorAll<HTMLElement>('.route-pin'));
    const cards = Array.from(section.querySelectorAll<HTMLElement>('.route-card'));
    if (!map || !svg || !route || !marker) return;

    const names = ['Who We Are', 'Our Values', 'Our Mission', 'Our Vision'];
    const WP: [number, number][] = [[480, 190], [720, 520], [480, 850], [720, 1180]];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Header entrance
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { section.classList.add('is-revealed'); io.disconnect(); } });
      }, { threshold: 0.15 });
      io.observe(section);
    } else {
      section.classList.add('is-revealed');
    }

    // Route geometry
    const L = route.getTotalLength();
    route.style.strokeDasharray = `${L}`;
    route.style.strokeDashoffset = `${L}`;
    const wpL = WP.map(([x, y]) => {
      let best = 0, bd = Infinity;
      for (let i = 0; i <= 600; i++) {
        const l = (L * i) / 600, p = route.getPointAtLength(l);
        const d = (p.x - x) ** 2 + (p.y - y) ** 2;
        if (d < bd) { bd = d; best = l; }
      }
      return best;
    });

    let lastCurrent = -2;

    function setProgress(p: number) {
      const l = L * p;
      route!.style.strokeDashoffset = `${L - l}`;

      const a = route!.getPointAtLength(l);
      const f = route!.getPointAtLength(Math.min(l + 3, L));
      const b = route!.getPointAtLength(Math.max(l - 3, 0));
      const angle = (Math.atan2(f.y - b.y, f.x - b.x) * 180) / Math.PI;
      marker!.setAttribute('transform', `translate(${a.x} ${a.y}) rotate(${angle})`);

      let current = -1;
      wpL.forEach((w, i) => {
        const reached = l >= w - 1;
        pins[i]?.classList.toggle('is-reached', reached);
        cards[i]?.classList.toggle('is-reached', reached);
        if (reached) current = i;
      });
      pins.forEach((pin, i) => pin.classList.toggle('is-current', i === current));
      cards.forEach((card, i) => card.classList.toggle('is-current', i === current));

      const arrived = p > 0.985;
      dest?.classList.toggle('is-arrived', arrived);
      if (fill) fill.style.width = `${(p * 100).toFixed(1)}%`;
      if (next) {
        next.innerHTML = arrived
          ? 'Arrived: <b>A Trusted Partner</b>'
          : current >= 3 ? 'Next: <b>Destination</b>' : `Next: <b>${names[current + 1]}</b>`;
      }

      if (current !== lastCurrent && current >= 0 && announce) {
        announce.textContent = `Waypoint 0${current + 1}: ${names[current]}.`;
      }
      lastCurrent = current;
    }

    const isStacked = () => getComputedStyle(svg).display === 'none';

    let ticking = false;
    function update() {
      ticking = false;
      if (isStacked()) { cards.forEach((c) => c.classList.add('is-reached')); return; }
      if (reduced) { setProgress(1); return; }
      const r = map!.getBoundingClientRect();
      const p = Math.min(Math.max((window.innerHeight * 0.6 - r.top) / (r.height * 0.92), 0), 1);
      setProgress(p);
    }
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };

    const controller = new AbortController();
    window.addEventListener('scroll', onScroll, { passive: true, signal: controller.signal });
    window.addEventListener('resize', onScroll, { signal: controller.signal });
    document.addEventListener('astro:before-swap', () => {
      controller.abort();
      delete section.dataset.routeInit;
    }, { once: true });

    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initOurMissionSection);
  } else {
    initOurMissionSection();
  }
  document.addEventListener('astro:page-load', initOurMissionSection);
</script>