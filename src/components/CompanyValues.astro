---
/**
 * CompanyValues.astro - Core Values & Delivery Framework
 * 
 * 100% Authentic Unity Compass Core Delivery Framework & Values:
 * - Royal Blue Canvas (#3355A5) with vertical dotted guidelines (.bg-vertical-dotted-guidelines)
 * - Top organic wave divider transitioning from the light section above
 * - Header Row:
 *   - Left: "OUR MISSION & CORE VALUES" white translucent pill + "How We Run Our Business"
 *   - Right: Circular navigation buttons (white circles with royal blue arrows)
 * - 4 Tall Vertical White Cards with responsive corners:
 *   1. Compliance-Centered Approach (Red accent badge #FF3130)
 *   2. Structured Methodology (Royal blue badge #0C487A)
 *   3. Integrated Support Model (Red accent badge #FF3130)
 *   4. Performance-Focused Delivery (Royal blue badge #0C487A)
 */

interface ValueItem {
  id: string;
  badgeColor: 'red' | 'navy';
  title: string;
  displayTitle: string;
  description: string;
  iconSvg: string;
}

const values: ValueItem[] = [
  {
    id: 'val-compliance',
    badgeColor: 'red',
    title: 'Compliance-Centered Approach',
    displayTitle: 'Compliance-Centered Approach',
    description: 'Every proposal, staffing action, and documentation package is built to withstand rigorous procurement evaluation and audit scrutiny.',
    iconSvg: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>`
  },
  {
    id: 'val-methodology',
    badgeColor: 'navy',
    title: 'Structured Methodology',
    displayTitle: 'Structured Methodology',
    description: 'From Qualifying Project (QP) structuring to clearance verification, our processes are systematic, defensible, and repeatable.',
    iconSvg: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM8.25 10.5v3m7.5-3v4.5m0 0H12m3.75 0h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25h-2.25a2.25 2.25 0 01-2.25-2.25v-1.5" /></svg>`
  },
  {
    id: 'val-integrated',
    badgeColor: 'red',
    title: 'Integrated Support Model',
    displayTitle: 'Integrated Support Model',
    description: 'We bridge proposal strategy, staffing execution, and technical advisory, reducing fragmentation common in complex federal projects.',
    iconSvg: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0l4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0l-5.571 3-5.571-3" /></svg>`
  },
  {
    id: 'val-performance',
    badgeColor: 'navy',
    title: 'Performance-Focused Delivery',
    displayTitle: 'Performance-Focused Delivery',
    description: 'We align services to measurable outcomes such as submission readiness, staffing cycle reduction, and defensible past performance records.',
    iconSvg: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" /></svg>`
  }
];
---

<section
  id="our-values"
  class="relative bg-[#3355A5] text-white pt-20 pb-24 lg:pt-28 lg:pb-32 overflow-hidden scroll-mt-20"
  aria-labelledby="values-heading"
>
  <!-- Top Wave Transition from light Section 4 into Royal Blue (Screenshot 5) -->
  <div class="absolute top-0 left-0 right-0 w-full overflow-hidden leading-none pointer-events-none z-10 -translate-y-[1px]">
    <svg viewBox="0 0 1440 70" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-10 sm:h-14 lg:h-16 text-[#F8FAFD] preserve-3d">
      <path d="M0,0 L1440,0 L1440,25 C1150,70 750,70 0,25 Z" fill="currentColor"></path>
    </svg>
  </div>

  <!-- Vertical Dotted Guidelines Background -->
  <div class="absolute inset-0 bg-vertical-dotted-guidelines opacity-80 pointer-events-none" aria-hidden="true"></div>

  <!-- Ambient Light Orbs -->
  <div class="absolute -top-24 -right-24 w-96 h-96 bg-blue-400/20 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-red-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20">
    
    <!-- Header Row (Screenshot 5 Layout) -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12 sm:mb-16">
      
      <!-- Left: Pill Eyebrow + Section Title -->
      <div>
        <!-- Translucent Pill: "OUR MISSION & CORE VALUES" -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/20 backdrop-blur-sm text-white text-xs font-bold uppercase tracking-widest shadow-xs mb-3">
          <span>OUR MISSION &amp; CORE VALUES</span>
        </div>

        <!-- Title: "How We Run Our Business" -->
        <h2
          id="values-heading"
          class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight"
        >
          How We Run Our Business
        </h2>

        <!-- Animated Brand Accent Bar (White-to-Red Dynamic Pulse) -->
        <div class="w-24 h-1.5 rounded-full bg-gradient-to-r from-white via-sky-200 to-[#FF3130] section-accent-line mt-4"></div>
      </div>

      <!-- Right: Circular Navigation Arrow Buttons (Screenshot 5) -->
      <div class="flex items-center gap-3 shrink-0">
        <button
          type="button"
          id="values-prev-btn"
          aria-label="Previous core value"
          class="w-12 h-12 rounded-full bg-white text-[#3355A5] flex items-center justify-center shadow-lg hover:bg-slate-100 hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer group"
        >
          <svg class="w-5 h-5 group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <button
          type="button"
          id="values-next-btn"
          aria-label="Next core value"
          class="w-12 h-12 rounded-full bg-white text-[#3355A5] flex items-center justify-center shadow-lg hover:bg-slate-100 hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer group"
        >
          <svg class="w-5 h-5 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

    </div>

    <!-- 4 Tall Vertical White Cards (Screenshot 5 Layout) -->
    <div
      id="values-carousel-container"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 overflow-x-auto lg:overflow-visible pb-4 lg:pb-0 scroll-smooth snap-x snap-mandatory"
    >
      {values.map((item, index) => (
        <div
          class="bg-white rounded-2xl sm:rounded-3xl p-8 sm:p-9 shadow-2xl flex flex-col justify-start relative overflow-hidden group hover:-translate-y-2 hover:shadow-[0_25px_50px_-12px_rgba(0,0,0,0.25)] transition-all duration-300 min-h-[380px] snap-center shrink-0 w-full"
          style={`animation-delay: ${index * 80}ms;`}
        >
          <!-- Top Indicator Accent -->
          <div class={`absolute top-0 left-0 right-0 h-1.5 transition-colors duration-300 ${
            item.badgeColor === 'red' ? 'bg-[#FF3130]' : 'bg-[#0C487A]'
          }`}></div>

          <!-- Circular Glowing Badge -->
          <div class="mb-8">
            <div class={`w-16 h-16 rounded-full flex items-center justify-center text-white transition-transform duration-300 group-hover:scale-110 ${
              item.badgeColor === 'red'
                ? 'bg-[#FF3130] shadow-[0_8px_25px_rgba(255,49,48,0.35)]'
                : 'bg-[#0C487A] shadow-[0_8px_25px_rgba(12,72,122,0.35)]'
            }`}>
              <Fragment set:html={item.iconSvg} />
            </div>
          </div>

          <!-- Title: Deep Navy (#0B2553) -->
          <h3 class="text-xl sm:text-2xl font-bold text-[#0B2553] mb-3.5 group-hover:text-[#0C487A] transition-colors leading-snug">
            {item.title}
          </h3>

          <!-- Description: Verbatim Unity Compass -->
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal">
            {item.description}
          </p>

          <!-- Micro bottom subtle accent indicator -->
          <div class="mt-auto pt-6 flex items-center gap-1.5 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <span class={`w-2 h-2 rounded-full ${item.badgeColor === 'red' ? 'bg-[#FF3130]' : 'bg-[#0C487A]'}`}></span>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider font-mono">Institutional Standard</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const container = document.getElementById('values-carousel-container');
  const prevBtn = document.getElementById('values-prev-btn');
  const nextBtn = document.getElementById('values-next-btn');

  if (container && prevBtn && nextBtn) {
    prevBtn.addEventListener('click', () => {
      container.scrollBy({ left: -320, behavior: 'smooth' });
    });
    nextBtn.addEventListener('click', () => {
      container.scrollBy({ left: 320, behavior: 'smooth' });
    });
  }
</script>
