---
import type { Testimonial } from '../data/testimonials';

interface Props {
  testimonial: Testimonial;
}

const { testimonial } = Astro.props;
---

<div class="gov-card flex flex-col justify-between h-full bg-white relative">
  <div>
    <!-- Top Quote Mark & Area Badge -->
    <div class="flex items-center justify-between mb-4">
      <span class="inline-flex items-center px-2.5 py-1 rounded text-[11px] font-semibold bg-slate-100 text-slate-700 border border-slate-200">
        {testimonial.impactArea}
      </span>
      <svg class="w-8 h-8 text-slate-200" fill="currentColor" viewBox="0 0 24 24">
        <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
      </svg>
    </div>

    <!-- Quote Body -->
    <blockquote class="text-sm sm:text-base text-slate-700 leading-relaxed italic">
      "{testimonial.quote}"
    </blockquote>
  </div>

  <!-- Attribution -->
  <div class="mt-6 pt-4 border-t border-slate-100 flex items-center gap-3">
    <div class="w-10 h-10 rounded-full bg-brand-navy/10 text-brand-navy font-bold flex items-center justify-center text-sm border border-brand-navy/20">
      {testimonial.authorRole.slice(0, 2).toUpperCase()}
    </div>
    <div>
      <div class="text-sm font-bold text-slate-900">
        {testimonial.authorRole}
      </div>
      <div class="text-xs text-slate-500">
        {testimonial.organizationType}
      </div>
    </div>
  </div>
</div>

