---
import { verifiedMetrics } from '../data/company';
---

<section class="py-16 bg-slate-900 text-white relative overflow-hidden" aria-labelledby="metrics-heading">
  <!-- Subtle Grid Texture Overlay -->
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 24px 24px;"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase bg-brand-red/20 text-red-400 border border-brand-red/30 mb-3">
        Proven Federal Track Record
      </span>
      <h2 id="metrics-heading" class="text-2xl sm:text-3xl font-bold tracking-tight text-white">
        Measurable Outcomes Across Federal, Defense, & State Solicitations
      </h2>
      <p class="mt-3 text-sm text-slate-400 leading-relaxed">
        Verifiable contract capture performance derived directly from Unity Compass’s corporate past performance and capability portfolio.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8">
      {verifiedMetrics.map((m) => (
        <div class="bg-slate-800/60 rounded-xl p-5 border border-slate-700/60 flex flex-col justify-between hover:border-slate-600 transition-colors">
          <div>
            <div class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight text-brand-red">
              {m.value}
            </div>
            <div class="text-xs font-bold text-slate-200 mt-2 uppercase tracking-wide">
              {m.label}
            </div>
          </div>
          <div class="text-[11px] text-slate-400 mt-2 pt-2 border-t border-slate-700/50 leading-snug">
            {m.detail}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

