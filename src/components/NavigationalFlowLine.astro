---
/**
 * NavigationalFlowLine.astro - SVG Motion Path with Traveling Luminous Orbs
 * 
 * Tailored specifically for Unity Compass's federal navigation theme.
 * 
 * Features:
 * - Ultra-fine, elegant cubic Bézier spline with multi-stop brand gradient
 * - Luminous traveling waypoint orbs (Beacon Red, Electric Azure, Compass Amber, Emerald Mint)
 * - Hardware-accelerated SVG <animateMotion> running at 60-120 FPS
 * - Zero external JS dependencies, zero layout shifts (CLS: 0)
 * - Full responsive vector scaling (viewBox)
 * - Supports prefers-reduced-motion accessibility
 */

interface Props {
  variant?: 'hero' | 'banner' | 'wave';
  class?: string;
}

const { variant = 'hero', class: className = '' } = Astro.props;

// Dedicated Bézier paths tailored for each layout context
const paths = {
  hero: "M -60 290 C 220 130, 480 470, 840 230 C 1100 50, 1320 370, 1520 220",
  banner: "M -60 210 C 260 410, 560 90, 890 270 C 1180 430, 1360 140, 1520 280",
  wave: "M -60 160 C 300 40, 620 320, 960 140 C 1220 20, 1380 260, 1520 180",
};

const activePath = paths[variant] || paths.hero;
---

<div
  class:list={[
    "nav-flow-container absolute inset-0 pointer-events-none overflow-hidden select-none",
    className,
  ]}
  aria-hidden="true"
>
  <svg
    class="w-full h-full"
    viewBox="0 0 1440 600"
    preserveAspectRatio="none"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!-- Multi-Stop Brand Gradient for the Waypoint Trajectory Spline -->
      <linearGradient id={`flowTrackGrad-${variant}`} x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#0B2553" stop-opacity="0.0" />
        <stop offset="15%" stop-color="#2563EB" stop-opacity="0.28" />
        <stop offset="45%" stop-color="#818CF8" stop-opacity="0.38" />
        <stop offset="70%" stop-color="#FF3130" stop-opacity="0.32" />
        <stop offset="90%" stop-color="#38BDF8" stop-opacity="0.25" />
        <stop offset="100%" stop-color="#0B2553" stop-opacity="0.0" />
      </linearGradient>

      <!-- Faint Secondary Echo Gradient -->
      <linearGradient id={`flowTrackEcho-${variant}`} x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#38BDF8" stop-opacity="0.0" />
        <stop offset="50%" stop-color="#60A5FA" stop-opacity="0.14" />
        <stop offset="100%" stop-color="#38BDF8" stop-opacity="0.0" />
      </linearGradient>

      <!-- Soft Ambient Glow Filters for Traveling Orbs -->
      <filter id={`orbGlowRed-${variant}`} x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="4.5" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <filter id={`orbGlowCyan-${variant}`} x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="4.5" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <filter id={`orbGlowAmber-${variant}`} x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="4" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <filter id={`orbGlowMint-${variant}`} x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="4" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <!-- Faint Parallel Depth Echo Path -->
    <path
      d={activePath}
      fill="none"
      stroke={`url(#flowTrackEcho-${variant})`}
      stroke-width="3"
      stroke-linecap="round"
      class="opacity-60 transform translate-y-1.5"
    />

    <!-- Primary Thin Navigational Guide Line -->
    <path
      d={activePath}
      fill="none"
      stroke={`url(#flowTrackGrad-${variant})`}
      stroke-width="1.35"
      stroke-linecap="round"
    />

    <!-- =================================================================== -->
    <!-- TRAVELING LUMINOUS ORBS (Continuous Bézier Motion Along Path)        -->
    <!-- =================================================================== -->

    <!-- 1. Federal Beacon Red Orb (#FF3130) -->
    <g class="flow-orb-group">
      <!-- Ambient Outer Bloom Circle -->
      <circle r="7" fill="#FF3130" opacity="0.35" filter={`url(#orbGlowRed-${variant})`} />
      <!-- Solid Core Bead -->
      <circle r="4.5" fill="#FF3130" />
      <!-- Luminous Specular Center Pin -->
      <circle r="1.8" fill="#FFFFFF" opacity="0.95" />
      <animateMotion
        dur="18s"
        repeatCount="indefinite"
        path={activePath}
      />
    </g>

    <!-- 2. GovCon Electric Cyan / Azure Orb (#00D2FF) -->
    <g class="flow-orb-group">
      <!-- Ambient Outer Bloom Circle -->
      <circle r="6.5" fill="#00D2FF" opacity="0.38" filter={`url(#orbGlowCyan-${variant})`} />
      <!-- Solid Core Bead -->
      <circle r="4.2" fill="#00C4F0" />
      <!-- Luminous Specular Center Pin -->
      <circle r="1.6" fill="#FFFFFF" opacity="0.95" />
      <animateMotion
        dur="22s"
        begin="-6s"
        repeatCount="indefinite"
        path={activePath}
      />
    </g>

    <!-- 3. Compass Amber / Gold Orb (#F59E0B) -->
    <g class="flow-orb-group">
      <!-- Ambient Outer Bloom Circle -->
      <circle r="6" fill="#F59E0B" opacity="0.35" filter={`url(#orbGlowAmber-${variant})`} />
      <!-- Solid Core Bead -->
      <circle r="4" fill="#F59E0B" />
      <!-- Luminous Specular Center Pin -->
      <circle r="1.5" fill="#FFFFFF" opacity="0.95" />
      <animateMotion
        dur="26s"
        begin="-13s"
        repeatCount="indefinite"
        path={activePath}
      />
    </g>

    <!-- 4. Contract Win Mint / Emerald Orb (#00E5A3) -->
    <g class="flow-orb-group">
      <!-- Ambient Outer Bloom Circle -->
      <circle r="5.5" fill="#00E5A3" opacity="0.4" filter={`url(#orbGlowMint-${variant})`} />
      <!-- Solid Core Bead -->
      <circle r="3.8" fill="#00D29E" />
      <!-- Luminous Specular Center Pin -->
      <circle r="1.4" fill="#FFFFFF" opacity="0.95" />
      <animateMotion
        dur="19s"
        begin="-9s"
        repeatCount="indefinite"
        path={activePath}
      />
    </g>
  </svg>
</div>

<style>
  .nav-flow-container {
    contain: layout style paint;
    will-change: transform;
  }

  .flow-orb-group {
    transform-origin: center;
    animation: orbPulseBreath 3.5s ease-in-out infinite;
  }

  @keyframes orbPulseBreath {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-flow-container animateMotion {
      dur: 0s !important;
    }
    .flow-orb-group {
      animation: none !important;
    }
  }
</style>

