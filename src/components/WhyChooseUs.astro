---
/**
 * WhyChooseUs.astro - Contragenix Recreation (Screenshot 4)
 * 
 * 100% Authentic Unity Compass Content & GovCon Value Proposition:
 * - Centered deep navy headline (#0B2553)
 * - 2-Column Split:
 *   - Left: 3D GovCon composition (RFP clipboard, hardhat, shield, cubes, crane)
 *   - Right: 3 stacked horizontal white rounded cards with alternating navy and brand red icon badges:
 *     1. Experience and GovCon Expertise (Navy badge)
 *     2. Customized & Defensible Solutions (Brand Red badge)
 *     3. Trust and Proven Reliability (Navy badge)
 * - Decorative line accent with red dot indicator
 * - Soothing light-blue background (#F8FAFD)
 */
---

<section
  id="why-choose-us"
  class="py-20 lg:py-28 bg-[#F8FAFD] relative overflow-hidden scroll-mt-20"
  aria-labelledby="why-heading"
>
  <!-- Ambient Soft Pastel Accents -->
  <div class="absolute top-1/4 -left-20 w-96 h-96 bg-blue-100/30 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-10 right-0 w-[450px] h-[450px] bg-red-50/20 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Centered Section Headline (Screenshot 4 Composition) -->
    <div class="text-center max-w-3xl mx-auto mb-14 lg:mb-20 reveal-on-scroll">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-[#0C487A] text-xs font-bold uppercase tracking-wider mb-4 shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-[#FF3130]" aria-hidden="true"></span>
        <span>Why Choose Unity Compass</span>
      </div>

      <h2
        id="why-heading"
        class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0B2553] tracking-tight leading-tight"
      >
        We Deliver Defensible Results <br class="hidden sm:inline" />
        for Federal Primes &amp; Contractors
      </h2>

      <!-- Animated Brand Accent Bar (Navy-to-Red Dynamic Pulse) -->
      <div class="w-24 h-1.5 rounded-full bg-gradient-to-r from-[#0C487A] via-[#1E40AF] to-[#FF3130] section-accent-line mx-auto mt-4"></div>
    </div>

    <!-- 2-Column Asymmetrical Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
      
      <!-- LEFT COLUMN: 3D Composition Graphic (Screenshot 4) -->
      <div class="lg:col-span-5 flex justify-center items-center relative reveal-on-scroll">
        <div class="relative w-full max-w-md lg:max-w-lg group">
          <!-- Subtle glow behind 3D image -->
          <div class="absolute inset-0 bg-gradient-to-tr from-[#0C487A]/10 to-[#FF3130]/10 rounded-full blur-2xl transform -scale-95 group-hover:scale-100 transition-transform duration-700 pointer-events-none"></div>
          
          <img
            src="/images/why-choose-3d.png"
            alt="Unity Compass Federal Proposal, RFP Capture and Advisory Solutions"
            class="relative z-10 w-full h-auto object-contain drop-shadow-2xl transform transition-transform duration-700 ease-out hover:scale-105"
            loading="lazy"
            width="540"
            height="500"
          />
        </div>
      </div>

      <!-- RIGHT COLUMN: 3 Stacked Horizontal White Cards (Screenshot 4) -->
      <div class="lg:col-span-7 space-y-6 sm:space-y-7 reveal-on-scroll delay-100">
        
        <!-- Card 1: Experience and GovCon Expertise (Navy Badge) -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-[0_10px_35px_-5px_rgba(11,37,83,0.06)] border border-slate-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group flex items-start gap-5 sm:gap-6">
          <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#0C487A] text-white flex items-center justify-center shrink-0 shadow-lg shadow-[#0C487A]/20 group-hover:scale-110 transition-transform duration-300">
            <!-- Gear / Expertise SVG Icon -->
            <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl sm:text-2xl font-bold text-[#0B2553] mb-2 group-hover:text-[#0C487A] transition-colors">
              Experience and GovCon Expertise
            </h3>
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal">
              With over a decade of industry experience, our professionals deliver rigorous, defensible services that withstand the strictest federal procurement evaluations and audit scrutiny.
            </p>
          </div>
        </div>

        <!-- Card 2: Customized & Defensible Solutions (Brand Red Badge) -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-[0_10px_35px_-5px_rgba(11,37,83,0.06)] border border-slate-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group flex items-start gap-5 sm:gap-6">
          <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#FF3130] text-white flex items-center justify-center shrink-0 shadow-lg shadow-[#FF3130]/25 group-hover:scale-110 transition-transform duration-300">
            <!-- Lightbulb / Custom Solutions SVG Icon -->
            <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl sm:text-2xl font-bold text-[#0B2553] mb-2 group-hover:text-[#FF3130] transition-colors">
              Customized &amp; Defensible Solutions
            </h3>
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal">
              We craft customized capture strategies, compliance matrices, and workforce surge models tailored to your exact federal scope and solicitation requirements.
            </p>
          </div>
        </div>

        <!-- Card 3: Trust and Proven Reliability (Navy Badge) -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-[0_10px_35px_-5px_rgba(11,37,83,0.06)] border border-slate-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group flex items-start gap-5 sm:gap-6">
          <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#0C487A] text-white flex items-center justify-center shrink-0 shadow-lg shadow-[#0C487A]/20 group-hover:scale-110 transition-transform duration-300">
            <!-- Handshake / Shield SVG Icon -->
            <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div>
            <h3 class="text-xl sm:text-2xl font-bold text-[#0B2553] mb-2 group-hover:text-[#0C487A] transition-colors">
              Trust and Proven Reliability
            </h3>
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal">
              Regarded as a trustworthy, dependable partner by leading defense prime contractors and commercial businesses across the United States.
            </p>
          </div>
        </div>

      </div>

    </div>

    <!-- Decorative Curved Line with Red Dot Indicator (Screenshot 4) -->
    <div class="mt-16 sm:mt-20 relative flex justify-end items-center pointer-events-none" aria-hidden="true">
      <img
        src="/images/line-element2.png"
        alt=""
        class="w-full max-w-2xl h-auto object-contain opacity-70"
        loading="lazy"
      />
      <!-- Glowing Red dot positioned on the curve -->
      <span class="absolute right-12 bottom-6 w-3.5 h-3.5 rounded-full bg-[#FF3130] shadow-[0_0_12px_rgba(255,49,48,0.8)] animate-pulse"></span>
    </div>

  </div>
</section>
