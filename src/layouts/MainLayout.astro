---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnimatedCursor from '../components/AnimatedCursor.astro';
import FloatingContactWidget from '../components/FloatingContactWidget.astro';
import Toast from '../components/Toast.astro';
import { companyInfo } from '../data/company';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title = 'Unity Compass | Government Contracting Consulting & Staffing',
  description = 'Unity Compass delivers strategic proposal development, OASIS+ readiness support, security-cleared recruitment, staffing solutions, and IT consulting to help federal contractors and commercial firms win and perform.',
  ogImage = '/images/Green-Minimal-Travel-Business-Logo.png',
  canonicalUrl = Astro.url.href,
} = Astro.props;

const siteUrl = 'https://unitycompass.com';
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

const schemaOrg = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: companyInfo.name,
      legalName: companyInfo.legalName,
      url: siteUrl,
      logo: `${siteUrl}/images/Green-Minimal-Travel-Business-Logo.png`,
      email: companyInfo.email,
      telephone: companyInfo.phone,
      address: {
        '@type': 'PostalAddress',
        streetAddress: companyInfo.address.street,
        addressLocality: companyInfo.address.city,
        addressRegion: companyInfo.address.state,
        postalCode: companyInfo.address.zip,
        addressCountry: 'US',
      },
      sameAs: [
        companyInfo.social.linkedin,
        companyInfo.social.twitter,
        companyInfo.social.instagram,
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: companyInfo.name,
      publisher: {
        '@id': `${siteUrl}/#organization`,
      },
    },
  ],
};
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#0C487A" />

    <!-- Premium Typography: Plus Jakarta Sans, Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
  </head>
  <body class="flex flex-col min-h-screen bg-white text-slate-900 font-sans antialiased selection:bg-[#0C487A] selection:text-white relative">
    <!-- Accessible Skip to Content -->
    <a
      href="#main-content"
      class="sr-only rounded-md sm:rounded-lg focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#FF3130] focus:text-white focus:shadow-lg focus:outline-none font-bold text-xs uppercase"
    >
      Skip to main content
    </a>

    <!-- Sticky Header (Glassmorphic on scroll) -->
    <Header />

    <!-- Main Content Slot -->
    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <!-- Global Enterprise Footer -->
    <Footer />

    <!-- Global Floating Contact & Support Hub -->
    <FloatingContactWidget />

    <!-- Executive Compass Navigational Reticle Cursor Follower -->
    <AnimatedCursor />

    <!-- Global Executive Dismissible Toaster -->
    <Toast />

    <!-- Global Motion & Universal Section Gradient Controller -->
    <script>
      function isDarkContainer(el: HTMLElement | null): boolean {
        let curr: HTMLElement | null = el;
        while (curr && curr !== document.body) {
          const cls = curr.className;
          if (typeof cls === 'string') {
            if (
              cls.includes('bg-[#0A1B3A]') ||
              cls.includes('bg-[#0B2553]') ||
              cls.includes('bg-[#0F172A]') ||
              cls.includes('bg-[#071120]') ||
              cls.includes('bg-slate-900') ||
              cls.includes('dark-section')
            ) {
              return true;
            }
          }
          if (curr.getAttribute('data-theme') === 'dark') return true;
          if (curr.tagName === 'FOOTER') return true;
          curr = curr.parentElement;
        }
        return false;
      }

      function applyUniversalSectionHeadingGradient() {
        // Automatically find all section headings across every single page
        const headings = document.querySelectorAll<HTMLElement>(
          'section h2, main h2, [aria-labelledby] h2, article h2'
        );

        headings.forEach((h2) => {
          if (
            h2.classList.contains('sr-only') ||
            h2.dataset.noShimmer !== undefined ||
            h2.classList.contains('text-white') ||
            isDarkContainer(h2)
          ) {
            return;
          }
          h2.classList.add('section-shimmer-heading');
        });
      }

      function setupScrollReveal() {
        const revealElements = document.querySelectorAll<HTMLElement>(
          '.reveal-on-scroll, .reveal-left, .reveal-right, .about-reveal, .career-reveal, .contact-reveal, .blog-reveal'
        );

        if (!revealElements.length) return;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (!('IntersectionObserver' in window) || prefersReducedMotion) {
          revealElements.forEach((el) => {
            el.classList.add('is-revealed', 'is-visible');
          });
          return;
        }

        // Fast-path: reveal anything already in viewport immediately
        const windowHeight = window.innerHeight || document.documentElement.clientHeight;
        revealElements.forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.top <= windowHeight + 60 && rect.bottom >= -60) {
            el.classList.add('is-revealed', 'is-visible');
          }
        });

        const observerOptions: IntersectionObserverInit = {
          root: null,
          rootMargin: '0px 0px -20px 0px',
          threshold: 0.05,
        };

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const target = entry.target as HTMLElement;
              target.classList.add('is-revealed', 'is-visible');
              obs.unobserve(target);
            }
          });
        }, observerOptions);

        revealElements.forEach((el) => {
          if (!el.classList.contains('is-revealed')) {
            observer.observe(el);
          }
        });
      }

      function initGlobalPageMotion() {
        try {
          applyUniversalSectionHeadingGradient();
        } catch (err) {
          console.warn('[Unity Compass] Heading gradient:', err);
        }

        try {
          setupScrollReveal();
        } catch (err) {
          console.warn('[Unity Compass] Scroll reveal:', err);
          document.querySelectorAll('.reveal-on-scroll, .reveal-left, .reveal-right').forEach((el) => {
            el.classList.add('is-revealed');
          });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initGlobalPageMotion);
      } else {
        initGlobalPageMotion();
      }

      document.addEventListener('astro:page-load', initGlobalPageMotion);
    </script>
  </body>
</html>
