---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnimatedCursor from '../components/AnimatedCursor.astro';
import FloatingContactWidget from '../components/FloatingContactWidget.astro';
import { companyInfo } from '../data/company';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title = 'Unity Compass | Government Contracting Consulting & Staffing',
  description = 'Unity Compass delivers strategic proposal development, OASIS+ readiness support, security-cleared recruitment, staffing solutions, and IT consulting to help federal contractors and commercial firms win and perform.',
  ogImage = '/images/Green-Minimal-Travel-Business-Logo.png',
  canonicalUrl = Astro.url.href,
} = Astro.props;

const siteUrl = 'https://unitycompass.com';
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

const schemaOrg = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: companyInfo.name,
      legalName: companyInfo.legalName,
      url: siteUrl,
      logo: `${siteUrl}/images/Green-Minimal-Travel-Business-Logo.png`,
      email: companyInfo.email,
      telephone: companyInfo.phone,
      address: {
        '@type': 'PostalAddress',
        streetAddress: companyInfo.address.street,
        addressLocality: companyInfo.address.city,
        addressRegion: companyInfo.address.state,
        postalCode: companyInfo.address.zip,
        addressCountry: 'US',
      },
      sameAs: [
        companyInfo.social.linkedin,
        companyInfo.social.twitter,
        companyInfo.social.instagram,
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: companyInfo.name,
      publisher: {
        '@id': `${siteUrl}/#organization`,
      },
    },
  ],
};
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#0C487A" />

    <!-- Premium Typography: Plus Jakarta Sans, Outfit & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
  </head>
  <body class="flex flex-col min-h-screen bg-white text-slate-900 font-sans antialiased selection:bg-[#0C487A] selection:text-white relative">
    <!-- Accessible Skip to Content -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#FF3130] focus:text-white focus:rounded-md focus:shadow-lg focus:outline-none font-bold text-xs uppercase"
    >
      Skip to main content
    </a>

    <!-- Sticky Header (Glassmorphic on scroll) -->
    <Header />

    <!-- Main Content Slot -->
    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <!-- Global Enterprise Footer -->
    <Footer />

    <!-- Global Floating Contact & Support Hub -->
    <FloatingContactWidget />

    <!-- Executive Compass Navigational Reticle Cursor Follower -->
    <AnimatedCursor />

    <!-- Global Scroll Reveal Observer Script -->
    <script>
      function setupScrollReveal() {
        const revealElements = document.querySelectorAll<HTMLElement>(
          '.reveal-on-scroll, .reveal-left, .reveal-right'
        );

        if (!('IntersectionObserver' in window)) {
          // Fallback if IntersectionObserver is unsupported
          revealElements.forEach((el) => el.classList.add('is-revealed'));
          return;
        }

        const observerOptions: IntersectionObserverInit = {
          root: null,
          rootMargin: '0px 0px -60px 0px',
          threshold: 0.1,
        };

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              obs.unobserve(entry.target);
            }
          });
        }, observerOptions);

        revealElements.forEach((el) => observer.observe(el));
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupScrollReveal);
      } else {
        setupScrollReveal();
      }
    </script>
  </body>
</html>
